<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY AnnotationVocabulary "https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/">
	<!ENTITY agento "http://www.w3id.org/agentic-ai/onto#">
	<!ENTITY cmns-av "https://www.omg.org/spec/Commons/AnnotationVocabulary/">
	<!ENTITY cmns-cls "https://www.omg.org/spec/Commons/Classifiers/">
	<!ENTITY cmns-col "https://www.omg.org/spec/Commons/Collections/">
	<!ENTITY cmns-doc "https://www.omg.org/spec/Commons/Documents/">
	<!ENTITY cmns-org "https://www.omg.org/spec/Commons/Organizations/">
	<!ENTITY dc "http://purl.org/dc/elements/1.1/">
	<!ENTITY dct "http://purl.org/dc/terms/">
	<!ENTITY expr "http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#">
	<!ENTITY fibo-fnd-gao-obj "https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/">
	<!ENTITY oe-agtorch "https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY pplan "http://purl.org/net/p-plan#">
	<!ENTITY process "http://www.daml.org/services/owl-s/1.2/Process.owl#">
	<!ENTITY prov "http://www.w3.org/ns/prov#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY vann "http://purl.org/vocab/vann/">
	<!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/"
	xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/"
	xmlns:AnnotationVocabulary="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"
	xmlns:agento="http://www.w3id.org/agentic-ai/onto#"
	xmlns:cmns-av="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
	xmlns:cmns-cls="https://www.omg.org/spec/Commons/Classifiers/"
	xmlns:cmns-col="https://www.omg.org/spec/Commons/Collections/"
	xmlns:cmns-doc="https://www.omg.org/spec/Commons/Documents/"
	xmlns:cmns-org="https://www.omg.org/spec/Commons/Organizations/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:dct="http://purl.org/dc/terms/"
	xmlns:expr="http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#"
	xmlns:fibo-fnd-gao-obj="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/"
	xmlns:oe-agtorch="https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:pplan="http://purl.org/net/p-plan#"
	xmlns:process="http://www.daml.org/services/owl-s/1.2/Process.owl#"
	xmlns:prov="http://www.w3.org/ns/prov#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:vann="http://purl.org/vocab/vann/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/">
		<dct:abstract xml:lang="en">The Agentic Capabilities Orchestration ontology describes how an agent harness chooses and orders the skills and Model Context Protocol tools that answer a user request. It links requests, information requirements and user constraints to capabilities, skills, tools and servers; represents candidate orchestration plans with their workflow steps, tasks, and the information artifacts each task consumes and produces; records how a plan is evaluated and selected; and traces invocations for provenance. The supplement recommendation scenarios of use case AC-001 scope it. It reuses AgentO, P-Plan, OWL-S Process, PROV-O and the OMG Commons Ontology Library.</dct:abstract>
		<owl:imports rdf:resource="http://purl.org/net/p-plan#"/>
		<owl:imports rdf:resource="http://www.daml.org/services/owl-s/1.2/Process.owl"/>
		<owl:imports rdf:resource="http://www.w3id.org/agentic-ai/onto"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Classifiers/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Collections/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Documents/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Organizations/"/>
		<owl:imports rdf:resource="https://www.w3.org/ns/prov-o.owl"/>
		<owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/agentic-orchestration/agentic-orchestration/"/>
	</owl:Ontology>
	
	<owl:AnnotationProperty rdf:about="&dct;source">
	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="&pplan;Plan">
	</owl:Class>
	
	<owl:Class rdf:about="&pplan;Step">
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&pplan;correspondsToStep">
		<rdfs:label xml:lang="en">corresponds to step</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">links an execution activity to its planned workflow step</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&process;hasParameter">
		<rdfs:label xml:lang="en">has parameter</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">relationship linking a process interface to a formal parameter through which values are supplied or returned</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&process;hasPrecondition">
		<rdfs:label xml:lang="en">has precondition</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">relationship linking a process to a condition that must hold for it to execute successfully</skos:definition>
	</owl:ObjectProperty>
	
	<rdfs:Datatype rdf:about="&xsd;date">
	</rdfs:Datatype>
	
	<owl:AnnotationProperty rdf:about="&skos;altLabel">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&skos;definition">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&skos;scopeNote">
	</owl:AnnotationProperty>
	
	<owl:ObjectProperty rdf:about="&prov;used">
		<rdfs:label xml:lang="en">used</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">links an invocation to an information artifact it used</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasAssociatedWith">
		<rdfs:label xml:lang="en">was associated with</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">links an invocation to an agent responsible for its execution</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasDerivedFrom">
		<rdfs:label xml:lang="en">was derived from</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">links an answer or other entity to an entity from which it was derived</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasGeneratedBy">
		<rdfs:label xml:lang="en">was generated by</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">links a generated information artifact to the activity that produced it</skos:definition>
	</owl:ObjectProperty>
	
	<rdf:Description rdf:about="&agento;Capability">
		<owl:equivalentClass rdf:resource="&oe-agtorch;Capability"/>
	</rdf:Description>
	
	<owl:Class rdf:about="&agento;LLMAgent">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;usesTool"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Tool"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">large language model agent</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">software agent that uses a large language model to guide its task-directed actions</skos:definition>
		<skos:scopeNote xml:lang="en">Reuses the AgentO class IRI; this is not a new local agent class.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&agento;WorkflowPattern">
	</owl:Class>
	
	<owl:Class rdf:about="&agento;WorkflowStep">
		<rdfs:label xml:lang="en">workflow step</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<dct:source rdf:resource="http://www.w3id.org/agentic-ai/onto"/>
		<skos:definition xml:lang="en">planned phase or position within an orchestration workflow that is associated with a task</skos:definition>
		<skos:scopeNote xml:lang="en">Reuses the AgentO class IRI and its named superclass p-plan:Step. AgentO is imported from its published ontology.</skos:scopeNote>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&agento;performedBy">
	</owl:ObjectProperty>
	
	<owl:Class rdf:about="&oe-agtorch;Answer">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;wasDerivedFrom"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">answer</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">information artifact that communicates a response to a user’s query and represents the result of completing a task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ArticleAbstract">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">article abstract</rdfs:label>
		<skos:definition xml:lang="en">information artifact that summarizes one research article and is returned by a literature search tool</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">PubMed User Guide, field tag AB (Abstract)</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Assessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">assessment</rdfs:label>
		<skos:definition xml:lang="en">information artifact that records a judgment about one candidate supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">IAO information content entity (genus, via information artifact); use case CQ 4 (differentia)</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;CandidateOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:label xml:lang="en">candidate orchestration plan</rdfs:label>
		<skos:definition xml:lang="en">orchestration plan proposed as a possible solution to a user request, subject to evaluation and selection</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;CandidateSupplement">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">candidate supplement</rdfs:label>
		<skos:definition xml:lang="en">information artifact describing a supplement being considered for a recommendation</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Capability">
		<rdfs:label xml:lang="en">capability</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">ability of an agent to perform a type of action or task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ConflictingEvidenceAssessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;EvidenceAssessment"/>
		<rdfs:label xml:lang="en">conflicting evidence assessment</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;EvidenceAssessment">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;hasFinding"/>
						<owl:someValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&oe-agtorch;hasEvidenceDirection"/>
								<owl:hasValue rdf:resource="&oe-agtorch;disputing"/>
							</owl:Restriction>
						</owl:someValuesFrom>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;hasFinding"/>
						<owl:someValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&oe-agtorch;hasEvidenceDirection"/>
								<owl:hasValue rdf:resource="&oe-agtorch;supporting"/>
							</owl:Restriction>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">evidence assessment that has at least one supporting finding and at least one disputing finding</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Defined class: EvidenceAssessment and (hasFinding some (hasEvidenceDirection value supporting)) and (hasFinding some (hasEvidenceDirection value disputing))</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ContentGeneration">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">content generation</rdfs:label>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” NORA 2026 workshop, IJCAI-ECAI 2026. https://openreview.net/forum?id=7MVoH9Y3mi</dct:source>
		<skos:definition xml:lang="en">capability that produces an information artifact by creating or composing content from intermediate information artifacts</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;DataProcessing">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">data processing</rdfs:label>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” NORA 2026 workshop, IJCAI-ECAI 2026. https://openreview.net/forum?id=7MVoH9Y3mi</dct:source>
		<skos:definition xml:lang="en">capability that operates on data to produce an information artifact</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;DecisionCriterion">
		<rdfs:label xml:lang="en">decision criterion</rdfs:label>
		<skos:definition xml:lang="en">criterion used to compare and select candidate orchestration plans based on measurable attributes and preferences</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceAssessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Assessment"/>
		<rdfs:label xml:lang="en">evidence assessment</rdfs:label>
		<skos:definition xml:lang="en">assessment that summarizes and weighs the research findings about one candidate supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO evidence line and evidence strength; use case</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceCertaintyLevel">
		<rdfs:label xml:lang="en">evidence certainty level</rdfs:label>
		<skos:definition xml:lang="en">category expressing how confident an assessment is that the summarized evidence reflects the true effect of the supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">GRADE guidelines 3: quality of evidence reflects confidence that the estimates of the effect are correct; four levels high, moderate, low, very low</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceCoverage">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">evidence coverage</rdfs:label>
		<skos:definition xml:lang="en">plan metric expressing how fully an orchestration plan covers the evidence needed to address a request</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceDirection">
		<rdfs:label xml:lang="en">evidence direction</rdfs:label>
		<skos:definition xml:lang="en">category stating whether a finding or an assessment supports, disputes, or is inconclusive about the effect of a supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “A data item that indicates an agent’s assessment of whether an evidence line supports or disputes a target proposition (or represents inconclusive evidence that is not sufficient for either).”</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceFinding">
		<rdfs:label xml:lang="en">evidence finding</rdfs:label>
		<skos:definition xml:lang="en">record of the result that one research article reports about one candidate supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: evidence line, “an independent and meaningful argument for or against a particular proposition, that is based on the interpretation of one or more pieces of information as evidence”</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutableResource">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">executable resource</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that an agent can run to perform computational operations, rather than only read as guidance or information</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutionConstraint">
		<rdfs:subClassOf rdf:resource="&agento;Constraint"/>
		<rdfs:label xml:lang="en">execution constraint</rdfs:label>
		<owl:disjointWith rdf:resource="&oe-agtorch;UserConstraint"/>
		<skos:definition xml:lang="en">constraint on the ordering, resource use, timing, or other operational conditions of tool or skill execution</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutionTrace">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">execution trace</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">chronological record of a workflow&apos;s actual execution, capturing the steps performed and their outcomes</skos:definition>
		<skos:scopeNote xml:lang="en">An information artifact recording execution, not a workflow plan. The records property identifies the recorded invocations; explicit timestamps and ordering are outside Figures 4 and 7.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExternalTool">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Tool"/>
		<rdfs:label xml:lang="en">external tool</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">tool that is exposed by a server or service outside the agent harness and is invoked through a communication protocol or a command-line interface</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;HardConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;UserConstraint"/>
		<rdfs:label xml:lang="en">hard constraint</rdfs:label>
		<skos:definition xml:lang="en">user constraint that an acceptable orchestration plan must satisfy</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationAccess">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">information access</rdfs:label>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” NORA 2026 workshop, IJCAI-ECAI 2026. https://openreview.net/forum?id=7MVoH9Y3mi</dct:source>
		<skos:definition xml:lang="en">capability that obtains information artifacts from an information source</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationArtifact">
		<rdfs:subClassOf rdf:resource="&prov;Entity"/>
		<rdfs:label xml:lang="en">information artifact</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">information content entity represented as an identifiable item that can be consumed, produced, or retained during an agent workflow</skos:definition>
		<skos:scopeNote xml:lang="en">Includes supplied input and generated output. Figure 7 generation is expressed on Invocation using inverse prov:wasGeneratedBy, so an input artifact is not required to have been generated by an invocation in this workflow.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationRequirement">
		<rdfs:label xml:lang="en">information requirement</rdfs:label>
		<skos:definition xml:lang="en">formalized description of information that a user needs to obtain</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Input">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">input</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;InformationArtifact">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-agtorch;consumes"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom rdf:resource="&agento;Task"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">information artifact that some task consumes</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Defined class: InformationArtifact and (inverse consumes some Task)</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InputConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Precondition"/>
		<rdfs:label xml:lang="en">input constraint</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">condition on the value of an input that an invocation must satisfy to be accepted by the tool or skill</skos:definition>
		<skos:scopeNote xml:lang="en">Figure 4 depicts this as a separate class. No additional superclass is imposed: Figure 2 and the curated term list differ on its placement, so that cross-figure reconciliation remains for the team.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Instruction">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">instruction</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that specifies the procedures, rules, or guidance an agent follows when applying a skill to perform a task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;IntermediateArtifact">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Output"/>
		<rdfs:label xml:lang="en">intermediate artifact</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Output">
					</rdf:Description>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">information artifact that one task produces and another task consumes</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Defined class: Input and Output</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Invocation">
		<rdfs:subClassOf rdf:resource="&pplan;Activity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&pplan;correspondsToStep"/>
				<owl:someValuesFrom rdf:resource="&agento;WorkflowStep"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;used"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;wasAssociatedWith"/>
				<owl:someValuesFrom rdf:resource="&agento;LLMAgent"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty>
					<rdf:Description>
						<owl:inverseOf rdf:resource="&prov;wasGeneratedBy"/>
					</rdf:Description>
				</owl:onProperty>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">invocation</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">execution activity in which a particular tool or skill is called or applied</skos:definition>
		<skos:scopeNote xml:lang="en">An actual occurrence, distinct from the tool or skill specification and from the planned workflow step. The required correspondsToStep value, combined with the functional P-Plan property, gives exactly one planned step. Existential restrictions do not require an explicitly asserted named value under OWL open-world semantics.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Latency">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">latency</rdfs:label>
		<skos:definition xml:lang="en">plan metric expressing elapsed time from an agent’s receipt of a task or request to completion of its response or execution</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ModelContextProtocolServer">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Server"/>
		<rdfs:label xml:lang="en">model context protocol server</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:altLabel xml:lang="en">MCPServer</skos:altLabel>
		<skos:definition xml:lang="en">server that implements the Model Context Protocol to expose supported tools, resources, or prompts to MCP clients</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ModelContextProtocolTool">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExternalTool"/>
		<rdfs:label xml:lang="en">model context protocol tool</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:altLabel xml:lang="en">MCPTool</skos:altLabel>
		<skos:definition xml:lang="en">tool exposed by an MCP server for discovery and invocation by an MCP client through the Model Context Protocol</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OptionalInput">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:label xml:lang="en">optional input</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;fills"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-agtorch;Parameter">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-agtorch;isRequired"/>
										<owl:hasValue rdf:datatype="&xsd;boolean">false</owl:hasValue>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">input that may be omitted from a tool or skill invocation without preventing the operation from being performed</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&pplan;Plan"/>
		<rdfs:label xml:lang="en">orchestration plan</rdfs:label>
		<skos:definition xml:lang="en">plan that prescribes which capabilities to invoke, and in what order, to satisfy the information requirements of one request</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">P-Plan Plan (genus); use case CQ 1 (differentia)</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OrchestrationWorkflowStep">
		<rdfs:subClassOf rdf:resource="&agento;WorkflowStep"/>
		<rdfs:label xml:lang="en">orchestration workflow step</rdfs:label>
		<dct:source xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, AgentO: An Ontology for Modeling Agentic AI Systems, ESWC 2026 (WorkflowStep, hasAssociatedTask). http://www.w3id.org/agentic-ai/onto</dct:source>
		<skos:definition xml:lang="en">workflow step of an orchestration plan that is associated with the task carried out at that point in the plan</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Output">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">output</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;InformationArtifact">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-agtorch;produces"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom rdf:resource="&agento;Task"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">information artifact that some task produces</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Defined class: InformationArtifact and (inverse produces some Task)</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OutputType">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ParameterType"/>
		<rdfs:label xml:lang="en">output type</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">parameter type that specifies the class or datatype of the values an invocation returns through an output parameter</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Parameter">
		<rdfs:label xml:lang="en">parameter</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">named element of the interface of a tool or skill through which a value is passed into or returned from an invocation</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ParameterType">
		<rdfs:label xml:lang="en">parameter type</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">class or datatype to which the values of a parameter must belong</skos:definition>
		<skos:scopeNote xml:lang="en">Instances describe permitted value types. They are type descriptions, not the values passed at runtime. hasType is not equivalent to the OWL-S datatype property parameterType.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PlanEvaluation">
		<rdfs:label xml:lang="en">plan evaluation</rdfs:label>
		<skos:definition xml:lang="en">evaluation record that associates an orchestration plan with the criteria used and the plan metrics obtained</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PlanMetric">
		<rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure"/>
		<rdfs:label xml:lang="en">plan metric</rdfs:label>
		<owl:disjointWith rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/MaterialMeasure"/>
		<skos:definition xml:lang="en">measure used in an evaluation to characterize an orchestration plan on a specified dimension</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Precondition">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExecutionConstraint"/>
		<rdfs:label xml:lang="en">precondition</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">execution constraint that must hold for a tool or skill to be validly invoked</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PreferenceSetting">
		<rdfs:label xml:lang="en">preference setting</rdfs:label>
		<skos:definition xml:lang="en">configuration item expressing a user preference that can be used to derive a user constraint</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ProductList">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">product list</rdfs:label>
		<skos:definition xml:lang="en">information artifact containing product records retrieved for one or more candidate supplements</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ReferenceMaterial">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">reference material</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that provides knowledge or contextual information an agent uses when applying a skill to perform a task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;RejectedOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:label xml:lang="en">rejected orchestration plan</rdfs:label>
		<owl:disjointWith rdf:resource="&oe-agtorch;SelectedOrchestrationPlan"/>
		<skos:definition xml:lang="en">candidate orchestration plan that has not been selected for execution</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Request">
		<rdfs:label xml:lang="en">request</rdfs:label>
		<skos:definition xml:lang="en">user input that expresses a task, action, or information need for an agent to address</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;RequiredInput">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:label xml:lang="en">required input</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;fills"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-agtorch;Parameter">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-agtorch;isRequired"/>
										<owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">input that must be supplied for a tool or skill invocation to be accepted</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SafetyAssessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Assessment"/>
		<rdfs:label xml:lang="en">safety assessment</rdfs:label>
		<skos:definition xml:lang="en">assessment recording the result of checking a candidate supplement against relevant safety constraints</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Version 1.1 term list row; genus changed from information artifact to assessment</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Script">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExecutableResource"/>
		<rdfs:label xml:lang="en">script</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">executable resource that specifies the computational operations an agent can invoke when applying a skill to perform a task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SearchQuery">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">search query</rdfs:label>
		<skos:definition xml:lang="en">information artifact specifying search terms or criteria submitted to an information-retrieval tool</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SelectedOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:label xml:lang="en">selected orchestration plan</rdfs:label>
		<skos:definition xml:lang="en">candidate orchestration plan that has been selected for execution</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Server">
		<rdfs:label xml:lang="en">server</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">software component that exposes computational resources and operations to clients through a communication protocol</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Skill">
		<rdfs:label xml:lang="en">skill</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">specification of a focused agent behavior that can be applied to perform a class of tasks</skos:definition>
		<skos:scopeNote xml:lang="en">A reusable behavior specification, not an invocation. Included as a shared reference from Figure 3; Skill is not modeled as a subclass of Capability, following the conceptual model Figure 3 decision.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SkillInvocation">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;invokes"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;Skill"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">skill invocation</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">invocation event in which a specific skill is selected and applied to perform a task</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SkillResource">
		<rdfs:subClassOf rdf:resource="http://w3id.org/beam/core#Resource"/>
		<rdfs:label xml:lang="en">skill resource</rdfs:label>
		<skos:definition xml:lang="en">resource used to aid in skill execution</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SoftConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;UserConstraint"/>
		<rdfs:label xml:lang="en">soft constraint</rdfs:label>
		<skos:definition xml:lang="en">user constraint that represents a preference or desirable condition that may be relaxed when evaluating an orchestration plan</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;StudyDesign">
		<rdfs:label xml:lang="en">study design</rdfs:label>
		<skos:definition xml:lang="en">category of research method used by the study that an article reports, as indexed by MeSH publication types</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH publication types; PubMed field tag PT</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SystemInteraction">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">system interaction</rdfs:label>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” NORA 2026 workshop, IJCAI-ECAI 2026. https://openreview.net/forum?id=7MVoH9Y3mi</dct:source>
		<skos:definition xml:lang="en">capability that performs an operation on or through an external computational system</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Template">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">template</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that provides the expected structure and organization of an information artifact produced when an agent applies a skill</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;TokenCost">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">token cost</rdfs:label>
		<skos:definition xml:lang="en">plan metric expressing monetary cost incurred for processing input tokens and generating output tokens during agent execution, calculated using the applicable model or provider rates</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Tool">
		<rdfs:subClassOf rdf:resource="&process;Process"/>
		<rdfs:subClassOf rdf:resource="&agento;Tool"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;hasCapability"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Capability"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&process;hasParameter"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Parameter"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&process;hasPrecondition"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Precondition"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">tool</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">callable computational resource that performs a defined operation when invoked</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolCallCount">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">tool call count</rdfs:label>
		<skos:definition xml:lang="en">plan metric recording the number of tool invocations attributed to an orchestration plan</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolCost">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">tool cost</rdfs:label>
		<skos:definition xml:lang="en">plan metric expressing cost attributable to invoking and using a tool in an agent workflow, including applicable per-use charges and associated model-processing costs</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolInvocation">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;invokes"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;Tool"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isPartOf"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;SkillInvocation"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">tool invocation</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<skos:definition xml:lang="en">invocation event in which a specific tool is requested to perform its operation using supplied input</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;UserConstraint">
		<rdfs:subClassOf rdf:resource="&agento;Constraint"/>
		<rdfs:label xml:lang="en">user constraint</rdfs:label>
		<skos:definition xml:lang="en">constraint derived from a user&apos;s request, profile, or execution preferences that governs the selection or execution of an orchestration plan</skos:definition>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;addresses">
		<rdfs:label xml:lang="en">addresses</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;Request"/>
		<skos:definition xml:lang="en">relation from an orchestration plan to the request it is intended to handle</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;assessesSupplement">
		<rdfs:label xml:lang="en">assesses supplement</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;Assessment"/>
		<rdfs:range rdf:resource="&oe-agtorch;CandidateSupplement"/>
		<skos:definition xml:lang="en">relation from an assessment to the candidate supplement it judges</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Use case CQ 4</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;caseReport">
		<rdf:type rdf:resource="&oe-agtorch;StudyDesign"/>
		<rdfs:label xml:lang="en">case report</rdfs:label>
		<skos:definition xml:lang="en">study design that describes the clinical presentation of one or a few individual patients</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH D002363 Case Reports (publication type)</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;conflictsWith">
		<rdfs:label xml:lang="en">conflicts with</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;SoftConstraint"/>
		<skos:definition xml:lang="en">relationship between soft constraints whose preferences cannot both be fully satisfied in the same planning context</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;constrains">
		<rdfs:label xml:lang="en">constrains</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;InputConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;Parameter"/>
		<skos:definition xml:lang="en">relationship linking an input constraint to the parameter whose permitted input values it restricts</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;consumes">
		<rdfs:label xml:lang="en">consumes</rdfs:label>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<skos:definition xml:lang="en">relation from a task to an information artifact it requires or uses as input</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;dependsOn">
		<rdfs:label xml:lang="en">depends on</rdfs:label>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&agento;Task"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;consumes">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&oe-agtorch;produces"/>
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a task to another task that produces an information artifact the first task consumes</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">Use case CQ 2 step 3: “A workflow step is dependent on another if it consumes an InformationArtifact produced by that step”; AgentO v0.2 requiresResource and producedResource; OWL 2 property chain</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;disputing">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceDirection"/>
		<rdfs:label xml:lang="en">disputing</rdfs:label>
		<skos:definition xml:lang="en">evidence direction indicating that the evidence argues against the claimed effect of the supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO label “disputing” (no definition in the 2023-06-13 release); wording mirrors the definition of supporting</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;evaluates">
		<rdfs:label xml:lang="en">evaluates</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figures 1 and 6 (evaluates); multiple-criteria decision analysis, https://www.sciencedirect.com/topics/computer-science/multiple-criteria-decision-analysis</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<skos:definition xml:lang="en">relation from a plan evaluation to the candidate orchestration plan whose metrics and criteria scores it records</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;exposes">
		<rdfs:label xml:lang="en">exposes</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Server"/>
		<rdfs:range rdf:resource="&oe-agtorch;Tool"/>
		<skos:definition xml:lang="en">relationship linking a server to a tool it makes available for discovery or invocation</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;expresses">
		<rdfs:label xml:lang="en">expresses</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Goal">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;InformationRequirement">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:range>
		<skos:definition xml:lang="en">relationship linking a request to the goal or information requirement communicated in it</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;fills">
		<rdfs:label xml:lang="en">fills</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:range rdf:resource="&oe-agtorch;Parameter"/>
		<skos:definition xml:lang="en">relation from an information artifact to the parameter for which it supplies a value</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasCapability">
		<rdfs:label xml:lang="en">has capability</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:range rdf:resource="&agento;Capability"/>
		<skos:definition xml:lang="en">relationship linking a skill or tool to an ability it provides</skos:definition>
		<skos:scopeNote xml:lang="en">Shared by tools and skills in Figures 3 and 4. No Tool-only global domain is asserted, because that would classify every skill using this property as a Tool. Figure 4 constrains the property locally on Tool.</skos:scopeNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasCertaintyLevel">
		<rdfs:label xml:lang="en">has certainty level</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;EvidenceAssessment"/>
		<rdfs:range rdf:resource="&oe-agtorch;EvidenceCertaintyLevel"/>
		<skos:definition xml:lang="en">relation from an evidence assessment to the certainty level of the evidence it summarizes</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “A relation describing the degree of support provided by an evidence line for a target assertion or proposition.”; GRADE levels</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasDirection">
		<rdfs:label xml:lang="en">has direction</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<rdfs:range>
			<rdfs:Datatype>
				<owl:oneOf>
					<rdf:List>
						<rdf:first>maximize</rdf:first>
						<rdf:rest>
							<rdf:List>
								<rdf:first>minimize</rdf:first>
								<rdf:rest rdf:resource="&rdf;nil"/>
							</rdf:List>
						</rdf:rest>
					</rdf:List>
				</owl:oneOf>
			</rdfs:Datatype>
		</rdfs:range>
		<skos:definition xml:lang="en">indicates whether a decision criterion should be minimized or maximized</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasEvidenceDirection">
		<rdfs:label xml:lang="en">has evidence direction</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;EvidenceAssessment">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;EvidenceFinding">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-agtorch;EvidenceDirection"/>
		<skos:definition xml:lang="en">relation from an evidence finding or an evidence assessment to its evidence direction</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “A relation indicating whether an evidence line supports or disputes a target proposition (or represents inconclusive evidence that is not sufficient for either).”</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasFinding">
		<rdfs:label xml:lang="en">has finding</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;EvidenceAssessment"/>
		<rdfs:range rdf:resource="&oe-agtorch;EvidenceFinding"/>
		<skos:definition xml:lang="en">relation from an evidence assessment to an evidence finding it summarizes</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “A relation between a proposition and information that supports its validity, based on the evaluation of some agent.”</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasMeasurement">
		<rdfs:label xml:lang="en">has measurement</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;PlanMetric"/>
		<skos:definition xml:lang="en">relates a plan evaluation to a metric used in the evaluation</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasPrecondition">
		<rdfs:label xml:lang="en">has precondition</rdfs:label>
		<dct:source xml:lang="en">D. Martin et al., OWL-S: Semantic Markup for Web Services, W3C Member Submission, 2004, section 5.1 (hasPrecondition). https://www.w3.org/submissions/OWL-S/</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;Precondition"/>
		<skos:definition xml:lang="en">relation from a skill to a precondition that must hold before the skill can be validly applied</skos:definition>
		<skos:scopeNote xml:lang="en">Tools use OWL-S process:hasPrecondition, whose domain is process:Process. This property serves skills, which are not processes, as in conceptual model Figure 3.</skos:scopeNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasPriority">
		<rdfs:label xml:lang="en">has priority</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&xsd;integer"/>
		<skos:definition xml:lang="en">relative importance of two or more soft constraints, which determines the selection of an orchestration plan</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasPublicationDate">
		<rdfs:label xml:lang="en">has publication date</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;ArticleAbstract"/>
		<rdfs:range rdf:resource="&xsd;date"/>
		<skos:definition xml:lang="en">attribute of an article abstract giving the date its article was published</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">PubMed User Guide, field tag DP</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasRank">
		<rdfs:label xml:lang="en">has rank</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&xsd;integer"/>
		<skos:definition xml:lang="en">ranking position assigned to a plan evaluation</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasResource">
		<rdfs:label xml:lang="en">has resource</rdfs:label>
		<dct:source xml:lang="en">X. Li et al., “SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,” arXiv:2602.12670, 2026, section 2 (Skill Definition) and Table 1. https://arxiv.org/abs/2602.12670</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;SkillResource"/>
		<skos:definition xml:lang="en">relation from a skill to a skill resource included in its reusable specification or package</skos:definition>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasScore">
		<rdfs:label xml:lang="en">has score</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:definition xml:lang="en">numerical evaluation score assigned to a plan evaluation</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasStep">
		<rdfs:label xml:lang="en">has step</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<skos:definition xml:lang="en">relationship connecting an orchestration plan with one of its constituent steps</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasStudyDesign">
		<rdfs:label xml:lang="en">has study design</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;EvidenceFinding"/>
		<rdfs:range rdf:resource="&oe-agtorch;StudyDesign"/>
		<skos:definition xml:lang="en">relation from an evidence finding to the design of the study that produced it</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH publication types</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasTask">
		<rdfs:label xml:lang="en">has task</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&agento;Task"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasStep">
			</rdf:Description>
			<rdf:Description rdf:about="&agento;hasAssociatedTask">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to a task that is associated with one of the plan’s workflow steps</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">has step composed with AgentO v0.2 hasAssociatedTask (“Links a workflow step to the task it corresponds to.”); OWL 2 property chain</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasType">
		<rdfs:label xml:lang="en">has type</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Parameter"/>
		<rdfs:range rdf:resource="&oe-agtorch;ParameterType"/>
		<skos:definition xml:lang="en">relationship linking a parameter to the class or datatype that specifies its permitted values</skos:definition>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasUnit">
		<rdfs:label xml:lang="en">has unit</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition xml:lang="en">unit of measurement associated with a plan metric</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasValue">
		<rdfs:label xml:lang="en">has value</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:definition xml:lang="en">numerical value of a plan metric</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasWeight">
		<rdfs:label xml:lang="en">has weight</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:definition xml:lang="en">relative importance assigned to a decision criterion</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;high">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceCertaintyLevel"/>
		<rdfs:label xml:lang="en">high</rdfs:label>
		<skos:definition xml:lang="en">evidence certainty level at which the true effect very likely lies close to the estimated effect</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">GRADE guidelines 3 (Balshem et al., 2011), definitions of the four levels</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;inconclusive">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceDirection"/>
		<rdfs:label xml:lang="en">inconclusive</rdfs:label>
		<skos:definition xml:lang="en">evidence direction indicating that the evidence is not sufficient to argue for or against the claimed effect of the supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “An evidence direction indicating that an evidence line lacks sufficient credibility, relevance, or completeness to argue for or against the validity of a target assertion.”</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;invokes">
		<rdfs:label xml:lang="en">invokes</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:range>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Skill">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Tool">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:range>
		<skos:definition xml:lang="en">links an invocation to the tool or skill specification executed by that occurrence</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isMeasuredBy">
		<rdfs:label xml:lang="en">is measured by</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<skos:definition xml:lang="en">relates a soft constraint to a decision criterion used to measure it</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isPartOf">
		<rdfs:label xml:lang="en">is part of</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;ToolInvocation"/>
		<rdfs:range rdf:resource="&oe-agtorch;SkillInvocation"/>
		<skos:definition xml:lang="en">links a tool invocation to the skill invocation that made that tool call</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isReportedIn">
		<rdfs:label xml:lang="en">is reported in</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;EvidenceFinding"/>
		<rdfs:range rdf:resource="&oe-agtorch;ArticleAbstract"/>
		<skos:definition xml:lang="en">relation from an evidence finding to the article abstract that reports it</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “A relation that holds between an evidence line and a citable document from which information supporting the evidence line was obtained.”</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;isRequired">
		<rdfs:label xml:lang="en">is required</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Parameter"/>
		<rdfs:range rdf:resource="&xsd;boolean"/>
		<skos:definition xml:lang="en">boolean attribute of a parameter indicating whether an input must be supplied for invocation</skos:definition>
		<skos:scopeNote xml:lang="en">true marks a required parameter and false an optional one. An absent assertion means unknown. This metadata does not perform runtime validation under OWL&apos;s open-world semantics.</skos:scopeNote>
	</owl:DatatypeProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;low">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceCertaintyLevel"/>
		<rdfs:label xml:lang="en">low</rdfs:label>
		<skos:definition xml:lang="en">evidence certainty level at which the true effect may be substantially different from the estimated effect</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">GRADE guidelines 3 (Balshem et al., 2011), definitions of the four levels</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;moderate">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceCertaintyLevel"/>
		<rdfs:label xml:lang="en">moderate</rdfs:label>
		<skos:definition xml:lang="en">evidence certainty level at which the true effect is likely close to the estimated effect but may be substantially different</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">GRADE guidelines 3 (Balshem et al., 2011), definitions of the four levels</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;observationalStudy">
		<rdf:type rdf:resource="&oe-agtorch;StudyDesign"/>
		<rdfs:label xml:lang="en">observational study</rdfs:label>
		<skos:definition xml:lang="en">study design in which the investigator does not assign participants to the interventions they receive</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH D064888 Observational Study: “… a clinical study in which participants may receive diagnostic, therapeutic, or other types of interventions, but the investigator does not assign participants to specific interventions.”</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;performedBySkill">
		<rdfs:label xml:lang="en">performed by skill</rdfs:label>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;Skill"/>
		<skos:definition xml:lang="en">relation from a task to the skill that carries it out</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">AgentO v0.2 performedBy (“Indicates the tool/agent that performs the task in a step.”); named after performedByAgent</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;produces">
		<rdfs:label xml:lang="en">produces</rdfs:label>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<skos:definition xml:lang="en">relation from a task to an information artifact it yields as output</skos:definition>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;randomizedControlledTrial">
		<rdf:type rdf:resource="&oe-agtorch;StudyDesign"/>
		<rdfs:label xml:lang="en">randomized controlled trial</rdfs:label>
		<skos:definition xml:lang="en">study design in which a random process assigns participants to a test treatment or a control treatment that are followed up concurrently</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH D016449 Randomized Controlled Trial: “A work that reports on a clinical trial that involves at least one test treatment and one control treatment, concurrent enrollment and follow-up of the test- and control-treated groups, and in which the treatments to be administered are selected by a random process.”</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;records">
		<rdfs:label xml:lang="en">records</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, version 1.1, Figure 7 (page 8); OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;ExecutionTrace"/>
		<rdfs:range rdf:resource="&oe-agtorch;Invocation"/>
		<skos:definition xml:lang="en">links an execution trace to an invocation included in its record</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;satisfiesConstraint">
		<rdfs:label xml:lang="en">satisfies constraint</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Capability">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;OrchestrationPlan">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&agento;Constraint"/>
		<skos:definition xml:lang="en">relation from an orchestration plan or a capability to a constraint that it satisfies</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;satisfiesRequirement">
		<rdfs:label xml:lang="en">satisfies requirement</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_UseCase.pdf, Section VII, competency questions 3 and 5.</dct:source>
		<rdfs:domain rdf:resource="&agento;Capability"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<skos:definition xml:lang="en">relation from a capability to an information requirement that the capability meets</skos:definition>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;supporting">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceDirection"/>
		<rdfs:label xml:lang="en">supporting</rdfs:label>
		<skos:definition xml:lang="en">evidence direction indicating that the evidence argues for the claimed effect of the supplement</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">SEPIO: “An evidence direction indicating that an evidence line provides an argument that supports the validity of a target assertion.”</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;systematicReview">
		<rdf:type rdf:resource="&oe-agtorch;StudyDesign"/>
		<rdfs:label xml:lang="en">systematic review</rdfs:label>
		<skos:definition xml:lang="en">study design that identifies, appraises, and synthesizes all empirical evidence meeting stated eligibility criteria to answer one research question</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">MeSH D000078182 Systematic Review: “A review of primary literature in health and health policy that attempts to identify, appraise, and synthesize all the empirical evidence that meets specified eligibility criteria to answer a given research question.”</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;usesCriterion">
		<rdfs:label xml:lang="en">uses criterion</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<skos:definition xml:lang="en">relationship linking a plan evaluation to a decision criterion applied in that evaluation</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;usesTool">
		<rdfs:label xml:lang="en">uses tool</rdfs:label>
		<dct:source xml:lang="en">OE_5_TeamAgenticCapabilities_ConceptualModel.pdf, Figure 4; OE_5_TeamAgenticCapabilities_CuratedTermList.xlsx, Prioritized List.</dct:source>
		<rdfs:range rdf:resource="&agento;Tool"/>
		<skos:definition xml:lang="en">links an agent or skill to a tool it uses</skos:definition>
		<skos:scopeNote xml:lang="en">Shared by Figures 3 and 4. No global domain is imposed, so skill use does not classify the skill as an LLMAgent. The Figure 4 agent-to-tool restriction is scoped to LLMAgent.</skos:scopeNote>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="&oe-agtorch;veryLow">
		<rdf:type rdf:resource="&oe-agtorch;EvidenceCertaintyLevel"/>
		<rdfs:label xml:lang="en">very low</rdfs:label>
		<skos:definition xml:lang="en">evidence certainty level at which the true effect is likely substantially different from the estimated effect</skos:definition>
		<cmns-av:adaptedFrom xml:lang="en">GRADE guidelines 3 (Balshem et al., 2011), definitions of the four levels</cmns-av:adaptedFrom>
	</owl:NamedIndividual>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;violatesConstraint">
		<rdfs:label xml:lang="en">violates constraint</rdfs:label>
		<rdfs:domain rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<skos:definition xml:lang="en">relation from a candidate orchestration plan to a hard constraint that the plan fails to satisfy, which disqualifies the plan</skos:definition>
		<skos:scopeNote xml:lang="en">A soft constraint is never violated in this sense: it is measured by a decision criterion and only lowers the plan&apos;s score and rank.</skos:scopeNote>
	</owl:ObjectProperty>
	
	<owl:AllDifferent>
		<owl:distinctMembers rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;caseReport">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;observationalStudy">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;randomizedControlledTrial">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;systematicReview">
			</rdf:Description>
		</owl:distinctMembers>
	</owl:AllDifferent>
	<owl:AllDifferent>
		<owl:distinctMembers rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;disputing">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;inconclusive">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;supporting">
			</rdf:Description>
		</owl:distinctMembers>
	</owl:AllDifferent>
	<owl:AllDifferent>
		<owl:distinctMembers rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;high">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;low">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;moderate">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;veryLow">
			</rdf:Description>
		</owl:distinctMembers>
	</owl:AllDifferent>
	<owl:AllDisjointClasses>
		<owl:members rdf:parseType="Collection">
			<rdf:Description rdf:about="http://w3id.org/beam/core#Instance">
			</rdf:Description>
			<rdf:Description rdf:about="http://w3id.org/beam/core#Model">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;ExecutableResource">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;Instruction">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;ReferenceMaterial">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;Template">
			</rdf:Description>
		</owl:members>
	</owl:AllDisjointClasses>
	<owl:AllDisjointClasses>
		<owl:members rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;ContentGeneration">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;DataProcessing">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;InformationAccess">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;SystemInteraction">
			</rdf:Description>
		</owl:members>
	</owl:AllDisjointClasses>
	<owl:AllDisjointClasses>
		<owl:members rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;EvidenceCoverage">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;Latency">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;TokenCost">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;ToolCallCount">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;ToolCost">
			</rdf:Description>
		</owl:members>
	</owl:AllDisjointClasses>
	<owl:Class>
		<rdfs:subClassOf rdf:resource="&oe-agtorch;RejectedOrchestrationPlan"/>
		<owl:intersectionOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;CandidateOrchestrationPlan">
			</rdf:Description>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;violatesConstraint"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;HardConstraint"/>
			</owl:Restriction>
		</owl:intersectionOf>
	</owl:Class>
</rdf:RDF>