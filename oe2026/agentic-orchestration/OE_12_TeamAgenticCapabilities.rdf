	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="&prov;Activity">
		<rdfs:label xml:lang="en">PROV-O activity</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term Activity</dct:source>
		<skos:definition xml:lang="en">something that occurs over a period of time and acts upon or with entities, and may include consuming, processing, transforming, modifying, relocating, using, or generating entities</skos:definition>
		<skos:editorialNote xml:lang="en">Assignment 12: added because the domain of prov:used and the range of prov:wasGeneratedBy restate PROV-O (OOPS! pitfall P04). The term has no row in the term list; the label, definition and source were taken from PROV-O, and Claude Opus 5.5 (Anthropic, in Claude Code) drafted the notes.</skos:editorialNote>
		<skos:example xml:lang="en">An invocation of the PubMed search articles tool, which is a P-Plan activity and therefore a PROV-O activity.</skos:example>
		<skos:scopeNote xml:lang="en">Labeled PROV-O activity to keep it apart from the P-Plan class activity (pplan:Activity), its subclass in P-Plan.</skos:scopeNote>
		<cmns-av:directSource xml:lang="en">PROV-O, class Activity, prov:definition: “An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities.”</cmns-av:directSource>
		<cmns-av:explanatoryNote xml:lang="en">Reused from PROV-O; P-Plan makes pplan:Activity a subclass of it, so every invocation is a PROV-O activity.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&prov;Entity">
		<rdfs:label xml:lang="en">entity</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term Entity</dct:source>
		<skos:definition xml:lang="en">physical, digital, conceptual, or other kind of thing with some fixed aspects, which may be real or imaginary</skos:definition>
		<skos:editorialNote xml:lang="en">Assignment 12: the term has no row in the term list; the label, definition and source were taken from the source ontology to resolve the OOPS! missing-annotation pitfall (P08), and Claude Opus 5.5 (Anthropic, in Claude Code) drafted the notes.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s search query, an information artifact and therefore a PROV-O entity.</skos:example>
		<cmns-av:directSource xml:lang="en">PROV-O, class Entity, prov:definition: “An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary.”</cmns-av:directSource>
		<cmns-av:explanatoryNote xml:lang="en">Reused from PROV-O; superclass of information artifact, drawn in Figure 7b, so artifacts can be used and generated by invocations.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&prov;Plan">
		<rdfs:subClassOf rdf:resource="&prov;Entity"/>
		<rdfs:label xml:lang="en">PROV-O plan</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term Plan</dct:source>
		<skos:definition xml:lang="en">entity that represents a set of actions or steps intended by one or more agents to achieve some goals</skos:definition>
		<skos:editorialNote xml:lang="en">Assignment 12: added because pplan:Plan rdfs:subClassOf prov:Plan and prov:Plan rdfs:subClassOf prov:Entity restate P-Plan and PROV-O (OOPS! pitfall P04). The term has no row in the term list; the label, definition and source were taken from P-Plan and PROV-O, and Claude Opus 5.5 (Anthropic, in Claude Code) drafted the notes.</skos:editorialNote>
		<skos:example xml:lang="en">Ken plan 1, a candidate orchestration plan, which is a P-Plan plan and therefore a PROV-O plan.</skos:example>
		<skos:scopeNote xml:lang="en">Labeled PROV-O plan to keep it apart from the P-Plan class plan (pplan:Plan), its subclass in P-Plan.</skos:scopeNote>
		<cmns-av:directSource xml:lang="en">PROV-O, class Plan, prov:definition: “A plan is an entity that represents a set of actions or steps intended by one or more agents to achieve some goals.”</cmns-av:directSource>
		<cmns-av:explanatoryNote xml:lang="en">Reused from PROV-O. The subclass axioms pplan:Plan rdfs:subClassOf prov:Plan (P-Plan) and prov:Plan rdfs:subClassOf prov:Entity (PROV-O) are restated unchanged in this file.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&prov;used">
		<rdfs:label xml:lang="en">used</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term used</dct:source>
		<rdfs:domain rdf:resource="&prov;Activity"/>
		<rdfs:range rdf:resource="&prov;Entity"/>
		<skos:definition xml:lang="en">links an invocation to an information artifact it used</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A29, Figure(s) 1, 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An invocation used a search-query artifact.</skos:example>
		<skos:note xml:lang="en">PROV-O relates activities to utilized entities.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range as used here: invocation → information artifact. The declared rdfs:domain and rdfs:range (PROV-O activity → entity) are restated unchanged from PROV-O, so the reused classes they name are connected in this file (OOPS! pitfall P04); this ontology adds no narrower domain or range.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term used.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology specializes the endpoints to invocation and information artifact.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an invocation to each information artifact it used as input.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasAssociatedWith">
		<rdfs:label xml:lang="en">was associated with</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasAssociatedWith</dct:source>
		<skos:definition xml:lang="en">links an invocation to an agent responsible for its execution</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A33, Figure(s) 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An invocation was associated with the LLM agent that carried it out.</skos:example>
		<skos:note xml:lang="en">PROV-O records agent responsibility for activities.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range as used here: invocation → LLM agent (PROV-O: activity → agent).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasAssociatedWith.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology specializes the endpoints to invocation and LLM agent.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an invocation to the LLM agent responsible for it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasDerivedFrom">
		<rdfs:label xml:lang="en">was derived from</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasDerivedFrom</dct:source>
		<skos:definition xml:lang="en">links an answer or other entity to an entity from which it was derived</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A34, Figure(s) 2, 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An answer was derived from an evidence artifact; a user constraint was derived from a preference setting.</skos:example>
		<skos:note xml:lang="en">PROV-O relates derived entities to their sources.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range as used here: answer → information artifact; user constraint → preference setting or request; candidate supplement or search query → request (PROV-O: entity → entity).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasDerivedFrom.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Preserves all three model endpoint pairs: Answer -&gt; InformationArtifact; UserConstraint -&gt; PreferenceSetting or Request.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a derived entity (answer, user constraint, candidate supplement, search query) to the entity it was derived from, so an explanation can trace it back to the user&apos;s request or settings.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&prov;wasGeneratedBy">
		<rdfs:label xml:lang="en">was generated by</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasGeneratedBy</dct:source>
		<rdfs:domain rdf:resource="&prov;Entity"/>
		<rdfs:range rdf:resource="&prov;Activity"/>
		<skos:definition xml:lang="en">links a generated information artifact to the activity that produced it</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A35, Figure(s) 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An evidence-assessment artifact was generated by an invocation.</skos:example>
		<skos:note xml:lang="en">PROV-O connects generated entities to generating activities.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range as used here: information artifact → invocation. The declared rdfs:domain and rdfs:range (PROV-O entity → activity) are restated unchanged from PROV-O, so the reused classes they name are connected in this file (OOPS! pitfall P04); this ontology adds no narrower domain or range.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O: The PROV Ontology, W3C Recommendation, 30 April 2013 (https://www.w3.org/TR/prov-o/), term wasGeneratedBy.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">In the ontology the direction is information artifact → invocation.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an information artifact to the invocation that produced it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<rdf:Description rdf:about="&agento;Capability">
		<owl:equivalentClass rdf:resource="&oe-agtorch;Capability"/>
	</rdf:Description>
	
	<owl:Class rdf:about="&agento;Goal">
		<rdfs:label xml:lang="en">goal</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">H. Xu et al., “The evolution of tool use in LLM agents: From single-tool call to multi-tool orchestration,” arXiv:2603.22862v30, Mar. 24, 2026. [Online]. Available: https://arxiv.org/abs/2603.22862v30 [Accessed: Sep. 23, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">Xu et al., The Evolution of Tool Use in LLM Agents: From Single-Tool Call to Multi-Tool Orchestration, which discusses goal drift in long-horizon tasks and maintaining alignment with a global objective.</dct:source>
		<skos:definition xml:lang="en">objective or desired state that an agent aims to achieve</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context. Earlier adapted-definition source (before the imported definition was adopted): “Toward an Ontology for EA Modeling and EA Model Quality,” which defines a goal as a statement about a state or condition to be brought about or sustained Assignment 12: declared with the annotations of its term-list row, which the ontology file did not carry (OOPS! pitfall P08).</skos:editorialNote>
		<skos:example xml:lang="en">Retrieve the relevant policy and produce a summary of its key requirements.</skos:example>
		<skos:note xml:lang="en">Also: “Toward an Ontology for EA Modeling and EA Model Quality,” which defines a goal as a statement about a state or condition to be brought about or sustained.</skos:note>
		<skos:scopeNote xml:lang="en">The goal is the intended outcome; the plan and workflow steps are means for achieving it.</skos:scopeNote>
		<cmns-av:directSource xml:lang="en">AgentO ontology v0.2 (Turtle), class Goal, rdfs:comment: “An objective or desired state that an agent aims to achieve.”</cmns-av:directSource>
	</owl:Class>
	
	<owl:Class rdf:about="&agento;LLMAgent">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;usesTool"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Tool"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">large language model agent</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, “AgentO: An ontology for modeling agentic AI systems,” in The Semantic Web: ESWC 2026 (Lecture Notes in Computer Science, vol. 16550). Cham, Switzerland: Springer, 2026, pp. 298–320, doi: 10.1007/978-3-032-25159-6_16. [Online]. Available: https://agentic-patterns.github.io/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term LLMAgent</dct:source>
		<skos:definition xml:lang="en">software agent that uses a large language model to guide its task-directed actions</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A27, Figure(s) 7 (ref 4). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">The agent that invokes the supplement-recommendation skill and external tools.</skos:example>
		<skos:note xml:lang="en">AgentO includes LLMAgent as an agent class.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the agent responsible for invocations, rather than the language model alone. Reuses the AgentO class IRI; this is not a new local agent class.</skos:scopeNote>
		<cmns-av:abbreviation xml:lang="en">LLM agent</cmns-av:abbreviation>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term LLMAgent.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">LLM expands to large language model.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Associate a recorded invocation with the agent responsible for it.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&agento;WorkflowStep">
		<rdfs:label xml:lang="en">workflow step</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, “AgentO: An ontology for modeling agentic AI systems,” in The Semantic Web: ESWC 2026 (Lecture Notes in Computer Science, vol. 16550). Cham, Switzerland: Springer, 2026, pp. 298–320, doi: 10.1007/978-3-032-25159-6_16. [Online]. Available: https://agentic-patterns.github.io/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term WorkflowStep</dct:source>
		<skos:definition xml:lang="en">planned phase or position within an orchestration workflow that is associated with a task</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A65, Figure(s) 1, 5 (ref 7). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">The evidence-retrieval step preceding recommendation generation.</skos:example>
		<skos:note xml:lang="en">AgentO represents WorkflowStep as a phase within a workflow.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the plan-level step, distinct from the invocation that realizes it. Reuses the AgentO class IRI and its named superclass p-plan:Step. AgentO is imported from its published ontology.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term WorkflowStep.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The model shows StartStep and EndStep as specializations.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a plan to its steps, each step to its task, and an invocation to the step it realizes.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&agento;performedBy">
		<rdfs:label xml:lang="en">performed by</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, “AgentO: An ontology for modeling agentic AI systems,” in The Semantic Web: ESWC 2026 (Lecture Notes in Computer Science, vol. 16550). Cham, Switzerland: Springer, 2026, pp. 298–320, doi: 10.1007/978-3-032-25159-6_16. [Online]. Available: https://agentic-patterns.github.io/</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO.</dct:source>
		<skos:definition xml:lang="en">indicates the tool/agent that performs the task in a step</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A24, Figure(s) 5. The definition quotes the AgentO comment word for word, so its source moved to Definition Source in Assignment 11.</skos:editorialNote>
		<skos:example xml:lang="en">The evidence-retrieval task is performed by a retrieval skill.</skos:example>
		<skos:note xml:lang="en">Adapted from AgentO task-performance terminology.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range (AgentO): task → tool; tasks carried out by a skill use performed by skill (task → skill).</skos:scopeNote>
		<cmns-av:directSource xml:lang="en">AgentO ontology v0.2 (Turtle), property performedBy, rdfs:comment: “Indicates the tool/agent that performs the task in a step.”</cmns-av:directSource>
		<cmns-av:explanatoryNote xml:lang="en">The ontology widens the target to skills with the local relation performed by skill, not a claim of exact property equivalence.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use for tasks performed by a tool, as in AgentO; use performed by skill for tasks carried out by a skill.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:Class rdf:about="&oe-agtorch;Answer">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;wasDerivedFrom"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">answer</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">R. V. Guha, D. Brickley, and S. Macbeth, “Schema.org: Evolution of structured data on the Web,” Communications of the ACM, vol. 59, no. 2, pp. 44–51, 2016, doi: 10.1145/2844544.</dct:bibliographicCitation>
		<dct:source xml:lang="en">R. V. Guha, D. Brickley, and S. Macbeth, “Schema.org: Evolution of structured data on the Web,” Communications of the ACM, vol. 59, no. 2, pp. 44–51, 2016, doi: 10.1145/2844544.</dct:source>
		<skos:definition xml:lang="en">information artifact that communicates a response to a user’s query and represents the result of completing a task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">Recommendation for Jessica: the answer returned to Jessica with the recommended supplements and products.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">R. V. Guha, D. Brickley, and S. Macbeth, “Schema.org: Evolution of structured data on the Web,” Communications of the ACM, vol. 59, no. 2, pp. 44–51, 2016, doi: 10.1145/2844544.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ArticleAbstract">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">article abstract</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;abstract,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/abstract [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">U.S. National Library of Medicine, “PubMed User Guide,” Appendices: PubMed format field tags AB (Abstract) and DP (Date of Publication). [Online]. Available: https://pubmed.ncbi.nlm.nih.gov/help/ [Accessed: Oct. 7, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">U.S. National Library of Medicine, PubMed User Guide, field tag AB (Abstract)</dct:source>
		<skos:definition xml:lang="en">information artifact that summarizes one research article and is returned by a literature search tool</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): Claude Opus 5.5 (Anthropic, in Claude Code): given the term, the cited source text and the use case, drafted a genus-plus-differentia definition; each quoted source definition was checked against the source file.</skos:editorialNote>
		<skos:example xml:lang="en">An abstract downloaded by the PubMed abstract download tool (download_articles_batch) for one of the articles found for Ken&apos;s candidate supplements.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the PubMed User Guide, field tag AB (Abstract), and the Cambridge Dictionary sense of “abstract”: “a short form of a speech, article, book, etc., giving only the most important facts or ideas”.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Assessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">assessment</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;assessment,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/assessment [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Information Artifact Ontology, “Information Artifact Ontology (IAO),” information content entity (IAO_0000030). [Online]. Available: http://purl.obolibrary.org/obo/iao.owl</dct:bibliographicCitation>
		<dct:source xml:lang="en">Information Artifact Ontology (IAO), information content entity (IAO_0000030); Cambridge Dictionary, assessment</dct:source>
		<skos:definition xml:lang="en">information artifact that records a judgment about one candidate supplement</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): Claude Opus 5.5 (Anthropic, in Claude Code): given the term, the cited source text and the use case, drafted a genus-plus-differentia definition; each quoted source definition was checked against the source file.</skos:editorialNote>
		<skos:example xml:lang="en">Safety assessment (Jessica): the assessment of Jessica&apos;s candidate supplements against celecoxib.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Cambridge Dictionary sense of “assessment”: “the act of judging or deciding the amount, value, quality, or importance of something, or the judgment or decision that is made”, with IAO information content entity (IAO_0000030) as the genus through information artifact.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Groups the two assessments so both carry assessesSupplement.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;CandidateOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:label xml:lang="en">candidate orchestration plan</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, “Industrial Ontologies Foundry (IOF) ontologies: 2025-02 release,” 2025. [Online]. Available: https://spec.industrialontologies.org/portal/release/202502/. [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adapted from IOF plan specification</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;RejectedOrchestrationPlan">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;SelectedOrchestrationPlan">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">orchestration plan proposed as a possible solution to a user request, subject to evaluation and selection</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the related source concept and source were provided to the language model, which was prompted to generate an ISO 704-compliant specialized definition; the generated definition was subsequently manually revised for the agent-orchestration context.</skos:editorialNote>
		<skos:example xml:lang="en">Candidate A uses PubMed and OpenFDA sequentially; Candidate B retrieves evidence and safety information in parallel.</skos:example>
		<skos:note xml:lang="en">The IOF source provides the underlying plan specification pattern but does not define the term “Candidate Orchestration Plan.” The candidate distinction is therefore a project-specific specialization of the planning concept.</skos:note>
		<skos:scopeNote xml:lang="en">A candidate orchestration plan is a proposed plan prior to selection; candidate status does not imply that the plan will be executed. After evaluation every candidate orchestration plan is either selected or rejected.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core: plan specification</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Multiple candidate orchestration plans may prescribe different capabilities, tools, ordering, or parallelization strategies for satisfying the same information requirement.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use only while a plan is being evaluated or compared during orchestration planning. Once selected, represent it as an Orchestration Plan according to the ontology&apos;s lifecycle modeling decision.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;CandidateSupplement">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">candidate supplement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;supplement,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/supplement [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">National Institutes of Health, Office of Dietary Supplements, &quot;Dietary Supplements: What You Need to Know,&quot; Fact Sheet for Consumers. [Online]. Available: https://ods.od.nih.gov/factsheets/WYNTK-Consumer/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NIH Office of Dietary Supplements, &quot;Dietary Supplements: What You Need to Know&quot; (dietary supplement)</dct:source>
		<skos:definition xml:lang="en">information artifact describing a supplement being considered for a recommendation</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A4, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A candidate description for calcium supplementation awaiting evidence and safety assessment.</skos:example>
		<skos:note xml:lang="en">NIH ODS states that &quot;Dietary supplements are products intended to supplement the diet&quot; and that &quot;They are not medicines&quot;; a candidate supplement is the information artifact describing one such product while it is being considered for a recommendation.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a candidate supplement description, not the physical supplement or a final recommendation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from NIH ODS, &quot;Dietary Supplements: What You Need to Know&quot; (what a dietary supplement is), specialized to a supplement that is under consideration for a recommendation.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping identifies this artifact in CQ 2, 3, 7, and 8.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Pass the candidate description to evidence, safety, and product-retrieval tasks.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Capability">
		<rdfs:label xml:lang="en">capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan, “AgentO: An ontology for modeling agentic AI systems,” Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://zenodo.org/records/18342625 [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO</dct:source>
		<skos:altLabel xml:lang="en">Agent Capability</skos:altLabel>
		<skos:definition xml:lang="en">ability of an agent to perform a type of action or task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — term and source were provided to the language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised.</skos:editorialNote>
		<skos:example xml:lang="en">An agent&apos;s capability to retrieve scientific evidence from PubMed.</skos:example>
		<skos:note xml:lang="en">AgentO models Capability as an ability that can be performed by an agent and uses capabilities as part of the semantic representation of agentic AI systems</skos:note>
		<skos:scopeNote xml:lang="en">Refers to what an agent is able to perform, independently of a particular execution instance</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">AgentO</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">AgentO characterizes a capability as an ability that can be performed by an agent. The definition is specialized here to distinguish the capability from the agent, task, or execution that realizes it.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Ability</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Use to represent an ability that can be matched against requirements during agent or tool selection.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ConstraintSatisfyingCapability">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">constraint-satisfying capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO v0.2, class Capability; Schiendorfer et al., MiniBrass (hard constraints)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Capability">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;satisfiesConstraint"/>
						<owl:someValuesFrom rdf:resource="&oe-agtorch;HardConstraint"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">capability that satisfies at least one hard constraint</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 8: defined class whose members the reasoner infers (conceptual model Figure 3c).</skos:editorialNote>
		<skos:example xml:lang="en">The interaction screening capability is inferred to be a constraint-satisfying capability because it satisfies the hard constraint safety screening against celecoxib (Jessica).</skos:example>
		<skos:scopeNote xml:lang="en">Defined class. Competency questions 3 and 5 use it to find capabilities that a plan needs because of a hard constraint, such as safety screening.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO v0.2 class Capability (“ability that can be performed by agent”) as the genus; the differentia uses hard constraints as in MiniBrass and the Cambridge Dictionary sense of “satisfy”: “to have or provide something that is needed or wanted”.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ConstraintSatisfyingSkill">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:label xml:lang="en">constraint-satisfying skill</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 1.0.0, section 4.4.5 (AgentSkill). [Online]. Available: https://a2a-protocol.org/latest/specification/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">A2A Protocol, AgentSkill; Schiendorfer et al., MiniBrass (hard constraints)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Skill">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;hasCapability"/>
						<owl:someValuesFrom rdf:resource="&oe-agtorch;ConstraintSatisfyingCapability"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">skill that has at least one constraint-satisfying capability</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 8: defined class whose members the reasoner infers (conceptual model Figure 3c).</skos:editorialNote>
		<skos:example xml:lang="en">The supplement safety screening skill is inferred to be a constraint-satisfying skill because it has the interaction screening capability.</skos:example>
		<skos:scopeNote xml:lang="en">Defined class. Competency question 3 uses it to find the skills whose capabilities satisfy a hard constraint of the request; a plan for that request needs at least one such skill for each hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the A2A Protocol AgentSkill (“Represents a distinct capability or function that an agent can perform.”) as the genus, with the differentia of constraint-satisfying capability (hard constraints as in MiniBrass).</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ContentGeneration">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">content generation</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:source>
		<skos:definition xml:lang="en">capability that produces an information artifact by creating or composing content from intermediate information artifacts</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">summarizing a document</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;DataProcessing">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">data processing</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:source>
		<skos:definition xml:lang="en">capability that operates on data to produce an information artifact</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">aggregating records</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</cmns-av:adaptedFrom>
		<cmns-av:synonym xml:lang="en">Content Transformation</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">performed via transforming, analyzing, filtering, or aggregating the data</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;DecisionCriterion">
		<rdfs:label xml:lang="en">decision criterion</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">H. Xu et al., “The evolution of tool use in LLM agents: From single-tool call to multi-tool orchestration,” arXiv:2603.22862v30, Mar. 24, 2026. [Online]. Available: https://arxiv.org/abs/2603.22862v30 [Accessed: Sep. 23, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook. [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Xu et al., The Evolution of Tool Use in LLM Agents: From Single-Tool Call to Multi-Tool Orchestration, pp. 3–5.</dct:source>
		<skos:altLabel xml:lang="en">Selection Criterion</skos:altLabel>
		<skos:definition xml:lang="en">criterion used to compare and select candidate orchestration plans based on measurable attributes and preferences</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">Select the available tool that meets the capability requirement while staying within the specified cost limit.</skos:example>
		<skos:scopeNote xml:lang="en">In agent orchestration, a decision criterion can guide an agent’s selection among candidate agents, tools, tasks, or workflow paths. Examples might include capability fit, cost, latency, or safety, depending on the decision.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">NASA, “Decision Analysis” — describes decision criteria as requirements for assessing options and alternatives, and says they should distinguish among alternatives.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceAssessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Assessment"/>
		<rdfs:label xml:lang="en">evidence assessment</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;assessment,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/assessment [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">G. H. Guyatt, A. D. Oxman, G. E. Vist, R. Kunz, Y. Falck-Ytter, P. Alonso-Coello, and H. J. Schünemann, &quot;GRADE: an emerging consensus on rating quality of evidence and strength of recommendations,&quot; BMJ, vol. 336, no. 7650, pp. 924–926, 2008, doi: 10.1136/bmj.39489.470347.AD.</dct:bibliographicCitation>
		<dct:source xml:lang="en">GRADE Working Group (Guyatt et al., BMJ 2008): rating the quality of a body of evidence</dct:source>
		<skos:definition xml:lang="en">assessment that summarizes and weighs the research findings about one candidate supplement</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A11, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A report linking retrieved studies to the claims made about a candidate supplement.</skos:example>
		<skos:note xml:lang="en">Guyatt et al. explain that &quot;the GRADE system classifies the quality of evidence in one of four levels—high, moderate, low, and very low&quot;; an evidence assessment here records such a weighing of the research findings for one candidate supplement.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the assessment result, not the assessment task or the evidence source itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Guyatt et al. (2008), GRADE, which rates the quality of a body of evidence; specialized to the evidence about one candidate supplement.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping identifies this artifact in CQ 3 and 7.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use as input to recommendation generation and evidence-coverage evaluation.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;EvidenceCoverage">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">evidence coverage</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;coverage,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/coverage [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Z. Xiang, C. Wu, Q. Zhang, S. Chen, Z. Hong, X. Huang, and J. Su, &quot;When to use Graphs in RAG: A Comprehensive Analysis for Graph Retrieval-Augmented Generation,&quot; arXiv:2506.05690v3, Feb. 2026, Section 3.3 (Evaluation Metrics). [Online]. Available: https://arxiv.org/abs/2506.05690</dct:bibliographicCitation>
		<dct:source xml:lang="en">Xiang et al. (2026), GraphRAG-Bench, Section 3.3, generation metric &quot;Evidence Coverage&quot;</dct:source>
		<skos:definition xml:lang="en">plan metric expressing how fully an orchestration plan covers the evidence needed to address a request</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A12, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An evaluation that records coverage of the evidence questions associated with a request.</skos:example>
		<skos:note xml:lang="en">Xiang et al. define Evidence Coverage as a metric that &quot;Measures whether the answer adequately covers all knowledge relevant to the question&quot;; the plan metric here applies the same idea to the evidence an orchestration plan gathers for a request.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to a plan evaluation. The supplied model does not prescribe a scoring formula or numeric scale.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Xiang et al. (2026), Section 3.3, metric &quot;Evidence Coverage&quot;; applied to an orchestration plan instead of a generated answer.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The model associates this metric with scenario 3 plan scores.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Compare candidates under an evidence-coverage criterion using an explicitly defined scale.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutableResource">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">executable resource</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., &quot;SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,&quot; arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">SkillsBench (arXiv:2602.12670), section 2 Background (Skill Definition) and Table 1</dct:source>
		<skos:altLabel xml:lang="en">Executable Skill Resource</skos:altLabel>
		<skos:definition xml:lang="en">skill resource that an agent can run to perform computational operations, rather than only read as guidance or information</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">A Python script in the Safety Screening skill that batches OpenFDA queries for the candidate supplements.</skos:example>
		<skos:note xml:lang="en">&quot;Each Skill contains a required SKILL.md file with natural-language instructions and may optionally include auxiliary resources such as scripts, templates, reference files, or worked examples.&quot; (SkillsBench (arXiv:2602.12670), section 2); &quot;Skills combine modular packaging, procedural guidance, executable resources, and portability.&quot; (Table 1 caption).</skos:note>
		<skos:scopeNote xml:lang="en">Covers scripts and other runnable code shipped in a skill folder (scripts/). Instructions, reference files and templates are non-executable skill resources (rows 51, 52, 54).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">SkillsBench (arXiv:2602.12670), section 2 Background: Skill Definition and Table 1</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">SkillsBench contrasts Skills with prompts and RAG by noting that Skills, like tools, can include executable resources, and states that a Skill becomes actionable only through a harness that injects its instructions and exposes its resources.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use as the parent of Script (row 53). An executable resource is run by the harness on the agent&apos;s behalf; represent each run as a Skill Invocation or Tool Invocation, not as the resource itself.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutionConstraint">
		<rdfs:subClassOf rdf:resource="&agento;Constraint"/>
		<rdfs:label xml:lang="en">execution constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">H. Xu et al., “The evolution of tool use in LLM agents: From single-tool call to multi-tool orchestration,” arXiv:2603.22862v30, Mar. 24, 2026. [Online]. Available: https://arxiv.org/abs/2603.22862v30 [Accessed: Sep. 23, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:source xml:lang="en">Xu et al., section 8.1</dct:source>
		<owl:disjointWith rdf:resource="&oe-agtorch;UserConstraint"/>
		<skos:definition xml:lang="en">constraint on the ordering, resource use, timing, or other operational conditions of tool or skill execution</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term, source references, and use case were provided to the language model, which was prompted to generate an ISO 704-compliant definition focused on conditions affecting tool and skill execution.</skos:editorialNote>
		<skos:example xml:lang="en">Evidence Verification must wait until a CandidateSupplement record is available.</skos:example>
		<skos:note xml:lang="en">Xu et al. discuss execution constraints such as dependencies between calls and limits on available resources.</skos:note>
		<skos:scopeNote xml:lang="en">Covers conditions that affect how the workflow runs.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Xu et al., sections 8.1 and 8.2</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">These may involve step order, available resources, time limits, or execution budgets. They can come from the user or the system.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Check these conditions when deciding the execution order and which steps can run in parallel.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExecutionTrace">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">execution trace</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, &quot;AgentO: An ontology for modeling agentic AI systems,&quot; in The Semantic Web: 23rd European Semantic Web Conference, ESWC 2026, Dubrovnik, Croatia, May 10-14, 2026, Proceedings, Part II (Lecture Notes in Computer Science, vol. 16550), M. Acosta, M. van Erp, S. Rudolph, O. Hartig, B. Spahiu, A. Rula, D. Garijo, and F. Osborne, Eds. Cham, Switzerland: Springer, 2026, pp. 298-320, doi: 10.1007/978-3-032-25159-6_16. Page numbers refer to the 22-page author preprint linked from the ESWC 2026 accepted-papers page (https://drive.google.com/file/d/1WrMSiXR-COZHrAKCEN6nE1M5QUB98gim/view).</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">OpenTelemetry Authors, &quot;Signals,&quot; OpenTelemetry documentation, section &quot;Traces.&quot; [Online]. Available: https://opentelemetry.io/docs/concepts/signals/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Ekelhart et al., AgentO: An Ontology for Modeling Agentic AI Systems. The paper identifies workflow auditing from execution traces as a use case.</dct:source>
		<skos:altLabel xml:lang="en">decision flow</skos:altLabel>
		<skos:altLabel xml:lang="en">runtime behavior</skos:altLabel>
		<skos:definition xml:lang="en">chronological record of a workflow&apos;s actual execution, capturing the steps performed and their outcomes</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">Agent receives a request → invokes a search tool → receives results → produces a response; the trace records those events and outcomes.</skos:example>
		<skos:scopeNote xml:lang="en">An information artifact recording what occurred during execution, such as workflow steps and outcomes; it is not a workflow plan, which describes intended steps. The records property identifies the recorded invocations; explicit timestamps and ordering are outside Figures 4 and 7.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">OpenTelemetry, “Signals,” which describes a trace as the path of a request through an application</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ExternalTool">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Tool"/>
		<rdfs:label xml:lang="en">external tool</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">H. Wang, C. Qian, M. Li, J. Qiu, B. Xue, M. Wang, H. Ji, A. Storkey, and K.-F. Wong, &quot;Position: Agent Should Invoke External Tools ONLY When Epistemically Necessary,&quot; arXiv:2506.00886v4 (revised version of &quot;Toward a Theory of Agents as Tool-Use Decision-Makers&quot;). [Online]. Available: https://arxiv.org/abs/2506.00886</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<skos:definition xml:lang="en">tool that is exposed by a server or service outside the agent harness and is invoked through a communication protocol or a command-line interface</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">search_articles on the PubMed MCP server; search on iHerb-CLI.</skos:example>
		<skos:note xml:lang="en">&quot;Tools enable models to interact with external systems, such as querying databases, calling APIs, or performing computations.&quot; (Model Context Protocol Specification, rev. 2026-07-28, Server Features &gt; Tools). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Every external tool is a Tool (row 7); a tool bundled inside the harness is not external. Distinguished from a Skill, which is an agent behavior executed inside the harness.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Server Features &gt; Tools (introduction and Data Types &gt; Tool)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP describes tools as server-exposed operations through which a model interacts with external systems such as databases and APIs. In the supplement-recommendation scenario the external tools are the operations of the PubMed, Supplement Advisor and OpenFDA MCP servers and of the iHerb command-line client.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use for a tool whose invocation leaves the harness (network or CLI call). Count External Tool invocations for the &quot;External Tool Calls&quot; decision criterion (Usage Scenario 3, CQ 4).</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;HardConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;UserConstraint"/>
		<rdfs:label xml:lang="en">hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:source xml:lang="en">MiniBrass: Soft Constraints for MiniZinc.</dct:source>
		<owl:disjointWith rdf:resource="&oe-agtorch;SoftConstraint"/>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isHardConstraint"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">user constraint that an acceptable orchestration plan must satisfy</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A18, Figure(s) 2 (ref 3). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A request requires the plan to include a safety-screening step.</skos:example>
		<skos:note xml:lang="en">Constraint programming treats mandatory constraints as feasibility conditions.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to mandatory conditions derived from a user&apos;s request or preference settings.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from MiniBrass: Soft Constraints for MiniZinc.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Specialized from user constraint. Hard constraint is also equivalent to (is hard constraint Self); the marker is hard constraint ends the property chains that should reach only hard constraints.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to exclude a candidate that fails a mandatory condition.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationAccess">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">information access</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:source>
		<skos:definition xml:lang="en">capability that obtains information artifacts from an information source</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">retrieving records via API call</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</cmns-av:adaptedFrom>
		<cmns-av:synonym xml:lang="en">Knowledge Retrieval</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">performed via retrieval, querying, or other aquisition operations</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationArtifact">
		<rdfs:subClassOf rdf:resource="&prov;Entity"/>
		<rdfs:label xml:lang="en">information artifact</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;artefact,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/artefact [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;artifact,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/artifact [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Information Artifact Ontology, “Information Artifact Ontology (IAO),” OBO Foundry, 2020, class information content entity (IAO_0000030). [Online]. Available: http://purl.obolibrary.org/obo/iao.owl [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">IAO</dct:source>
		<skos:altLabel xml:lang="en">Information Artefact</skos:altLabel>
		<skos:definition xml:lang="en">information content entity represented as an identifiable item that can be consumed, produced, or retained during an agent workflow</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term, IAO source, and use case were provided to the language model, which was prompted to generate an ISO 704-compliant definition focused on information used, produced, or stored in an agent workflow.</skos:editorialNote>
		<skos:example xml:lang="en">A CandidateSupplement record used by Evidence Verification, or the EvidenceAssessment that the skill produces.</skos:example>
		<skos:note xml:lang="en">IAO describes information content entities as being about something. Our definition focuses on the information items used in an agent workflow.</skos:note>
		<skos:scopeNote xml:lang="en">Includes supplied inputs, intermediate results, generated outputs such as final answers, and records kept about the workflow. Figure 7 generation is expressed on Invocation using inverse prov:wasGeneratedBy, so an input artifact is not required to have been generated by an invocation in this workflow.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">IAO, information content entity (IAO_0000030)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The artifact contains information about something. For example, a supplement record is an information artifact; the physical supplement is not.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Record which artifacts each invocation uses and produces. These connections help explain dependencies between steps.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InformationRequirement">
		<rdfs:label xml:lang="en">information requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">F. Richter, F. Matteucci, P. Reimann, and K. Böhm, “Survey on information requirements on the Google Books Ngram Corpus,” International Journal of Digital Humanities, vol. 7, no. 3, pp. 393–416, 2025, doi: 10.1007/s42803-025-00113-9.</dct:bibliographicCitation>
		<dct:source xml:lang="en">Richter et al. (2025)</dct:source>
		<skos:altLabel xml:lang="en">Information Need</skos:altLabel>
		<skos:definition xml:lang="en">formalized description of information that a user needs to obtain</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — term and source were provided to the language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised</skos:editorialNote>
		<skos:example xml:lang="en">Determine whether calcium supplementation is appropriate for this user.</skos:example>
		<skos:note xml:lang="en">Richter et al. use information requirements to describe the information users seek from a query system and explicitly treat the term as closely related to information need</skos:note>
		<skos:scopeNote xml:lang="en">Represents the information sought by the user, rather than the query, task, process, or mechanism used to obtain it.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Richter et al. (2025)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Richter et al. define an information requirement as a formalized need: a rigorous and precise description of a user&apos;s conscious information need.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Formalized Information Need</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Use to represent the informational objective extracted from a user&apos;s request and used to identify appropriate capabilities and orchestration steps</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Input">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">input</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 0.3.0, AgentSkill. [Online]. Available: https://a2a-protocol.org/v0.3.0/specification/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/ [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adapted from MCP input schema and A2A input modes</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;InformationArtifact">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-agtorch;consumes"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom rdf:resource="&agento;Task"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">information artifact that some task consumes</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — related source concepts and sources were provided to a language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">A medication list provided to a drug-interaction tool invocation.</skos:example>
		<skos:note xml:lang="en">MCP distinguishes a tool&apos;s input schema from the actual arguments supplied when the tool is called.</skos:note>
		<skos:scopeNote xml:lang="en">Represents information consumed by a Tool Invocation or Skill Invocation. It does not represent the schema that specifies which inputs are permitted.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Tools Specification / A2A AgentSkill</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP tools declare an inputSchema specifying expected parameters, and tool calls provide arguments conforming to that schema. A2A skills can similarly declare supported input modes.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Distinguish an actual Input from an Input Specification/Input Schema. The former exists at execution time; the latter describes what inputs are expected.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;InputConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Precondition"/>
		<rdfs:label xml:lang="en">input constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Wright, H. Andrews, and B. Hutton, Eds., “JSON Schema Validation: A vocabulary for structural validation of JSON,” Internet-Draft draft-bhutton-json-schema-validation-01 (JSON Schema draft 2020-12), Jun. 16, 2022, section 6. [Online]. Available: https://json-schema.org/draft/2020-12/json-schema-validation [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">JSON Schema, “Object,” Understanding JSON Schema, sections “Properties” and “Required Properties.” [Online]. Available: https://json-schema.org/understanding-json-schema/reference/object</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<skos:altLabel xml:lang="en">Input Validation Rule</skos:altLabel>
		<skos:definition xml:lang="en">condition on the value of an input that an invocation must satisfy to be accepted by the tool or skill</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">max_results of PubMed search_articles must be an integer between 1 and 100; the medication name passed to OpenFDA must be a non-empty string.</skos:example>
		<skos:note xml:lang="en">&quot;Validation keywords in a schema impose requirements for successful validation of an instance.&quot; (JSON Schema Validation, draft 2020-12, section 6); &quot;Input validation errors (e.g., date in wrong format, value out of range)&quot; are tool execution errors (Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Error Handling). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Specializes precondition for conditions on the values that a tool or skill accepts for one of its parameters (Figure 4, constrains), and constrains a single input value at invocation time. Distinguished from Constraint (row 15) and its subclasses User Constraint and Execution Constraint, which govern plan selection rather than tool arguments.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool (inputSchema follows the JSON Schema usage guidelines); JSON Schema Validation, draft 2020-12, section 6 (validation keywords such as type, enum, minimum, maximum, pattern, required)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">In MCP the constraints are the JSON Schema validation keywords inside the tool&apos;s inputSchema; a call whose arguments violate them (a value out of range, a date in the wrong format) is reported as a tool execution error (result with isError: true) that the model can use to correct the arguments and retry.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to check candidate plans before execution: an invocation whose planned input violates an input constraint is not executable (CQ 8).</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Instruction">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">instruction</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:source>
		<skos:altLabel xml:lang="en">Instructions</skos:altLabel>
		<skos:definition xml:lang="en">skill resource that specifies the procedures, rules, or guidance an agent follows when applying a skill to perform a task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">The step-by-step instructions in a skill&apos;s SKILL.md file, such as how the evidence verification skill should search PubMed and judge the studies it finds.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">typically in the form of a SKILL.MD file. provides when and how to perform the skill</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;IntermediateArtifact">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Output"/>
		<rdfs:label xml:lang="en">intermediate artifact</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">J. Rosen and S. Rosen, &quot;Intermediate Artifacts as First-Class Citizens: A Data Model for Durable Intermediate Artifacts in Agentic Systems,&quot; arXiv:2605.12087, May 2026. [Online]. Available: https://arxiv.org/abs/2605.12087</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang et al., “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload” (NORA 2026)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Output">
					</rdf:Description>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel xml:lang="en">Intermediate Work Product</skos:altLabel>
		<skos:definition xml:lang="en">information artifact that one task produces and another task consumes</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">A tool returns a structured list of candidate services; the agent passes that list to a later step to select a service.</skos:example>
		<skos:scopeNote xml:lang="en">Refers to a work product passed to or used by a subsequent workflow step, not the final deliverable.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Rosen and Rosen, Intermediate Artifacts as First-Class Citizens: A Data Model for Durable Intermediate Artifacts in Agentic Systems.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Invocation">
		<rdfs:subClassOf rdf:resource="&pplan;Activity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&pplan;correspondsToStep"/>
				<owl:someValuesFrom rdf:resource="&agento;WorkflowStep"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;used"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;wasAssociatedWith"/>
				<owl:someValuesFrom rdf:resource="&agento;LLMAgent"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty>
					<rdf:Description>
						<owl:inverseOf rdf:resource="&prov;wasGeneratedBy"/>
					</rdf:Description>
				</owl:onProperty>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationArtifact"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">invocation</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, “The P-Plan ontology,” version 1.3, Mar. 12, 2014, class Activity and property correspondsToStep. [Online]. Available: https://www.opmw.org/model/p-plan/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">PROV-O.</dct:source>
		<skos:definition xml:lang="en">execution activity in which a particular tool or skill is called or applied</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A26, Figure(s) 1, 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">One execution of the evidence-retrieval skill for a particular request.</skos:example>
		<skos:note xml:lang="en">PROV-O Activity supplies the execution concept; P-Plan relates executions to planned steps.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a runtime occurrence, distinct from the reusable tool or skill specification and from the planned workflow step. The required correspondsToStep value, combined with the functional P-Plan property, gives exactly one planned step. Existential restrictions do not require an explicitly asserted named value under OWL open-world semantics.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The model uses Invocation as the common parent of SkillInvocation and ToolInvocation.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Record the associated agent, used artifacts, generated artifacts, and corresponding workflow step.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;JustifiedCapability">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">justified capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;justified,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/justified [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan (Markovic et al., 2019), class Rationale; AgentO v0.2, class Capability</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;ConstraintSatisfyingCapability">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;RequirementSatisfyingCapability">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">capability that satisfies an information requirement or a hard constraint</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 8: defined class whose members the reasoner infers (conceptual model Figure 3c).</skos:editorialNote>
		<skos:example xml:lang="en">The evidence verification capability is a justified capability: it satisfies Jessica&apos;s information requirement for supporting scientific evidence and her hard constraint for evidence verification. The dosage calculation capability satisfies neither, so it is not classified as justified.</skos:example>
		<skos:scopeNote xml:lang="en">Defined as the union of requirement-satisfying capability and constraint-satisfying capability. A capability required by a plan that is not a justified capability has no reason in the request to be there (competency question 5).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan class Rationale: “A generic concept describing a specific justification of a plan or an individual plan element.”; a capability is justified when it satisfies an information requirement or a hard constraint. Cambridge Dictionary, “justified”: “having a good reason for something”.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Latency">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">latency</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Google Cloud, &quot;Generative AI glossary,&quot; entry &quot;latency.&quot; [Online]. Available: https://docs.cloud.google.com/docs/generative-ai/glossary [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">Li et al., SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks (2026), Appendix L.4, which measures mean agent wall-clock time per task as the agent-execution span of each trial.</dct:source>
		<skos:altLabel xml:lang="en">Agent Execution Time</skos:altLabel>
		<skos:definition xml:lang="en">plan metric expressing elapsed time from an agent’s receipt of a task or request to completion of its response or execution</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">An agent takes 45 seconds from receiving a task to completing its response; the task latency is 45 seconds.</skos:example>
		<skos:scopeNote xml:lang="en">Here, latency refers to elapsed agent-execution time for a task. It is distinct from time to first token, which measures how soon a streamed response begins.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Google Cloud, “Generative AI glossary,” entry “latency.”</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ModelContextProtocolServer">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Server"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;exposes"/>
				<owl:onClass rdf:resource="&oe-agtorch;ModelContextProtocolTool"/>
				<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">model context protocol server</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Architecture (Core Components: Servers). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/architecture [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">MCP Architecture specification, Servers</dct:source>
		<skos:altLabel xml:lang="en">MCP Server</skos:altLabel>
		<skos:definition xml:lang="en">server that implements the Model Context Protocol to expose supported tools, resources, or prompts to MCP clients</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term and MCP Architecture specification were provided to the language model, which was prompted to generate an ISO 704-compliant definition that distinguishes the server from the tools it provides.</skos:editorialNote>
		<skos:example xml:lang="en">The PubMed MCP server, which exposes the search_articles and download_articles_batch tools; the OpenFDA MCP server, which exposes adverse event, drug label and recall search tools.</skos:example>
		<skos:note xml:lang="en">MCP distinguishes servers from hosts and clients. Servers provide supported tools, resources, or prompts and can run locally or remotely.</skos:note>
		<skos:scopeNote xml:lang="en">Includes MCP servers running locally or remotely.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Architecture specification, Core Components: Servers</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">One server can provide several tools. The server and the tools it provides should be represented separately.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Record which server provides each MCP Tool. Treat iHerb-CLI separately unless it is made available through an MCP wrapper.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ModelContextProtocolTool">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExternalTool"/>
		<rdfs:label xml:lang="en">model context protocol tool</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">MCP Tools specification</dct:source>
		<skos:altLabel xml:lang="en">MCP Tool</skos:altLabel>
		<skos:definition xml:lang="en">tool exposed by an MCP server for discovery and invocation by an MCP client through the Model Context Protocol</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term and MCP Tools specification were provided to the language model, which was prompted to generate an ISO 704-compliant definition that distinguishes MCP tools from other tools in the use case.</skos:editorialNote>
		<skos:example xml:lang="en">The PubMed article search tool (search_articles), exposed by the PubMed MCP server, which searches PubMed for articles matching a query.</skos:example>
		<skos:note xml:lang="en">MCP describes tools as operations provided by servers and defines how clients list and call them.</skos:note>
		<skos:scopeNote xml:lang="en">Includes operations exposed through MCP. A standalone CLI operation is not an MCP Tool.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Tools specification, introduction and sections on listing and calling tools</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The tool describes an available operation. A Tool Invocation records a particular use of that operation.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Connect each MCP Tool to the server that provides it and the capability it supports.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OptionalInput">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:label xml:lang="en">optional input</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Wright, H. Andrews, and B. Hutton, Eds., “JSON Schema Validation: A vocabulary for structural validation of JSON,” Internet-Draft draft-bhutton-json-schema-validation-01 (JSON Schema draft 2020-12), Jun. 16, 2022, section 6. [Online]. Available: https://json-schema.org/draft/2020-12/json-schema-validation [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">JSON Schema, “Object,” Understanding JSON Schema, sections “Properties” and “Required Properties.” [Online]. Available: https://json-schema.org/understanding-json-schema/reference/object</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">OpenAPI Initiative, “OpenAPI Specification v3.1.0,” Feb. 15, 2021, section Parameter Object. [Online]. Available: https://spec.openapis.org/oas/v3.1.0 [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;fills"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-agtorch;Parameter">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-agtorch;isRequired"/>
										<owl:hasValue rdf:datatype="&xsd;boolean">false</owl:hasValue>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel xml:lang="en">Non-mandatory Input</skos:altLabel>
		<skos:definition xml:lang="en">input that may be omitted from a tool or skill invocation without preventing the operation from being performed</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">The sort key of iHerb-CLI search (price for Ken, rating for Jessica); max_results of PubMed search_articles.</skos:example>
		<skos:note xml:lang="en">&quot;Omitting this keyword has the same behavior as an empty array.&quot; (JSON Schema Validation, draft 2020-12, section 6.5.3, on &quot;required&quot;); MCP example tool get_weather declares only &quot;location&quot; as required (Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Listing Tools). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Omission may change the result (a default value applies) but not the validity of the invocation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool; JSON Schema Validation, draft 2020-12, section 6.5.3 &quot;required&quot; (properties not listed are optional)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP input schemas list mandatory properties under &quot;required&quot;; every other declared property is optional, and JSON Schema treats an absent &quot;required&quot; keyword as an empty array. Defaults come from the tool description or the schema.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Optional parameter</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Record which optional inputs were supplied in the Tool Invocation, so that two invocations with different optional inputs can be told apart in provenance.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&pplan;Plan"/>
		<rdfs:label xml:lang="en">orchestration plan</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, “Industrial Ontologies Foundry (IOF) ontologies: 2025-02 release,” 2025. [Online]. Available: https://spec.industrialontologies.org/portal/release/202502/. [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Z. Ren et al., “OrchBench: Evaluating multi-agent orchestration plans in isolation via deterministic simulation,” arXiv:2607.25656, Jul. 2026. [Online]. Available: https://arxiv.org/abs/2607.25656 [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adapted from IOF plan specification</dct:source>
		<skos:altLabel xml:lang="en">Agent Orchestration Plan</skos:altLabel>
		<skos:definition xml:lang="en">plan that prescribes which capabilities to invoke, and in what order, to satisfy the information requirements of one request</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the related source concept and source were provided to the language model, which was prompted to generate an ISO 704-compliant specialized definition; the generated definition was subsequently manually revised for the agent-orchestration context.</skos:editorialNote>
		<skos:example xml:lang="en">Retrieve candidate supplements → obtain scientific evidence → check safety → retrieve product information → generate recommendation.</skos:example>
		<skos:note xml:lang="en">IOF treats a plan specification as an information content entity containing action and objective specifications and distinguishes such a specification from the planned process it prescribes.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the prescribed organization of capabilities/actions, not the actual execution of those actions.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core: plan specification</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">IOF defines a plan specification as an information content entity having action specifications and objective specifications as parts. Orchestration Plan specializes this pattern for coordinating capabilities in an agentic AI system.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Execution Plan</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Use for a plan selected or accepted for execution. Keep it distinct from the execution process that realizes the plan and from alternative plans considered during planning.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OrchestrationWorkflowStep">
		<rdfs:subClassOf rdf:resource="&agento;WorkflowStep"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&agento;hasAssociatedTask"/>
				<owl:onClass rdf:resource="&agento;Task"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">orchestration workflow step</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, &quot;AgentO: An ontology for modeling agentic AI systems,&quot; in The Semantic Web: 23rd European Semantic Web Conference, ESWC 2026, Dubrovnik, Croatia, May 10-14, 2026, Proceedings, Part II (Lecture Notes in Computer Science, vol. 16550), M. Acosta, M. van Erp, S. Rudolph, O. Hartig, B. Spahiu, A. Rula, D. Garijo, and F. Osborne, Eds. Cham, Switzerland: Springer, 2026, pp. 298-320, doi: 10.1007/978-3-032-25159-6_16. Page numbers refer to the 22-page author preprint linked from the ESWC 2026 accepted-papers page (https://drive.google.com/file/d/1WrMSiXR-COZHrAKCEN6nE1M5QUB98gim/view).</dct:bibliographicCitation>
		<dct:source xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, AgentO: An Ontology for Modeling Agentic AI Systems, ESWC 2026 (WorkflowStep, hasAssociatedTask). http://www.w3id.org/agentic-ai/onto</dct:source>
		<skos:definition xml:lang="en">workflow step of an orchestration plan that is associated with the task carried out at that point in the plan</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">Step 2 of Jessica&apos;s orchestration plan, associated with the task screen interactions (Jessica); it has step position 2 and runs in parallel with steps 3 and 4.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, AgentO: An Ontology for Modeling Agentic AI Systems, ESWC 2026 (WorkflowStep, hasAssociatedTask). http://www.w3id.org/agentic-ai/onto</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Output">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">output</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 0.3.0, AgentSkill. [Online]. Available: https://a2a-protocol.org/v0.3.0/specification/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/ [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adapted from MCP tool results and A2A output modes</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;InformationArtifact">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-agtorch;produces"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom rdf:resource="&agento;Task"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">information artifact that some task produces</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — related source concepts and sources were provided to a language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">A list of drug-interaction warnings returned by an OpenFDA tool invocation.</skos:example>
		<skos:note xml:lang="en">MCP represents tool results as content or structured content produced in response to a tool call. An optional outputSchema can specify the expected structure.</skos:note>
		<skos:scopeNote xml:lang="en">Represents information produced by a Tool Invocation or Skill Invocation. It does not represent a schema specifying the structure of such information.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Tools Specification / A2A AgentSkill</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP tool calls return results as structured or unstructured content and may define an outputSchema; A2A skills can specify supported output modes.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Distinguish an actual Output from an Output Specification/Output Schema. An Output is generated during execution; the schema describes the form that output may or must take.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;OutputType">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ParameterType"/>
		<rdfs:label xml:lang="en">output type</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<skos:altLabel xml:lang="en">Output Datatype</skos:altLabel>
		<skos:definition xml:lang="en">parameter type that specifies the class or datatype of the values an invocation returns through an output parameter</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">Array of PMID strings from search_articles; object of adverse-event records from OpenFDA search_drug_adverse_events; list of products with price and rating from iHerb-CLI search.</skos:example>
		<skos:note xml:lang="en">&quot;`outputSchema`: Optional JSON Schema defining expected output structure&quot; (Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool); &quot;For backwards compatibility, a tool that returns structured content SHOULD also return the serialized JSON in a TextContent block.&quot; (Tools &gt; Tool Result &gt; Structured Content). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Describes the structure of an Output (row 13), not the output value itself. When no output schema is declared, the type is the unstructured content type returned (text, image, audio or resource).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool (&quot;outputSchema: Optional JSON Schema defining expected output structure&quot;) and Tool Result &gt; Structured Content; OWL-S 1.1 (W3C Member Submission, 2004), section 5.1 (Output as a Parameter with a parameterType)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP tools may declare an outputSchema; structured results must conform to it, and for backwards compatibility the same JSON is also returned as text content.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use together with Parameter Type to check producer-consumer compatibility between capabilities; an Output Type that does not match the consuming capability&apos;s parameter type makes the candidate plan invalid.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Parameter">
		<rdfs:label xml:lang="en">parameter</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<skos:definition xml:lang="en">named element of the interface of a tool or skill through which a value is passed into or returned from an invocation</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">location (string, required) in the MCP get_weather example; search_query and max_results of PubMed search_articles.</skos:example>
		<skos:note xml:lang="en">&quot;Inputs and outputs are subclasses of parameter&quot; (OWL-S 1.1 (W3C Member Submission, 2004), section 5.1); &quot;`inputSchema`: JSON Schema defining expected parameters&quot; (Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">A parameter is the declared slot (design time); the value passed at run time is an Input (row 12) or an Output (row 13).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from OWL-S 1.1 (W3C Member Submission, 2004), section 5.1 (&quot;Inputs and outputs are subclasses of parameter&quot;; &quot;Every parameter has a type&quot;) and Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool (&quot;inputSchema: JSON Schema defining expected parameters&quot;)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">OWL-S models Input and Output as subclasses of Parameter and requires every parameter to carry a parameterType; MCP declares a tool&apos;s parameters as the properties of its inputSchema.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use when describing a tool or skill capability in the KG (which parameters exist, which are required, their types), and match parameters to the Information Artifacts a capability consumes and produces.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ParameterType">
		<rdfs:label xml:lang="en">parameter type</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Wright, H. Andrews, and B. Hutton, Eds., “JSON Schema Validation: A vocabulary for structural validation of JSON,” Internet-Draft draft-bhutton-json-schema-validation-01 (JSON Schema draft 2020-12), Jun. 16, 2022, section 6. [Online]. Available: https://json-schema.org/draft/2020-12/json-schema-validation [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">OpenAPI Initiative, “OpenAPI Specification v3.1.0,” Feb. 15, 2021, section Parameter Object. [Online]. Available: https://spec.openapis.org/oas/v3.1.0 [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<skos:altLabel xml:lang="en">Parameter Datatype</skos:altLabel>
		<skos:definition xml:lang="en">class or datatype to which the values of a parameter must belong</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">string (location); integer (max_results); object (health profile); array of strings (PMIDs).</skos:example>
		<skos:note xml:lang="en">&quot;Every parameter has a type, specified using a URI. This is not the OWL class the parameter belongs to, but a specification of the class (or datatype) that values of the parameter belong to.&quot; (OWL-S 1.1 (W3C Member Submission, 2004), section 5.1); &quot;String values MUST be one of the six primitive types (&quot;null&quot;, &quot;boolean&quot;, &quot;object&quot;, &quot;array&quot;, &quot;number&quot;, or &quot;string&quot;), or &quot;integer&quot;&quot; (JSON Schema Validation, draft 2020-12, section 6.1.1). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Instances describe the permitted type of a parameter&apos;s values, not the OWL class of the parameter itself; OWL-S makes this distinction explicitly. They are type descriptions, not the values passed at runtime. hasType is not equivalent to the OWL-S datatype property parameterType.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">OWL-S 1.1 (W3C Member Submission, 2004), section 5.1 (&quot;a specification of the class (or datatype) that values of the parameter belong to&quot;); JSON Schema Validation, draft 2020-12, section 6.1.1 &quot;type&quot;</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">OWL-S gives every parameter a parameterType URI. JSON Schema, used by MCP input and output schemas, expresses it with the &quot;type&quot; keyword (null, boolean, object, array, number, string or integer), optionally refined by format, enum or a nested object schema.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use parameter types to check that the Output Type of a producing capability is compatible with the parameter type of the consuming capability when the dependency graph is built (basic flow step 8).</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PlanEvaluation">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;evaluates"/>
				<owl:onClass rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">plan evaluation</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;evaluation,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/evaluation [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">N. Noy and A. Rector, Eds., “Defining N-ary relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook. [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">W3C n-ary relations pattern.</dct:source>
		<skos:definition xml:lang="en">evaluation record that associates an orchestration plan with the criteria used and the plan metrics obtained</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A37, Figure(s) 1, 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An evaluation of Candidate A with token-cost, latency, and evidence-coverage measurements.</skos:example>
		<skos:note xml:lang="en">The n-ary relation pattern supports a separate record for a relation involving several participants.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the evaluation record connecting a plan, its criteria, and its measurements. Each plan evaluation evaluates exactly one candidate orchestration plan.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Noy and Rector (2006), Defining N-ary Relations on the Semantic Web, Pattern 1 (“Introducing a new class for a relation”): “we create a new class and n new properties to represent an n-ary relation”. The participants are the plan, the decision criteria and the plan metrics; the criteria are as in NASA, 6.8 Decision Analysis: “Decision criteria are requirements for individually assessing the options and alternatives being considered.”</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology specializes the pattern with evaluates, uses criterion and has measurement.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Create an evaluation for each plan comparison and attach its criteria and measurements.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PlanMetric">
		<rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure"/>
		<rdfs:label xml:lang="en">plan metric</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;metric,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/metric [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Fox and D. Long, &quot;PDDL2.1: An Extension to PDDL for Expressing Temporal Planning Domains,&quot; Journal of Artificial Intelligence Research, vol. 20, pp. 61–124, 2003, doi: 10.1613/jair.1129 (Section 4 &quot;Plan Metrics&quot;; Appendix A.4).</dct:bibliographicCitation>
		<dct:source xml:lang="en">Fox and Long (2003), PDDL2.1, Section 4 &quot;Plan Metrics&quot;</dct:source>
		<skos:definition xml:lang="en">measure used in an evaluation to characterize an orchestration plan on a specified dimension</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A38, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A tool-call-count measurement associated with an evaluated candidate plan.</skos:example>
		<skos:note xml:lang="en">Fox and Long introduce the plan metric as an optional problem field: &quot;Plan metrics specify, for the benefit of the planner, the basis on which a plan will be evaluated for a particular problem.&quot; A plan metric here is one such basis of evaluation for an orchestration plan.</skos:note>
		<skos:scopeNote xml:lang="en">Includes the model&apos;s ToolCost, TokenCost, Latency, ToolCallCount, and EvidenceCoverage specializations.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Fox and Long (2003), PDDL2.1, Section 4, the plan metric on which a plan is evaluated.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The measurement dimension is distinct from the criterion used to compare plans.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Attach the metric to its PlanEvaluation and record its unit or scoring convention where applicable.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Precondition">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExecutionConstraint"/>
		<rdfs:label xml:lang="en">precondition</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/ [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">H. Xu et al., “The evolution of tool use in LLM agents: From single-tool call to multi-tool orchestration,” arXiv:2603.22862v30, Mar. 24, 2026. [Online]. Available: https://arxiv.org/abs/2603.22862v30 [Accessed: Sep. 23, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">OWL-S, section 5</dct:source>
		<skos:definition xml:lang="en">execution constraint that must hold for a tool or skill to be validly invoked</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term, OWL-S source, and use case were provided to the language model, which was prompted to generate an ISO 704-compliant definition adapted to the conditions required before a tool or skill invocation.</skos:editorialNote>
		<skos:example xml:lang="en">A CandidateSupplement record must be available before the Evidence Verification Skill starts.</skos:example>
		<skos:note xml:lang="en">OWL-S distinguishes preconditions from inputs and states that preconditions must hold for a process to be successfully invoked.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to conditions checked before a particular invocation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">OWL-S, sections 5 and 5.3</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Having a required input available can be a precondition. The precondition is the availability requirement, rather than the input itself.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Check each precondition against the current workflow state. Identify any that are unmet or cannot yet be confirmed.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;PreferenceSetting">
		<rdfs:label xml:lang="en">preference setting</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;preference,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/preference [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">G. Adomavicius and A. Tuzhilin, &quot;Toward the next generation of recommender systems: a survey of the state-of-the-art and possible extensions,&quot; IEEE Transactions on Knowledge and Data Engineering, vol. 17, no. 6, pp. 734–749, 2005, doi: 10.1109/TKDE.2005.99.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Pearson, &quot;preference,&quot; Longman Dictionary of Contemporary English (online). [Online]. Available: https://www.ldoceonline.com/dictionary/preference [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adomavicius and Tuzhilin (2005), recommender-systems survey (user preferences); Longman Dictionary, &quot;preference&quot;</dct:source>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isPreferenceSetting"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">configuration item expressing a user preference that can be used to derive a user constraint</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A40, Figure(s) 2. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A setting indicating that the user prefers fewer external tool calls.</skos:example>
		<skos:note xml:lang="en">Adomavicius and Tuzhilin survey recommender systems, which estimate a user&apos;s preferences for items from the preferences the user has already expressed; Longman defines preference as &quot;if you have a preference for something, you like it more than another thing and will choose it if you can&quot;. A preference setting stores one such preference.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the preference input, rather than the resulting constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Longman Dictionary sense of &quot;preference&quot; (liking one thing more than another and choosing it if you can), specialized to a stored user setting from which user constraints are derived; concept of user preferences per Adomavicius and Tuzhilin (2005).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Covers the preference and execution settings a user saves, such as turning safety screening on or asking to minimize token usage. Preference setting is also equivalent to (is preference setting Self); the marker is preference setting ends the property chain of has preference setting.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a derived user constraint to the preference setting from which it originates.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ProductList">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">product list</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Schema.org, &quot;ItemList,&quot; Schema.org vocabulary, version 30.1, Sep. 16, 2026. [Online]. Available: https://schema.org/ItemList</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Schema.org, &quot;Product,&quot; Schema.org vocabulary, version 30.1, Sep. 16, 2026. [Online]. Available: https://schema.org/Product</dct:bibliographicCitation>
		<dct:source xml:lang="en">Schema.org, types ItemList and Product</dct:source>
		<skos:definition xml:lang="en">information artifact containing product records retrieved for one or more candidate supplements</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A41, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A product-search result listing candidate products and their available metadata.</skos:example>
		<skos:note xml:lang="en">Schema.org models a list as ItemList, &quot;A list of items of any sort&quot;, and a product as Product, &quot;Any offered product or service&quot;; a product list here is an ItemList of product records retrieved for candidate supplements.</skos:note>
		<skos:scopeNote xml:lang="en">Represents product-search output rather than physical products or a final product selection.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Schema.org ItemList (&quot;A list of items of any sort&quot;) whose items are of type Product (&quot;Any offered product or service&quot;).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping identifies this artifact as an iHerb-CLI output in CQ 2 and 7.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Provide product information to later comparison and recommendation tasks.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ReferenceMaterial">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">reference material</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that provides knowledge or contextual information an agent uses when applying a skill to perform a task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">A reference file packaged with a skill, such as a table of known supplement–drug interactions that the supplement safety screening skill reads when it needs it.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">found in resources/ of a skill folder</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;RejectedOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:label xml:lang="en">rejected orchestration plan</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;reject,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/reject [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook (online edition). [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NASA Systems Engineering Handbook, 6.8 Decision Analysis (alternatives that are not recommended)</dct:source>
		<owl:disjointWith rdf:resource="&oe-agtorch;SelectedOrchestrationPlan"/>
		<skos:definition xml:lang="en">candidate orchestration plan that has not been selected for execution</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A43, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A candidate excluded because it violates a mandatory constraint.</skos:example>
		<skos:note xml:lang="en">NASA describes decision analysis as &quot;a framework within which analyses of diverse types are applied&quot; to choose among alternatives and notes that &quot;Generally, a single alternative should be recommended&quot;; a rejected orchestration plan is a candidate that was not the one selected.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to the outcome of a particular plan-selection decision.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from NASA Systems Engineering Handbook, 6.8 Decision Analysis: a candidate alternative that is not the one recommended.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Figure 6 retains rejected plans as candidate-plan subclasses; CQ 4 and 9 provide the use-case basis.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Retain the rejected candidate and the evaluation or constraint violation explaining its rejection.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Request">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty>
					<rdf:Description>
						<owl:inverseOf rdf:resource="&oe-agtorch;addresses"/>
					</rdf:Description>
				</owl:onProperty>
				<owl:onClass rdf:resource="&oe-agtorch;SelectedOrchestrationPlan"/>
				<owl:maxQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:maxQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;expresses"/>
				<owl:onClass rdf:resource="&oe-agtorch;InformationRequirement"/>
				<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">request</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;request,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/request [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Dumontier et al., “The Semanticscience Integrated Ontology (SIO) for biomedical research and knowledge discovery,” Journal of Biomedical Semantics, vol. 5, no. 1, Art. no. 14, 2014, doi: 10.1186/2041-1480-5-14.</dct:bibliographicCitation>
		<dct:source xml:lang="en">Dumontier et al., “The Semanticscience Integrated Ontology (SIO) for biomedical research and knowledge discovery” (2014).</dct:source>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isRequest"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">user input that expresses a task, action, or information need for an agent to address</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">“Find the latest approved policy and summarize its key requirements.”</skos:example>
		<skos:scopeNote xml:lang="en">Includes requests phrased as questions or instructions. It identifies what the agent is being asked to address; it is not the plan for carrying out the request. A request expresses at least one information requirement and is addressed by at most one selected orchestration plan.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">SIO, class Question, defined as a linguistic expression used to request information.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Request is also equivalent to (is request Self), which gives every request the marker is request for the property chains of has preference setting, has hard constraint and has soft constraint.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;RequiredInput">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Input"/>
		<rdfs:label xml:lang="en">required input</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Wright, H. Andrews, and B. Hutton, Eds., “JSON Schema Validation: A vocabulary for structural validation of JSON,” Internet-Draft draft-bhutton-json-schema-validation-01 (JSON Schema draft 2020-12), Jun. 16, 2022, section 6. [Online]. Available: https://json-schema.org/draft/2020-12/json-schema-validation [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">JSON Schema, “Object,” Understanding JSON Schema, sections “Properties” and “Required Properties.” [Online]. Available: https://json-schema.org/understanding-json-schema/reference/object</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">OpenAPI Initiative, “OpenAPI Specification v3.1.0,” Feb. 15, 2021, section Parameter Object. [Online]. Available: https://spec.openapis.org/oas/v3.1.0 [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Mulang&apos; et al. (2026), https://openreview.net/forum?id=7MVoH9Y3mi (term source)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Input">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;fills"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-agtorch;Parameter">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-agtorch;isRequired"/>
										<owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel xml:lang="en">Mandatory Input</skos:altLabel>
		<skos:definition xml:lang="en">input that must be supplied for a tool or skill invocation to be accepted</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">The search query of PubMed search_articles; the medication list of the OpenFDA interaction-screening tool.</skos:example>
		<skos:note xml:lang="en">&quot;`inputSchema`: JSON Schema defining expected parameters&quot; (Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool); &quot;An object instance is valid against this keyword if every item in the array is the name of a property in the instance.&quot; (JSON Schema Validation, draft 2020-12, section 6.5.3). Term source (Mulang&apos; et al., OpenReview 7MVoH9Y3mi) could not be opened for quotation on 9/25/2026 (OpenReview access check); the definition is adapted from the sources cited in column Q.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to the declared interface of a tool or skill: whether an input is required is fixed by the input schema, not by a particular invocation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Tools &gt; Data Types &gt; Tool (inputSchema: &quot;JSON Schema defining expected parameters&quot;); JSON Schema Validation, draft 2020-12, section 6.5.3 &quot;required&quot;</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">In MCP a tool&apos;s inputSchema is a JSON Schema whose &quot;required&quot; array names the properties that every call must contain; JSON Schema Validation 2020-12 section 6.5.3 makes an object valid only if every listed name is present.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Required parameter</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">When a required input is missing, the prerequisite check of CQ 8 reports the invocation as blocked and traces the input to the capability that produces it.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;RequirementSatisfyingCapability">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">requirement-satisfying capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core, satisfiesRequirement; AgentO v0.2, class Capability</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Capability">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-agtorch;satisfiesRequirement"/>
						<owl:someValuesFrom rdf:resource="&oe-agtorch;InformationRequirement"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">capability that satisfies at least one information requirement</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 8: defined class whose members the reasoner infers (conceptual model Figure 3c).</skos:editorialNote>
		<skos:example xml:lang="en">The product search capability is inferred to be a requirement-satisfying capability because it satisfies Jessica&apos;s information requirement for purchasable supplement products.</skos:example>
		<skos:scopeNote xml:lang="en">Defined class. Competency question 5 uses it to explain that a capability is in a plan because it satisfies an information requirement of the request.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement (“relation from an entity to a requirement specification that the entity conforms to”), with AgentO v0.2 class Capability as the genus.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SafetyAssessment">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Assessment"/>
		<rdfs:label xml:lang="en">safety assessment</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">National Institutes of Health, Office of Dietary Supplements, &quot;Dietary Supplements: What You Need to Know,&quot; Fact Sheet for Consumers. [Online]. Available: https://ods.od.nih.gov/factsheets/WYNTK-Consumer/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">U.S. Food and Drug Administration, &quot;Drug Adverse Event Overview,&quot; openFDA. [Online]. Available: https://open.fda.gov/apis/drug/event/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NIH ODS, &quot;Dietary Supplements: What You Need to Know,&quot; Safety and Risk; openFDA Drug Adverse Event API (FAERS data)</dct:source>
		<skos:definition xml:lang="en">assessment recording the result of checking a candidate supplement against relevant safety constraints</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A47, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An assessment recording the safety checks performed for a candidate supplement.</skos:example>
		<skos:note xml:lang="en">NIH ODS warns that &quot;Supplements can also interact with some medicines in ways that might cause problems&quot; and that a supplement&apos;s safety &quot;depends on many things, such as its chemical makeup, how it works in the body, how it is prepared, and the amount you take&quot;; openFDA defines an adverse event as &quot;any undesirable experience associated with the use of a medical product in a patient&quot;. A safety assessment records the result of such a check for one candidate supplement.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a workflow assessment artifact, not a clinical guarantee or the checking task itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the NIH ODS &quot;Safety and Risk&quot; guidance on supplement side effects and interactions with medicines, and from the openFDA adverse-event data used to check them.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping identifies this artifact in CQ 2, 3, and 7.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Supply the assessment to tasks that decide whether a candidate meets the request&apos;s safety constraints.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Script">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;ExecutableResource"/>
		<rdfs:label xml:lang="en">script</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">executable resource that specifies the computational operations an agent can invoke when applying a skill to perform a task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">A script packaged with a skill, such as a program the dosage calculator skill runs to compute a supplement dose.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">found in scripts/ of a skill folder</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SearchQuery">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:label xml:lang="en">search query</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">C. D. Manning, P. Raghavan, and H. Schütze, Introduction to Information Retrieval. Cambridge, U.K.: Cambridge University Press, 2008, ch. 1, &quot;An example information retrieval problem.&quot; [Online]. Available: https://nlp.stanford.edu/IR-book/html/htmledition/an-example-information-retrieval-problem-1.html</dct:bibliographicCitation>
		<dct:source xml:lang="en">Manning, Raghavan, and Schütze (2008), Introduction to Information Retrieval, ch. 1 (query vs. information need)</dct:source>
		<skos:definition xml:lang="en">information artifact specifying search terms or criteria submitted to an information-retrieval tool</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A49, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A query requesting scientific evidence about a candidate supplement.</skos:example>
		<skos:note xml:lang="en">Manning et al. distinguish the information need, &quot;the topic about which the user desires to know more&quot;, from the query, &quot;what the user conveys to the computer in an attempt to communicate the information need&quot;; a search query here is that conveyed artifact submitted to a retrieval tool.</skos:note>
		<skos:scopeNote xml:lang="en">Represents the query content rather than the search tool, invocation, or retrieved result.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Manning et al. (2008), ch. 1: a query is &quot;what the user conveys to the computer in an attempt to communicate the information need&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping identifies this artifact in CQ 8.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use as an input artifact that fills a search parameter.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SelectedOrchestrationPlan">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:label xml:lang="en">selected orchestration plan</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, “Industrial Ontologies Foundry (IOF) ontologies: 2025-02 release,” 2025. [Online]. Available: https://spec.industrialontologies.org/portal/release/202502/. [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook (online edition). [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NASA Systems Engineering Handbook, 6.8 Decision Analysis (the recommended alternative)</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;CandidateOrchestrationPlan">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-agtorch;evaluates"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&oe-agtorch;hasRank"/>
								<owl:hasValue rdf:datatype="&xsd;integer">1</owl:hasValue>
							</owl:Restriction>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">candidate orchestration plan that is selected for execution because its plan evaluation ranks it first</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A50, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">The candidate chosen after comparing the applicable criteria and constraints.</skos:example>
		<skos:note xml:lang="en">NASA describes decision analysis as &quot;a framework within which analyses of diverse types are applied&quot; to choose among alternatives, and &quot;Generally, a single alternative should be recommended&quot;; the selected orchestration plan is that alternative.</skos:note>
		<skos:scopeNote xml:lang="en">The scoring step computes the rank; the reasoner then classifies the plan whose evaluation has rank 1 as selected (competency question 1). Selection identifies the chosen candidate; it does not establish that execution has completed.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from NASA Systems Engineering Handbook, 6.8 Decision Analysis: the single alternative recommended after evaluating the candidates.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Figure 6 retains selected plans as candidate-plan subclasses.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Retain its evaluation and connect subsequent invocations to its workflow steps.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Server">
		<rdfs:label xml:lang="en">server</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol Project, “Model Context Protocol specification,” revision 2026-07-28, Model Context Protocol a Series of LF Projects, LLC (Agentic AI Foundation, The Linux Foundation), Jul. 28, 2026. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28 [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Model Context Protocol (MCP)</dct:source>
		<skos:definition xml:lang="en">software component that exposes computational resources and operations to clients through a communication protocol</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the source concept and source were provided to a language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised for the ontology context. Reference note (moved from References in Assignment 11): the MCP text used was docs/specification/2026-07-28/*.mdx in github.com/modelcontextprotocol/modelcontextprotocol (main, Sep. 22, 2026), sections Specification overview, Architecture, Base Protocol, Server Features and Client Features (Roots).</skos:editorialNote>
		<skos:example xml:lang="en">An MCP server exposing PubMed, OpenFDA, and product-search tools.</skos:example>
		<skos:note xml:lang="en">MCP implementations describe the server as the component responsible for exposing tools and other resources and processing client requests.</skos:note>
		<skos:scopeNote xml:lang="en">In this ontology, Server primarily represents the infrastructure component through which tools are made available to agents or clients.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Architecture / Server documentation</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">An MCP server implements the server side of the protocol and may expose tools, resources, prompts, and capabilities that clients can discover and use.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use for the software component providing access to one or more tools. Do not use Server for the tools themselves.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Skill">
		<rdfs:label xml:lang="en">skill</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, &quot;AgentO: An ontology for modeling agentic AI systems,&quot; in The Semantic Web: 23rd European Semantic Web Conference, ESWC 2026, Dubrovnik, Croatia, May 10-14, 2026, Proceedings, Part II (Lecture Notes in Computer Science, vol. 16550), M. Acosta, M. van Erp, S. Rudolph, O. Hartig, B. Spahiu, A. Rula, D. Garijo, and F. Osborne, Eds. Cham, Switzerland: Springer, 2026, pp. 298-320, doi: 10.1007/978-3-032-25159-6_16. Page numbers refer to the 22-page author preprint linked from the ESWC 2026 accepted-papers page (https://drive.google.com/file/d/1WrMSiXR-COZHrAKCEN6nE1M5QUB98gim/view).</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 0.3.0, AgentSkill. [Online]. Available: https://a2a-protocol.org/v0.3.0/specification/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">A2A Protocol – AgentSkill</dct:source>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isSkill"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:altLabel xml:lang="en">Agent Skill</skos:altLabel>
		<skos:definition xml:lang="en">specification of a focused agent behavior that can be applied to perform a class of tasks</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the source concept and source were provided to a language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised to distinguish a skill from a general capability.</skos:editorialNote>
		<skos:example xml:lang="en">Personalized Supplement Recommendation Skill; Safety Assessment Skill; Scientific Evidence Retrieval Skill.</skos:example>
		<skos:note xml:lang="en">In A2A, skills appear in an Agent Card and describe specific abilities or functions supported by an agent, including descriptions, examples, input modes, and output modes.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a focused and describable behavior available to an agent: a reusable behavior specification, not an invocation or other occurrence of that behavior. Included as a shared reference from Figure 3; Skill is not modeled as a subclass of Capability, following the conceptual model Figure 3 decision.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">A2A Protocol – AgentSkill</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">A2A defines an AgentSkill as a distinct capability or function that an agent can perform and describes skills as focused behaviors the agent is likely to perform successfully. Skill is also equivalent to (is skill Self), which gives every skill the marker is skill for the property chains of skill satisfies requirement and skill satisfies hard constraint.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Agent Function</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Use to represent an operationally defined agent behavior that can be selected during orchestration. Represent an occurrence of its use as a Skill Invocation.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SkillInvocation">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;invokes"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;Skill"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">skill invocation</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 0.3.0, AgentSkill. [Online]. Available: https://a2a-protocol.org/v0.3.0/specification/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Agent Skills, “Agent Skills overview,” Agent Skills documentation, section “How do Agent Skills work?” [Online]. Available: https://agentskills.io/what-are-skills [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">A2A Protocol, AgentSkill; Agent Skills (agentskills.io), “How do Agent Skills work?” (stages Activation and Execution)</dct:source>
		<skos:altLabel xml:lang="en">Skill Activation</skos:altLabel>
		<skos:definition xml:lang="en">invocation event in which a specific skill is selected and applied to perform a task</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — related source concepts and sources were provided to a language model, which was prompted to generate an ISO 704-compliant specialized definition; the generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">Invocation of the Personalized Supplement Recommendation Skill for a user&apos;s bone-health request.</skos:example>
		<skos:note xml:lang="en">Agent systems commonly distinguish available skills from their runtime invocation. Skills may be invoked explicitly by a user or selected automatically by an agent.</skos:note>
		<skos:scopeNote xml:lang="en">Represents an occurrence of applying a skill, rather than the reusable Skill specification itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">A2A Protocol, AgentSkill; Agent Skills overview (agentskills.io), stages “Activation” and “Execution”</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">A2A defines the reusable skill that an agent can perform, while current agent frameworks distinguish that skill definition from its activation or invocation during execution.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Skill Execution</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Use to capture runtime provenance, including which Skill was applied, which inputs were provided, what outputs resulted, and which tool invocations occurred as part of it.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SkillResource">
		<rdfs:subClassOf rdf:resource="http://w3id.org/beam/core#Resource"/>
		<rdfs:label xml:lang="en">skill resource</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Anthropic, &quot;Agent Skills,&quot; Claude Developer Platform documentation. [Online]. Available: https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, et al., &quot;SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,&quot; arXiv:2602.12670v4, Jun. 2026, Section 2 (Skill Definition) and Table 1. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">Li et al. (2026), SkillsBench, Section 2 (Skill Definition); Anthropic, Agent Skills documentation</dct:source>
		<skos:definition xml:lang="en">resource used to aid in skill execution</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The files packaged with a skill, such as the SKILL.md instructions, reference files, scripts and templates of the evidence verification skill.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from SkillsBench, Section 2, where a skill “may optionally include auxiliary resources such as scripts, templates, reference files, or worked examples”.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SoftConstraint">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;UserConstraint"/>
		<rdfs:label xml:lang="en">soft constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:source xml:lang="en">MiniBrass: Soft Constraints for MiniZinc.</dct:source>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isSoftConstraint"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">user constraint that represents a preference or desirable condition that may be relaxed when evaluating an orchestration plan</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A54, Figure(s) 2 (ref 6). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A preference for fewer external tool calls when comparing acceptable plans.</skos:example>
		<skos:note xml:lang="en">Soft-constraint models assign preference or penalty information to candidate solutions.</skos:note>
		<skos:scopeNote xml:lang="en">Applies to user preferences that guide comparison among acceptable candidates.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from MiniBrass: Soft Constraints for MiniZinc.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Specialized from user constraint. Soft constraint is also equivalent to (is soft constraint Self); the marker is soft constraint ends the property chains of has soft constraint.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Associate the preference with its DecisionCriterion and compare candidates under the chosen evaluation method.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;SystemInteraction">
		<rdfs:subClassOf rdf:resource="&agento;Capability"/>
		<rdfs:label xml:lang="en">system interaction</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:source xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:source>
		<skos:definition xml:lang="en">capability that performs an operation on or through an external computational system</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">read/write to a file</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</cmns-av:adaptedFrom>
		<cmns-av:usageNote xml:lang="en">performed to obtain a result from the system or modify its state</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Template">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;SkillResource"/>
		<rdfs:label xml:lang="en">template</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:source>
		<skos:definition xml:lang="en">skill resource that provides the expected structure and organization of an information artifact produced when an agent applies a skill</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT Desktop. fed the term and source. prompted the model to generate a ISO-704 definition aligned with the scope of the use case. Manually made the necessary revisions afterward.</skos:editorialNote>
		<skos:example xml:lang="en">An output template packaged with a skill, such as the layout the personalized supplement recommendation skill follows for each recommended supplement.</skos:example>
		<cmns-av:adaptedFrom xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">found in assets/ of a skill folder</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;TokenCost">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">token cost</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">OpenAI, &quot;Agents API: Observability,&quot; OpenAI API documentation, section &quot;Model usage and cost.&quot; [Online]. Available: https://developers.openai.com/api/docs/guides/agents-api/observability [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">OpenAI, &quot;Pricing,&quot; OpenAI API documentation. [Online]. Available: https://developers.openai.com/api/docs/pricing [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">Li et al., SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks (2026), Appendix L, “Token, Cost, and Time Efficiency.” The paper reports token counts and per-trial costs.</dct:source>
		<skos:altLabel xml:lang="en">Token Usage Cost</skos:altLabel>
		<skos:definition xml:lang="en">plan metric expressing monetary cost incurred for processing input tokens and generating output tokens during agent execution, calculated using the applicable model or provider rates</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">An agent’s prompt and tool results consume input tokens, and its response consumes output tokens; the provider’s rates determine the token cost.</skos:example>
		<skos:scopeNote xml:lang="en">Token cost is the monetary charge; it is distinct from token usage, the number of tokens processed or generated. Actual cost depends on model/provider rates and may treat cached input differently.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">OpenAI, “Agents API: Observability,” “Model usage and cost.” It describes model costs by input, cached input, and output tokens, billed according to applicable rates</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;Tool">
		<rdfs:subClassOf rdf:resource="&process;Process"/>
		<rdfs:subClassOf rdf:resource="&agento;Tool"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;hasCapability"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Capability"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&process;hasParameter"/>
				<owl:allValuesFrom rdf:resource="&oe-agtorch;Parameter"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">tool</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">H. Xu et al., “The evolution of tool use in LLM agents: From single-tool call to multi-tool orchestration,” arXiv:2603.22862v30, Mar. 24, 2026. [Online]. Available: https://arxiv.org/abs/2603.22862v30 [Accessed: Sep. 23, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">National Institute of Standards and Technology, “Lessons learned from the consortium: Tool use in agent systems,” NIST News, Aug. 5, 2025. [Online]. Available: https://www.nist.gov/news-events/news/2025/08/lessons-learned-consortium-tool-use-agent-systems [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Model Context Protocol (MCP)</dct:source>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isTool"/>
				<owl:hasSelf rdf:datatype="&xsd;boolean">true</owl:hasSelf>
			</owl:Restriction>
		</owl:equivalentClass>
		<skos:altLabel xml:lang="en">Agent Tool</skos:altLabel>
		<skos:definition xml:lang="en">callable computational resource that performs a defined operation when invoked</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the term and source were provided to a language model, which was prompted to generate an ISO 704-compliant definition; the generated definition was subsequently manually revised.</skos:editorialNote>
		<skos:example xml:lang="en">PubMed search tool; OpenFDA tool; iHerb product search tool.</skos:example>
		<skos:note xml:lang="en">MCP models a Tool as a server-exposed callable object identified by name and described by metadata and input/output schemas.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a resource available for invocation, rather than a particular execution of that resource.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP Tools Specification</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP defines tools as server-exposed mechanisms that language models can invoke to interact with external systems, including APIs, databases, and computational services. Tool is also equivalent to (is tool Self), which gives every tool the marker is tool for the property chains of tool satisfies requirement and tool satisfies hard constraint.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use for an executable resource that may be selected by a skill or orchestration plan. Do not use for an individual execution; represent that as a Tool Invocation.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolCallCount">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">tool call count</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Z. Guo, Y. Li, L. Qiu, X. Wang, J. Xv, D. Ru, X. Li, X. Zheng, X. Cao, and X. Cai, &quot;AgentEscapeBench: Evaluating Out-of-Domain Tool-Grounded Reasoning in LLM Agents,&quot; arXiv:2605.07926v2, May 2026, Section 4.3 (Efficiency Analysis) and Table 3. [Online]. Available: https://arxiv.org/abs/2605.07926</dct:bibliographicCitation>
		<dct:source xml:lang="en">Guo et al. (2026), AgentEscapeBench, Section 4.3 (average number of tool calls per instance)</dct:source>
		<skos:definition xml:lang="en">plan metric recording the number of tool invocations attributed to an orchestration plan</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!A61, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A comparison records eight tool calls for one candidate and three for another.</skos:example>
		<skos:note xml:lang="en">Guo et al. use &quot;the average number of tool calls consumed per instance as a measure of problem-solving efficiency&quot; (Table 3: &quot;Average tool calls per instance across difficulty levels. Lower is better.&quot;); the plan metric here records that count for one orchestration plan.</skos:note>
		<skos:scopeNote xml:lang="en">Distinguish estimated calls for a candidate plan from calls observed during an execution.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Guo et al. (2026), Section 4.3, which uses &quot;the average number of tool calls consumed per instance as a measure of problem-solving efficiency&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The supplied mapping cites external-call preferences and the eight-versus-three example in CQ 4.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Specify the counting boundary and whether retries or only external tool calls are included.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolCost">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:label xml:lang="en">tool cost</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">OpenAI, &quot;Agents API: Observability,&quot; OpenAI API documentation, section &quot;Model usage and cost.&quot; [Online]. Available: https://developers.openai.com/api/docs/guides/agents-api/observability [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, Y. He, et al., “SkillsBench: Benchmarking how well agent skills work across diverse tasks,” arXiv:2602.12670, 2026. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">Li et al., SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks (2026), Appendix L, “Token, Cost, and Time Efficiency.”</dct:source>
		<skos:altLabel xml:lang="en">Tool-use cost</skos:altLabel>
		<skos:definition xml:lang="en">plan metric expressing cost attributable to invoking and using a tool in an agent workflow, including applicable per-use charges and associated model-processing costs</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">A search API’s per-query fee, plus the model-token cost of preparing the tool call and processing its result.</skos:example>
		<skos:scopeNote xml:lang="en">The SkillsBench paper reports per-trial agent cost, including token usage and model/provider charges; that is broader than the cost of an individual tool invocation. In this glossary, “tool cost” means costs attributable to tool use within an agent workflow.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">OpenAI, “Agents API: Observability,” section “Model usage and cost.” It describes costs across model calls and notes applicable tool, compute, and third-party service charges.</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;ToolInvocation">
		<rdfs:subClassOf rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;invokes"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;Tool"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-agtorch;isPartOf"/>
				<owl:someValuesFrom rdf:resource="&oe-agtorch;SkillInvocation"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">tool invocation</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">I. O. Mulang, J. Thaller, T. Trivedi, L. Heling, and F. Sasaki, “Representing Agentic Tools in Knowledge Graphs for Structure-Aware Tool Discovery Under Tool Overload,” in Proc. 2nd Workshop on KNOwledge GRaphs &amp; Agentic Systems Interplay (NORA 2026), co-located with IJCAI-ECAI 2026, Bremen, Germany, 2026.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2025-06-18, Server Features: Tools (sections &quot;Calling Tools&quot; and &quot;Security Considerations&quot;). [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adapted from MCP tools/call</dct:source>
		<skos:altLabel xml:lang="en">Tool Call</skos:altLabel>
		<skos:definition xml:lang="en">invocation event in which a specific tool is requested to perform its operation using supplied input</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the related source concept and source were provided to a language model, which was prompted to generate an ISO 704-compliant specialized definition; the generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">An invocation of the OpenFDA interaction-checking tool using the user&apos;s medication list as input.</skos:example>
		<skos:note xml:lang="en">MCP uses tools/call for a client request to invoke a tool provided by a server. The result can contain structured or unstructured output and an error state.</skos:note>
		<skos:scopeNote xml:lang="en">Represents a particular occurrence of using a Tool and must therefore be distinguished from the Tool itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">MCP CallToolRequest / Tools Specification</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">MCP represents invocation through a tools/call request containing the name of the selected tool and its arguments, followed by a tool result returned by the server.</cmns-av:explanatoryNote>
		<cmns-av:synonym xml:lang="en">Tool Execution</cmns-av:synonym>
		<cmns-av:usageNote xml:lang="en">Create a separate Tool Invocation individual for each execution when provenance, inputs, outputs, status, timing, or errors need to be recorded.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-agtorch;UserConstraint">
		<rdfs:subClassOf rdf:resource="&agento;Constraint"/>
		<rdfs:label xml:lang="en">user constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">R. Iannella and S. Villata, “ODRL Information Model 2.2,” W3C Recommendation, Feb. 15, 2018. [Online]. Available: https://www.w3.org/TR/odrl-model/</dct:bibliographicCitation>
		<dct:source xml:lang="en">ODRL, underlying constraint concept</dct:source>
		<owl:equivalentClass>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;HardConstraint">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;SoftConstraint">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">constraint derived from a user&apos;s request, profile, or execution preferences that governs the selection or execution of an orchestration plan</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT — the related constraint concept and use case were provided to the language model, which was prompted to generate an ISO 704-compliant definition focused on constraints derived from the user&apos;s request, profile, and preferences.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica’s medication profile leads to a requirement for safety screening before the final recommendation.</skos:example>
		<skos:note xml:lang="en">ODRL 2.2 states that “Constraints are boolean/logical expressions that can be used to refine the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule” (section 2.5).</skos:note>
		<skos:scopeNote xml:lang="en">Covers constraints that come from the user’s request, profile, or settings. Every user constraint is either a hard constraint or a soft constraint, and no constraint is both.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">ODRL, section 2.5</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">A user constraint may also be an execution constraint. A user’s limit on tool calls is an example of both.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Keep a link to the request, profile information, or setting that led to the constraint.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;addresses">
		<rdfs:label xml:lang="en">addresses</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;address,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/address [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Cambridge Dictionary, &quot;address&quot; (verb: to deal with a matter)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;Request"/>
		<skos:definition xml:lang="en">relation from an orchestration plan to the request it is intended to handle</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A2, Figure(s) 1, 5. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">Plan A addresses the user&apos;s supplement-information request.</skos:example>
		<skos:note xml:lang="en">Cambridge defines the verb &quot;address&quot; as &quot;to give attention to or deal with a matter or problem&quot;; the relation names the request that an orchestration plan deals with.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → request.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Cambridge Dictionary sense of &quot;address&quot; (verb), &quot;to give attention to or deal with a matter or problem&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Expresses the planning target without asserting that execution succeeded.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link each candidate orchestration plan to the one request it answers; the plans for a request are found by following addresses backwards.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;confirmsPrecondition">
		<rdfs:label xml:lang="en">confirms precondition</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;confirm,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/confirm [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan (Markovic et al., 2019), property satisfied; OWL-S, process preconditions</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:range rdf:resource="&oe-agtorch;Precondition"/>
		<skos:definition xml:lang="en">relation from an invocation to a precondition that the invocation checked and found to hold</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">The invocation PubMed reachability check (Jessica) confirms the precondition PubMed MCP server is reachable, a precondition of the evidence verification skill.</skos:example>
		<skos:note xml:lang="en">OWL-S says a process can have any number of preconditions, “which must all hold in order for the process to be successfully invoked”; Cambridge defines confirm as “to prove or state the truth of something that was previously not completely certain”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: invocation → precondition. A precondition holds in an agent&apos;s current phase of orchestration when the execution trace records an invocation that confirms it. Competency question 9 uses it, with prov:wasGeneratedBy for required inputs, to decide whether a skill is ready to execute. Under OWL&apos;s open-world semantics, an unconfirmed precondition is unknown, not false.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan satisfied: “ep-plan:satisfied links ep-plan:Activity or ep-plan:Communication to a ep-plan:Constraint. The property indicates that the execution trace element satisfied the constraint.”</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">A precondition holds in the agent&apos;s current phase of orchestration when the execution trace records an invocation that confirms it. Under OWL&apos;s open-world semantics an unconfirmed precondition is unknown, not false.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use with prov:wasGeneratedBy for required inputs to decide whether a skill is ready to execute (competency question 9).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;conflictsWith">
		<rdfs:label xml:lang="en">conflicts with</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;conflict,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/conflict [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Pearson, &quot;conflict,&quot; Longman Dictionary of Contemporary English (online). [Online]. Available: https://www.ldoceonline.com/dictionary/conflict [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Longman Dictionary, &quot;conflict&quot; (verb)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;SoftConstraint"/>
		<skos:definition xml:lang="en">relationship between soft constraints whose preferences cannot both be fully satisfied in the same planning context</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A3, Figure(s) 2. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A preference for minimal latency conflicts with a preference for more extensive evidence retrieval.</skos:example>
		<skos:note xml:lang="en">Longman defines the verb &quot;conflict&quot; as &quot;if two ideas, beliefs, opinions etc conflict, they cannot exist together or both be true&quot;; the relation applies this to soft constraints whose preferences cannot both be fully satisfied.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: soft constraint → soft constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Longman Dictionary sense of &quot;conflict&quot; (verb): &quot;if two ideas, beliefs, opinions etc conflict, they cannot exist together or both be true&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Use only when the preferences actually conflict in the stated context.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Assert between two soft constraints of the same request that pull in opposite directions, such as few tool calls and strong evidence; priorities and the plan evaluation settle the conflict.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;constrains">
		<rdfs:label xml:lang="en">constrains</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;constrain,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/constrain [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">JSON Schema, “Object,” Understanding JSON Schema, sections “Properties” and “Required Properties.” [Online]. Available: https://json-schema.org/understanding-json-schema/reference/object</dct:bibliographicCitation>
		<dct:source xml:lang="en">JSON Schema: Object.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;InputConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;Parameter"/>
		<skos:definition xml:lang="en">relationship linking an input constraint to the parameter whose permitted input values it restricts</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A4, Figure(s) 4. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A positive-number input constraint constrains a dosage parameter.</skos:example>
		<skos:note xml:lang="en">JSON Schema supplies rules for permitted property values.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: input constraint → parameter.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from JSON Schema: Object.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The model represents the validation rule and interface parameter separately.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an input constraint to the parameter whose values it restricts.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;consumes">
		<rdfs:label xml:lang="en">consumes</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, &quot;The P-Plan Ontology,&quot; release of Mar. 12, 2014, revision 1.3. [Online]. Available: http://vocab.linkeddata.es/p-plan/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">P-Plan ontology (Garijo and Gil, 2014), property hasInputVar</dct:source>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<skos:definition xml:lang="en">relation from a task to an information artifact it requires or uses as input</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A5, Figure(s) 1, 3, 5. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An evidence-assessment task consumes a candidate-supplement description.</skos:example>
		<skos:note xml:lang="en">P-Plan relates a planned step to its inputs through hasInputVar (&quot;binds a p-plan:Step to the p-plan:Variable that takes as input for the planned execution&quot;); consumes plays the same role between a task and the information artifact it uses as input.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: task (agento:Task) → information artifact.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from P-Plan hasInputVar, which &quot;binds a p-plan:Step to the p-plan:Variable that takes as input for the planned execution&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">This is a skill/task dependency; runtime usage is recorded with prov:used.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Assert on tasks, not on skills or steps; plan consumes and depends on are inferred from it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;dependsOn">
		<rdfs:label xml:lang="en">depends on</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, &quot;AgentO: An ontology for modeling agentic AI systems,&quot; in The Semantic Web: 23rd European Semantic Web Conference, ESWC 2026, Dubrovnik, Croatia, May 10-14, 2026, Proceedings, Part II (Lecture Notes in Computer Science, vol. 16550), M. Acosta, M. van Erp, S. Rudolph, O. Hartig, B. Spahiu, A. Rula, D. Garijo, and F. Osborne, Eds. Cham, Switzerland: Springer, 2026, pp. 298-320, doi: 10.1007/978-3-032-25159-6_16. Page numbers refer to the 22-page author preprint linked from the ESWC 2026 accepted-papers page (https://drive.google.com/file/d/1WrMSiXR-COZHrAKCEN6nE1M5QUB98gim/view).</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">E. Deelman et al., “Pegasus, a workflow management system for science automation,” Future Generation Computer Systems, vol. 46, pp. 17–35, May 2015, doi: 10.1016/j.future.2014.10.008.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO v0.2 [3]: requiresResource and producedResource; OWL 2 property chains [14]</dct:source>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&agento;Task"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;consumes">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&oe-agtorch;produces"/>
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:altLabel xml:lang="en">data dependency</skos:altLabel>
		<skos:altLabel xml:lang="en">resource dependency</skos:altLabel>
		<skos:definition xml:lang="en">relation from a task to another task that produces an information artifact the first task consumes</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): Claude Fable 5.1 (Anthropic, in Claude Code) - the term, its source passages (local copies of the cited documents), the definitions already in this sheet and the use case were provided; the model drafted a genus-plus-differentia definition and the notes, each quotation was matched mechanically against the source text, and the team member reviewed the result.</skos:editorialNote>
		<skos:example xml:lang="en">Evidence Verification depends on Personalized Supplement Recommendation because it requires the CandidateSupplement that the latter produces.</skos:example>
		<skos:note xml:lang="en">&quot;systematically managing workflows, goals, and resource dependencies&quot; ([A] Ekelhart et al., AgentO, ESWC 2026 (author preprint), section 1, p. 2); &quot;Relates a task to resources needed for its execution&quot; and &quot;Relates a task to resources produced as output&quot; ([B] AgentO ontology v0.2 (Turtle), requiresResource, producedResource).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: task → task.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from [B] AgentO ontology v0.2 (Turtle): requiresResource (&quot;Relates a task to resources needed for its execution&quot;) and producedResource (&quot;Relates a task to resources produced as output&quot;); the paper uses the term without defining it ([A] Ekelhart et al., AgentO, ESWC 2026 (author preprint), pp. 1-2)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">AgentO lists resource dependencies among the things its vocabulary lets practitioners manage but does not define the term; the definition composes AgentO&apos;s two task-to-resource relations. The ontology infers the relation with the property chain consumes o inverse(produces): a task depends on another task when it consumes an information artifact that the other task produces.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert directly: infer it from a requiresResource/producedResource (consumes/produces) pair, then use the inferred set to build the dependency graph (basic flow step 8) and to find steps that can run in parallel (CQ 2, CQ 3).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;evaluates">
		<rdfs:label xml:lang="en">evaluates</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;evaluate,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/evaluate [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">N. Noy and A. Rector, Eds., “Defining N-ary relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
		<dct:source xml:lang="en">W3C n-ary relations pattern.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<skos:definition xml:lang="en">relation from a plan evaluation to the candidate orchestration plan whose metrics and criteria scores it records</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A8, Figure(s) 1, 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">Evaluation A evaluates Candidate Plan A.</skos:example>
		<skos:note xml:lang="en">Noy and Rector (2006) represent a relation with additional attributes by creating “a new class and n new properties to represent an n-ary relation”, so that an instance of the relation “is then an instance of this class”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: plan evaluation → candidate orchestration plan.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Noy and Rector (2006), Defining N-ary Relations on the Semantic Web, Pattern 1 (“Introducing a new class for a relation”): “We create an individual that represents the relation instance itself” and link it to each participant; evaluates is the link from the evaluation record to the plan being evaluated.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">CandidateOrchestrationPlan is included in the model&apos;s OrchestrationPlan hierarchy.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Each plan evaluation evaluates exactly one candidate orchestration plan; the selected plan is inferred from the evaluation ranked first.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;exposes">
		<rdfs:label xml:lang="en">exposes</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, “Tools,” Model Context Protocol Specification, revision 2025-06-18, Server Features. [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools</dct:bibliographicCitation>
		<dct:source xml:lang="en">MCP Tools Specification.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Server"/>
		<rdfs:range rdf:resource="&oe-agtorch;Tool"/>
		<skos:definition xml:lang="en">relationship linking a server to a tool it makes available for discovery or invocation</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A9, Figure(s) 4. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A search server exposes its literature-search tool.</skos:example>
		<skos:note xml:lang="en">MCP servers publish callable tools and their interface descriptions.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: server → tool.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from MCP Tools Specification.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Availability of a tool does not assert that the tool has been invoked.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a server to each tool it makes available; an MCP server exposes at least one MCP tool.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;expresses">
		<rdfs:label xml:lang="en">expresses</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;express,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/express [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Pearson, &quot;express,&quot; Longman Dictionary of Contemporary English (online). [Online]. Available: https://www.ldoceonline.com/dictionary/express [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Longman Dictionary, &quot;express&quot; (verb)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Goal">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;InformationRequirement">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:range>
		<skos:definition xml:lang="en">relationship linking a request to the goal or information requirement communicated in it</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A10, Figure(s) 1, 2. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A request expresses an information requirement about candidate supplements.</skos:example>
		<skos:note xml:lang="en">Longman defines &quot;express&quot; as &quot;to tell or show what you are feeling or thinking by using words, looks, or actions&quot;; the relation links a request to the goal or information requirement it communicates.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → goal or information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Longman Dictionary sense of &quot;express&quot; (verb): &quot;to tell or show what you are feeling or thinking by using words, looks, or actions&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Both endpoint alternatives are preserved from the supplied model.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a request to each information requirement or goal it states; every request expresses at least one information requirement.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;fills">
		<rdfs:label xml:lang="en">fills</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;fill,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/fill [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, “Tools,” Model Context Protocol Specification, revision 2025-06-18, Server Features. [Online]. Available: https://modelcontextprotocol.io/specification/2025-06-18/server/tools</dct:bibliographicCitation>
		<dct:source xml:lang="en">MCP Tools Specification.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;InformationArtifact"/>
		<rdfs:range rdf:resource="&oe-agtorch;Parameter"/>
		<skos:definition xml:lang="en">relation from an information artifact to the parameter for which it supplies a value</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A11, Figure(s) 8. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A search-query artifact fills the search tool&apos;s query parameter.</skos:example>
		<skos:note xml:lang="en">Tool-call arguments provide values for the input interface.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: information artifact → parameter.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from MCP Tools Specification.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Separates an actual input artifact from its formal parameter.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an information artifact to the parameter it supplies a value for, such as a search query that fills the query parameter of a search tool.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasCapability">
		<rdfs:label xml:lang="en">has capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, “AgentO: An ontology for modeling agentic AI systems,” in The Semantic Web: ESWC 2026 (Lecture Notes in Computer Science, vol. 16550). Cham, Switzerland: Springer, 2026, pp. 298–320, doi: 10.1007/978-3-032-25159-6_16. [Online]. Available: https://agentic-patterns.github.io/</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO.</dct:source>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Skill">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Tool">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&agento;Capability"/>
		<skos:definition xml:lang="en">relationship linking a skill or tool to an ability it provides</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A13, Figure(s) 1, 3, 4. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A search tool has an information-access capability.</skos:example>
		<skos:note xml:lang="en">Adapted from AgentO capability modeling.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: skill or tool → capability. Shared by tools and skills in Figures 3 and 4, so the domain is the union skill or tool; a Tool-only domain would classify every skill using this property as a Tool. Figure 4 constrains the property locally on Tool.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology uses a local relation with skill or tool endpoints; no owl:equivalentProperty assertion is implied.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a skill or tool to each capability it provides; the satisfies-requirement and satisfies-hard-constraint chains for skills and tools start from it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasDirection">
		<rdf:type rdf:resource="&owl;FunctionalProperty"/>
		<rdfs:label xml:lang="en">has direction</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">M. Fox and D. Long, &quot;PDDL2.1: An Extension to PDDL for Expressing Temporal Planning Domains,&quot; Journal of Artificial Intelligence Research, vol. 20, pp. 61–124, 2003, doi: 10.1613/jair.1129 (Section 4 &quot;Plan Metrics&quot;; Appendix A.4).</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook. [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Fox and Long (2003), PDDL2.1, Section 4 and Appendix A.4 (metric specification: minimize | maximize)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<rdfs:range>
			<rdfs:Datatype>
				<owl:oneOf>
					<rdf:List>
						<rdf:first>maximize</rdf:first>
						<rdf:rest>
							<rdf:List>
								<rdf:first>minimize</rdf:first>
								<rdf:rest rdf:resource="&rdf;nil"/>
							</rdf:List>
						</rdf:rest>
					</rdf:List>
				</owl:oneOf>
			</rdfs:Datatype>
		</rdfs:range>
		<skos:altLabel xml:lang="en">direction</skos:altLabel>
		<skos:definition xml:lang="en">indicates whether a decision criterion should be minimized or maximized</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!G9, Figure(s) 1, 6 (ref 2). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A latency criterion has direction minimize; an evidence-coverage criterion has direction maximize.</skos:example>
		<skos:note xml:lang="en">PDDL2.1 attaches an optimization direction to a plan metric: &quot;&lt;metric-spec&gt; ::= (:metric &lt;optimization&gt; &lt;ground-f-exp&gt;)&quot; with &quot;&lt;optimization&gt; ::= minimize&quot; or &quot;&lt;optimization&gt; ::= maximize&quot; (Appendix A.4); direction records the same choice for a decision criterion.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: decision criterion → maximize or minimize.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the PDDL2.1 metric specification, &quot;&lt;metric-spec&gt; ::= (:metric &lt;optimization&gt; &lt;ground-f-exp&gt;)&quot; with &quot;&lt;optimization&gt; ::= minimize&quot; or &quot;&lt;optimization&gt; ::= maximize&quot; (Appendix A.4).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Records ordering preference, not the measurement itself.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Set the comparison direction for the criterion before ranking candidate plans.</cmns-av:usageNote>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasHardConstraint">
		<rdfs:subPropertyOf rdf:resource="&oe-agtorch;hasUserConstraint"/>
		<rdfs:label xml:lang="en">has hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Schiendorfer et al., MiniBrass (hard constraints); EP-Plan, property hasConstraint; OWL 2 property chains (OWL 2 Primer, section 6.2)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasPreferenceSetting">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&prov;wasDerivedFrom"/>
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isRequest">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&prov;wasDerivedFrom"/>
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a request to a hard constraint that applies to the request</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s request has the hard constraints safety screening against celecoxib (Jessica) and evidence verification (Jessica), each derived from one of her preference settings.</skos:example>
		<skos:note xml:lang="en">The OWL 2 Primer introduces property chains with hasGrandparent, which connects “all individuals that are linked by a chain of exactly two hasParent properties” (section 6.2). PROV-O defines derivation as “a transformation of one entity into another”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → hard constraint. Subproperty of has user constraint. Inferred by two property chains: from a request to a hard constraint derived from a preference setting of the person the request is attributed to (through has preference setting), or derived from the request itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan hasConstraint (“ep-plan:hasConstraint links ep-plan:Step, ep-plan:CommunicationSpec or ep-plan:Plan to a ep-plan:Constraint”), restricted to hard constraints in the sense of MiniBrass.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by two property chains: has preference setting o inverse(prov:wasDerivedFrom) o is hard constraint (a hard constraint derived from a preference setting of the person who made the request), and is request o inverse(prov:wasDerivedFrom) o is hard constraint (a hard constraint derived from the request itself).</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the mandatory conditions a plan must meet; competency questions 1 and 7 query it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasMeasurement">
		<rdfs:label xml:lang="en">has measurement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;measurement,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/measurement [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">N. Noy and A. Rector, Eds., “Defining N-ary relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
		<dct:source xml:lang="en">W3C n-ary relations pattern.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;PlanMetric"/>
		<skos:definition xml:lang="en">relates a plan evaluation to a metric used in the evaluation</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A14, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">Evaluation A has a latency measurement.</skos:example>
		<skos:note xml:lang="en">Noy and Rector (2006): “We create an individual that represents the relation instance itself”, which then carries the attributes of the relation, as an evaluation record carries its measurements.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: plan evaluation → plan metric.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Noy and Rector (2006), Defining N-ary Relations on the Semantic Web, Pattern 1, applied to “additional attributes describing a relation”: the evaluation record carries the plan metrics as attributes of the evaluation.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The linked object is a PlanMetric, not the DecisionCriterion.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a plan evaluation to each plan metric measured for the plan, such as token cost or tool call count.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasPrecondition">
		<rdfs:label xml:lang="en">has precondition</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004. [Online]. Available: https://www.w3.org/submissions/OWL-S/ [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">D. Martin et al., OWL-S: Semantic Markup for Web Services, W3C Member Submission, 2004, section 5.1 (hasPrecondition). https://www.w3.org/submissions/OWL-S/</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;Precondition"/>
		<skos:definition xml:lang="en">relation from a skill to a precondition that must hold before the skill can be validly applied</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The evidence verification skill has precondition PubMed MCP server is reachable.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: skill → precondition. Tools use OWL-S process:hasPrecondition, whose domain is process:Process. This property serves skills, which are not processes, as in conceptual model Figure 3.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">D. Martin et al., OWL-S: Semantic Markup for Web Services, W3C Member Submission, 2004, section 5.1 (hasPrecondition). https://www.w3.org/submissions/OWL-S/</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasPreferenceSetting">
		<rdfs:label xml:lang="en">has preference setting</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;preference,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/preference [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;setting,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/setting [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">G. Adomavicius and A. Tuzhilin, &quot;Toward the next generation of recommender systems: a survey of the state-of-the-art and possible extensions,&quot; IEEE Transactions on Knowledge and Data Engineering, vol. 17, no. 6, pp. 734–749, 2005, doi: 10.1109/TKDE.2005.99.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Adomavicius and Tuzhilin (2005), user preferences in recommender systems; PROV-O, prov:wasAttributedTo</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range rdf:resource="&oe-agtorch;PreferenceSetting"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isRequest">
			</rdf:Description>
			<rdf:Description rdf:about="&prov;wasAttributedTo">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&prov;wasAttributedTo"/>
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isPreferenceSetting">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a request to a preference setting of the person the request is attributed to</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s request has the preference settings Jessica&apos;s safety screening setting and Jessica&apos;s evidence setting, because all three are attributed to Jessica.</skos:example>
		<skos:note xml:lang="en">Adomavicius and Tuzhilin survey recommender systems, which estimate a user&apos;s preferences for items from the preferences the user has already expressed; PROV-O defines attribution as “the ascribing of an entity to an agent”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → preference setting. Inferred by a property chain: request, prov:wasAttributedTo, person, inverse of prov:wasAttributedTo, preference setting. The is request and is preference setting markers keep the chain from starting at a preference setting or ending at a request or another entity attributed to the same person.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from PROV-O prov:wasAttributedTo (“Attribution is the ascribing of an entity to an agent.”): the request and the preference setting are attributed to the same person.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain is request o prov:wasAttributedTo o inverse(prov:wasAttributedTo) o is preference setting. The markers is request and is preference setting keep the chain from starting at a preference setting or ending at another entity attributed to the same person.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to retrieve the stored settings that apply to a request before its constraints are derived (competency question 1).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasPriority">
		<rdfs:label xml:lang="en">has priority</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">ISO/PAS 8235:2024, Road vehicles — Ergonomic aspects of human vehicle interactions — Taxonomy for the classification of adaptive interactive vehicle systems, 1st ed. Geneva, Switzerland: International Organization for Standardization, 2024. [Online]. Available: https://www.iso.org/standard/83080.html</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook. [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">ISO/PAS 8235:2024(en): Road vehicles — Ergonomic aspects of human vehicle interactions — Taxonomy for the classification of adaptive interactive vehicle systems</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&xsd;integer"/>
		<skos:altLabel xml:lang="en">priority</skos:altLabel>
		<skos:definition xml:lang="en">relative importance of two or more soft constraints, which determines the selection of an orchestration plan</skos:definition>
		<skos:example xml:lang="en">Ken&apos;s soft constraints minimize token usage (Ken) and minimize external tool calls (Ken) each have priority 1.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: soft constraint → xsd:integer.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from ISO/PAS 8235:2024</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasRank">
		<rdf:type rdf:resource="&owl;FunctionalProperty"/>
		<rdfs:label xml:lang="en">has rank</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;rank,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/rank [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">N. Noy and A. Rector, Eds., “Defining N-ary relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">National Cancer Institute, &quot;NCI Thesaurus,&quot; concepts Rank (C48904) and Score (C25338). [Online]. Available: https://ncit.nci.nih.gov/ (looked up in the EMBL-EBI Ontology Lookup Service, https://www.ebi.ac.uk/ols4/) [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NCI Thesaurus, Rank (C48904); Noy and Rector (2006), n-ary relation pattern for the evaluation record</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&xsd;integer"/>
		<skos:definition xml:lang="en">ranking position assigned to a plan evaluation</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The evaluation of Ken plan 1 has rank 1 and the evaluation of Ken plan 2 has rank 2, so Ken plan 1 is inferred to be the selected plan.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: plan evaluation → xsd:integer.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Cambridge Dictionary sense of “rank”: “a particular position in a list that shows how important, good, profitable, etc. something is compared to other things of the same type”, and NCI Thesaurus Rank (C48904): “A relative status as compared to others within a group.”</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasResource">
		<rdfs:label xml:lang="en">has resource</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Anthropic, &quot;Agent Skills,&quot; Claude Developer Platform documentation. [Online]. Available: https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">X. Li, Y. Liu, W. Chen, B. You, Z. Di, et al., &quot;SkillsBench: Benchmarking How Well Agent Skills Work Across Diverse Tasks,&quot; arXiv:2602.12670v4, Jun. 2026, Section 2 (Skill Definition) and Table 1. [Online]. Available: https://arxiv.org/abs/2602.12670</dct:bibliographicCitation>
		<dct:source xml:lang="en">Li et al. (2026), SkillsBench, Section 2 (Skill Definition) and Table 1; Anthropic, Agent Skills documentation (bundled resources)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;SkillResource"/>
		<skos:definition xml:lang="en">relation from a skill to a skill resource included in its reusable specification or package</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A17, Figure(s) 3. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A skill has an instructions resource and an executable script.</skos:example>
		<skos:note xml:lang="en">SkillsBench describes skills as &quot;structured packages of instructions, code templates, resources, and reference material&quot; that &quot;may optionally include auxiliary resources such as scripts, templates, reference files, or worked examples&quot;; Anthropic&apos;s Agent Skills documentation likewise says &quot;Each Skill packages instructions, metadata, and optional resources (scripts, templates)&quot;.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: skill → skill resource.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from SkillsBench, Section 2, where a skill &quot;may optionally include auxiliary resources such as scripts, templates, reference files, or worked examples&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The model groups Instructions, ReferenceMaterial, Script, and Template as skill resources.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a skill to each instruction, reference material, script or template packaged with it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasScore">
		<rdfs:label xml:lang="en">has score</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;score,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/score [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">National Cancer Institute, &quot;NCI Thesaurus,&quot; concepts Rank (C48904) and Score (C25338). [Online]. Available: https://ncit.nci.nih.gov/ (looked up in the EMBL-EBI Ontology Lookup Service, https://www.ebi.ac.uk/ols4/) [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NCI Thesaurus, Score (C25338)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:definition xml:lang="en">numerical evaluation score assigned to a plan evaluation</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The evaluation of plan B (Olivia) has score 1.70 and the evaluation of plan A (Olivia) has score 1.00.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: plan evaluation → xsd:decimal.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from NCI Thesaurus Score (C25338): “A number or range of numeric values measuring performance, function, quality, or ability.”</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasSoftConstraint">
		<rdfs:subPropertyOf rdf:resource="&oe-agtorch;hasUserConstraint"/>
		<rdfs:label xml:lang="en">has soft constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Schiendorfer et al., MiniBrass (soft constraints); EP-Plan, property hasConstraint; OWL 2 property chains (OWL 2 Primer, section 6.2)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range rdf:resource="&oe-agtorch;SoftConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasPreferenceSetting">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&prov;wasDerivedFrom"/>
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isSoftConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isRequest">
			</rdf:Description>
			<rdf:Description>
				<owl:inverseOf rdf:resource="&prov;wasDerivedFrom"/>
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isSoftConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a request to a soft constraint that applies to the request</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Ken&apos;s request has the soft constraints minimize external tool calls (Ken) and minimize token usage (Ken), derived from Ken&apos;s execution settings; Olivia&apos;s request has few external tool calls (Olivia) and strong scientific evidence (Olivia), derived from the request itself.</skos:example>
		<skos:note xml:lang="en">The OWL 2 Primer introduces property chains with hasGrandparent, which connects “all individuals that are linked by a chain of exactly two hasParent properties” (section 6.2). PROV-O defines derivation as “a transformation of one entity into another”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → soft constraint. Subproperty of has user constraint. Inferred by two property chains: from a request to a soft constraint derived from a preference setting of the person the request is attributed to (through has preference setting), or derived from the request itself.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan hasConstraint (“ep-plan:hasConstraint links ep-plan:Step, ep-plan:CommunicationSpec or ep-plan:Plan to a ep-plan:Constraint”), restricted to soft constraints in the sense of MiniBrass.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by two property chains: has preference setting o inverse(prov:wasDerivedFrom) o is soft constraint (a soft constraint derived from a preference setting of the person who made the request), and is request o inverse(prov:wasDerivedFrom) o is soft constraint (a soft constraint derived from the request itself).</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the preferences used to rank the acceptable plans; competency question 7 queries it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasStep">
		<rdfs:label xml:lang="en">has step</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Ekelhart, K. Kurniawan, F. J. Ekaputra, and E. Kiesling, “AgentO: An ontology for modeling agentic AI systems,” in The Semantic Web: ESWC 2026 (Lecture Notes in Computer Science, vol. 16550). Cham, Switzerland: Springer, 2026, pp. 298–320, doi: 10.1007/978-3-032-25159-6_16. [Online]. Available: https://agentic-patterns.github.io/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term hasWorkflowStep</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<skos:altLabel xml:lang="en">has workflow step</skos:altLabel>
		<skos:definition xml:lang="en">relationship connecting an orchestration plan with one of its constituent steps</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A19, Figure(s) 1, 5. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An orchestration plan has an evidence-retrieval workflow step.</skos:example>
		<skos:note xml:lang="en">AgentO represents workflow membership through this relation.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → orchestration workflow step.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO ontology v0.2 (K. Kurniawan, Zenodo, doi:10.5281/zenodo.18342625; A. Ekelhart et al., ESWC 2026), term hasWorkflowStep.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology applies the relation to orchestration plans and orchestration workflow steps.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an orchestration plan to each of its orchestration workflow steps; has task is inferred through it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasStepPosition">
		<rdf:type rdf:resource="&owl;FunctionalProperty"/>
		<rdfs:label xml:lang="en">has step position</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, “The P-Plan ontology,” version 1.3, Mar. 12, 2014. [Online]. Available: http://purl.org/net/p-plan</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Schema.org, “HowToStep,” Schema.org vocabulary. [Online]. Available: https://schema.org/HowToStep [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Schema.org, “position,” Schema.org vocabulary. [Online]. Available: https://schema.org/position [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Schema.org, property position; AgentO v0.2, property nextStep (execution order of workflow steps)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<rdfs:range rdf:resource="&xsd;positiveInteger"/>
		<skos:definition xml:lang="en">position of a workflow step in the execution order of its orchestration plan, starting at 1 for the steps that run first</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 11, added to the ontology with the step-position change. Label, definition, domain, range and notes match the Assignment 11 ontology; the definition adapts the Schema.org position definition to workflow steps, and steps that run in parallel share a position.</skos:editorialNote>
		<skos:example xml:lang="en">In Jessica&apos;s orchestration plan, step 1 (get candidate supplements) has step position 1; steps 2, 3 and 4 (screen interactions, verify evidence, get supplement products) run in parallel and all have step position 2; step 5 (select supplement product) has 3 and step 6 (produce recommendation) has 4.</skos:example>
		<skos:note xml:lang="en">Schema.org uses position for the position of an item in a series or sequence of items, such as a list item or a HowToStep (a step in instructions that form an ordered list); AgentO orders workflow steps only pairwise, with nextStep.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration workflow step → xsd:positiveInteger (functional). Steps that may run at the same time share a position, and a step has a higher position than every step it follows through AgentO next step. AgentO next step records the order step by step but branches where steps run in parallel; the position gives each step one number, so competency question queries can list a plan&apos;s steps in execution order (ORDER BY) instead of by label.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Schema.org, property position: “The position of an item in a series or sequence of items.”</cmns-av:adaptedFrom>
		<cmns-av:usageNote xml:lang="en">Give every orchestration workflow step of a plan a position, and sort query results by it instead of by step labels, which carry no machine-readable order.</cmns-av:usageNote>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasTask">
		<rdfs:label xml:lang="en">has task</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">J. Bao, E. F. Kendall, D. L. McGuinness, and P. F. Patel-Schneider, Eds., “OWL 2 Web Ontology Language quick reference guide (second edition),” W3C Recommendation, Dec. 11, 2012. [Online]. Available: https://www.w3.org/TR/owl2-quick-reference/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">[AgentO] hasWorkflowStep and hasAssociatedTask</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&agento;Task"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasStep">
			</rdf:Description>
			<rdf:Description rdf:about="&agento;hasAssociatedTask">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to a task that is associated with one of the plan’s workflow steps</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): Claude Opus 5.5 (Anthropic, in Claude Code): given the term, the cited source text and the use case, drafted a genus-plus-differentia definition; each quoted source definition was checked against the source file.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan has task verify evidence (Jessica), inferred from its step 3.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → task.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">AgentO v0.2 hasWorkflowStep (“Specifies a step that is part of a workflow pattern.”) composed with hasAssociatedTask (“Links a workflow step to the task it corresponds to.”)</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain has step o agento:hasAssociatedTask.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasType">
		<rdfs:label xml:lang="en">has type</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Martin et al., “OWL-S: Semantic markup for web services,” W3C Member Submission, Nov. 22, 2004, sec. 5.1. [Online]. Available: https://www.w3.org/submissions/OWL-S/</dct:bibliographicCitation>
		<dct:source xml:lang="en">OWL-S.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Parameter"/>
		<rdfs:range rdf:resource="&oe-agtorch;ParameterType"/>
		<skos:definition xml:lang="en">relationship linking a parameter to the class or datatype that specifies its permitted values</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A18, Figure(s) 4. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A query parameter has the string parameter type.</skos:example>
		<skos:note xml:lang="en">Adapted from the OWL-S parameterType concept.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: parameter → parameter type.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from OWL-S.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The ontology uses a local object relation to parameter type; it is not declared equivalent to process:parameterType.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a parameter to the class or datatype its values must belong to.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasUnit">
		<rdfs:label xml:lang="en">has unit</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;unit,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/unit [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Dumontier et al., “The Semanticscience Integrated Ontology (SIO) for biomedical research and knowledge discovery,” Journal of Biomedical Semantics, vol. 5, no. 1, Art. no. 14, 2014, doi: 10.1186/2041-1480-5-14.</dct:bibliographicCitation>
		<dct:source xml:lang="en">SIO, has unit (SIO_000221)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition xml:lang="en">unit of measurement associated with a plan metric</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The tool call count of Ken plan 1 has unit “external tool calls”; its token cost has unit “US dollars”.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: plan metric → xsd:string.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from SIO has unit (SIO_000221): “has unit is a relation between a quantity and the unit it is a multiple of.”, and the Cambridge Dictionary sense of “unit”: “a standard measure that is used to express amounts”.</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;hasUserConstraint">
		<rdfs:label xml:lang="en">has user constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">R. Iannella and S. Villata, “ODRL Information Model 2.2,” W3C Recommendation, Feb. 15, 2018, section 2.5. [Online]. Available: https://www.w3.org/TR/odrl-model/</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan (Markovic et al., 2019), property hasConstraint; ODRL Information Model 2.2, section 2.5</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range rdf:resource="&oe-agtorch;UserConstraint"/>
		<skos:definition xml:lang="en">relation from a request to a user constraint that applies to the request</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Ken&apos;s request has the user constraints evidence verification (Ken), minimize external tool calls (Ken) and minimize token usage (Ken).</skos:example>
		<skos:note xml:lang="en">EP-Plan attaches constraints to plans and steps through hasConstraint and does “not stipulate that this constriant [sic] must be strictly satisfied before the plan can continue”; ODRL 2.2 interprets several constraints on the same rule “as conjunction and all MUST be satisfied” (section 2.5).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → user constraint. Super-property of has hard constraint and has soft constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan hasConstraint: “ep-plan:hasConstraint links ep-plan:Step, ep-plan:CommunicationSpec or ep-plan:Plan to a ep-plan:Constraint.” Here the constrained element is the user&apos;s request.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">No value is asserted directly: its values come from its two subproperties, which the reasoner infers through property chains, so a query on it returns every constraint of a request, hard or soft.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to list all constraints that govern a request; use has hard constraint or has soft constraint to separate requirements from preferences.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasValue">
		<rdfs:label xml:lang="en">has value</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">M. Dumontier et al., “The Semanticscience Integrated Ontology (SIO) for biomedical research and knowledge discovery,” Journal of Biomedical Semantics, vol. 5, no. 1, Art. no. 14, 2014, doi: 10.1186/2041-1480-5-14.</dct:bibliographicCitation>
		<dct:source xml:lang="en">SIO, has value (SIO_000300)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanMetric"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:definition xml:lang="en">numerical value of a plan metric</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">The token cost of Ken plan 1 has value 0.02 (US dollars); its tool call count has value 4.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: plan metric → xsd:decimal.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from SIO has value (SIO_000300): “A relation between a informational entity and its actual value (numeric, date, text, etc).”</cmns-av:adaptedFrom>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;hasWeight">
		<rdfs:label xml:lang="en">has weight</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook (online edition). [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">NASA Systems Engineering Handbook, 6.8 Decision Analysis (criteria weights)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<rdfs:range rdf:resource="&xsd;decimal"/>
		<skos:altLabel xml:lang="en">weight</skos:altLabel>
		<skos:definition xml:lang="en">relative importance assigned to a decision criterion</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!G9, Figure(s) 1, 6 (ref 2). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">Two criteria are assigned weights under the selected scoring method.</skos:example>
		<skos:note xml:lang="en">NASA&apos;s decision analysis uses &quot;weighted trade-off matrices&quot; and advises that when results are revisited &quot;the decision criteria should be reevaluated, not only the weights&quot;; weight is the relative importance given to one criterion.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: decision criterion → xsd:decimal.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from NASA Systems Engineering Handbook, 6.8 Decision Analysis, which weights decision criteria in &quot;weighted trade-off matrices&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Weight is a criterion attribute, not a separate plan metric.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Record the weighting convention used by the evaluation; do not assume that all weights sum to one.</cmns-av:usageNote>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;invokes">
		<rdfs:label xml:lang="en">invokes</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Tools,&quot; Model Context Protocol Specification, revision 2026-07-28, Server Features. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools</dct:bibliographicCitation>
		<dct:source xml:lang="en">Model Context Protocol Specification, rev. 2026-07-28, Server Features &gt; Tools (tool invocation, tools/call)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Invocation"/>
		<rdfs:range>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-agtorch;Skill">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Tool">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:range>
		<skos:definition xml:lang="en">links an invocation to the tool or skill specification executed by that occurrence</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A20, Figure(s) 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A tool invocation invokes the literature-search tool.</skos:example>
		<skos:note xml:lang="en">The MCP specification states that servers &quot;expose tools that can be invoked by language models&quot; and that &quot;To invoke a tool, clients send a tools/call request&quot;; invokes links one such invocation to the tool or skill it executes.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: invocation → skill or tool (skill invocation → skill; tool invocation → tool).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the MCP specification: &quot;To invoke a tool, clients send a tools/call request&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Pair ToolInvocation with Tool, and SkillInvocation with Skill, as drawn.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a skill invocation to the skill, and a tool invocation to the tool, that it executed.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isHardConstraint">
		<rdfs:label xml:lang="en">is hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;HardConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<skos:definition xml:lang="en">marker relation from a hard constraint to itself, used to restrict a property chain to hard constraints</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Hard Constraint (row 58).</skos:editorialNote>
		<skos:example xml:lang="en">Safety screening against celecoxib (Jessica) is hard constraint itself (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: hard constraint → the same hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Hard constraint is equivalent to (is hard constraint Self). The marker ends the property chains of has hard constraint, step satisfies hard constraint, skill satisfies hard constraint and tool satisfies hard constraint, so these reach only hard constraints.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isMeasuredBy">
		<rdfs:label xml:lang="en">is measured by</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;measure,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/measure [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook (online edition). [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Pearson, &quot;measure,&quot; Longman Dictionary of Contemporary English (online). [Online]. Available: https://www.ldoceonline.com/dictionary/measure [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Longman Dictionary, &quot;measure&quot; (verb); NASA Systems Engineering Handbook, 6.8 Decision Analysis (decision criteria and weights)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<skos:definition xml:lang="en">relates a soft constraint to a decision criterion used to measure it</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A21, Figure(s) 2, 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A preference for fewer calls is measured by a tool-call-count criterion.</skos:example>
		<skos:note xml:lang="en">Longman defines &quot;measure&quot; as &quot;to judge the importance, value, or true nature of something&quot;; NASA&apos;s decision analysis judges alternatives against decision criteria and their weights, and the relation names the criterion that measures a soft constraint.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: soft constraint → decision criterion.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Longman Dictionary sense of &quot;measure&quot; (verb), &quot;to judge the importance, value, or true nature of something&quot;, applied to a decision criterion.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Despite its label, the target is DecisionCriterion in the supplied model, not PlanMetric.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link each soft constraint to the decision criterion that measures it, so the plan evaluation can score how well a plan meets the constraint.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isPartOf">
		<rdfs:label xml:lang="en">is part of</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;part,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/part [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">DCMI Usage Board, &quot;DCMI Metadata Terms,&quot; Dublin Core Metadata Initiative, Jan. 20, 2020, term isPartOf (http://purl.org/dc/terms/isPartOf). [Online]. Available: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/isPartOf/</dct:bibliographicCitation>
		<dct:source xml:lang="en">DCMI Metadata Terms, isPartOf</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;ToolInvocation"/>
		<rdfs:range rdf:resource="&oe-agtorch;SkillInvocation"/>
		<skos:definition xml:lang="en">links a tool invocation to the skill invocation that made that tool call</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A22, Figure(s) 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A literature-search tool invocation is part of a recommendation skill invocation.</skos:example>
		<skos:note xml:lang="en">DCMI defines Is Part Of as &quot;A related resource in which the described resource is physically or logically included&quot;; here a tool invocation is part of the skill invocation that made the call.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: tool invocation → skill invocation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from DCMI isPartOf: &quot;A related resource in which the described resource is physically or logically included&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Captures runtime containment between invocation occurrences.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a tool invocation to the skill invocation that made the tool call.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isPreferenceSetting">
		<rdfs:label xml:lang="en">is preference setting</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;preference,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/preference [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;setting,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/setting [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PreferenceSetting"/>
		<rdfs:range rdf:resource="&oe-agtorch;PreferenceSetting"/>
		<skos:definition xml:lang="en">marker relation from a preference setting to itself, used to restrict a property chain to preference settings</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Preference Setting (row 63).</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s safety screening setting is preference setting Jessica&apos;s safety screening setting (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: preference setting → the same preference setting.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Preference setting is equivalent to (is preference setting Self). The marker ends the property chain of has preference setting, so the chain reaches only preference settings, not other entities attributed to the same person.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isRequest">
		<rdfs:label xml:lang="en">is request</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;request,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/request [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Request"/>
		<rdfs:range rdf:resource="&oe-agtorch;Request"/>
		<skos:definition xml:lang="en">marker relation from a request to itself, used to restrict a property chain to requests</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Request (row 42).</skos:editorialNote>
		<skos:example xml:lang="en">Ken&apos;s request is request Ken&apos;s request (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: request → the same request.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Request is equivalent to (is request Self), so the reasoner links every request to itself. The marker starts the property chains of has preference setting, has hard constraint and has soft constraint, which therefore start only at requests.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-agtorch;isRequired">
		<rdfs:label xml:lang="en">is required</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Wright, H. Andrews, and B. Hutton, Eds., “JSON Schema Validation: A vocabulary for structural validation of JSON,” Internet-Draft draft-bhutton-json-schema-validation-01 (JSON Schema draft 2020-12), Jun. 16, 2022, section 6. [Online]. Available: https://json-schema.org/draft/2020-12/json-schema-validation [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">JSON Schema, “Object,” Understanding JSON Schema, sections “Properties” and “Required Properties.” [Online]. Available: https://json-schema.org/understanding-json-schema/reference/object</dct:bibliographicCitation>
		<dct:source xml:lang="en">JSON Schema Validation (draft 2020-12), Section 6.5.3, keyword &quot;required&quot;</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Parameter"/>
		<rdfs:range rdf:resource="&xsd;boolean"/>
		<skos:definition xml:lang="en">boolean attribute of a parameter indicating whether an input must be supplied for invocation</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Classes!G31 and G45, Figure(s) 8 (parameter referenced from 4). AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An input filling a parameter with isRequired = true is a RequiredInput.</skos:example>
		<skos:note xml:lang="en">JSON Schema distinguishes required properties from optional ones.</skos:note>
		<skos:scopeNote xml:lang="en">true marks a required parameter and false an optional one; an absent assertion means unknown. This metadata does not perform runtime validation under OWL&apos;s open-world semantics.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from JSON Schema: Object.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">is required is a local attribute, not the literal JSON Schema keyword required.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Classify an input through the parameter it fills, preserving the true/false distinction.</cmns-av:usageNote>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isSkill">
		<rdfs:label xml:lang="en">is skill</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">A2A Project, &quot;Agent2Agent (A2A) Protocol Specification,&quot; version 1.0.0, section 4.4.5 (AgentSkill). [Online]. Available: https://a2a-protocol.org/latest/specification/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;Skill"/>
		<skos:definition xml:lang="en">marker relation from a skill to itself, used to restrict a property chain to skills</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Skill (row 8).</skos:editorialNote>
		<skos:example xml:lang="en">The product selection skill is skill itself (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: skill → the same skill.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Skill is equivalent to (is skill Self). The marker starts the property chains of skill satisfies requirement and skill satisfies hard constraint, so they start only at skills (the domain of has capability is skill or tool).</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isSoftConstraint">
		<rdfs:label xml:lang="en">is soft constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;SoftConstraint"/>
		<rdfs:range rdf:resource="&oe-agtorch;SoftConstraint"/>
		<skos:definition xml:lang="en">marker relation from a soft constraint to itself, used to restrict a property chain to soft constraints</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Soft Constraint (row 69).</skos:editorialNote>
		<skos:example xml:lang="en">Minimize token usage (Ken) is soft constraint itself (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: soft constraint → the same soft constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Soft constraint is equivalent to (is soft constraint Self). The marker ends the property chains of has soft constraint, so they reach only soft constraints.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;isTool">
		<rdfs:label xml:lang="en">is tool</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Krisnadhi, F. Maier, and P. Hitzler, &quot;OWL and Rules,&quot; in Reasoning Web. Semantic Technologies for the Web of Data: 7th International Summer School 2011, Galway, Ireland, Tutorial Lectures (Lecture Notes in Computer Science, vol. 6848). Berlin, Germany: Springer, 2011, pp. 382–415.</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, &quot;OWL and Rules,&quot; tutorial slides, Reasoning Web 2011, Galway, Ireland, Sept. 2011, slides 21–23 (&quot;Rolification&quot;). [Online]. Available: https://www.semantic-web-book.org/w/images/1/10/OWLRules-RW2011.pdf [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">Krisnadhi, Maier and Hitzler (2011), OWL and Rules (rolification of a class); OWL 2 Primer, sections 5.2 (self restriction) and 6.2 (property chains)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Tool"/>
		<rdfs:range rdf:resource="&oe-agtorch;Tool"/>
		<skos:definition xml:lang="en">marker relation from a tool to itself, used to restrict a property chain to tools</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10. Added together with the equivalence axiom on Tool (row 7).</skos:editorialNote>
		<skos:example xml:lang="en">The iHerb product search tool is tool itself (inferred).</skos:example>
		<skos:note xml:lang="en">Hitzler&apos;s Reasoning Web 2011 tutorial gives the rolification of a concept A as A ≡ ∃R_A.Self (slides 21–23, following Krisnadhi, Maier and Hitzler, 2011); the OWL 2 Primer shows the self restriction with the idea that “all narcissists love themselves” (section 5.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: tool → the same tool.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the OWL 2 Primer, section 5.2: “As a special case of individuals being interlinked by properties, an individual might be linked to itself”; the class is rolified as in Krisnadhi, Maier and Hitzler (2011).</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Tool is equivalent to (is tool Self). The marker starts the property chains of tool satisfies requirement and tool satisfies hard constraint, so they start only at tools.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Do not assert it: the reasoner infers it from the class axiom. It is not meant to be queried directly.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;performedBySkill">
		<rdfs:label xml:lang="en">performed by skill</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:source xml:lang="en">[AgentO] performedBy, performedByAgent</dct:source>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;Skill"/>
		<skos:definition xml:lang="en">relation from a task to the skill that carries it out</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): Claude Opus 5.5 (Anthropic, in Claude Code): given the term, the cited source text and the use case, drafted a genus-plus-differentia definition; each quoted source definition was checked against the source file.</skos:editorialNote>
		<skos:example xml:lang="en">The task verify evidence (Jessica) is performed by skill evidence verification skill.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: task → skill.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">AgentO v0.2 performedBy (“Indicates the tool/agent that performs the task in a step.”); named after performedByAgent</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Not a subproperty of agento:performedBy, whose range Tool would make every Skill a Tool.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;planConsumes">
		<rdfs:label xml:lang="en">plan consumes</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;consume,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/consume [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, &quot;The P-Plan Ontology,&quot; release of Mar. 12, 2014, revision 1.3. [Online]. Available: http://vocab.linkeddata.es/p-plan/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">P-Plan ontology 1.3, property hasInputVar; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasTask">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;consumes">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to an information artifact that a task of the plan consumes</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan consumes candidate supplements (Jessica), Jessica&apos;s search query, safety assessment (Jessica), evidence assessment (Jessica), product list (Jessica) and selected products (Jessica).</skos:example>
		<skos:note xml:lang="en">P-Plan relates a planned step to its inputs through hasInputVar and to its outputs through hasOutputVar.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → information artifact.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from P-Plan hasInputVar, which “binds a p-plan:Step to the p-plan:Variable that takes as input for the planned execution”, lifted from a task to the plan that has the task.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain has task o consumes.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Compare with plan produces: competency question 1 keeps a plan only if every artifact the plan consumes is also produced by one of its tasks.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;planProduces">
		<rdfs:label xml:lang="en">plan produces</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;produce,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/produce [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, &quot;The P-Plan Ontology,&quot; release of Mar. 12, 2014, revision 1.3. [Online]. Available: http://vocab.linkeddata.es/p-plan/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">P-Plan ontology 1.3, property hasOutputVar; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasTask">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;produces">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to an information artifact that a task of the plan produces</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan produces candidate supplements (Jessica), safety assessment (Jessica), evidence assessment (Jessica), product list (Jessica), selected products (Jessica) and recommendation for Jessica.</skos:example>
		<skos:note xml:lang="en">P-Plan relates a planned step to its inputs through hasInputVar and to its outputs through hasOutputVar.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → information artifact.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from P-Plan hasOutputVar, which “binds a p-plan:Step to the p-plan:Variable that will be produced as output in the planned execution”, lifted from a task to the plan that has the task.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain has task o produces.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Compare with plan consumes: competency question 1 keeps a plan only if every artifact the plan consumes is also produced by one of its tasks.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;planSatisfiesHardConstraint">
		<rdfs:label xml:lang="en">plan satisfies hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan, property satisfied; Schiendorfer et al., MiniBrass (hard constraints); OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasStep">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;stepSatisfiesHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to a hard constraint satisfied by one of its steps</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan satisfies the hard constraint safety screening against celecoxib (Jessica) through step 2.</skos:example>
		<skos:note xml:lang="en">EP-Plan attaches constraints to a plan or its steps (hasConstraint) and records which trace elements satisfied them (satisfied).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan satisfied (“The property indicates that the execution trace element satisfied the constraint.”), lifted from a step to the plan that has the step.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain has step o step satisfies hard constraint. Unlike satisfies constraint, which is asserted for plans in the individuals file, this property is inferred.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to keep only the candidate plans that satisfy every hard constraint of the request (competency question 1).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;planSatisfiesRequirement">
		<rdfs:label xml:lang="en">plan satisfies requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core, satisfiesRequirement; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;hasStep">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;stepSatisfiesRequirement">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from an orchestration plan to an information requirement satisfied by one of its steps</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan satisfies the requirement supporting scientific evidence (Jessica) through step 3.</skos:example>
		<skos:note xml:lang="en">IOF Core defines satisfies requirement as a “relation from an entity to a requirement specification that the entity conforms to”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration plan → information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement (“relation from an entity to a requirement specification that the entity conforms to”), lifted from a step to the plan that has the step.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain has step o step satisfies requirement.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to keep only the candidate plans that satisfy every information requirement the request expresses (competency question 1).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;produces">
		<rdfs:label xml:lang="en">produces</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">D. Garijo and Y. Gil, &quot;The P-Plan Ontology,&quot; release of Mar. 12, 2014, revision 1.3. [Online]. Available: http://vocab.linkeddata.es/p-plan/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Model Context Protocol, &quot;Specification,&quot; revision 2026-07-28, Server Features: Tools. [Online]. Available: https://modelcontextprotocol.io/specification/2026-07-28/server/tools [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">P-Plan ontology (Garijo and Gil, 2014), property hasOutputVar</dct:source>
		<rdfs:domain rdf:resource="&agento;Task"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationArtifact"/>
		<skos:definition xml:lang="en">relation from a task to an information artifact it yields as output</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A25, Figure(s) 1, 3, 5. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An evidence-assessment task produces an evidence-assessment artifact.</skos:example>
		<skos:note xml:lang="en">P-Plan relates a planned step to its outputs through hasOutputVar (&quot;binds a p-plan:Step to the p-plan:Variable that will be produced as output in the planned execution&quot;); produces plays the same role between a task and the information artifact it yields.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: task (agento:Task) → information artifact.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from P-Plan hasOutputVar, which &quot;binds a p-plan:Step to the p-plan:Variable that will be produced as output in the planned execution&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Plan-level production is distinct from runtime generation recorded with prov:wasGeneratedBy.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Assert on tasks, not on skills or steps; plan produces and depends on are inferred from it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;records">
		<rdfs:label xml:lang="en">records</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">OpenTelemetry, &quot;Traces,&quot; OpenTelemetry documentation, Concepts &gt; Signals. [Online]. Available: https://opentelemetry.io/docs/concepts/signals/traces/ [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">OpenTelemetry documentation, Traces (traces and spans)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;ExecutionTrace"/>
		<rdfs:range rdf:resource="&oe-agtorch;Invocation"/>
		<skos:definition xml:lang="en">links an execution trace to an invocation included in its record</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A26, Figure(s) 7. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">The execution trace records the literature-search invocation.</skos:example>
		<skos:note xml:lang="en">OpenTelemetry describes a trace as &quot;The path of a request through your application&quot; composed of spans, where &quot;A span represents a unit of work or operation&quot;; records links an execution trace to an invocation it contains in the same way.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: execution trace → invocation.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from OpenTelemetry: a trace is &quot;The path of a request through your application&quot; made of spans, each of which &quot;represents a unit of work or operation&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">The trace is the record; the invocation is the recorded occurrence.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link an execution trace to each invocation it records.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;satisfiesConstraint">
		<rdfs:label xml:lang="en">satisfies constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">R. Iannella and S. Villata, “ODRL Information Model 2.2,” W3C Recommendation, Feb. 15, 2018, section 2.5. [Online]. Available: https://www.w3.org/TR/odrl-model/</dct:bibliographicCitation>
		<dct:source xml:lang="en">ODRL Information Model 2.2, section 2.5 (constraints that must be satisfied); EP-Plan (Markovic et al., 2019), property satisfied</dct:source>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;Capability">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;OrchestrationPlan">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&agento;Constraint"/>
		<skos:definition xml:lang="en">relation from an orchestration plan or a capability to a constraint that it satisfies</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting (moved from Definition Source in Assignment 10): The definition was written for this ontology and adapted from the source named in Definition Adapted from Source; generative AI use is described in the Assignment 6 report.</skos:editorialNote>
		<skos:example xml:lang="en">Jessica&apos;s orchestration plan satisfies constraint safety screening against celecoxib (Jessica); the interaction screening capability satisfies the same constraint.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: capability or orchestration plan → constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from ODRL 2.2, section 2.5, where several constraints on the same rule “are interpreted as conjunction and all MUST be satisfied”, and the Cambridge Dictionary sense of “satisfy”: “to have or provide something that is needed or wanted”.</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;satisfiesRequirement">
		<rdfs:label xml:lang="en">satisfies requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; Release 202603, object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core Ontology, Release 202603, object property satisfiesRequirement</dct:source>
		<rdfs:domain rdf:resource="&agento;Capability"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<skos:definition xml:lang="en">relation from a capability to an information requirement that the capability meets</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A28, Figure(s) 1, 3, 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">An information-access capability satisfies a retrieval information requirement.</skos:example>
		<skos:note xml:lang="en">IOF Core defines satisfies requirement as &quot;relation from an entity to a requirement specification that the entity conforms to&quot;; satisfies generalizes this to a capability or plan meeting a requirement or constraint.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: capability → information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement: &quot;relation from an entity to a requirement specification that the entity conforms to&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Use the endpoint pairs listed in the model. Capability relates to HardConstraint or InformationRequirement; plans relate to Constraint.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Assert from capabilities; the skill, tool, step and plan versions of this relation are inferred through property chains.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;skillSatisfiesHardConstraint">
		<rdfs:label xml:lang="en">skill satisfies hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan, property satisfied; Schiendorfer et al., MiniBrass (hard constraints); AgentO v0.2, hasCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isSkill">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;hasCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesConstraint">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a skill to a hard constraint that a capability of the skill satisfies</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">The supplement safety screening skill satisfies the hard constraint safety screening against celecoxib (Jessica) through the interaction screening capability.</skos:example>
		<skos:note xml:lang="en">EP-Plan records whether an execution trace element satisfied a plan constraint with ep-plan:satisfied.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: skill → hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan satisfied (“The property indicates that the execution trace element satisfied the constraint.”), applied to a skill through the capabilities it has.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain is skill o has capability o satisfies constraint o is hard constraint.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the skills that can meet a mandatory condition of a request.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;skillSatisfiesRequirement">
		<rdfs:label xml:lang="en">skill satisfies requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core, satisfiesRequirement; AgentO v0.2, hasCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Skill"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isSkill">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;hasCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesRequirement">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a skill to an information requirement that a capability of the skill satisfies</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">The product selection skill satisfies the requirement purchasable supplement products (Jessica) through the product search capability.</skos:example>
		<skos:note xml:lang="en">IOF Core defines satisfies requirement as a “relation from an entity to a requirement specification that the entity conforms to”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: skill → information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement (“relation from an entity to a requirement specification that the entity conforms to”), applied to a skill through the capabilities it has.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain is skill o has capability o satisfies requirement. The is skill marker restricts the chain to skills, because the domain of has capability is skill or tool.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the skills that can meet an information requirement of a request.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;stepRequiresCapability">
		<rdfs:label xml:lang="en">step requires capability</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">AgentO v0.2, properties hasAssociatedTask and requiresCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<rdfs:range rdf:resource="&agento;Capability"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&agento;hasAssociatedTask">
			</rdf:Description>
			<rdf:Description rdf:about="&agento;requiresCapability">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a workflow step to a capability that the task of the step requires</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Step 2 of Jessica&apos;s orchestration plan requires the interaction screening capability, because its task, screen interactions (Jessica), requires it.</skos:example>
		<skos:note xml:lang="en">AgentO links a workflow step to its task with hasAssociatedTask and a task to the capability it needs with requiresCapability; the OWL 2 Primer composes properties with property chains (section 6.2).</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration workflow step → capability (agento:Capability).</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from AgentO v0.2 requiresCapability (“capability needed for a task .”) and hasAssociatedTask (“Links a workflow step to the task it corresponds to.”), composed from the step to its task.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain agento:hasAssociatedTask o agento:requiresCapability.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to see which capabilities each step of a plan needs; the chains of step satisfies requirement and step satisfies hard constraint start from it.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;stepSatisfiesHardConstraint">
		<rdfs:label xml:lang="en">step satisfies hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan, property satisfied; Schiendorfer et al., MiniBrass (hard constraints); OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;stepRequiresCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesConstraint">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a workflow step to a hard constraint satisfied by a capability that the task of the step requires</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Step 2 of Jessica&apos;s orchestration plan satisfies the hard constraint safety screening against celecoxib (Jessica) through the interaction screening capability.</skos:example>
		<skos:note xml:lang="en">EP-Plan records whether an execution trace element met a plan constraint with satisfied and violated, the subproperties of evaluatedAgainst.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration workflow step → hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan satisfied: “ep-plan:satisfied links ep-plan:Activity or ep-plan:Communication to a ep-plan:Constraint. The property indicates that the execution trace element satisfied the constraint.” Here the constraint is satisfied by a planned step through the capability its task requires.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain step requires capability o satisfies constraint o is hard constraint; the final marker keeps only hard constraints.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the step of a plan that meets each mandatory condition (competency question 1).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;stepSatisfiesRequirement">
		<rdfs:label xml:lang="en">step satisfies requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core, satisfiesRequirement; AgentO v0.2, requiresCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;OrchestrationWorkflowStep"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;stepRequiresCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesRequirement">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a workflow step to an information requirement satisfied by a capability that the task of the step requires</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">Step 3 of Jessica&apos;s orchestration plan satisfies the requirement supporting scientific evidence (Jessica) through the evidence verification capability.</skos:example>
		<skos:note xml:lang="en">IOF Core defines satisfies requirement as a “relation from an entity to a requirement specification that the entity conforms to”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: orchestration workflow step → information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement (“relation from an entity to a requirement specification that the entity conforms to”), applied to a step through the capability its task requires.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain step requires capability o satisfies requirement.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to show which information requirement of the request each step of a plan addresses (competency question 1).</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;toolSatisfiesHardConstraint">
		<rdfs:label xml:lang="en">tool satisfies hard constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">A. Schiendorfer, A. Knapp, G. Anders, and W. Reif, “MiniBrass: Soft constraints for MiniZinc,” Constraints, vol. 23, no. 4, pp. 403–450, 2018, sec. 3, doi: 10.1007/s10601-018-9289-2. [Online]. Available: https://d-nb.info/1218972122/34</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;satisfy,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/satisfy [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">M. Markovic, D. Garijo, P. Edwards, and W. Vasconcelos, &quot;EP-Plan: Linking Abstract Plans with Execution Traces,&quot; ontology version 1.0, Apr. 2019. [Online]. Available: https://w3id.org/ep-plan [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">EP-Plan, property satisfied; Schiendorfer et al., MiniBrass (hard constraints); AgentO v0.2, hasCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Tool"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isTool">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;hasCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesConstraint">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;isHardConstraint">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a tool to a hard constraint that a capability of the tool satisfies</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">The OpenFDA drug label search tool satisfies the hard constraint safety screening against celecoxib (Jessica) through the interaction screening capability.</skos:example>
		<skos:note xml:lang="en">EP-Plan records whether an execution trace element satisfied a plan constraint with ep-plan:satisfied.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: tool → hard constraint.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from EP-Plan satisfied (“The property indicates that the execution trace element satisfied the constraint.”), applied to a tool through the capabilities it has.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain is tool o has capability o satisfies constraint o is hard constraint.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the tools that can meet a mandatory condition of a request.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;toolSatisfiesRequirement">
		<rdfs:label xml:lang="en">tool satisfies requirement</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Industrial Ontologies Foundry, &quot;IOF Core Ontology,&quot; object property satisfiesRequirement. [Online]. Available: https://spec.industrialontologies.org/ontology/core/Core/ [Accessed: Nov. 5, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan and F. J. Ekaputra, “AgentO: An ontology for modeling agentic AI systems,” ontology release v0.2, Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://w3id.org/agentic-ai/onto</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">P. Hitzler, M. Krötzsch, B. Parsia, P. F. Patel-Schneider, and S. Rudolph, Eds., &quot;OWL 2 Web Ontology Language Primer (Second Edition),&quot; W3C Recommendation, Dec. 11, 2012, sections 5.2 and 6.2. [Online]. Available: https://www.w3.org/TR/owl2-primer/</dct:bibliographicCitation>
		<dct:source xml:lang="en">IOF Core, satisfiesRequirement; AgentO v0.2, hasCapability; OWL 2 property chains</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;Tool"/>
		<rdfs:range rdf:resource="&oe-agtorch;InformationRequirement"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-agtorch;isTool">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;hasCapability">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-agtorch;satisfiesRequirement">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition xml:lang="en">relation from a tool to an information requirement that a capability of the tool satisfies</skos:definition>
		<skos:editorialNote xml:lang="en">New in Assignment 10.</skos:editorialNote>
		<skos:example xml:lang="en">The iHerb product search tool satisfies the requirement purchasable supplement products (Jessica) through the product search capability.</skos:example>
		<skos:note xml:lang="en">IOF Core defines satisfies requirement as a “relation from an entity to a requirement specification that the entity conforms to”.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: tool → information requirement.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from IOF Core satisfiesRequirement (“relation from an entity to a requirement specification that the entity conforms to”), applied to a tool through the capabilities it has.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Inferred by the property chain is tool o has capability o satisfies requirement. The is tool marker restricts the chain to tools.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Use to find the tools that can meet an information requirement of a request.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;usesCriterion">
		<rdfs:label xml:lang="en">uses criterion</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;criterion,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/criterion [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">N. Noy and A. Rector, Eds., “Defining N-ary relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">NASA, &quot;6.8 Decision Analysis,&quot; NASA Systems Engineering Handbook. [Online]. Available: https://www.nasa.gov/reference/6-8-decision-analysis/ [Accessed: Nov. 6, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">W3C n-ary relations pattern.</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;PlanEvaluation"/>
		<rdfs:range rdf:resource="&oe-agtorch;DecisionCriterion"/>
		<skos:definition xml:lang="en">relationship linking a plan evaluation to a decision criterion applied in that evaluation</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A30, Figure(s) 1, 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">Evaluation A uses a latency criterion.</skos:example>
		<skos:note xml:lang="en">Noy and Rector (2006) link the individual that represents an n-ary relation instance to each of its participants; uses criterion links the evaluation record to the decision criteria it applies.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: plan evaluation → decision criterion.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from Noy and Rector (2006), Defining N-ary Relations on the Semantic Web, Pattern 1 (“Introducing a new class for a relation”), which links the individual for the relation instance to each participant; here the participant is a decision criterion as in NASA, 6.8 Decision Analysis: “Decision criteria are requirements for individually assessing the options and alternatives being considered.”</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">Keeps the choice of criterion distinct from the measured PlanMetric.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Link a plan evaluation to each decision criterion it applies.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;usesTool">
		<rdfs:label xml:lang="en">uses tool</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">K. Kurniawan, “AgentO: An ontology for modeling agentic AI systems,” Zenodo, Jan. 22, 2026, doi: 10.5281/zenodo.18342625. [Online]. Available: https://zenodo.org/records/18342625 [Accessed: Sep. 22, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Kurniawan, AgentO: An Ontology for Modeling Agentic AI Systems, version 1, Zenodo, January 22, 2026</dct:source>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&agento;LLMAgent">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-agtorch;Skill">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&agento;Tool"/>
		<skos:altLabel xml:lang="en">Agent tool usage</skos:altLabel>
		<skos:definition xml:lang="en">links an agent or skill to a tool it uses</skos:definition>
		<skos:editorialNote xml:lang="en">Definition drafting/editing method (moved out of source fields): ChatGPT - provided the model with the term, source, and use-case scope which was prompted to generate an ISO 704-compliant definition. The generated definition was subsequently manually revised for the ontology context.</skos:editorialNote>
		<skos:example xml:lang="en">A research agent uses a search tool to retrieve sources for a task.</skos:example>
		<skos:scopeNote xml:lang="en">Domain → range: LLM agent or skill → tool. Shared by Figures 3a and 4, so the domain is the union LLM agent or skill; a skill that uses a tool is not classified as an LLMAgent. The Figure 4 agent-to-tool restriction is scoped to LLMAgent.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Kurniawan, Agentic AI Ontology, “agent tool usage” relationship.</cmns-av:adaptedFrom>
	</owl:ObjectProperty>
	
	<rdf:Description rdf:about="&oe-agtorch;v4.1">
		<rdfs:seeAlso rdf:resource="https://tetherless-world.github.io/ontology-engineering/branch/agentic-orchestration/oe2026/agentic-orchestration/archived/OE_11_TeamAgenticCapabilities.txt"/>
		<owl:deprecated rdf:datatype="&xsd;boolean">true</owl:deprecated>
	</rdf:Description>
	
	<owl:ObjectProperty rdf:about="&oe-agtorch;violatesConstraint">
		<rdfs:label xml:lang="en">violates constraint</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Cambridge University Press, &quot;violate,&quot; Cambridge Advanced Learner&apos;s Dictionary &amp; Thesaurus (online). [Online]. Available: https://dictionary.cambridge.org/dictionary/english/violate [Accessed: Nov. 13, 2026].</dct:bibliographicCitation>
		<dct:bibliographicCitation xml:lang="en">Pearson, &quot;violate,&quot; Longman Dictionary of Contemporary English (online). [Online]. Available: https://www.ldoceonline.com/dictionary/violate [Accessed: Oct. 16, 2026].</dct:bibliographicCitation>
		<dct:source xml:lang="en">Longman Dictionary, &quot;violate&quot; (verb)</dct:source>
		<rdfs:domain rdf:resource="&oe-agtorch;CandidateOrchestrationPlan"/>
		<rdfs:range rdf:resource="&oe-agtorch;HardConstraint"/>
		<skos:definition xml:lang="en">relation from a candidate orchestration plan to a hard constraint that the plan fails to satisfy, which disqualifies the plan</skos:definition>
		<skos:editorialNote xml:lang="en">Traceability: AC-001_ConceptualModel_TermListTraceability.xlsx, Properties!A32, Figure(s) 6. AI-assisted definition adapted for the use case (note moved from Explanatory Note in Assignment 10).</skos:editorialNote>
		<skos:example xml:lang="en">A candidate without a required screening step violates the screening constraint.</skos:example>
		<skos:note xml:lang="en">Longman defines &quot;violate&quot; as &quot;to disobey or do something against an official agreement, law, principle etc&quot;; violates links a candidate plan to a constraint it fails to meet.</skos:note>
		<skos:scopeNote xml:lang="en">Domain → range: candidate orchestration plan → hard constraint. A soft constraint is never violated in this sense: it is measured by a decision criterion and only lowers the plan&apos;s score and rank.</skos:scopeNote>
		<cmns-av:adaptedFrom xml:lang="en">Adapted from the Longman Dictionary sense of &quot;violate&quot;: &quot;to disobey or do something against an official agreement, law, principle etc&quot;.</cmns-av:adaptedFrom>
		<cmns-av:explanatoryNote xml:lang="en">A violation of a hard constraint prevents acceptance; a soft-constraint shortfall may affect ranking.</cmns-av:explanatoryNote>
		<cmns-av:usageNote xml:lang="en">Assert when a candidate plan fails a hard constraint; the plan is then disqualified from selection.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;abbreviation">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;adaptedFrom">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;directSource">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;explanatoryNote">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;synonym">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;usageNote">
	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure">
		<rdfs:label xml:lang="en">measure</rdfs:label>
		<dct:bibliographicCitation xml:lang="en">Object Management Group, “Commons Ontology Library (Commons), Version 1.2,” QuantitiesAndUnits module, version 20240801. [Online]. Available: https://www.omg.org/spec/Commons/</dct:bibliographicCitation>
		<dct:source xml:lang="en">OMG Commons Ontology Library, QuantitiesAndUnits module (version 20240801), class Measure</dct:source>
		<skos:definition xml:lang="en">amount or degree of something; the dimensions, capacity, or amount of something ascertained by measuring</skos:definition>
		<skos:editorialNote xml:lang="en">Assignment 12: the term has no row in the term list; the label, definition and source were taken from the source ontology to resolve the OOPS! missing-annotation pitfall (P08), and Claude Opus 5.5 (Anthropic, in Claude Code) drafted the notes.</skos:editorialNote>
		<skos:example xml:lang="en">The token cost of a candidate orchestration plan, recorded as a plan metric.</skos:example>
		<skos:note xml:lang="en">Commons: “Measure refers to the phenomenon or phenomena to be measured in a data set. In a data set, the instance of a measure is often called an observation.”</skos:note>
		<cmns-av:directSource xml:lang="en">OMG Commons QuantitiesAndUnits, class Measure, skos:definition: “amount or degree of something; the dimensions, capacity, or amount of something ascertained by measuring” (Commons cites https://stats.oecd.org/glossary/detail.asp?ID=7062)</cmns-av:directSource>
		<cmns-av:explanatoryNote xml:lang="en">Reused from OMG Commons; superclass of plan metric, drawn in Figure 6b.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:AllDisjointClasses>
		<owl:members rdf:parseType="Collection">
			<rdf:Description rdf:about="http://w3id.org/beam/core#Instance">
