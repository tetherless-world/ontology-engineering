<?xml version="1.0"?>
<rdf:RDF xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
     xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:oe-cjf="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
     xmlns:cmns-av="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
     xmlns:cmns-dt="https://www.omg.org/spec/Commons/DatesAndTimes/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:resource="http://semanticscience.org/resource/">
    <owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/">
        <owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/OE_12/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
        <owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
        <dct:abstract>Represents conversation moves, their evidenced relationships, and recorded state assignments in collective judgment formation.</dct:abstract>
        <dct:creator>Devin De Silva</dct:creator>
        <dct:creator>Matthew Lausev</dct:creator>
        <dct:creator>Srihari Sridharan</dct:creator>
        <dct:creator>Tiziana Hernandez</dct:creator>
        <dct:license rdf:resource="https://spdx.org/licenses/MIT.html"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-19</dct:modified>
        <dct:publisher>Tracking CJF</dct:publisher>
        <rdfs:label>Tracking collective judgment formation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://tetherless-world.github.io/ontology-engineering/branch/tracking-cjf/oe2026/tracking-cjf/gettinginvolved"/>
        <rdfs:seeAlso rdf:resource="https://tetherless-world.github.io/ontology-engineering/branch/tracking-cjf/oe2026/tracking-cjf/license.html"/>
        <owl:priorVersion rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/OE_10/"/>
        <owl:priorVersion rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/OE_11/"/>
        <owl:versionInfo>OE_12</owl:versionInfo>
        <skos:changeNote>Added the About and Select classes to record what an information request is about and which option an outcome selects. Each relationship record can carry a reason and supporting evidence. Property chains infer the direct isAbout and selects links.</skos:changeNote>
        <skos:changeNote>Added the MIT license, project copyright, release label, and links to maintenance policies and community feedback.</skos:changeNote>
        <skos:changeNote>Created the OE Week 12 starting schema from OE Week 11 and archived the previous release with its import catalog.</skos:changeNote>
        <skos:changeNote>Revised definitions and source citations to match the team’s terminology sheet. Added examples and usage notes.</skos:changeNote>
        <cmns-av:copyright>Copyright (c) 2026 Tracking CJF Ontology Team</cmns-av:copyright>
    </owl:Ontology>
    


