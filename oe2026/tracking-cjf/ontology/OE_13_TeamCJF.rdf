    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://semanticscience.org/resource/SIO_000001 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000001">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <dc:identifier>SIO_000001</dc:identifier>
        <dct:description xml:lang="en">A is related to B iff there is some relation between A and B.</dct:description>
        <resource:subset>core</resource:subset>
        <resource:subset>relations+</resource:subset>
        <rdfs:comment>&apos;is related to&apos; is the top level relation in SIO</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000028 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000028">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000028</dc:identifier>
        <dct:description xml:lang="en">has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:example xml:lang="en">a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000053 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000053">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000028"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000053</dc:identifier>
        <dct:description xml:lang="en">has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has proper part</rdfs:label>
        <skos:example xml:lang="en">a car has an engine as a proper part; a car has a piston as a proper part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000061 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000061">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000061</dc:identifier>
        <dct:description xml:lang="en">A is located in B iff the spatialtemporial region occupied by A is part of the spatialtemporal region occupied by B. [T][R]</dct:description>
        <resource:equivalentTo>OBO_REL:located_in</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <skos:example xml:lang="en">A parasite in the interior of a person&apos;s intestine is located in their intestinal lumen.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000068 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000068">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000061"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000068</dc:identifier>
        <dct:description xml:lang="en">is part of is a transitive, reflexive and anti-symmetric mereological relation between a whole and itself or a part and its whole.</dct:description>
        <resource:equivalentTo>OBO_REL:part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000093 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000093">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000093</dc:identifier>
        <dct:description xml:lang="en">is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole.</dct:description>
        <resource:equivalentTo>OBO_REL:proper_part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is proper part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000145 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000145">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000145</dc:identifier>
        <dct:description xml:lang="en">A is location of B iff the spatialtemporal region occupied by A has the spatialtemporal region occupied by B as a part. [T][R]</dct:description>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000206 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000206">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000772"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000208"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <dc:identifier>SIO_000206</dc:identifier>
        <dct:description xml:lang="en">is supported by is a relation between a proposition and something that supports the truth of the assertion.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is supported by</rdfs:label>
        <skos:definition>directed grounding relationship linking a CJF conversation move to the Text Span that provides transcript evidence for the conversation move annotation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000208 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000208">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000773"/>
        <dc:identifier>SIO_000208</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is supporting evidence for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000212 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000212">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000628"/>
        <dc:identifier>SIO_000212</dc:identifier>
        <dct:description xml:lang="en">A is referred to by B iff B is an informational entity that makes reference to A.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is referred to by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000252 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000252">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000212"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <dc:identifier>SIO_000252</dc:identifier>
        <dct:description xml:lang="en">is reference for is a relation between a document that provides information about an entity.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is referenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000322 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000322">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc:identifier>SIO_000322</dc:identifier>
        <dct:description xml:lang="en">A is spatiotemporally related to B iff A is in the spatial or temporal vicinity of B</dct:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is spatiotemporally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000628 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000628">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:identifier>SIO_000628</dc:identifier>
        <dct:description xml:lang="en">refers to is a relation between one entity and the entity that it makes reference to.</dct:description>
        <resource:subset>core</resource:subset>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">refers to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000631 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000631">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000628"/>
        <dc:identifier>SIO_000631</dc:identifier>
        <dct:alternative>mentions</dct:alternative>
        <dct:description xml:lang="en">references is a relation between one entity and the entity that it makes reference to by name, but is not described by it.</dct:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">references</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000772 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000772">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000773"/>
        <dc:identifier>SIO_000772</dc:identifier>
        <dct:description xml:lang="en">has evidence is a relation between a proposition and something that demonstrates the truth of the assertion.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000773 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000773">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000252"/>
        <dc:identifier>SIO_000773</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is evidence for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_001403 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_001403">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:description xml:lang="en">x is associated with y when x and y are logically or statistically related to one another.</dc:description>
        <dc:identifier>SIO_001403</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/addresses -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/addresses">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAddresses"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAddresses"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08- 0125</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>addresses</rdfs:label>
        <skos:definition>provides information, reasoning, a proposed solution, or a group decision that directly responds to the problem or concern represented by</skos:definition>
        <skos:example>Option O1 addresses Issue I1; the group has not decided whether to adopt it.</skos:example>
        <skos:prefLabel>addresses</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when the conversation move responds to or acknowledges an issue through providing information, reasoning, or a possible solution. Use resolves instead when an explicit Outcome settles the Issue</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/answers -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/answers">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/respondsTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAnswers"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAnswers"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>answers</rdfs:label>
        <skos:definition>provides a response that satisfies the information need expressed by</skos:definition>
        <skos:prefLabel>answers</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Claim C2 answers Information Request Q1: “Friday” answers “When is the meeting?”</cmns-av:usageNote>
        <cmns-av:usageNote>Use when an information need is satisified by this contribution. Do not infer an answer simply from topical relevance.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedAtUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedAtUtterance">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A quick start guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <rdfs:label>assigned at utterance</rdfs:label>
        <skos:definition>becomes effective at</skos:definition>
        <skos:example>claim1_assignment2 assignedAtUtterance utterance_0370.</skos:example>
        <skos:prefLabel>assigned at utterance</skos:prefLabel>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Identifies where the state becomes applicable in the conversation, rather than when an annotator entered the record. The turn number belongs to the linked Utterance.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <rdfs:label>assigned state</rdfs:label>
        <skos:definition>records the conversation move&apos;s state at the specified point in the conversation as</skos:definition>
        <skos:example>claim1_assignment2 assignedState supported_state_1.</skos:example>
        <skos:prefLabel>assigned state</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Each StateAssignment records exactly one State.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/challenges -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/challenges">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesChallenges"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtChallenges"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>challenges</rdfs:label>
        <skos:definition>provides an identifiable objection, counterargument, or evidence against</skos:definition>
        <skos:example>Issue I2 challenges Option O1: ‘O1 exceeds our budget, so we need to address its cost.’</skos:example>
        <skos:prefLabel>challenges</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when a Claim or Issue provides evidence, reasoning, objections, or concerns that question or oppose another conversation move. Do not use for simple disagreement.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasCurrentStateAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasCurrentStateAssignment">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <dct:bibliographicCitation>[34] World Wide Web Consortium, “Data Catalog Vocabulary (DCAT) – Version 3,” W3C Recommendation, Aug. 22, 2024. [Online]. Available: https://www.w3.org/TR/vocab-dcat-3/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[36] P. Ciccarese, S. Soiland-Reyes, K. Belhajjame, A. J. G. Gray, C. Goble, and T. Clark, “PAV ontology: Provenance, authoring and versioning,” Journal of Biomedical Semantics, vol. 4, art. no. 37, 2013, doi: 10.1186/2041-1480-4-37.</dct:bibliographicCitation>
        <rdfs:label>has current state assignment</rdfs:label>
        <skos:definition>has as a currently applicable state assignment</skos:definition>
        <skos:example>claim_1 hasCurrentStateAssignment claim1_assignment2. claim1_assignment2 assignedState supported_state_1. claim1_assignment2 hasPreviousAssignment claim1_assignment1.</skos:example>
        <cmns-av:adaptedFrom>https://doi.org/10.1186/2041-1480-4-37</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/vocab-dcat-3/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use to identify the StateAssignment record representing a conversation move&apos;s currently applicable state(s). Preserve earlier assignments through hasStateAssignment, but do not mark historical assignments as current. If multiple states apply simultaneously, link each applicable StateAssignment.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPositionTowards -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPositionTowards">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesPositionTowards"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtPositionTowards"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>has position towards</rdfs:label>
        <skos:definition>expresses the speaker’s attitude toward</skos:definition>
        <skos:example>Expressed Position P1 hasPositionTowards Option O1: “I prefer O1.”</skos:example>
        <skos:prefLabel>has position towards</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use hasPositionTowards to link an Expressed Position to a Claim, Option, or Issue it targets</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <dct:bibliographicCitation>[34] World Wide Web Consortium, “Data Catalog Vocabulary (DCAT) – Version 3,” W3C Recommendation, Aug. 22, 2024. [Online]. Available: https://www.w3.org/TR/vocab-dcat-3/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[36] P. Ciccarese, S. Soiland-Reyes, K. Belhajjame, A. J. G. Gray, C. Goble, and T. Clark, “PAV ontology: Provenance, authoring and versioning,” Journal of Biomedical Semantics, vol. 4, art. no. 37, 2013, doi: 10.1186/2041-1480-4-37.</dct:bibliographicCitation>
        <rdfs:label>has previous assignment</rdfs:label>
        <skos:definition>has as its immediately preceding state assignment record for the same conversation move as</skos:definition>
        <skos:example>claim1_assignment2 hasPreviousAssignment claim1_assignment1.</skos:example>
        <skos:prefLabel>has previous assignment</skos:prefLabel>
        <cmns-av:adaptedFrom>https://doi.org/10.1186/2041-1480-4-37</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/vocab-dcat-3/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Omit for the initial assignment. The preceding assignment must concern the same conversation move; the current cardinality restriction does not enforce that condition.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeaker -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeaker">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_001403"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000206"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[21] T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV Ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>has speaker</rdfs:label>
        <skos:definition>is expressed in a conversational contribution made by</skos:definition>
        <skos:example>If an ExpressedPosition is supported by a TextSpan in an Utterance introduced by Speaker C, infer that the ExpressedPosition hasSpeaker Speaker C.</skos:example>
        <skos:prefLabel>has speaker</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/prov-o/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The relationship is inferred by following the conversation move’s supporting TextSpan to its containing Utterance and then to the Speaker who introduced that Utterance.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Infer the relationship when the complete provenance path is represented.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasCurrentStateAssignment"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>has state</rdfs:label>
        <skos:definition>has its evidence-based standing at a specified point in the conversation characterized by</skos:definition>
        <skos:example>Issue I1 hasState Open at Turn 5 and hasState Resolved after Outcome O2 at Turn 18.</skos:example>
        <skos:scopeNote>Applies only to state-bearing conversation moves. A later observation may associate the same conversation move with a different State as new evidence appears.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>When implementation permits, record the conversation point or evidence supporting each state assertion so changes over time remain traceable.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Do not infer a terminal state merely from lack of further discussion; require positive evidence for transitions such as Resolved, Selected, or Accepted.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[36] P. Ciccarese, S. Soiland-Reyes, K. Belhajjame, A. J. G. Gray, C. Goble, and T. Clark, “PAV ontology: Provenance, authoring and versioning,” Journal of Biomedical Semantics, vol. 4, art. no. 37, 2013, doi: 10.1186/2041-1480-4-37.</dct:bibliographicCitation>
        <rdfs:label>has state assignment</rdfs:label>
        <skos:definition>has a state assignment record given at specified turn in the conversation recorded through</skos:definition>
        <skos:example>claim_1 hasStateAssignment claim1_assignment2.</skos:example>
        <skos:prefLabel>has state assignment</skos:prefLabel>
        <cmns-av:adaptedFrom>https://doi.org/10.1186/2041-1480-4-37</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Links to all recorded state assignments, including the assignment corresponding to the current state.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateEvidence -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateEvidence">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>has state evidence</rdfs:label>
        <skos:definition>has its assigned state justified by conversational evidence contained in</skos:definition>
        <skos:example>claim1_assignment2 hasStateEvidence span_0370_support.</skos:example>
        <skos:prefLabel>has state evidence</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>May link to multiple Text Spans, including evidence from earlier Utterances.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <rdfs:label>has triggering relationship</rdfs:label>
        <skos:definition>has its recorded state transition triggered by</skos:definition>
        <skos:prefLabel>has triggering relationship</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Links a relationship-based state assignment to the relationship individual that triggers that transition. The relationship must target the same conversation move and be established by evidence available at the assignment&apos;s effective utterance. Earlier contextual evidence alone does not establish the trigger. Initial assignments and evidence-based transitions need not have a triggering relationship; multiple relationships may jointly trigger one transition.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasUtterance">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000206"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <rdfs:label>has utterance</rdfs:label>
        <skos:definition>has supporting conversational evidence in</skos:definition>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Links a CJF conversation move or relationship instance to the Utterance that provides its supporting evidence. This preserves the connection between an annotation and its source.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to identify the Utterance supporting a conversation move or relationship. Link to the Utterance individual rather than storing the text directly.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAbout -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAbout">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesIsAbout"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtIsAbout"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>is about</rdfs:label>
        <skos:definition>concerns the content of</skos:definition>
        <skos:example>Information Request Q1 isAbout Claim C1: “What evidence supports C1?”</skos:example>
        <skos:prefLabel>is about</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when an information request concerns an identifiable existing conversation move; a later reply to the request uses respondsTo or answers.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <rdfs:label>is aimed at</rdfs:label>
        <skos:definition>has as its target conversation move</skos:definition>
        <skos:example>General target-linking property specialized for each modeled relationship type through isAimedAtRespondsTo, isAimedAtAnswers, isAimedAtAddresses, isAimedAtResolves, isAimedAtSupports, isAimedAtChallenges, and isAimedAtPositionTowards. Use the applicable specialized property to link the relationship individual to its target conversation move.</skos:example>
        <skos:prefLabel>is aimed at</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>This is used for reification of the CJF conversation moves relationships. This points from a conversation move relationship in question to the conversation move it&apos;s pointing to. This is superclass from which we inherit for each relationship</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAddresses -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAddresses">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08- 0125</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>is aimed at addresses</rdfs:label>
        <skos:definition>represents information, reasoning, or a possible solution that directly responds to the problem or concern represented by</skos:definition>
        <skos:example>Address AD1 isAimedAtAddresses Issue I1.</skos:example>
        <skos:prefLabel>is aimed at addresses</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the address relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesAddresses so the relationship has both its source and target. A claim, option, or outcome engages with an issue; this does not necessarily resolve it.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAnswers -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAnswers">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRespondsTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answer"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/ |</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/ |</dct:bibliographicCitation>
        <rdfs:label>is aimed at answers</rdfs:label>
        <skos:definition>represents a response that fully satisfies the information need expressed by</skos:definition>
        <skos:example>Answer A1 isAimedAtAnswers Information Request Q1.</skos:example>
        <skos:prefLabel>is aimed at answers</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the answer relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesAnswers so the relationship has both its source and target. The response satisfies the information need in the question.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtChallenges -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtChallenges">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8. |</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>is aimed at challenges</rdfs:label>
        <skos:definition>represents an identifiable objection, counterargument, or evidence against</skos:definition>
        <skos:example>Challenge CH1 isAimedAtChallenges Option O1.</skos:example>
        <skos:prefLabel>is aimed at challenges</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the challenge relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesChallenges so the relationship has both its source and target. A claim or issue gives a reason, objection, or counterevidence against another Claim, Option, or Issue.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtIsAbout -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtIsAbout">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/About"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>is aimed at is about</rdfs:label>
        <skos:definition>is directed toward the conversation move that the request concerns</skos:definition>
        <skos:example>About AB1 isAimedAtIsAbout Claim C1.</skos:example>
        <skos:prefLabel>is aimed at is about</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the Information Request concerns. The Information Request providing the relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesIsAbout so the relationship has both its source and target. The target must be the Claim, Option, Issue, or Expressed Position that the request concerns, not a response to the request.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtPositionTowards -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtPositionTowards">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Position"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>is aimed at position towards</rdfs:label>
        <skos:definition>represents an expression of a speaker&apos;s attitude toward</skos:definition>
        <skos:example>Position POS1 isAimedAtPositionTowards Option O1.</skos:example>
        <skos:prefLabel>is aimed at position towards</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the position relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesPositionTowards so the relationship has both its source and target. An expressed position communicates a participant&apos;s attitude toward a Claim, Option, or Issue.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRefines -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRefines">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Refinement"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>is aimed at refines</rdfs:label>
        <skos:definition>represents an extension, correction, or reformulation of the content of</skos:definition>
        <skos:example>Refinement RF1 isAimedAtRefines Option O1.</skos:example>
        <skos:prefLabel>is aimed at refines</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the refinement relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesRefines so the relationship has both its source and target. A later move extends, corrects, or reformulates an earlier move of the same type.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtResolves -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtResolves">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAddresses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolve"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>is aimed at resolves</rdfs:label>
        <skos:definition>represents the explicit settling of the concern represented by</skos:definition>
        <skos:example>Resolve RV1 isAimedAtResolves Issue I1.</skos:example>
        <skos:prefLabel>is aimed at resolves</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the resolve relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesResolves so the relationship has both its source and target. An explicit group-level outcome settles an issue; this is a specific kind of addressing.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRespondsTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRespondsTo">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Response"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>is aimed at responds to</rdfs:label>
        <skos:definition>represents a relevant response to</skos:definition>
        <skos:example>Response R1 isAimedAtRespondsTo Information Request Q1.</skos:example>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the response relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesRespondsTo so the relationship has both its source and target. Relevant response to a question; the information need may remain unanswered.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSelects -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSelects">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Select"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <rdfs:label>is aimed at selects</rdfs:label>
        <skos:definition>is directed toward the selected</skos:definition>
        <skos:example>Selection SEL1 isAimedAtSelects Option O1.</skos:example>
        <skos:prefLabel>is aimed at selects</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the Option chosen by the group Outcome. The Outcome providing the selection relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesSelects so the relationship has both its source and target. The target must be the Option explicitly selected by the group.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSupports -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSupports">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAt"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>is aimed at supports</rdfs:label>
        <skos:definition>represents identifiable evidence, reasoning, or an explanation in favor of</skos:definition>
        <skos:example>Support S1 isAimedAtSupports Option O1.</skos:example>
        <skos:prefLabel>is aimed at supports</skos:prefLabel>
        <skos:scopeNote>This links the relationship record to the move it concerns.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the conversation move that the support relationship concerns. The move providing that relationship is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use with makesSupports so the relationship has both its source and target. A claim gives reasons or evidence in favor of another Claim, Option, or Issue.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAlternativeTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAlternativeTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <rdfs:label>is alternative to</rdfs:label>
        <skos:definition>is a competing course of action to</skos:definition>
        <skos:example>Option O1 isAlternativeTo Option O2.</skos:example>
        <skos:prefLabel>is alternative to</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The relationship is symmetric: if one Option is an alternative to another, the reverse also holds.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when Options are offered as separate choices to the same issue they both address</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isNegativeSupportedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isNegativeSupportedBy">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <owl:propertyDisjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPositiveSupportedBy"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[15] F. Niu, M. Yang, A. Li, B. Zhang, X. Peng, and B. Zhang, “A challenge dataset and effective models for conversational stance detection,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 122–132. [Online]. Available: https://aclanthology.org/2024.lrec-main.11/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A quick start guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>is negative supported by</rdfs:label>
        <skos:definition>has its interpretation as a negative-polarity position supported by the linguistic content of</skos:definition>
        <skos:example>An Expressed Position of Disagreement isNegativeSupportedBy the span “No, I do not support Option B.”</skos:example>
        <skos:prefLabel>is negative supported by</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.11/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the transcript evidence used to interpret a position as negative.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when the source text clearly expresses disagreement or an opposition position towards something. Do not use it to assert that one conversation move challenges another; use challenges for that semantic relation.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>is part of utterance</rdfs:label>
        <skos:definition>forms a textual part of</skos:definition>
        <skos:prefLabel>is part of utterance</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects a TextSpan to the Utterance containing it, allowing specific portions of an utterance to be identified.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a TextSpan represents part of an Utterance. This allows annotations to refer to the exact portion of text providing evidence.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPositiveSupportedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPositiveSupportedBy">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[15] F. Niu, M. Yang, A. Li, B. Zhang, X. Peng, and B. Zhang, “A challenge dataset and effective models for conversational stance detection,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 122–132. [Online]. Available: https://aclanthology.org/2024.lrec-main.11/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>is positive supported by</rdfs:label>
        <skos:definition>has its interpretation as a positive-polarity position supported by the linguistic content of</skos:definition>
        <skos:example>An Expressed Position of Agreement isPositiveSupportedBy the span “Yes, I agree with Option B.”</skos:example>
        <skos:prefLabel>is positive supported by</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.11/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Identifies the transcript evidence used to interpret a position as positive.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when the source text clearly expresses agreement or a favorable position towards something. Do not use it to assert that one conversation move supports another; use supports for that semantic relation.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isSelectedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isSelectedBy">
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/selects"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
        <rdfs:label>is selected by</rdfs:label>
        <skos:definition>is the option chosen by a group Outcome</skos:definition>
        <skos:prefLabel>is selected by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <rdfs:label>makes</rdfs:label>
        <skos:definition>serves as the source conversation move of</skos:definition>
        <skos:prefLabel>makes</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>This is used for reification of the CJF conversation moves relationships. This points from a conversation move to the relationship in question. This is superclass from which we inherit for each relationship</cmns-av:explanatoryNote>
        <cmns-av:usageNote>General source-linking property specialized for each modeled relationship type through makesRespondsTo, makesAnswers, makesAddresses, makesResolves, makesSupports, makesChallenges, and makesPositionTowards. Use the applicable specialized property to link the source conversation move to the relationship individual.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAddresses -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAddresses">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08- 0125</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>makes addresses</rdfs:label>
        <skos:definition>serves as the source of information, reasoning, a proposed solution, or a group decision that directly responds to the problem or concern represented by</skos:definition>
        <skos:example>Option O1 makesAddresses Address AD1.</skos:example>
        <skos:prefLabel>makes addresses</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the address relationship to a Address instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use for a direct response or proposed solution to an Issue. Do not treat it as resolution. Pair with isAimedAtAddresses to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAnswers -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAnswers">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRespondsTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answer"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/ |</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/ |</dct:bibliographicCitation>
        <rdfs:label>makes answers</rdfs:label>
        <skos:definition>serves as the source of a response that fully satisfies an information request, as represented by</skos:definition>
        <skos:example>Claim C2 makesAnswers Answer A1.</skos:example>
        <skos:prefLabel>makes answers</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the answer relationship to a Answer instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only when the question is answered, not merely discussed. Pair with isAimedAtAnswers to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesChallenges -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesChallenges">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8. |</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>makes challenges</rdfs:label>
        <skos:definition>serves as the source of an identifiable objection, counterargument, or evidence against another conversation move, as represented by</skos:definition>
        <skos:example>Issue I2 makesChallenges Challenge CH1.</skos:example>
        <skos:prefLabel>makes challenges</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the challenge relationship to a Challenge instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use for an identifiable objection or counterargument, not simple disagreement. Pair with isAimedAtChallenges to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesIsAbout -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesIsAbout">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/About"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>makes is about</rdfs:label>
        <skos:definition>is the source of the subject-matter relationship represented by</skos:definition>
        <skos:example>Information Request Q1 makesIsAbout About AB1.</skos:example>
        <skos:prefLabel>makes is about</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the Information Request to an About instance. The conversation move that the request concerns is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when an Information Request concerns an identifiable Claim, Option, Issue, or Expressed Position. Pair with isAimedAtIsAbout to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesPositionTowards -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesPositionTowards">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Position"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>makes position towards</rdfs:label>
        <skos:definition>serves as the source of an expression of a speaker&apos;s attitude toward another conversation move, as represented by</skos:definition>
        <skos:example>Expressed Position P1 makesPositionTowards Position POS1.</skos:example>
        <skos:prefLabel>makes position towards</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the position relationship to a Position instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to connect an explicit agreement, disagreement to its target. Pair with isAimedAtPositionTowards to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRefines -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRefines">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Refinement"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>makes refines</rdfs:label>
        <skos:definition>serves as the source of an extension, correction, or reformulation of another conversation move, as represented by</skos:definition>
        <skos:example>Option O2 makesRefines Refinement RF1.</skos:example>
        <skos:prefLabel>makes refines</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the refinement relationship to a Refinement instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only for a clear revision between moves of the same type. Pair with isAimedAtRefines to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesResolves -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesResolves">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAddresses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolve"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>makes resolves</rdfs:label>
        <skos:definition>serves as the source of resolution representing by</skos:definition>
        <skos:example>Outcome OUT1 makesResolves Resolve RV1.</skos:example>
        <skos:prefLabel>makes resolves</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the resolve relationship to a Resolve instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only for a group decision or agreement that settles the Issue. Pair with isAimedAtResolves to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRespondsTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRespondsTo">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Response"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>makes responds to</rdfs:label>
        <skos:definition>serves as the source of a response to an information request, as represented by</skos:definition>
        <skos:example>Claim C2 makesRespondsTo Response R1.</skos:example>
        <skos:prefLabel>makes responds to</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the response relationship to a Response instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a move responds to a question without necessarily answering it. Pair with isAimedAtRespondsTo to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSelects -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSelects">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Select"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <rdfs:label>makes selects</rdfs:label>
        <skos:definition>is the source of the group selection represented by</skos:definition>
        <skos:example>Outcome OUT1 makesSelects Selection SEL1.</skos:example>
        <skos:prefLabel>makes selects</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the Outcome that records the group selection to a Selection instance. The chosen Option is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only when an explicit group Outcome selects an Option. An individual preference or vote does not establish group selection. Pair with isAimedAtSelects to identify the selected Option.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSupports -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSupports">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makes"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support"/>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>makes supports</rdfs:label>
        <skos:definition>serves as the source of identifiable evidence, reasoning, or an explanation in favor of another conversation move, as represented by</skos:definition>
        <skos:example>Claim C2 makesSupports Support S1.</skos:example>
        <skos:prefLabel>makes supports</skos:prefLabel>
        <skos:scopeNote>This links the move to its relationship record.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Connects the move that provides the support relationship to a Support instance. The target conversation move is connected separately.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use for an identifiable supporting reason, not simple agreement. Pair with isAimedAtSupports to identify the target.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/refines -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/refines">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRefines"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRefines"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>refines</rdfs:label>
        <skos:definition>extends, corrects, or reformulates the content of</skos:definition>
        <skos:example>Claim C2 refines Claim C1 by correcting a figure in C1.</skos:example>
        <skos:prefLabel>refines</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Record a specific extension, correction, or reformulation; do not link unrelated contributions solely because they share a topic. A move refined by a Claim, Issue, or Option is of the same type as that source move.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/resolves -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/resolves">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/addresses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesResolves"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtResolves"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>resolves</rdfs:label>
        <skos:definition>records that a group Outcome explicitly settles the concern represented by</skos:definition>
        <skos:example>Outcome O1 resolves Issue I1: the group explicitly closes the Issue.</skos:example>
        <skos:prefLabel>resolves</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>An individual’s agreement or an unaccepted proposal does not by itself resolve a group Issue.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/respondsTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/respondsTo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesRespondsTo"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtRespondsTo"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>responds to</rdfs:label>
        <skos:definition>provides a relevant response to</skos:definition>
        <skos:example>Claim C2 respondsTo Information Request Q1; its does not satify the information need</skos:example>
        <skos:prefLabel>responds to</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The relationship does not establish whether the information need is satisfied.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use for a relevant response when the evidence does not establish the answers relation</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/selects -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/selects">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSelects"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSelects"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <rdfs:label>selects</rdfs:label>
        <skos:definition>records that a group Outcome chooses an</skos:definition>
        <skos:example>Outcome O1 selects Option O2: the group chooses O2.</skos:example>
        <skos:prefLabel>selects</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:usageNote>An individual vote or stated preference is an Expressed Position; a group Outcome can select an Option.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/supports -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/supports">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesSupports"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtSupports"/>
        </owl:propertyChainAxiom>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>supports</rdfs:label>
        <skos:definition>provides identifiable evidence, reasoning, or an explanation in favor of</skos:definition>
        <skos:example>Claim C2 supports Option O1: “O1 costs less to implement.”</skos:example>
        <skos:prefLabel>supports</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when a Claim provides evidence, reasoning, or justification in favor of another conversation move. The connection must be clear from the conversation. Do not use for simple agreement.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/deliberation/ontology#responseTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/deliberation/ontology#responseTo">
        <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:comment>Relates a contribution to another contribution it responds to.</rdfs:comment>
        <rdfs:label>response to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/hasDateTime -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/hasDateTime">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime"/>
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime"/>
        <rdfs:label>has date time</rdfs:label>
        <skos:definition>identifies a specific date and time of day, possibly excluding the time zone</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/hasTime -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime">
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity"/>
        <rdfs:label>has time</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3c.github.io/sdw/time/#time:hasTime"/>
        <skos:definition>specifies a general time that can be associated with any element</skos:definition>
        <skos:note>This property corresponds to the property of the same name in the W3C Time Ontology, and can be used to support mapping.</skos:note>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationIdentifier -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/MultipartyConversation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:bibliographicCitation>[33] Dublin Core Metadata Initiative, “DCMI Metadata Terms,” Jan. 20, 2020. [Online]. Available: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/</dct:bibliographicCitation>
        <rdfs:label>has conversation identifier</rdfs:label>
        <skos:definition>has as its unique conversation identifier</skos:definition>
        <skos:prefLabel>has conversation identifier</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores a unique string identifier for a MultipartyConversation, distinguishing it from other conversations.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to assign a unique and consistent identifier to each MultipartyConversation.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationText -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationText">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>has conversation text</rdfs:label>
        <skos:definition>has its conversation text recorded as</skos:definition>
        <skos:prefLabel>has conversation text</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores the original conversational text of an Utterance or TextSpan as a string, preserving the source wording.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to record the actual text of an Utterance or TextSpan. Preserve the original wording rather than replacing it with a summary.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasReason -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasReason">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[35] Cambridge University Press &amp; Assessment, “Reason,” Cambridge Dictionary. [Online]. Available: https://dictionary.cambridge.org/dictionary/english/reason</dct:bibliographicCitation>
        <rdfs:label>has reason</rdfs:label>
        <skos:definition>has the explanation of how conversational evidence establishes an annotated relationship or state assignment recorded as</skos:definition>
        <cmns-av:adaptedFrom>https://dictionary.cambridge.org/dictionary/english/reason</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores a text explanation of why conversational evidence supports a relationship or StateAssignment. This records the reasoning behind the annotation, rather than the evidence itself.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to explain why a relationship or state assignment is justified by the conversation. The reason should reference the relevant evidence and explain how it supports the annotation.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeakerName -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeakerName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:bibliographicCitation>[21] T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV Ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>has speaker name</rdfs:label>
        <skos:definition>has as its speaker name</skos:definition>
        <skos:prefLabel>has speaker name</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores the name or identifier of a Speaker as a string, allowing participants to be distinguished within a conversation.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to record the name or label associated with a Speaker. Apply the same identifier consistently when the speaker appears in multiple turns.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSummary -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSummary">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:bibliographicCitation>[33] Dublin Core Metadata Initiative, “DCMI Metadata Terms,” Jan. 20, 2020. [Online]. Available: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/</dct:bibliographicCitation>
        <rdfs:label>has summary</rdfs:label>
        <skos:definition>has the content of a conversation move concisely described in context as</skos:definition>
        <cmns-av:adaptedFrom>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores a concise description of a CJF conversation move&apos;s meaning in context, rather than the original utterance text.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to summarize what a conversation move communicates. Keep the summary short and grounded in the source conversation.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTurnNumber -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTurnNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>has turn number</rdfs:label>
        <skos:definition>has its position in the conversation identified by</skos:definition>
        <skos:prefLabel>has turn number</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Stores the position of an Utterance in the conversation as an integer, allowing annotations to be traced to their source location.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to record the turn number associated with an Utterance. Preserve the original conversation numbering to maintain traceability and order.</cmns-av:usageNote>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://semanticscience.org/resource/SIO_000000 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000000">
        <dc:identifier>SIO_000000</dc:identifier>
        <dct:description xml:lang="en">Every thing is an entity.</dct:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </rdf:Description>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/About -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/About">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>about</rdfs:label>
        <skos:definition>CJF conversation move relationship in which a source Information Request concerns the content of a target Deliberative Conversation Move or Expressed Position.</skos:definition>
        <skos:example>Information Request Q1 makesIsAbout About AB1; About AB1 isAimedAtIsAbout Claim C1. Q1 asks what evidence supports C1.</skos:example>
        <skos:prefLabel>about</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the isAbout object property. Instead of directly linking an Information Request to its target conversation move, the About class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when an Information Request concerns an identifiable existing conversation move. Connect using makesIsAbout and isAimedAtIsAbout. A later contribution responding to the request uses respondsTo or answers instead.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>address</rdfs:label>
        <skos:definition>CJF conversation move relationship in which a source Claim, Option, or Outcome provides information, reasoning, a proposed solution, or a group decision that directly responds to the problem or concern represented by a target Issue, without necessarily resolving it.</skos:definition>
        <skos:example>Option O2 makesAddresses Address AD1; Address AD1 isAimedAtAddresses Issue I1. O2 proposes a solution to I1, but the group has not yet settled it.</skos:example>
        <skos:prefLabel>address</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the addresses object property. Instead of directly linking two conversation moves, the Address class represents the relationship as a separate individual. Resolve is a more specific type of Address.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a Claim, Option, or Outcome directly addresses an Issue, whether or not that Issue is settled. Connect using makesAddresses and isAimedAtAddresses.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:unionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed"/>
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                                                                </owl:unionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[29] W. Kunz and H. W. J. Rittel, “Issues as elements of information systems,” Institute of Urban and Regional Development, University of California, Berkeley, CA, USA, Working Paper No. 131, 1970. [Online]. Available: https://escholarship.org/uc/item/5cj786v8</dct:bibliographicCitation>
        <rdfs:label>addressed</rdfs:label>
        <skos:definition>A state of an Issue for which a Claim or Option provides information, reasoning, or a possible solution that directly responds to the problem or concern, without necessarily resolving it.</skos:definition>
        <skos:example>Option O1 responds to all parts of Issue I1, but the group has not settled I1; I1 is Addressed.</skos:example>
        <skos:prefLabel>addressed</skos:prefLabel>
        <skos:scopeNote>Issue only. Addressed concerns response coverage; Resolved requires an explicit group settlement; The reasoner will record a transition to Addressed when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://escholarship.org/uc/item/5cj786v8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Issue: A Claim or Option addresses the entire Issue.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>An addresses relationship can provide evidence that the entire Issue has been handled.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Agreement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Agreement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPositiveSupportedBy"/>
                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>agreement</rdfs:label>
        <skos:definition>an Expressed Position in which a participant explicitly endorses or accepts an identifiable Claim, Option, or Issue.</skos:definition>
        <skos:example>After another participant proposes O1, a speaker says, “I agree with O1.”</skos:example>
        <skos:prefLabel>agreement</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when the participant directly communicates agreement or acceptance. Do not confuse acknowledgment, repetition, or silence with agreement.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answer -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answer">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Response"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>answer</rdfs:label>
        <skos:definition>a response relationship in which a source Claim, Option, Issue, or Expressed Position provides a reply that satisfies the information need expressed by a target Information Request.</skos:definition>
        <skos:example>Claim C2 makesAnswers Answer A1; Answer A1 isAimedAtAnswers Information Request Q1. Q1 asks for a meeting date, and C2 gives that date.</skos:example>
        <skos:prefLabel>answer</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the answers object property. Instead of directly linking two conversation moves, the Answer class represents the relationship as a separate individual. Answer is a more specific type of Response.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use Answer when the reply satisfies the information request. Use Response for a relevant reply when satisfaction has not been established.</cmns-av:usageNote>
        <cmns-av:usageNote>Use only if the source contribution satisfies the information need expressed by the target Information Request. Connect the moves through makesAnswers and isAimedAtAnswers.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answered -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answered">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty>
                                                            <rdf:Description>
                                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/answers"/>
                                                            </rdf:Description>
                                                        </owl:onProperty>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>answered</rdfs:label>
        <skos:definition>state of an Information Request whose information need is satisfied by one or more contributions</skos:definition>
        <skos:example>An information request asks &quot;What time is it?&quot;. A claim answers with &quot;It is 8 am&quot;. The answer relationship between the claim and information request allows the state of the information request to be inferred as Answered.</skos:example>
        <skos:prefLabel>answered</skos:prefLabel>
        <skos:scopeNote>The Answered state applies when an Information Request&apos;s information need has been satisfied. The reasoner will record a transition to Answered when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when the information need is met; a relevant response alone does not establish Answered.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>challenge</rdfs:label>
        <skos:definition>CJF conversation move relationship in which a source Claim or Issue provides an objection, counterargument, or evidence against a target Claim, Option, or Issue.</skos:definition>
        <skos:example>Issue I2 makesChallenges Challenge CH1; Challenge CH1 isAimedAtChallenges Option O1. I2 raises a concern against O1.</skos:example>
        <skos:prefLabel>challenge</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the challenges object property. Instead of directly linking two conversation moves, the Challenge class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a Claim or Issue provides an identifiable objection, counterargument, or contrary evidence against a target Claim, Option, or Issue. Connect using makesChallenges and isAimedAtChallenges.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>claim</rdfs:label>
        <skos:definition>CJF conversation move that introduces an assertion, interpretation, assessment, explanation, or piece of evidence for the group to consider</skos:definition>
        <skos:example>A speaker presents a piece of evidence for the group to consider.</skos:example>
        <skos:prefLabel>claim</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>A Claim does not need an argumentative target. A proposed choice is an Option, and a preference toward it is an Expressed Position.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Add supports or challenges when the Claim is clearly used for or against an identifiable conversation move; Create one Claim for each distinct claim, even if originating from the same utterance.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove">
        <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasUtterance"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSummary"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSummary"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[24] R. Mallick et al., “Model of collective judgment formation for sequential teams in information-dense scenarios,” Proc. Human Factors Ergonom. Soc. Annu. Meeting, 2026, doi: 10.1177/10711813261475151.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[28] F. Macagno and S. Bigi, “Analyzing the pragmatic structure of dialogues,” Discourse Studies, vol. 19, no. 2, pp. 148–168, 2017, doi: 10.1177/1461445617691702.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>collective judgment formation conversation move</rdfs:label>
        <skos:definition>a functionally distinct contribution to a deliberative dialogue that represents an information request, issue, option, claim, expressed position, outcome, or other element of collective reasoning and decision-making, and that may be related to and evaluated through subsequent conversational contributions.</skos:definition>
        <skos:prefLabel>collective judgment formation conversation move</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1177/10711813261475151</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1177/1461445617691702</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use as the common superclass for all CJF move classes. Link each move to its source turn(s) and add relationships or states only where applicable.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship">
        <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasUtterance"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasReason"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasReason"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[3] N. Asher, J. Hunter, M. Morey, F. Benamara, and S. Afantenos, “Discourse structure and dialogue acts in multiparty dialogue: The STAC corpus,” in Proc. 10th International Conference on Language Resources and Evaluation (LREC’16), Portorož, Slovenia, 2016, pp. 2721–2727. [Online]. Available: https://aclanthology.org/L16-1432/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <rdfs:label>collective judgment formation conversation move relationship</rdfs:label>
        <skos:definition>relationship between a source CJF conversation move and a target CJF conversation move, represented as an individual to which information about that relationship can be attached</skos:definition>
        <skos:prefLabel>collective judgment formation conversation move relationship</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/L16-1432/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use this class only to reify relationships as individuals; keep it distinct from object properties such as supports and challenges.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested"/>
                                                                    </owl:Restriction>
                                                                </owl:intersectionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:unionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support"/>
                                                                </owl:unionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                                        <owl:someValuesFrom>
                                                                            <owl:Class>
                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported"/>
                                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
                                                                                </owl:unionOf>
                                                                            </owl:Class>
                                                                        </owl:someValuesFrom>
                                                                    </owl:Restriction>
                                                                </owl:intersectionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:unionOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>contested</rdfs:label>
        <skos:definition>a state of a Claim evidenced by a challenge from an Issue or another Claim.</skos:definition>
        <skos:example>Issue 1 challenges Claim C1; C1 is Contested.</skos:example>
        <skos:prefLabel>contested</skos:prefLabel>
        <skos:scopeNote>Classifies a Claim state as Contested when an assignment is triggered by Challenge with an Unassessed or Supported predecessor. Contested membership is retained from a Contested predecessor when the assignment is triggered by Support or Challenge. A Claim state may be both Contested and Supported when both conditions are met. The reasoner will record a transition to Contested when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Assign Contested when an Issue or Claim challenges the Claim. Retain Contested if the Claim subsequently receives support.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>conversation move with state</rdfs:label>
        <skos:definition>A collective judgment formation conversation move whose status is tracked through evidence-grounded State assignments as the conversation progresses.</skos:definition>
        <skos:example>An Issue remains the same conversation move while moving from Open to Addressed and later to Resolved.</skos:example>
        <skos:prefLabel>conversation move with state</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use hasStateAssignment to connect the move to a StateAssignment. Record its assignedState, effective conversation turn, and evidence.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[29] W. Kunz and H. W. J. Rittel, “Issues as elements of information systems,” Institute of Urban and Regional Development, University of California, Berkeley, CA, USA, Working Paper No. 131, 1970. [Online]. Available: https://escholarship.org/uc/item/5cj786v8</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>deliberative conversation move</rdfs:label>
        <skos:definition>a ConversationMoveWithState that introduces or develops the content of the group’s reasoning by stating a Claim, raising an Issue, or proposing an Option</skos:definition>
        <skos:example>An Issue about cost, an Option to reduce cost, and a Claim about the expected savings are deliberative content moves.</skos:example>
        <skos:prefLabel>deliberative conversation move</skos:prefLabel>
        <cmns-av:adaptedFrom>https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://escholarship.org/uc/item/5cj786v8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use as a superclass of Issue, Option, and Claim for axioms or queries shared by these types; do not classify Information Request, Expressed Position, or Outcome under this class.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeDialogue -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeDialogue">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/MultipartyConversation"/>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>deliberative dialogue</rdfs:label>
        <skos:definition>A type of multiparty dialogue in which participants engage in collaborative reasoning to address a problem, consider and evaluate possible courses of action, and seek agreement on a decision or course of action.</skos:definition>
        <skos:prefLabel>deliberative dialogue</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use to describe the deliberative interaction or context containing CJF conversation moves</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Disagreement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Disagreement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isNegativeSupportedBy"/>
                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>disagreement</rdfs:label>
        <skos:definition>An Expressed Position in which a participant explicitly disagrees with or rejects an identifiable Claim, Option, or Issue.</skos:definition>
        <skos:example>“I disagree with Platform A” expresses a disagreement position</skos:example>
        <skos:prefLabel>disagreement</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Use when the participant directly communicates disagreement; annotate a distinct concern as an Issue if present.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeaker"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isNegativeSupportedBy"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPositiveSupportedBy"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>expressed position</rdfs:label>
        <skos:definition>CJF conversation move that explicitly communicates a participant’s agreement or disagreement toward an identifiable deliberative conversation move</skos:definition>
        <skos:example>At Turn 12, Speaker C says “I prefer Platform B.” Expressed Position is inferred as Agreement through a positive conversational marker annotated as positive support.  Its position is toward the Platform B Option; link it to Speaker C and Turn 12.</skos:example>
        <skos:prefLabel>expressed position</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The type of position can be inferred as agreement or disagreement. Link the position to its target through hasPositionTowards, to its speaker through hasSpeaker, and to its source utterance through hasUtterance. An individual position is not by itself a group Outcome.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use for “I agree,” “That’s a good idea,” or “I vote for X” when the target is identifiable. Annotate a distinct explanation or concern in the same turn separately as a Claim or Issue; understanding without endorsement is not agreement.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answered"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Answered"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>information request</rdfs:label>
        <skos:altLabel>info-request</skos:altLabel>
        <skos:definition>CJF conversation move that creates an information need calling for another contribution to provide information, a claim, evidence, reasoning, an option, a position or reaction, or clarification</skos:definition>
        <skos:example>What do you think of Option O1?</skos:example>
        <skos:prefLabel>information request</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Annotate by the utterance&apos;s function. A rhetorical or assertive question counts only if it creates an information need; Create one information request for each distinct information need, even if originating from the same utterance.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolved"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolved"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>issue</rdfs:label>
        <skos:definition>CJF conversation move that introduces a problem, concern, challenge, objection, correction, limitation, or uncertainty requiring the group attention</skos:definition>
        <skos:example>A speaker raises the issue of deciding which platform to adopt for a development project.</skos:example>
        <skos:prefLabel>issue</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Disagreement alone is an Expressed Position; a request for an answer is an Information Request; a negative fact presented as evidence is a Claim.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when the speaker frames a specific problem for the group to address; Create one issue for each distinct issue requiring attention, even if originating from the same utterance.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/MultipartyConversation -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/MultipartyConversation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationIdentifier"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>multiparty conversation</rdfs:label>
        <skos:altLabel>multi-speaker conversation</skos:altLabel>
        <skos:definition>conversation among three or more identifiable participants who exchange ordered contributions that may respond to or build upon one another.</skos:definition>
        <skos:prefLabel>multiparty conversation</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The conversation contains ordered Turns and Utterances. Speaker identity and order support tracing a conversation move across contributions.</cmns-av:explanatoryNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Open">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[29] W. Kunz and H. W. J. Rittel, “Issues as elements of information systems,” Institute of Urban and Regional Development, University of California, Berkeley, CA, USA, Working Paper No. 131, 1970. [Online]. Available: https://escholarship.org/uc/item/5cj786v8</dct:bibliographicCitation>
        <rdfs:label>open</rdfs:label>
        <skos:definition>state of an Information Request or Issue when introduced, before evidence establishes another applicable state</skos:definition>
        <skos:example>Issue I1 is Open after a participant raises it and before it has been addressed.</skos:example>
        <skos:prefLabel>open</skos:prefLabel>
        <skos:scopeNote>Open is the initial state established when an information request is introduced; Open is the initial state when an Issue is introduced.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://escholarship.org/uc/item/5cj786v8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Assign when the Information Request or Issue is introduced; retain until conversational evidence establishes another state.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Rejected"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Selected"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/UnderConsideration"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Rejected"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Selected"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/UnderConsideration"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>option</rdfs:label>
        <skos:altLabel>proposal</skos:altLabel>
        <skos:altLabel>proposed solution</skos:altLabel>
        <skos:definition>CJF conversation move that introduces a possible solution or course of action for the group to consider</skos:definition>
        <skos:example>A speaker proposes a possible solution to a problem the group is discussing.</skos:example>
        <skos:prefLabel>option</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Create one Option for each distinct candidate, even if originating from the same utterance.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <rdfs:label>outcome</rdfs:label>
        <skos:altLabel>decision</skos:altLabel>
        <skos:altLabel>resolution</skos:altLabel>
        <skos:definition>CJF conversation move that records an established group-level selection, resolution, or commitment reached through deliberation</skos:definition>
        <skos:example>The group establishes a decision to select an Option.</skos:example>
        <skos:prefLabel>outcome</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>A majority decision can be an Outcome without unanimity; an individual vote cannot establish one by itself.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Annotated only when the conversation establishes the result as the group’s decision.</cmns-av:usageNote>
        <cmns-av:usageNote>Use Issue for the concern raised for deliberation and Outcome for the group decision or commitment reached through deliberation.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Position -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Position">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>position</rdfs:label>
        <skos:definition>CJF conversation move relationship in which the source Expressed Position expresses the speaker&apos;s attitude toward the target deliberative conversation move</skos:definition>
        <skos:example>Expressed Position EP1 makesPositionTowards Position P1; Position P1 isAimedAtPositionTowards Option O1. EP1 expresses agreement with O1.</skos:example>
        <skos:prefLabel>position</skos:prefLabel>
        <skos:scopeNote>A CJF conversation move relationship connecting an Expressed Position to the deliberative conversation move toward which the participant expresses an attitude. This relationship is distinct from the ExpressedPosition conversation move itself.</skos:scopeNote>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the hasPositionTowards object property. Instead of directly linking an Expressed Position to its target conversation move, the Position class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use to connect an explicit Expressed Position to the deliberative conversation move that it concerns. Represent the relationship through makesPositionTowards and isAimedAtPositionTowards.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Refinement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Refinement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>refinement</rdfs:label>
        <skos:definition>CJF conversation move relationship in which a source Claim, Option, or Issue extends, corrects, or reformulates the content of an earlier target conversation move of the same type</skos:definition>
        <skos:example>Option O2 makesRefines Refinement RF1; Refinement RF1 isAimedAtRefines Option O1. O2 revises the earlier Option O1.</skos:example>
        <skos:prefLabel>refinement</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the refines object property. Instead of directly linking two conversation moves, the Refinement class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a later Claim refines a Claim, an Option refines an Option, or an Issue refines an Issue. Connect using makesRefines and isAimedAtRefines.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Rejected -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Rejected">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>rejected</rdfs:label>
        <skos:definition>state of an Option evidenced by a group-level decision to rule out the Option as a possible course of action</skos:definition>
        <skos:example>The group rules out Option O1; O1 is Rejected.</skos:example>
        <skos:prefLabel>rejected</skos:prefLabel>
        <skos:scopeNote>Applies to Options</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Clear group-level evidence establishes that the option has been ruled out; expressing a position of disagreement or rejection should not automatically change the option to Rejected, it can still be under consideration even if people disagree/reject it.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolve -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolve">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Address"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <rdfs:label>resolve</rdfs:label>
        <skos:definition>an address relationship in which a source Outcome explicitly settles the problem or concern represented by a target Issue through a group-level decision or agreement.</skos:definition>
        <skos:example>Outcome OUT1 makesResolves Resolve RV1; Resolve RV1 isAimedAtResolves Issue I1. OUT1 records a group agreement settling I1.</skos:example>
        <skos:prefLabel>resolve</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the resolves object property. Instead of directly linking two conversation moves, the Resolve class represents the relationship as a separate individual. Resolve is a more specific type of Address.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only when a group Outcome explicitly settles the target Issue. Connect the Outcome and Issue through makesResolves and isAimedAtResolves.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolved -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolved">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Addressed"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Resolve"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty>
                                                            <rdf:Description>
                                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/resolves"/>
                                                            </rdf:Description>
                                                        </owl:onProperty>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[29] W. Kunz and H. W. J. Rittel, “Issues as elements of information systems,” Institute of Urban and Regional Development, University of California, Berkeley, CA, USA, Working Paper No. 131, 1970. [Online]. Available: https://escholarship.org/uc/item/5cj786v8</dct:bibliographicCitation>
        <rdfs:label>resolved</rdfs:label>
        <skos:definition>state of an Issue evidenced by a group Outcome that explicitly settles the concern it represents</skos:definition>
        <skos:example>Outcome U1 records the group’s decision settling Issue I1; I1 is Resolved.</skos:example>
        <skos:prefLabel>resolved</skos:prefLabel>
        <skos:scopeNote>Issue only. Requires an Outcome indicating that the group has settled it. The reasoner will record a transition to Resolved when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://escholarship.org/uc/item/5cj786v8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Issue: An Outcome resolves the Issue.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>An Outcome resolves the Issue; a response or an individual’s acceptance alone does not establish Resolved.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Response -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Response">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>response</rdfs:label>
        <skos:definition>A CJF conversation move relationship in which a source Claim, Option, Issue, or Expressed Position provides a relevant reply to the information need expressed by a target Information Request, without necessarily satisfying that need.</skos:definition>
        <skos:example>Claim C2 makesRespondsTo Response R1; Response R1 isAimedAtRespondsTo Information Request Q1. C2 is relevant to Q1 but does not fully answer it.</skos:example>
        <skos:prefLabel>response</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the respondsTo object property. Instead of directly linking two conversation moves, the Response class represents the relationship as a separate individual. Answer is a more specific type of Response.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a contribution responds to the information need in an Information Request, even when the request remains unanswered. Connect the source and target through makesRespondsTo and isAimedAtRespondsTo.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Select -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Select">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[12] G. Karadzhov, T. Stafford, and A. Vlachos, “DeliData: A dataset for deliberation in multi-party problem solving,” Proceedings of the ACM on Human-Computer Interaction, vol. 7, no. CSCW2, Art. no. 265, pp. 1–25, Oct. 2023, doi: 10.1145/3610056.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <rdfs:label>select</rdfs:label>
        <skos:definition>CJF conversation move relationship in which a source Outcome records the group&apos;s selection of a target Option.</skos:definition>
        <skos:example>Outcome OUT1 makesSelects Selection SEL1; Selection SEL1 isAimedAtSelects Option O1. OUT1 records the group&apos;s selection of O1.</skos:example>
        <skos:prefLabel>select</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1145/3610056</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the selects object property. Instead of directly linking an Outcome to an Option, the Selection class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use only when an Outcome explicitly records the group&apos;s selection of an Option. An individual preference or vote does not establish group selection. Connect using makesSelects and isAimedAtSelects.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Selected -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Selected">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/UnderConsideration"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty>
                                                            <rdf:Description>
                                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/selects"/>
                                                            </rdf:Description>
                                                        </owl:onProperty>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>selected</rdfs:label>
        <skos:definition>state of an Option evidenced by a group Outcome that explicitly chooses the Option</skos:definition>
        <skos:example>Outcome U1 selects Option O1; O1 is Selected.</skos:example>
        <skos:prefLabel>selected</skos:prefLabel>
        <skos:scopeNote>Option only. Requires a group Outcome selecting the Option; The reasoner will record a transition to Selected when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Option: An Outcome conversation move selects the Option.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>An individual preference or vote is an Expressed Position and does not alone make the Option Selected.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeakerName"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[21] T. Lebo, S. Sahoo, and D. McGuinness, Eds., “PROV-O: The PROV Ontology,” W3C Recommendation, Apr. 30, 2013. [Online]. Available: https://www.w3.org/TR/prov-o/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>speaker</rdfs:label>
        <skos:definition>prov:Agent that participates in a multiparty conversation and is identified as the source of one or more Utterances</skos:definition>
        <skos:example>Speaker S3 introduces the Utterance that contains Option O1.</skos:example>
        <skos:prefLabel>speaker</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/prov-o/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Speaker identity supports tracing who introduced source utterances and, through provenance chains, who is associated with an Expressed Position.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use a stable speaker identifier even when the transcript anonymizes participant names.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State">
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:description>resolution and open questions motivate selected distinctions.</dct:description>
        <rdfs:label>state</rdfs:label>
        <skos:definition>status assigned to a CJF conversation move at a specified point in a conversation based on evidence of how its information need, issue, option, or claim has been addressed or evaluated</skos:definition>
        <skos:example>The cost Issue is Open when raised at Turn 5, Addressed when an Option addresses it at Turn 15, and Resolved when a group Outcome resolves it at Turn 18.</skos:example>
        <skos:prefLabel>state</skos:prefLabel>
        <skos:scopeNote>Applicable states depend on the conversation move type. For example, an Issue can be Open, Addressed, or Resolved, while an Option can be Under Consideration or Selected.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W08-0125/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/W10-1012/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>A state may change as later turns provide evidence.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Require evidence for a state change which is recorded in StateAssignment; the absence of further objections does not establish Resolved. Keep an Expressed Position’s positionType distinct from a conversation move’s State.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateEvidence"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedAtUtterance"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasReason"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[13] R. Fernández, M. Frampton, P. Ehlen, M. Purver, and S. Peters, “Modelling and detecting decisions in multi-party dialogue,” in Proc. 9th SIGdial Workshop on Discourse and Dialogue, Columbus, OH, USA, 2008, pp. 156–163. [Online]. Available: https://aclanthology.org/W08-0125/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[1] J. Kim, J. Li, and T. Kim, “Towards identifying unresolved discussions in student online forums,” in Proc. NAACL HLT 2010 Fifth Workshop on Innovative Use of NLP for Building Educational Applications, Los Angeles, CA, USA, 2010, pp. 84–91. [Online]. Available: https://aclanthology.org/W10-1012/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[32] N. Noy and A. Rector, Eds., “Defining N-ary Relations on the Semantic Web,” W3C Working Group Note, Apr. 12, 2006. [Online]. Available: https://www.w3.org/TR/swbp-n-aryRelations/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[36] P. Ciccarese, S. Soiland-Reyes, K. Belhajjame, A. J. G. Gray, C. Goble, and T. Clark, “PAV ontology: Provenance, authoring and versioning,” Journal of Biomedical Semantics, vol. 4, art. no. 37, 2013, doi: 10.1186/2041-1480-4-37.</dct:bibliographicCitation>
        <rdfs:label>state assignment</rdfs:label>
        <skos:definition>record that associates a CJF conversation move with state with one State at a specified Utterance and with the Text Span evidence supporting that state assignment</skos:definition>
        <skos:example>claim1_assignment2 records Supported at utterance_0370 with evidence span_0370_support.</skos:example>
        <skos:prefLabel>state assignment</skos:prefLabel>
        <cmns-av:adaptedFrom>https://doi.org/10.1186/2041-1480-4-37</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://www.w3.org/TR/swbp-n-aryRelations/</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Preserve earlier assignment records when a conversation move changes state. Assignment records include both initial states and subsequent changes.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[31] N. Tran, D. Litman, and A. Godley, “Using large language models to analyze students’ collaborative argumentation in classroom discussions,” in Proc. Artificial Intelligence in Measurement and Education Conference (AIME-Con): Full Papers, Pittsburgh, PA, USA, 2025, pp. 111–125. [Online]. Available: https://aclanthology.org/2025.aimecon-main.13/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>support</rdfs:label>
        <skos:definition>A CJF conversation move relationship in which a source Claim provides evidence, reasoning, or an explanation in favor of a target Claim, Option, or Issue.</skos:definition>
        <skos:example>Claim C2 makesSupports Support S1; Support S1 isAimedAtSupports Option O1. C2 gives a reason in favor of O1.</skos:example>
        <skos:prefLabel>support</skos:prefLabel>
        <cmns-av:adaptedFrom>https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://aclanthology.org/2025.aimecon-main.13/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom>https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Created by reifying the supports object property. Instead of directly linking two conversation moves, the Support class represents the relationship as a separate individual.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Use when a Claim offers identifiable evidence, reasoning, or explanation in favor of the target Claim, Option, or Issue. Connect it using makesSupports and isAimedAtSupports.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Supported"/>
                                                                    </owl:Restriction>
                                                                </owl:intersectionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:unionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support"/>
                                                                </owl:unionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState"/>
                                                                        <owl:someValuesFrom>
                                                                            <owl:Class>
                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Contested"/>
                                                                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
                                                                                </owl:unionOf>
                                                                            </owl:Class>
                                                                        </owl:someValuesFrom>
                                                                    </owl:Restriction>
                                                                </owl:intersectionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTriggeringRelationship"/>
                                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Support"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:unionOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty>
                                            <rdf:Description>
                                                <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
                                            </rdf:Description>
                                        </owl:onProperty>
                                        <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[16] P. Baroni, M. Romano, F. Toni, M. Aurisicchio, and G. Bertanza, “Automatic evaluation of design alternatives with quantitative argumentation,” Argument &amp; Computation, vol. 6, no. 1, pp. 24–49, 2015, doi: 10.1080/19462166.2014.1001791.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[7] R. Ruiz-Dolz, J. Lawrence, E. Schad, and C. Reed, “Overview of DialAM-2024: Argument mining in natural language dialogues,” in Proc. 11th Workshop on Argument Mining (ArgMining 2024), Bangkok, Thailand, 2024, pp. 83–92, doi: 10.18653/v1/2024.argmining-1.8.</dct:bibliographicCitation>
        <dct:bibliographicCitation>[9] C. Olshefski, L. Lugini, R. Singh, D. Litman, and A. Godley, “The Discussion Tracker corpus of collaborative argumentation,” in Proc. 12th Language Resources and Evaluation Conference, Marseille, France, 2020, pp. 1033–1043. [Online]. Available: https://aclanthology.org/2020.lrec-1.130/</dct:bibliographicCitation>
        <rdfs:label>supported</rdfs:label>
        <skos:definition>a state of a Claim evidenced by supporting information or reasoning from another Claim.</skos:definition>
        <skos:example>Claim 2 supports Claim C1; C1 is Supported.</skos:example>
        <skos:prefLabel>supported</skos:prefLabel>
        <skos:scopeNote>Classifies a Claim state as Supported when an assignment is triggered by Support with an Unassessed or Contested predecessor. Supported membership is retained from a Supported predecessor when the assignment is triggered by Support or Challenge. A Claim state may be both Supported and Contested when both conditions are met; The reasoner will record a transition to Supported when the required conditions are represented</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2020.lrec-1.130/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1080/19462166.2014.1001791</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.18653/v1/2024.argmining-1.8</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Assign Supported when another Claim supports the Claim. Retain Supported if the Claim is subsequently challenged.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationText"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A Quick Start Guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[22] W3C, “Web Annotation Data Model,” W3C Recommendation, Feb. 23, 2017. [Online]. Available: https://www.w3.org/TR/annotation-model/</dct:bibliographicCitation>
        <rdfs:label>text span</rdfs:label>
        <skos:definition>contiguous segment of transcript text delimited by start and end positions and used as the specific target of an annotation</skos:definition>
        <skos:example>In Turn 12, the characters covering “Option B costs less” form the Text Span supporting Claim C1.</skos:example>
        <skos:prefLabel>text span</skos:prefLabel>
        <skos:scopeNote>The exact section of transcript text used as evidence for an annotation.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/annotation-model/</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>A Text Span connects an annotation to specific words in the conversation. It can be shorter than an Utterance.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Record where the text begins and ends in the transcript. Update these positions if the transcript changes.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[16] P. Baroni, M. Romano, F. Toni, M. Aurisicchio, and G. Bertanza, “Automatic evaluation of design alternatives with quantitative argumentation,” Argument &amp; Computation, vol. 6, no. 1, pp. 24–49, 2015, doi: 10.1080/19462166.2014.1001791.</dct:bibliographicCitation>
        <rdfs:label>unassessed</rdfs:label>
        <skos:definition>state of a Claim introduced into the conversation, before evidence establishes another applicable state</skos:definition>
        <skos:example>Claim C1 is introduced without a clear group assessment; C1 is Unassessed.</skos:example>
        <skos:prefLabel>unassessed</skos:prefLabel>
        <skos:scopeNote>Initial state for a newly introduced Claim.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1080/19462166.2014.1001791</cmns-av:adaptedFrom>
        <cmns-av:usageNote>Apply initially when the Claim has been recorded but no group support or challenge can be established; revise when later evidence warrants a state change.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/UnderConsideration -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/UnderConsideration">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[30] P. McBurney, D. Hitchcock, and S. Parsons, “The eightfold way of deliberation dialogue,” International Journal of Intelligent Systems, vol. 22, no. 1, pp. 95–132, 2007, doi: 10.1002/int.20191.</dct:bibliographicCitation>
        <rdfs:label>under consideration</rdfs:label>
        <skos:definition>state of a proposed Option when introduced, before evidence establishes another applicable state</skos:definition>
        <skos:example>Option O1 has been proposed; the group has not decided on it, so O1 is Under Consideration.</skos:example>
        <skos:prefLabel>under consideration</skos:prefLabel>
        <skos:scopeNote>Initial state for an Option when it is proposed.</skos:scopeNote>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1002/int.20191</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>Option: Under Consideration is the initial state of a proposed option.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>A participant’s disagreement does not automatically remove an Option from consideration.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime"/>
                <owl:allValuesFrom rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasConversationText"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasTurnNumber"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dct:bibliographicCitation>[14] M. G. Core and J. F. Allen, “Coding dialogs with the DAMSL annotation scheme,” in Working Notes of the AAAI Fall Symposium on Communicative Action in Humans and Machines, 1997, pp. 28–35. [Online]. Available: https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[20] Centre for Argument Technology, “A quick start guide to Inference Anchoring Theory (IAT),” May 2, 2022. [Online]. Available: https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</dct:bibliographicCitation>
        <dct:bibliographicCitation>[8] V. D. Lai, D. N. Pham, J. Steinberg, J. Mikeska, and T. H. Nguyen, “CAMAL: A novel dataset for multi-label conversational argument move analysis,” in Proc. 2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING 2024), Torino, Italy, 2024, pp. 2673–2682. [Online]. Available: https://aclanthology.org/2024.lrec-main.239/</dct:bibliographicCitation>
        <rdfs:label>utterance</rdfs:label>
        <skos:definition>speaker-attributed segment of a conversation bounded for annotation as one communicative contribution and capable of expressing one or more dialogue functions</skos:definition>
        <skos:example>“I prefer Option B because it costs less” is one Utterance that may ground an Expressed Position and a Claim.</skos:example>
        <skos:prefLabel>utterance</skos:prefLabel>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://aclanthology.org/2024.lrec-main.239/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.arg.tech/f/IATannotationguidelines-2022-05.pdf</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>An Utterance belongs to a Turn. A Turn can contain multiple Utterances.</cmns-av:explanatoryNote>
        <cmns-av:usageNote>Divide conversation text into contributions within a turn. Do not assume every sentence is a separate Utterance.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://w3id.org/deliberation/ontology#Contribution -->

    <owl:Class rdf:about="https://w3id.org/deliberation/ontology#Contribution">
        <rdfs:comment>Any input provided by a participant in a deliberation.</rdfs:comment>
        <rdfs:label>Contribution</rdfs:label>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/DateTime -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime">
        <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant"/>
        <rdfs:label>date time</rdfs:label>
        <skos:definition>time point including a date and a time, optionally including a time zone offset</skos:definition>
        <skos:note>&apos;has date time value&apos; is omitted if the &apos;date time&apos; is not (yet) known. The time zone is implicitly UTC.</skos:note>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity">
        <rdfs:label>temporal entity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <skos:definition>time interval or instant</skos:definition>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant">
        <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity"/>
        <rdfs:label>time instant</rdfs:label>
        <skos:definition>temporal entity that is a member of a time scale, with no extent or duration</skos:definition>
        <skos:example>The Battle of Hastings was on &apos;14 October 1066&apos;. (This gives the Julian date of the battle at a granularity of &apos;day&apos;. If desired, the battle could be given more precisely as a time period within that calendar day.)</skos:example>
        <skos:note>For scales that have a granularity specified in days, a date is a time point; for scales down to the seconds, the equivalent of an xsd:dateTime or xsd:dateTimeStamp is a time point.</skos:note>
        <skos:note>The duration of each time interval that is an instance of the time point is the granularity of the time scale of the time point.</skos:note>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.omg.org/spec/DTV/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/owl-time/#time:Instant</cmns-av:adaptedFrom>
        <cmns-av:synonym>instant in time</cmns-av:synonym>
        <cmns-av:synonym>time point</cmns-av:synonym>
    </owl:Class>
    


