  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_899f398e4c9324a6ca58">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>I’m voting for Platform A as well. The full cost comparison and the integration test changed my mind.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_27"/>
    <rdfs:label>Text span Span_899f398e4c9324a6ca58</rdfs:label>
    <skos:definition>Conversation text span: “I’m voting for Platform A as well. The full cost comparison and the integration test changed my mind.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_908d1b67947cf090e9a6">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>I’ve checked those quotes too. Platform A includes the connectors and vendor onboarding in its price, so the revised comparison actually puts Platform A lower.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_14"/>
    <rdfs:label>Text span Span_908d1b67947cf090e9a6</rdfs:label>
    <skos:definition>Conversation text span: “I’ve checked those quotes too. Platform A includes the connectors and vendor onboarding in its price, so the revised comparison actually puts Platform A lower.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_206894ef89a1b7994cb0">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>We could use Platform A.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_2"/>
    <rdfs:label>Text span Span_206894ef89a1b7994cb0</rdfs:label>
    <skos:definition>Conversation text span: “We could use Platform A.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_33f1186a2b40a1f7b8a3">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Its base subscription is $12,000 a year, so I expect Platform B would cost us less overall.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_10"/>
    <rdfs:label>Text span Span_33f1186a2b40a1f7b8a3</rdfs:label>
    <skos:definition>Conversation text span: “Its base subscription is $12,000 a year, so I expect Platform B would cost us less overall.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/State_7de8b4a5d0de7ec78981">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
    <rdfs:label>state state State_7de8b4a5d0de7ec78981</rdfs:label>
    <skos:definition>Recorded state state value in the sample conversation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_7b799de6c01a283e5aa5">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>and the funds are still available.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_16"/>
    <rdfs:label>Text span Span_7b799de6c01a283e5aa5</rdfs:label>
    <skos:definition>Conversation text span: “and the funds are still available.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_9dba47deb827f27a7021">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Agreed. Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_18"/>
    <rdfs:label>Text span Span_9dba47deb827f27a7021</rdfs:label>
    <skos:definition>Conversation text span: “Agreed. Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.”</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_bb729291b1ff0433afd4">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Then we could cover Platform A’s $6,000 gap by moving the funds reserved for the reporting add-on. Both platforms already include the basic reporting this project needs.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_15"/>
    <rdfs:label>Text span Span_bb729291b1ff0433afd4</rdfs:label>
    <skos:definition>Conversation text span: “Then we could cover Platform A’s $6,000 gap by moving the funds reserved for the reporting add-on. Both platforms already include the basic reporting this project needs.”</skos:definition>
  </rdf:Description>
