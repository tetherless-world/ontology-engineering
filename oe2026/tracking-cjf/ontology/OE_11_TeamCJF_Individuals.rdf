  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/individuals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/individuals/OE_11/"/>
    <owl:priorVersion rdf:resource="https://raw.githubusercontent.com/DevinDeSilva/ontology-engineering/df1d49e3ae8ce1245100b112f14c182000cd5f23/oe2026/tracking-cjf/prev-ontology-versions/OE_10/OE_10_TeamCJF_Individuals.rdf"/>
    <owl:imports rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"/>
    <dct:creator>Devin De Silva</dct:creator>
    <dct:creator>Matthew Lausev</dct:creator>
    <dct:creator>Srihari Sridharan</dct:creator>
    <dct:creator>Tiziana Hernandez</dct:creator>
    <dct:publisher>Tracking CJF</dct:publisher>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-13</dct:modified>
    <dct:abstract>Contains annotated individuals for a multiparty conversation, including conversation moves, relationships, speakers, utterances, evidence and state assignments used to represent and query the evolving process of collective judgment formation.</dct:abstract>
    <skos:changeNote>Updated ontology metadata and version links, and added labels, definitions and explanatory notes for the conversation data. Kept matching copies with and without current-state links for SHACL processing.</skos:changeNote>
  </rdf:Description>
