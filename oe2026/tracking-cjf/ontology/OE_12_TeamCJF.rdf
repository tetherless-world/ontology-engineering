		<cmns-av:adaptedFrom rdf:datatype="&xsd;anyURI">https://markcore.github.io/papers/97.Core-Allen.AAAI.pdf</cmns-av:adaptedFrom>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;ExpressedPosition">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<rdfs:subClassOf rdf:nodeID="blank239"/>
		<rdfs:subClassOf rdf:nodeID="blank240"/>
