    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 12</rdfs:label>
        <tracking-cjf:hasConversationText>I’m not sure that cost comparison includes everything. Doesn’t Platform B require separate licenses for the deployment and identity extensions?</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn13FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn13FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 13</rdfs:label>
        <tracking-cjf:hasConversationText>It does. I put together a fuller estimate this morning. The required licenses add $8,000, and training adds another $6,000. That puts Platform B at $26,000 for the first year, compared with $24,000 for Platform A.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn13"/>
    </owl:NamedIndividual>


