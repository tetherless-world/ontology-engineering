    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn5FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn5FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 5</rdfs:label>
        <tracking-cjf:hasConversationText>My concern is the cost. Platform A looks more expensive than we can afford with the current tooling budget.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn5"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn6FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn6FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 6</rdfs:label>
        <tracking-cjf:hasConversationText>The annual quote is $24,000, and we have $18,000 allocated. So there’s a $6,000 gap we would need to cover.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn6"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 15</rdfs:label>
        <tracking-cjf:hasConversationText>Then we could cover Platform A’s $6,000 gap by moving the funds reserved for the reporting add-on. Both platforms already include the basic reporting this project needs.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn16FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn16FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 16</rdfs:label>
        <tracking-cjf:hasConversationText>I manage that budget, and the funds are still available. I’m comfortable moving them because we haven’t committed to purchasing the add-on.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn16"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn17FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn17FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 17</rdfs:label>
        <tracking-cjf:hasConversationText>I agree with that reallocation. We can deliver the required reports without the separate add-on.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn17"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn18FullTextSpan -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn18FullTextSpan">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <rdfs:label>Full utterance evidence, source turn 18</rdfs:label>
        <tracking-cjf:hasConversationText>Agreed. Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.</tracking-cjf:hasConversationText>
        <tracking-cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn18"/>
    </owl:NamedIndividual>


