<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/cq-sample-conversation/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:resource="http://semanticscience.org/resource/" xmlns:tracking-cjf="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/" xmlns:DatesAndTimes="https://www.omg.org/spec/Commons/DatesAndTimes/" xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/cq-sample-conversation/">
    <owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/cq-sample-conversation">
        <owl:imports rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"/>
        <dct:abstract xmlns:dct="http://purl.org/dc/terms/">Extends the team's annotated platform discussion with four selected-option agreement connections and one information-request answer transition, retaining the source individuals and evidence.</dct:abstract>
        <dct:creator xmlns:dct="http://purl.org/dc/terms/">Devin De Silva</dct:creator>
        <dct:creator xmlns:dct="http://purl.org/dc/terms/">Matthew Lausev</dct:creator>
        <dct:creator xmlns:dct="http://purl.org/dc/terms/">Srihari Sridharan</dct:creator>
        <dct:creator xmlns:dct="http://purl.org/dc/terms/">Tiziana Hernandez</dct:creator>
        <rdfs:label>CJF sample conversation CQs and answers</rdfs:label>
    </owl:Ontology>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn1 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn1">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>We need to choose a platform for the new development project today so we can start setting up the environment next week.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn2 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn2">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>We could use Platform A. It seems like the better fit for our delivery schedule.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn3 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn3">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>What makes you say that? Are you mainly thinking about the setup work?</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn4 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn4">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>Yes. Platform A could simplify implementation because it already includes the repository management, issue tracking, and deployment tools we need.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn5 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn5">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>My concern is the cost. Platform A looks more expensive than we can afford with the current tooling budget.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn6 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn6">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>The annual quote is $24,000, and we have $18,000 allocated. So there’s a $6,000 gap we would need to cover.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn7 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn7">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText>I’m also worried about training. Most of the developers haven’t used Platform A, and we haven’t allowed much time for onboarding.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn8 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn8">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerC"/>
        <tracking-cjf:hasConversationText>That’s fair, although Platform A integrates well with our existing systems. The connector worked with our identity service and build pipeline in last week’s test.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn9 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn9">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerC"/>
        <tracking-cjf:hasConversationText>I’d still prefer Platform B at this point. We should consider adopting it instead, especially given the budget gap.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn10 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn10">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerC"/>
        <tracking-cjf:hasConversationText>Its base subscription is $12,000 a year, so I expect Platform B would cost us less overall.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn11 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn11">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText>Would we have it ready in time, though? Platform B needs additional configuration, and we only have two weeks before development starts.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>I’m not sure that cost comparison includes everything. Doesn’t Platform B require separate licenses for the deployment and identity extensions?</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn13 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn13">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText>It does. I put together a fuller estimate this morning. The required licenses add $8,000, and training adds another $6,000. That puts Platform B at $26,000 for the first year, compared with $24,000 for Platform A.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn14 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn14">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>I’ve checked those quotes too. Platform A includes the connectors and vendor onboarding in its price, so the revised comparison actually puts Platform A lower.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>Then we could cover Platform A’s $6,000 gap by moving the funds reserved for the reporting add-on. Both platforms already include the basic reporting this project needs.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn16 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn16">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>I manage that budget, and the funds are still available. I’m comfortable moving them because we haven’t committed to purchasing the add-on.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn17 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn17">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText>I agree with that reallocation. We can deliver the required reports without the separate add-on.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn18 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn18">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerC"/>
        <tracking-cjf:hasConversationText>Agreed. Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn19 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn19">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText>That settles the funding concern. I still need an answer on training, though. Having onboarding included doesn’t tell us when people can attend.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn20 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn20">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>We could use Monday’s five-to-six training slot for a vendor-led session, then give developers the recording and a practice environment.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn21 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn21">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
        <tracking-cjf:hasConversationText> I’m not sure that training arrangement will work yet. I need to check whether the release team can attend Monday from five to six and whether the vendor is available then.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn22 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn22">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <tracking-cjf:hasConversationText>What does the onboarding cover? If it’s only a product overview, people could still struggle with their first deployment.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn23 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn23">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
