    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn20 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn20">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerA"/>
        <tracking-cjf:hasConversationText>We could use Monday’s five-to-six training slot for a vendor-led session, then give developers the recording and a practice environment.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</tracking-cjf:hasTurnNumber>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
    </owl:NamedIndividual>


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn21 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn21">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerD"/>
