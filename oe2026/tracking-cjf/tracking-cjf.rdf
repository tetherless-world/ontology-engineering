    <!-- http://semanticscience.org/resource/SIO_000001 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000001"/>
    


    <!-- http://semanticscience.org/resource/SIO_000053 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000053">
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000068 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000068"/>
    


    <!-- http://semanticscience.org/resource/SIO_000093 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000093">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000093</dc:identifier>
        <dct:description xml:lang="en">is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole.</dct:description>
        <resource:equivalentTo>OBO_REL:proper_part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is proper part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000206 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000206">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000772"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000208"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
        <dc:identifier>SIO_000206</dc:identifier>
        <dct:description xml:lang="en">is supported by is a relation between a proposition and something that supports the truth of the assertion.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is supported by</rdfs:label>
        <skos:definition>directed grounding relationship linking a CJF Milestone to the Text Span that provides transcript evidence for the milestone annotation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000208 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000208"/>
    


    <!-- http://semanticscience.org/resource/SIO_000772 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000772"/>
    


    <!-- http://semanticscience.org/resource/SIO_001403 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_001403">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:description xml:lang="en">x is associated with y when x and y are logically or statistically related to one another.</dc:description>
        <dc:identifier>SIO_001403</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#contributed -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#contributed">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#hadMember -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#hadMember">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#wasMemberOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>hadMember</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>expanded</prov:component>
        <prov:inverse>wasMemberOf</prov:inverse>
        <prov:sharesDefinitionWith rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections.</rdfs:comment>
        <prov:dm>http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection</prov:dm>
    </owl:Axiom>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Attribution is the ascribing of an entity to an agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>wasAttributedTo</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:definition xml:lang="en">Attribution is the ascribing of an entity to an agent.</prov:definition>
        <prov:inverse>contributed</prov:inverse>
        <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#Attribution"/>
        <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#qualifiedAttribution"/>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
        <rdfs:comment>Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.</rdfs:comment>
        <prov:definition>IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. </prov:definition>
    </owl:Axiom>
    


    <!-- http://www.w3.org/ns/prov#wasInfluencedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy"/>
    


    <!-- http://www.w3.org/ns/prov#wasMemberOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasMemberOf"/>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/addresses -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/addresses">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Outcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Issue"/>
        <rdfs:label>addresses</rdfs:label>
        <skos:definition>substantively engages with the concern represented by</skos:definition>
        <skos:prefLabel>addresses</skos:prefLabel>
        <skos:scopeNote>Directed: Claim, Option, or Outcome → Issue. Handles the Issue without necessarily settling it.</skos:scopeNote>
        <cmns-av:usageNote>Use resolves when an explicit Outcome settles the Issue</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/answers -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/answers">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/respondsTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/InformationRequest"/>
        <rdfs:label>answers</rdfs:label>
        <skos:definition>provides a response that fully satisfies the information need expressed by</skos:definition>
        <skos:prefLabel>answers</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedAtUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedAtUtterance">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
        <skos:definition>records a milestone’s state as becoming applicable at</skos:definition>
        <skos:prefLabel>assigned at utterance</skos:prefLabel>
        <cmns-av:usageNote>Identifies where the state becomes applicable in the conversation, rather than when an annotator entered the record. The turn number belongs to the linked Utterance.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <skos:definition>records the milestone’s condition at the specified point in the conversation as</skos:definition>
        <skos:prefLabel>assigned state</skos:prefLabel>
        <cmns-av:usageNote>Records the state for that assignment</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/challenges -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/challenges">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Issue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:label>challenges</rdfs:label>
        <skos:definition>provides evidence or reasoning that weakens or rebuts the epistemic standing of</skos:definition>
        <skos:prefLabel>challenges</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasPositionTowards -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasPositionTowards">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:label>has position towards</rdfs:label>
        <skos:definition>expresses the speaker’s attitude toward</skos:definition>
        <skos:prefLabel>has position towards</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasPreviousAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasPreviousAssignment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <skos:definition>has as its immediately preceding state record for the same milestone</skos:definition>
        <skos:prefLabel>has previous assignment</skos:prefLabel>
        <cmns-av:usageNote>Omit for the initial state assignment. The preceding assignment must concern the same milestone (the current cardinality restriction does not enforce that condition.)</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasSpeaker -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasSpeaker">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_001403"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000206"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPartOfUtterance"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo"/>
        </owl:propertyChainAxiom>
        <rdfs:label>has speaker</rdfs:label>
        <skos:definition>is expressed in a conversational contribution made by</skos:definition>
        <skos:prefLabel>has speaker</skos:prefLabel>
        <cmns-av:explanatoryNote>The relationship is inferred from the conversational contribution that expresses the milestone.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <skos:definition>has its evidence-based standing at a specified point in the conversation characterized by</skos:definition>
        <skos:prefLabel>has state</skos:prefLabel>
        <skos:scopeNote>Records the milestone’s current state. Earlier states and their supporting evidence are retained through StateAssignment records linked by hasStateAssignment.</skos:scopeNote>
        <cmns-av:usageNote>require positive evidence for transitions</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <skos:definition>has its state at a specified point in the conversation recorded through</skos:definition>
        <skos:prefLabel>has state assignment</skos:prefLabel>
        <cmns-av:usageNote>Links to all recorded state assignments, including the assignment corresponding to the current state.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateEvidence -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateEvidence">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
        <skos:definition>has its assigned state justified by</skos:definition>
        <skos:prefLabel>has state evidence</skos:prefLabel>
        <cmns-av:usageNote>May link to multiple Text Spans, including evidence from earlier Utterances.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isAbout -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isAbout">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/InformationRequest"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>is about</rdfs:label>
        <skos:definition>concerns the content of</skos:definition>
        <skos:prefLabel>is about</skos:prefLabel>
        <cmns-av:explanatoryNote>The target identifies the milestone that the InformationRequest concerns: a Claim, Option, Issue, or ExpressedPosition.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isAlternativeto -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isAlternativeto">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option"/>
        <rdfs:label>is alternative to</rdfs:label>
        <skos:definition>is a competing course of action to</skos:definition>
        <skos:prefLabel>is alternative to</skos:prefLabel>
        <cmns-av:explanatoryNote>The relationship is symmetric: if one Option is an alternative to another, the reverse also holds.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isNegativeSupportedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isNegativeSupportedBy">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
        <owl:propertyDisjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPositiveSupportedBy"/>
        <rdfs:label>is negative supported by</rdfs:label>
        <skos:definition>has its interpretation as a negative-polarity position supported by the linguistic content of</skos:definition>
        <skos:prefLabel>is negative supported by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPartOfUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPartOfUtterance">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
        <rdfs:label>is part of utterance</rdfs:label>
        <skos:definition>forms a textual part of</skos:definition>
        <skos:prefLabel>is part of utterance</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPositiveSupportedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPositiveSupportedBy">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
        <rdfs:label>is positive supported by</rdfs:label>
        <skos:definition>has its interpretation as a positive-polarity position supported by the linguistic content of</skos:definition>
        <skos:prefLabel>is positive supported by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/refines -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/refines">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:label>refines</rdfs:label>
        <skos:definition>extends, corrects, or reformulates the content of</skos:definition>
        <skos:prefLabel>refines</skos:prefLabel>
        <cmns-av:explanatoryNote>The source is a later Claim, Option, or Issue, and the target is an earlier milestone of the same type.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/resolves -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/resolves">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/addresses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Issue"/>
        <rdfs:label>resolves</rdfs:label>
        <skos:definition>closes through collective confirmation of a recommended Option</skos:definition>
        <skos:prefLabel>resolves</skos:prefLabel>
        <skos:scopeNote>Directed: Outcome → Issue. Requires an explicit issue-settling conversational event. A more specific form of addresses.</skos:scopeNote>
        <cmns-av:explanatoryNote></cmns-av:explanatoryNote>
        <cmns-av:usageNote>An individual’s agreement or an unaccepted proposal does not by itself resolve a group Issue</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/respondsTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/respondsTo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/InformationRequest"/>
        <rdfs:label>responds to</rdfs:label>
        <skos:definition>provides a relevant response to</skos:definition>
        <skos:prefLabel>responds to</skos:prefLabel>
        <cmns-av:explanatoryNote>The relationship does not establish whether the information need is satisfied.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/selects -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/selects">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Outcome"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option"/>
        <rdfs:label>selects</rdfs:label>
        <skos:definition>records the recommendation and confirmation for joint acceptance of</skos:definition>
        <skos:prefLabel>selects</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/supports -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/supports">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Claim"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:label>supports</rdfs:label>
        <skos:definition>provides evidence or reasoning that strengthens the epistemic standing of</skos:definition>
        <skos:prefLabel>supports</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/deliberation/ontology#responseTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/deliberation/ontology#responseTo">
        <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:comment>Relates a contribution to another contribution it responds to.</rdfs:comment>
        <rdfs:label>response to</rdfs:label>
        <mappings:metagovMapping>Direct conceptual equivalent for threading of contributions.</mappings:metagovMapping>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/hasDateTime -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/hasDateTime">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime"/>
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime"/>
        <rdfs:label>has date time</rdfs:label>
        <skos:definition>identifies a specific date and time of day, possibly excluding the time zone</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/hasTime -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime">
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity"/>
        <rdfs:label>has time</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3c.github.io/sdw/time/#time:hasTime"/>
        <skos:definition>specifies a general time that can be associated with any element</skos:definition>
        <skos:note>This property corresponds to the property of the same name in the W3C Time Ontology, and can be used to support mapping.</skos:note>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#value -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>value</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>entities-activities</prov:component>
        <prov:definition xml:lang="en">Provides a value that is a direct representation of an entity.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value</prov:dm>
        <prov:editorialNote>The editor&apos;s definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue</prov:editorialNote>
        <prov:editorialNote xml:lang="en">This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, &apos;may be used in describing structured values&apos;).</prov:editorialNote>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationIdentifier -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MultipartyConversation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>conversation identifier</rdfs:label>
        <skos:prefLabel>conversation identifier</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationText -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationText">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>conversation text</rdfs:label>
        <skos:prefLabel>conversation text</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/speakerName -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/speakerName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>speaker name</rdfs:label>
        <skos:prefLabel>speaker name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/turnNumber -->

    <owl:DatatypeProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/turnNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>turn number</rdfs:label>
        <skos:prefLabel>turn number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Agent</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:definition xml:lang="en">An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent&apos;s activity. </prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent</prov:n>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Collection -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Collection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Collection</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>collections</prov:component>
        <prov:definition xml:lang="en">A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection</prov:dm>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#EmptyCollection -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#EmptyCollection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
        <owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MultipartyConversation"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label xml:lang="en">EmptyCollection</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>collections</prov:component>
        <prov:definition xml:lang="en">An empty collection is a collection without members.</prov:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Entity</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>entities-activities</prov:component>
        <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig</prov:constraints>
        <prov:definition xml:lang="en">An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. </prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity</prov:n>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#InstantaneousEvent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#InstantaneousEvent"/>
    


    <!-- http://www.w3.org/ns/prov#Person -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Person">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Person</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:definition xml:lang="en">Person agents are people.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types</prov:n>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Addressed -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Addressed">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>addressed</rdfs:label>
        <skos:definition>state of an Issue for which a Claim or Option substantively engages with the entire concern, without necessarily settling it</skos:definition>
        <skos:prefLabel>addressed</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Agreement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Agreement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
        <rdfs:label>agreement</rdfs:label>
        <skos:definition>value of an Expressed Position indicating that a participant directly shares or accepts a position</skos:definition>
        <skos:prefLabel>agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Answered -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Answered">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>answered</rdfs:label>
        <skos:definition>state of an Information Request whose full information need is satisfied by one or more contributions</skos:definition>
        <skos:prefLabel>answered</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Claim -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Claim">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Contested"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Supported"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/SupportedContested"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Unassessed"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Contested"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Supported"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/SupportedContested"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Unassessed"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>claim</rdfs:label>
        <skos:altLabel>Assertion</skos:altLabel>
        <skos:altLabel>Statement</skos:altLabel>
        <skos:definition>CJF Milestone that introduces an assertion, interpretation, assessment, explanation, or piece of evidence for the group to consider, accept, or challenge</skos:definition>
        <skos:prefLabel>claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone">
        <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000206"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>collective judgment formation milestone</rdfs:label>
        <skos:definition>persistent semantic object representing a consequential contribution to the evolving collective judgment, such as an information request, issue, option, claim, expressed position, or outcome</skos:definition>
        <skos:prefLabel>collective judgment formation milestone</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Contested -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Contested">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:comment>contested</rdfs:comment>
        <skos:definition>state of a Claim subject to a challenge from an Issue or another Claim</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState"/>
        <rdfs:label>deliberative milestone</rdfs:label>
        <skos:definition>MilestoneWithState that introduces or develops the content of the group’s reasoning by stating a Claim, raising an Issue, or proposing an Option</skos:definition>
        <skos:prefLabel>deliberative milestone</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Disagreement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Disagreement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition"/>
        <rdfs:label>disagreement</rdfs:label>
        <skos:definition>value of an Expressed Position indicating that a participant directly does not share a position</skos:definition>
        <skos:prefLabel>disagreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/ExpressedPosition">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasSpeaker"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isNegativeSupportedBy"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPositiveSupportedBy"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>expressed position</rdfs:label>
        <skos:definition>CJF Milestone that directly communicates a participant’s agreement or disagreement toward an identifiable Claim, Option, or Issue</skos:definition>
        <skos:prefLabel>expressed position</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/InformationRequest -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/InformationRequest">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Answered"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Answered"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>information request</rdfs:label>
        <skos:altLabel>info-request</skos:altLabel>
        <skos:altLabel>question</skos:altLabel>
        <skos:definition>CJF Milestone that creates an information need calling for another contribution to provide information, a claim, evidence, reasoning, an option, a position or reaction, or clarification</skos:definition>
        <skos:prefLabel>information request</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Issue -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Issue">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Addressed"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Resolved"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Addressed"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Resolved"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>issue</rdfs:label>
        <skos:altLabel>Challenge</skos:altLabel>
        <skos:definition>CJF Milestone that introduces a problem, concern, challenge, objection, correction, limitation, or lack of understanding for the group to address</skos:definition>
        <skos:prefLabel>issue</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MilestoneWithState">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>milestone with state</rdfs:label>
        <skos:definition>CJF Milestone for which the ontology records a time-dependent State supported by evidence from the conversation</skos:definition>
        <skos:prefLabel>milestone with state</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MultipartyConversation -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MultipartyConversation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationIdentifier"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>multiparty conversation</rdfs:label>
        <skos:altLabel>multi-speaker conversation</skos:altLabel>
        <skos:altLabel>multiparty conversation</skos:altLabel>
        <skos:definition>conversation among three or more identifiable participants, comprising ordered contributions that may respond to or build on contributions by different speakers</skos:definition>
        <skos:prefLabel>multiparty conversation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Open">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>open</rdfs:label>
        <skos:definition>state of an Information Request or Issue when introduced, before evidence establishes another applicable state</skos:definition>
        <skos:prefLabel>open</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Option">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/DeliberativeMilestone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasState"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Selected"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/UnderConsideration"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateAssignment"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Selected"/>
                                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/UnderConsideration"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>option</rdfs:label>
        <skos:altLabel>Course of action</skos:altLabel>
        <skos:altLabel>Proposal</skos:altLabel>
        <skos:altLabel>Resolution proposal</skos:altLabel>
        <skos:altLabel>Solution</skos:altLabel>
        <skos:altLabel>Suggestion</skos:altLabel>
        <skos:definition>CJF Milestone that introduces a possible solution or course of action for the group to consider, compare, select, or reject</skos:definition>
        <skos:prefLabel>option</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Outcome -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Outcome">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/CollectiveJudgmentFormationMilestone"/>
        <rdfs:label>outcome</rdfs:label>
        <skos:altLabel>decision</skos:altLabel>
        <skos:altLabel>resolution</skos:altLabel>
        <skos:definition>CJF Milestone that records an established group-level selection, rejection, resolution, deferral, or commitment reached through deliberation</skos:definition>
        <skos:prefLabel>outcome</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Rejected">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>rejected</rdfs:label>
        <skos:definition>state of an Option or Claim evidenced by a group-level decision to rule out the Option or disallow the Claim as a premise in collective reasoning</skos:definition>
        <skos:prefLabel>rejected</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Resolved -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Resolved">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>resolved</rdfs:label>
        <skos:definition>state of an Issue evidenced by a group Outcome that explicitly settles the concern it represents</skos:definition>
        <skos:prefLabel>resolved</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Selected -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Selected">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>selected</rdfs:label>
        <skos:definition>state of an Option evidenced by a group Outcome that explicitly chooses the Option</skos:definition>
        <skos:prefLabel>selected</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/speakerName"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>speaker</rdfs:label>
        <skos:definition>prov:Agent that participates in a multiparty conversation and is identified as the source of one or more Utterances</skos:definition>
        <skos:prefLabel>speaker</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State">
        <rdfs:label>state</rdfs:label>
        <skos:definition>status assigned to a CJF Milestone at a specified point in a conversation based on evidence of how its information need, issue, option, or claim has been addressed or evaluated</skos:definition>
        <skos:prefLabel>state</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasStateEvidence"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedAtUtterance"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/assignedState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/hasPreviousAssignment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/StateAssignment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>state assignment</rdfs:label>
        <skos:definition>record that associates a state-bearing collective judgment formation milestone with one State at a specified Utterance and with the Text Span evidence supporting that state assignment</skos:definition>
        <skos:prefLabel>state assignment</skos:prefLabel>
        <cmns-av:usageNote>Preserve earlier assignment records when a milestone changes state. Assignment records include both initial states and subsequent changes.</cmns-av:usageNote>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Supported -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Supported">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>supported</rdfs:label>
        <skos:definition>state of a Claim evidenced by support from another claim</skos:definition>
        <skos:prefLabel>supported</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/SupportedContested -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/SupportedContested">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>supported contested</rdfs:label>
        <skos:definition>state of a Claim evidenced by support from another claim and subject to a challenge from an Issue or another Claim</skos:definition>
        <skos:prefLabel>supported contested</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/TextSpan">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/isPartOfUtterance"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationText"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>text span</rdfs:label>
        <skos:definition>contiguous segment of transcript text delimited by start and end positions and used as the specific target of an annotation</skos:definition>
        <skos:prefLabel>text span</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Unassessed -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Unassessed">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>unassessed</rdfs:label>
        <skos:definition>state of a Claim introduced into the conversation without an identifiable group assessment of its standing in collective reasoning</skos:definition>
        <skos:prefLabel>unassessed</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/UnderConsideration -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/UnderConsideration">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/State"/>
        <rdfs:label>under consideration</rdfs:label>
        <skos:definition>state of a proposed Option without an established group selection, group rejection, or explicit deferral</skos:definition>
        <skos:prefLabel>under consideration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Utterance">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/Speaker"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/hasTime"/>
                <owl:allValuesFrom rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/MultipartyConversation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/conversationText"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/tracking-cjf/turnNumber"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>utterance</rdfs:label>
        <skos:definition>speaker-attributed segment of a conversation bounded for annotation as one communicative contribution and capable of expressing one or more dialogue functions</skos:definition>
        <skos:prefLabel>utterance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/deliberation/ontology#Contribution -->

    <owl:Class rdf:about="https://w3id.org/deliberation/ontology#Contribution">
        <rdfs:comment>Any input provided by a participant in a deliberation.</rdfs:comment>
        <rdfs:label>Contribution</rdfs:label>
        <mappings:metagovMapping>DIP Statement (org.deliberation.statement) closely matches del:Contribution. DIP StatementRole values map onto DEL specializations: Evidence to del:Evidence, Refutation to del:attacks relations, Proposal and Decision to del:Position and del:Consensus contexts.</mappings:metagovMapping>
        <mappings:siocMapping>More general than sioc:Post as contributions may include non-textual input</mappings:siocMapping>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/DateTime -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/DateTime">
        <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant"/>
        <rdfs:label>date time</rdfs:label>
        <skos:definition>time point including a date and a time, optionally including a time zone offset</skos:definition>
        <skos:note>&apos;has date time value&apos; is omitted if the &apos;date time&apos; is not (yet) known. The time zone is implicitly UTC.</skos:note>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/ProperInterval -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/ProperInterval">
        <owl:disjointWith rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant"/>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity">
        <rdfs:label>temporal entity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <skos:definition>time interval or instant</skos:definition>
    </owl:Class>
    


    <!-- https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant -->

    <owl:Class rdf:about="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant">
        <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity"/>
        <rdfs:label>time instant</rdfs:label>
        <skos:definition>temporal entity that is a member of a time scale, with no extent or duration</skos:definition>
        <skos:example>The Battle of Hastings was on &apos;14 October 1066&apos;. (This gives the Julian date of the battle at a granularity of &apos;day&apos;. If desired, the battle could be given more precisely as a time period within that calendar day.)</skos:example>
        <skos:note>For scales that have a granularity specified in days, a date is a time point; for scales down to the seconds, the equivalent of an xsd:dateTime or xsd:dateTimeStamp is a time point.</skos:note>
        <skos:note>The duration of each time interval that is an instance of the time point is the granularity of the time scale of the time point.</skos:note>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.omg.org/spec/DTV/</cmns-av:adaptedFrom>
        <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/owl-time/#time:Instant</cmns-av:adaptedFrom>
        <cmns-av:synonym>instant in time</cmns-av:synonym>
        <cmns-av:synonym>time point</cmns-av:synonym>
    </owl:Class>
    <rdf:Description>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </rdf:Description>
    <rdf:Description>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </rdf:Description>
    


