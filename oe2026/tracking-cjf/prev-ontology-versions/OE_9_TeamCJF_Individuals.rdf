    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_1 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_1">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>1</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_8a4bce894543c95c6fef"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>We need to choose a platform for the new development project today so we can start setting up the environment next week.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_10 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_10">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>10</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_1ce82228187659212b16"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>Its base subscription is $12,000 a year, so I expect Platform B would cost us less overall.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_11 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_11">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>11</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>Would we have it ready in time, though? Platform B needs additional configuration, and we only have two weeks before development starts.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">11</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_12 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_12">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>12</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>I’m not sure that cost comparison includes everything. Doesn’t Platform B require separate licenses for the deployment and identity extensions?</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">12</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_13 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_13">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>13</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>It does. I put together a fuller estimate this morning. The required licenses add $8,000, and training adds another $6,000. That puts Platform B at $26,000 for the first year, compared with $24,000 for Platform A.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">13</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_14 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_14">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>14</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>I’ve checked those quotes too. Platform A includes the connectors and vendor onboarding in its price, so the revised comparison actually puts Platform A lower.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">14</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_15 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_15">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>15</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_8a4bce894543c95c6fef"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>Then we could cover Platform A’s $6,000 gap by moving the funds reserved for the reporting add-on. Both platforms already include the basic reporting this project needs.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_16 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_16">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>16</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>I manage that budget, and the funds are still available. I’m comfortable moving them because we haven’t committed to purchasing the add-on.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">16</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_17 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_17">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>17</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>I agree with that reallocation. We can deliver the required reports without the separate add-on.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">17</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_18 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_18">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>18</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_1ce82228187659212b16"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>Agreed. Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">18</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_19 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_19">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>19</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>That settles the funding concern. I still need an answer on training, though. Having onboarding included doesn’t tell us when people can attend.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">19</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_2 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_2">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>2</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_8a4bce894543c95c6fef"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>We could use Platform A. It seems like the better fit for our delivery schedule.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_20 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_20">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>20</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_8a4bce894543c95c6fef"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>We could use Monday’s five-to-six training slot for a vendor-led session, then give developers the recording and a practice environment.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_21 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_21">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>21</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>I’m not sure that training arrangement will work yet. I need to check whether the release team can attend Monday from five to six and whether the vendor is available then.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">21</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_22 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_22">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>22</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>What does the onboarding cover? If it’s only a product overview, people could still struggle with their first deployment.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">22</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_23 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_23">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>23</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_8a4bce894543c95c6fef"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>The vendor’s outline includes creating a repository, configuring a build, and deploying a sample service. We can ask them to use our project template for the walkthrough.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">23</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_24 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_24">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>24</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>That outline sounds good. The outline covers the right tasks.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">24</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_25 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_25">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>25</dc:identifier>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_b5efae1edfaf7c011c3d"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
        <cjf:hasConversationText>For this project, I think Platform A’s tested integrations and simpler setup make it the better fit. I support choosing Platform A.</cjf:hasConversationText>
        <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_26 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_26">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <dc:identifier>26</dc:identifier>
