    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87eca3603a6e9295af6d -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87eca3603a6e9295af6d">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <cjf:hasConversationText>The training arrangements need to be confirmed</cjf:hasConversationText>
