    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_8663835d04964c23222b -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_8663835d04964c23222b">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <cjf:hasConversationText>and whether the vendor is available then.</cjf:hasConversationText>
