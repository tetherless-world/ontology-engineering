    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87c680a4806633bf7cb4 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87c680a4806633bf7cb4">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <cjf:hasConversationText>We should consider adopting it instead</cjf:hasConversationText>
