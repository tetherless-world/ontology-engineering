    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87c4c0c9bc01bb75aabb -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_87c4c0c9bc01bb75aabb">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
