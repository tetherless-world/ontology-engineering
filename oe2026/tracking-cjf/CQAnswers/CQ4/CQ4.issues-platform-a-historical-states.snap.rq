PREFIX cjf: <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/>
PREFIX sample: <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sio: <http://semanticscience.org/resource/>

SELECT DISTINCT ?issue ?assignment ?stateType
    (IF(BOUND(?resolvedAssignment), cjf:Resolved,
        IF(BOUND(?addressedAssignment), cjf:Addressed,
            IF(BOUND(?openAssignment), cjf:Open, ""))) AS ?currentState)
    ?sourceMove ?evidence
WHERE {
    ?issue cjf:makesChallenges ?challenge .

    ?challenge cjf:isAimedAtChallenges
        sample:Move_OCT21_A-M0003 .

    OPTIONAL {
        ?issue rdf:type ?issueType .
    }

    FILTER (?issueType = cjf:Issue)

    ?issue cjf:hasStateAssignment ?assignment .

    ?assignment cjf:assignedState ?state .

    OPTIONAL {
        ?state rdf:type ?stateType .
    }

    FILTER (
        ?stateType = cjf:Open ||
        ?stateType = cjf:Addressed ||
        ?stateType = cjf:Resolved
    )

    # The current state uses the most specific classification.
    OPTIONAL {
        ?issue cjf:hasCurrentStateAssignment ?resolvedAssignment .
        ?resolvedAssignment cjf:assignedState ?resolvedState .
        ?resolvedState rdf:type cjf:Resolved .
    }

    OPTIONAL {
        ?issue cjf:hasCurrentStateAssignment ?addressedAssignment .
        ?addressedAssignment cjf:assignedState ?addressedState .
        ?addressedState rdf:type cjf:Addressed .
    }

    OPTIONAL {
        ?issue cjf:hasCurrentStateAssignment ?openAssignment .
        ?openAssignment cjf:assignedState ?openState .
        ?openState rdf:type cjf:Open .
    }

    OPTIONAL {
        ?assignment cjf:hasTriggeringRelationship ?trigger .

        OPTIONAL {
            ?sourceMove cjf:makesAddresses ?trigger .

            OPTIONAL {
                ?sourceMove sio:SIO_000206 ?textSpan .
                ?textSpan cjf:hasConversationText ?evidence .
            }
        }
    }
}
ORDER BY ?issue ?assignment ?stateType ?sourceMove ?evidence
