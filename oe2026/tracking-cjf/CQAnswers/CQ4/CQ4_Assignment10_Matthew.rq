PREFIX cjf: <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/>
PREFIX sample: <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sio: <http://semanticscience.org/resource/>

SELECT DISTINCT ?issue ?stateType ?sourceMove ?evidence
WHERE {
    ?issue cjf:makesChallenges ?challenge .

    ?challenge cjf:isAimedAtChallenges
        sample:Move_OCT21_A-M0003 .

    OPTIONAL {
        ?issue rdf:type ?moveType .
    }

    FILTER (?moveType = cjf:Issue)

    ?issue cjf:hasCurrentStateAssignment ?assignment .

    ?assignment cjf:assignedState ?state .

    OPTIONAL {
        ?state rdf:type ?stateType .
    }

    FILTER (
        ?stateType = cjf:Open ||
        ?stateType = cjf:Addressed ||
        ?stateType = cjf:Resolved
    )

    ?assignment cjf:hasTriggeringRelationship ?trigger .

    OPTIONAL {
        ?sourceMove cjf:makesAddresses ?trigger .

        OPTIONAL {
            ?sourceMove sio:SIO_000206 ?textSpan .
            ?textSpan cjf:hasConversationText ?evidence .
        }
    }
}
ORDER BY ?issue ?stateType ?sourceMove
