PREFIX cjf:  <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ1 for Protégé's Snap SPARQL Query view (start HermiT first).
# Answers come from the reasoner, so hasState needs no materialized file.
# moveType is limited to six explicit move classes; Agreement moves appear
# as ExpressedPosition, their superclass.
# Snap SPARQL differences from cq1-conversation-moves-current-states.rq:
#   - No VALUES, and BIND cannot take a class, so the classes are a FILTER.
#   - rdfs:subClassOf is entailed (reflexive, transitive), so no * path.
#   - cjf:State is excluded with MINUS; a FILTER inside OPTIONAL crashes Snap.
#   - Comments must come after the first PREFIX line; LIMIT is unsupported.

SELECT DISTINCT ?move ?moveType ?stateType ?summary
WHERE {
    ?move a ?moveType .
    FILTER (?moveType = cjf:Issue
            || ?moveType = cjf:Claim
            || ?moveType = cjf:Option
            || ?moveType = cjf:InformationRequest
            || ?moveType = cjf:ExpressedPosition
            || ?moveType = cjf:Outcome)
    
    ?move cjf:hasSummary ?summary .

    OPTIONAL {
        ?move cjf:hasState ?state .
        ?state a ?stateType .
        ?stateType rdfs:subClassOf cjf:State .
        MINUS {
            ?state a ?stateType .
            FILTER (?stateType = cjf:State)
        }
    }
}
ORDER BY ?move ?moveType
