PREFIX cjf: <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

select distinct ?issues ?stateclass ?evidence
where {
    ?issues a cjf:Issue .
    ?issues cjf:hasCurrentStateAssignment ?stateassignment .
    ?stateassignment cjf:assignedState ?state .
    ?state a ?stateclass

    # remove the generic state class triples
    FILTER (?stateclass != cjf:State && ?stateclass != sio:SIO_000000 && ?stateclass != owl:Thing)
    ?stateassignment cjf:hasTriggeringRelationship ?relation .
    
    # sio:isSupportedBy
    ?relation sio:SIO_000206 ?text_span . 
    ?text_span cjf:hasConversationText ?evidence . 
}
