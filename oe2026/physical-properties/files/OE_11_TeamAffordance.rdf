	<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetFeatureType">
		<rdfs:label xml:lang="en">uses target feature type</rdfs:label>
		<dcterms:bibliographicCitation>Cambridge Dictionary, “Feature.” https://dictionary.cambridge.org/dictionary/english/feature</dcterms:bibliographicCitation>
		<dcterms:source>Cambridge Dictionary, “Feature.” https://dictionary.cambridge.org/dictionary/english/feature</dcterms:source>
		<rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<skos:definition xml:lang="en">relates a requirement mapping to the physical feature type of the target used as a condition in the mapping</skos:definition>
		<skos:editorialNote>Project-specific object property represented in the current RDF/OWL implementation; terminology entry added to align the curated term list with the implemented ontology. Lexical basis only: Supports the idea of a feature; target feature mapping direction is project-specific. The dictionary does not define this specific OWL class or property. Concept/term developed for the current ontology; internal artifact history is provenance, not an external literature source. Preferred label is locally assigned for this ontology; no claim of external publication as the label origin.</skos:editorialNote>
		<skos:example xml:lang="en">cutRigidityMapping usesTargetFeatureType hardness.</skos:example>
		<skos:note xml:lang="en">Usage: Use from Requirement Mapping to Physical Feature to identify the target feature type used as a condition for determining a required level.</skos:note>
		<skos:prefLabel xml:lang="en">Uses Target Feature Type</skos:prefLabel>
		<skos:scopeNote xml:lang="en">Restricted to identifying the target Physical Feature type used as a condition in a Requirement Mapping.</skos:scopeNote>
		<cmns-av:explanatoryNote xml:lang="en">The target feature type determines which target condition the mapping inspects. Requirements may depend on target properties.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetLevel">
		<rdfs:label xml:lang="en">uses target level</rdfs:label>
		<dcterms:bibliographicCitation>Cambridge Dictionary, “Requirement.” https://dictionary.cambridge.org/dictionary/english/requirement</dcterms:bibliographicCitation>
		<dcterms:source>Cambridge Dictionary, “Requirement.” https://dictionary.cambridge.org/dictionary/english/requirement</dcterms:source>
		<rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel"/>
		<skos:definition xml:lang="en">relates a requirement mapping to the feature level of the target used as a condition in the mapping</skos:definition>
		<skos:editorialNote>Project-specific object property represented in the current RDF/OWL implementation; terminology entry added to align the curated term list with the implemented ontology. Lexical basis only: Supports requirement terminology; the usesTargetLevel relation is local. The dictionary does not define this specific OWL class or property. Concept/term developed for the current ontology; internal artifact history is provenance, not an external literature source. Preferred label is locally assigned for this ontology; no claim of external publication as the label origin.</skos:editorialNote>
		<skos:example xml:lang="en">cutRigidityMapping usesTargetLevel high.</skos:example>
		<skos:note xml:lang="en">Usage: Use from Requirement Mapping to Feature Level to identify the target feature level used as a condition for determining a required level.</skos:note>
		<skos:prefLabel xml:lang="en">Uses Target Level</skos:prefLabel>
		<skos:scopeNote xml:lang="en">Restricted to identifying the target Feature Level used as a condition in a Requirement Mapping.</skos:scopeNote>
		<cmns-av:explanatoryNote xml:lang="en">A target level is a qualitative condition triggering a requirement mapping, not a numerical threshold.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:AnnotationProperty rdf:about="&cmns-av;explanatoryNote">
	</owl:AnnotationProperty>
	
