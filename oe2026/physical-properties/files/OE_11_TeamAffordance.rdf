	xmlns:swrl="http://www.w3.org/2003/11/swrl#"
	xmlns:xs="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/">
		<dcterms:abstract xml:lang="en">This ontology represents physical properties of candidate tools and targets, action requirements, and assessment relationships to support property-grounded reasoning about CUT feasibility. It enables assessments based on satisfied, conflicting, and unresolved physical requirements without relying on object identity or conventional function.</dcterms:abstract>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<dcterms:creator>Alex Clark</dcterms:creator>
		<dcterms:creator>Hyejin Park</dcterms:creator>
		<dcterms:creator>Liangliang Zhang</dcterms:creator>
		<dcterms:creator>Xiye Fan</dcterms:creator>
		<dcterms:modified rdf:datatype="&xs;date">2026-11-13</dcterms:modified>
		<dcterms:publisher xml:lang="en">Team Affordance</dcterms:publisher>
		<owl:priorVersion rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/versions/OE_10"/>
		<owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/versions/OE_11"/>
		<skos:changeNote>Assignment 11: Added explicit representation of unresolved action requirements, introduced SWRL reasoning for unresolved feature information, improved rule labels, and updated ontology metadata for version management.
OE11 annotation review (2026-11-13): synchronized curated term definitions, dictionary/adapted-definition sources, bibliographic citations, and explanatory, scope, editorial, usage and example annotations; clarified Low/Medium/High FeatureLevel definitions.</skos:changeNote>
	</owl:Ontology>
	
