<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY dcterms "http://purl.org/dc/terms/">
	<!ENTITY ns1 "http://www.w3.org/2003/11/swrl#">
	<!ENTITY ns2 "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY xs "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"
	xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"
	xmlns:dcterms="http://purl.org/dc/terms/"
	xmlns:ns1="http://www.w3.org/2003/11/swrl#"
	xmlns:ns2="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:xs="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/">
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<dcterms:creator>Alex Clark</dcterms:creator>
		<dcterms:creator>Hyejin Park</dcterms:creator>
		<dcterms:creator>Liangliang Zhang</dcterms:creator>
		<dcterms:creator>Xiye Fan</dcterms:creator>
	</owl:Ontology>
	
	<owl:AnnotationProperty rdf:about="&dcterms;contributor">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&dcterms;creator">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&ns2;isRuleEnabled">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&skos;definition">
	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action">
		<rdfs:label xml:lang="en">action</rdfs:label>
		<skos:definition xml:lang="en">physical action whose feasibility is evaluated using represented physical features and action requirements</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement">
		<rdfs:label xml:lang="en">action requirement</rdfs:label>
		<skos:definition xml:lang="en">represented physical condition relevant to determining whether an action is feasible</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasAction"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasJudgment"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasCandidate"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasTarget"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">assessment</rdfs:label>
		<skos:definition xml:lang="en">evaluation context that relates a candidate physical entity, a target physical entity, and an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature"/>
		<rdfs:label xml:lang="en">contact area feature</rdfs:label>
		<skos:definition xml:lang="en">geometric feature describing the area of a physical entity available for contact during an interaction</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
		<rdfs:label xml:lang="en">contact area requirement</rdfs:label>
		<skos:definition xml:lang="en">geometric requirement concerning the contact area needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/DescribedObject">
		<rdfs:label xml:lang="en">described object</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
					</rdf:Description>
					<rdf:Description>
						<owl:unionOf rdf:parseType="Collection">
							<owl:Restriction>
								<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
								<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
							</owl:Restriction>
							<owl:Restriction>
								<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureValue"/>
								<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue"/>
							</owl:Restriction>
						</owl:unionOf>
					</rdf:Description>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object represented by at least one explicit object part or physical feature value</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature"/>
		<rdfs:label xml:lang="en">edge geometry feature</rdfs:label>
		<skos:definition xml:lang="en">geometric feature describing the shape or form of an edge relevant to physical interaction</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
		<rdfs:label xml:lang="en">edge geometry requirement</rdfs:label>
		<skos:definition xml:lang="en">geometric requirement concerning the edge geometry needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment">
		<rdfs:label xml:lang="en">feasibility judgment</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Feasible">
					</rdf:Description>
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Infeasible">
					</rdf:Description>
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">judgment representing the outcome of evaluating whether a candidate can physically support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Feasible">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
		<rdfs:label xml:lang="en">feasible</rdfs:label>
		<owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Infeasible"/>
		<owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation"/>
		<skos:definition xml:lang="en">feasibility judgment indicating that at least one evaluated configuration is supported by the represented information</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel">
		<rdfs:label xml:lang="en">feature level</rdfs:label>
		<skos:definition xml:lang="en">categorical level used to represent the degree of a physical feature, such as low, medium, or high</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasLevel"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureType"/>
				<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
				<owl:qualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">feature value</rdfs:label>
		<skos:definition xml:lang="en">representation that associates a physical feature type with a categorical feature level for a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature"/>
		<rdfs:label xml:lang="en">flexibility feature</rdfs:label>
		<skos:definition xml:lang="en">mechanical feature describing the degree to which a physical entity can bend or deform without failure</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalRequirement"/>
		<rdfs:label xml:lang="en">flexibility requirement</rdfs:label>
		<skos:definition xml:lang="en">mechanical requirement concerning the flexibility needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceFeature"/>
		<rdfs:label xml:lang="en">friction feature</rdfs:label>
		<skos:definition xml:lang="en">surface feature describing resistance to sliding between contacting surfaces</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceRequirement"/>
		<rdfs:label xml:lang="en">friction requirement</rdfs:label>
		<skos:definition xml:lang="en">surface requirement concerning the friction needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<rdfs:label xml:lang="en">geometric feature</rdfs:label>
		<skos:definition xml:lang="en">physical feature describing the geometry, dimensions, or spatial form of a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<rdfs:label xml:lang="en">geometric requirement</rdfs:label>
		<skos:definition xml:lang="en">action requirement concerning geometric characteristics needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/HardnessFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature"/>
		<rdfs:label xml:lang="en">hardness feature</rdfs:label>
		<skos:definition xml:lang="en">mechanical feature describing resistance to localized deformation or indentation</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/HighHardnessRigidityMapping">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:label xml:lang="en">high hardness rigidity mapping</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/affectsRequirement"/>
						<owl:hasValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutRigidityRequirement"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/specifiesRequiredLevel"/>
						<owl:hasValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetFeatureType"/>
						<owl:hasValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hardness"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetLevel"/>
						<owl:hasValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">requirement mapping that connects high target hardness to a high required rigidity level for cutting</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Infeasible">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
		<rdfs:label xml:lang="en">infeasible</rdfs:label>
		<owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation"/>
		<skos:definition xml:lang="en">feasibility judgment indicating that all evaluated configurations are explicitly blocked by represented information</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
		<rdfs:label xml:lang="en">insufficient information</rdfs:label>
		<skos:definition xml:lang="en">feasibility judgment indicating that the represented information is insufficient to determine feasibility or infeasibility</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InteractingPart">
		<rdfs:label xml:lang="en">interacting part</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/interactsWith"/>
						<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object part that physically interacts with another object part relevant to the represented action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InteractingPartObject">
		<rdfs:label xml:lang="en">object with interacting parts</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
						<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InteractingPart"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object having at least one part that interacts with another object part</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralFeature"/>
		<rdfs:label xml:lang="en">joint feature</rdfs:label>
		<skos:definition xml:lang="en">structural feature describing a connection between parts of a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralRequirement"/>
		<rdfs:label xml:lang="en">joint requirement</rdfs:label>
		<skos:definition xml:lang="en">structural requirement concerning a connection between parts needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<rdfs:label xml:lang="en">material feature</rdfs:label>
		<skos:definition xml:lang="en">physical feature describing a material characteristic of a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<rdfs:label xml:lang="en">material requirement</rdfs:label>
		<skos:definition xml:lang="en">action requirement concerning a material characteristic needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<rdfs:label xml:lang="en">mechanical feature</rdfs:label>
		<skos:definition xml:lang="en">physical feature describing the mechanical behavior of a physical entity under applied forces</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<rdfs:label xml:lang="en">mechanical requirement</rdfs:label>
		<skos:definition xml:lang="en">action requirement concerning mechanical behavior needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartObject">
		<rdfs:label xml:lang="en">multi-part object</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
						<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
						<owl:minQualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">2</owl:minQualifiedCardinality>
					</owl:Restriction>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object with at least two distinct represented object parts</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralFeature"/>
		<rdfs:label xml:lang="en">multi part structure feature</rdfs:label>
		<skos:definition xml:lang="en">structural feature describing an arrangement in which multiple parts jointly participate in a physical configuration</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralRequirement"/>
		<rdfs:label xml:lang="en">multi part structure requirement</rdfs:label>
		<skos:definition xml:lang="en">structural requirement concerning the use or arrangement of multiple parts needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/isPartOf"/>
				<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">object part</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<skos:definition xml:lang="en">physical entity represented as a constituent part of an object</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PairedInteractingObject">
		<rdfs:label xml:lang="en">object with paired interacting parts</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
						<owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InteractingPart"/>
						<owl:minQualifiedCardinality rdf:datatype="&xs;nonNegativeInteger">2</owl:minQualifiedCardinality>
					</owl:Restriction>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object with at least two distinct parts that each interact with another part</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PartBearingObject">
		<rdfs:label xml:lang="en">part-bearing object</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:equivalentClass>
			<rdf:Description>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
						<owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</rdf:Description>
		</owl:equivalentClass>
		<skos:definition xml:lang="en">object with at least one represented object part</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity">
		<rdfs:label xml:lang="en">physical entity</rdfs:label>
		<skos:definition xml:lang="en">physical entity that may participate in an action as an object, object part, candidate, or target</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature">
		<rdfs:label xml:lang="en">physical feature</rdfs:label>
		<skos:definition xml:lang="en">represented physical characteristic of a physical entity used in evaluating action feasibility</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PointGeometryFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature"/>
		<rdfs:label xml:lang="en">point geometry feature</rdfs:label>
		<skos:definition xml:lang="en">geometric feature describing the shape or form of a point or tip of a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PointGeometryRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
		<rdfs:label xml:lang="en">point geometry requirement</rdfs:label>
		<skos:definition xml:lang="en">geometric requirement concerning the point or tip geometry needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping">
