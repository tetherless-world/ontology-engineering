	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RotationalStructureRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralRequirement"/>
		<rdfs:label xml:lang="en">rotational structure requirement</rdfs:label>
		<skos:definition xml:lang="en">structural requirement concerning rotational relationships between parts needed to support an action</skos:definition>
	</owl:Class>
	
