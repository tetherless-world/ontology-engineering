		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
		<rdfs:label xml:lang="en">shape requirement</rdfs:label>
		<skos:definition xml:lang="en">geometric requirement concerning the shape needed to support an action</skos:definition>
