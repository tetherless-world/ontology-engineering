		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature"/>
		<rdfs:label xml:lang="en">strength feature</rdfs:label>
		<skos:definition xml:lang="en">mechanical feature describing resistance to failure under an applied force</skos:definition>
