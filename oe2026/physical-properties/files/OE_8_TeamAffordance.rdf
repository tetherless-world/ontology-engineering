	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<rdfs:label xml:lang="en">surface feature</rdfs:label>
		<skos:definition xml:lang="en">physical feature describing a characteristic of the surface of a physical entity</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<rdfs:label xml:lang="en">surface requirement</rdfs:label>
		<skos:definition xml:lang="en">action requirement concerning a surface characteristic needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/TensileStrengthFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StrengthFeature"/>
		<rdfs:label xml:lang="en">tensile strength feature</rdfs:label>
		<skos:definition xml:lang="en">strength feature describing resistance to failure when subjected to tensile force</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/TensileStrengthRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StrengthRequirement"/>
		<rdfs:label xml:lang="en">tensile strength requirement</rdfs:label>
		<skos:definition xml:lang="en">strength requirement concerning resistance to tensile force needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ThicknessFeature">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SizeFeature"/>
		<rdfs:label xml:lang="en">thickness feature</rdfs:label>
		<skos:definition xml:lang="en">size feature describing the thickness of a physical entity or object part</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ThicknessRequirement">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SizeRequirement"/>
		<rdfs:label xml:lang="en">thickness requirement</rdfs:label>
		<skos:definition xml:lang="en">size requirement concerning the thickness needed to support an action</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/TwoCUTRequirementsSatisfiedAssessment">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
		<rdfs:label xml:lang="en">two cut requirements satisfied assessment</rdfs:label>
		<skos:definition xml:lang="en">assessment in which both modeled cutting requirements are represented as satisfied</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/WholeObject">
		<rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart"/>
				<owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en">whole object</rdfs:label>
		<dcterms:contributor xml:lang="en">LZ</dcterms:contributor>
		<owl:disjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
		<skos:definition xml:lang="en">physical entity represented as a whole object that may serve as a candidate or target in an assessment</skos:definition>
	</owl:Class>
	
	<ns1:Variable rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/a">
	</ns1:Variable>
	
	<ns1:Variable rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/act">
	</ns1:Variable>
	
	<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/affectsRequirement">
		<rdfs:label xml:lang="en">affects requirement</rdfs:label>
		<rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<skos:definition xml:lang="en">relates a requirement mapping to the action requirement whose required level is determined by the mapping</skos:definition>
	</owl:ObjectProperty>
	
	<ns1:Variable rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/c">
	</ns1:Variable>
	
	<ns1:Variable rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/candidateFV">
	</ns1:Variable>
	
	<ns1:Variable rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/candidateType">
	</ns1:Variable>
	
	<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/concernsFeature">
		<rdfs:label xml:lang="en">concerns feature</rdfs:label>
		<rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
		<skos:definition xml:lang="en">relates an action requirement to the physical feature that the requirement concerns</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/conflictsWithRequirement">
		<rdfs:label xml:lang="en">conflicts with requirement</rdfs:label>
		<rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
		<rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
		<owl:propertyDisjointWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/satisfiesRequirement"/>
		<skos:definition xml:lang="en">relates an assessment to an action requirement that is not satisfied by the evaluated candidate configuration</skos:definition>
	</owl:ObjectProperty>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cut">
		<rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action"/>
		<rdfs:label xml:lang="en">cut</rdfs:label>
		<skos:definition xml:lang="en">cut action evaluated by the ontology in physical feasibility assessments</skos:definition>
		<hasRequirement rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutEdgeThicknessRequirement"/>
		<hasRequirement rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutRigidityRequirement"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutEdgeThicknessMapping">
		<rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:label xml:lang="en">cut edge thickness mapping</rdfs:label>
		<skos:definition xml:lang="en">requirement mapping that maps high target hardness to a low required edge thickness level for the cut edge thickness requirement</skos:definition>
		<affectsRequirement rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutEdgeThicknessRequirement"/>
		<specifiesRequiredLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/low"/>
		<usesTargetFeatureType rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hardness"/>
		<usesTargetLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutEdgeThicknessRequirement">
		<rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ThicknessRequirement"/>
		<rdfs:label xml:lang="en">cut edge thickness requirement</rdfs:label>
		<skos:definition xml:lang="en">action requirement for cut concerning the edge thickness of the candidate</skos:definition>
		<concernsFeature rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/edgeThickness"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutRigidityMapping">
		<rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
		<rdfs:label xml:lang="en">cut rigidity mapping</rdfs:label>
		<skos:definition xml:lang="en">requirement mapping that maps high target hardness to a high required rigidity level for the cut rigidity requirement</skos:definition>
		<affectsRequirement rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutRigidityRequirement"/>
		<specifiesRequiredLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
		<usesTargetFeatureType rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hardness"/>
		<usesTargetLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/cutRigidityRequirement">
		<rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RigidityRequirement"/>
