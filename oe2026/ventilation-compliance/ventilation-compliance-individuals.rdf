		<rdf:type rdf:resource="&v;MinBoundedCompliancePolicy"/>
		<rdf:type rdf:resource="&v;MinimumAirChangesOfOutdoorAirPerHour"/>
		<rdfs:label>min outdoor air changes per hour</rdfs:label>
		<qu:hasLowerBound rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/LB_ACH"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/P_AII_AIRMOVE">
		<rdf:type rdf:resource="&v;AirMovementRelationshipToAdjacentArea"/>
		<rdf:type rdf:resource="&v;MinBoundedCompliancePolicy"/>
		<rdfs:label>air movement in from adjacent area (AII room)</rdfs:label>
		<rdfs:comment>CDC (2003) Guidelines for Environmental Infection Control in Health-Care
      Facilities, Appendix B, Table B.2, airborne infection isolation room: In. Air movement
      relationship made measurable through the incoming transfer airflow rate (return + exhaust -
      supply); bound is the 125 cfm = 212 m3/h supply/exhaust offset recommended by the AIA (2001)
      guidelines cited in the CDC document.</rdfs:comment>
		<qu:hasLowerBound rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/LB_P_AII_AIRMOVE"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/P_AII_OACH">
		<rdf:type rdf:resource="&v;MinBoundedCompliancePolicy"/>
		<rdf:type rdf:resource="&v;MinimumAirChangesOfOutdoorAirPerHour"/>
		<rdfs:label>min outdoor air changes per hour (AII room)</rdfs:label>
		<rdfs:comment>CDC (2003) Guidelines for Environmental Infection Control in Health-Care
      Facilities, Appendix B, Table B.2, airborne infection isolation room: 2 outdoor ACH</rdfs:comment>
		<qu:hasLowerBound rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/LB_P_AII_OACH"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/P_AII_RH">
		<rdf:type rdf:resource="&v;MaxBoundedCompliancePolicy"/>
		<rdf:type rdf:resource="&v;RelativeHumidity"/>
		<rdfs:label>relative humidity maximum (AII room)</rdfs:label>
		<rdfs:comment>ANSI/ASHRAE/ASHE 170-2021 Table 7.1, AII room: max 60 % RH (CDC Table B.2 gives no
      RH requirement)</rdfs:comment>
		<qu:hasUpperBound rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/UB_P_AII_RH"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/test-individuals/P_AII_TACH">
		<rdf:type rdf:resource="&v;MinBoundedCompliancePolicy"/>
		<rdf:type rdf:resource="&v;MinimumTotalAirChangesPerHour"/>
