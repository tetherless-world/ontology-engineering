<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.</rdfs:comment>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. </prov:definition>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to 
http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasQuotedFrom"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or "quoting", some or all of it. </rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://www.w3.org/ns/prov#hadPrimarySource"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information.</rdfs:comment>
</owl:Axiom>


</rdf:RDF>
