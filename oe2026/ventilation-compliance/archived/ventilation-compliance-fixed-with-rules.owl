  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">delievery room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical room equipped for childbirth and immediate maternal and newborn care.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/critical_care_area">
  <rdfs:subClassOf rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critical care area</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">healthcare facility area intended for patients who require continuous physiological monitoring and immediate access to life-supporting interventions.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit">
