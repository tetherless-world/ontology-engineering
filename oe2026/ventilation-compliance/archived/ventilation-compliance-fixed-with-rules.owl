<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="file:///tmp/claude-0/-home-claude/7590e7b2-0b4d-5c86-8df2-b78a7c3c6a7c/scratchpad/rep/mf.owl"
         xmlns="file:///tmp/claude-0/-home-claude/7590e7b2-0b4d-5c86-8df2-b78a7c3c6a7c/scratchpad/rep/mf.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:prov="http://www.w3.org/ns/prov#"
         xmlns:core="http://www.w3.org/2004/02/skos/core#"
         xmlns:term="http://purl.org/dc/terms/"
         xmlns:o2o.="https://karlhammar.com/owl2oas/o2o.owl#"
         xmlns:vent="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/"
         xmlns:Quan="https://www.omg.org/spec/Commons/QuantitiesAndUnits/"
         xmlns:Coll="https://www.omg.org/spec/Commons/Collections/"
         xmlns:Part="https://www.omg.org/spec/Commons/PartiesAndSituations/"
         xmlns:Anno="https://www.omg.org/spec/Commons/AnnotationVocabulary/">

<owl:Ontology rdf:about="file:///tmp/claude-0/-home-claude/7590e7b2-0b4d-5c86-8df2-b78a7c3c6a7c/scratchpad/rep/mf.owl"/>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/isPartOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is part of</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</core:definition>
  <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that 'is part of' is not a subproperty of 'isIncludedIn' in order to enable transitivity for whole-part relationships without limiting the use of cardinality constraints on inclusion and membership.</core:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedPolicy">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluated policy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a policy assessment and a compliance policy when the policy provides the requirements against which the assessment determines compliance</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasAssociatedWith</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agents-responsibility</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasAssociateFor</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">Because prov:wasInfluencedBy is a broad relation, its more specific subproperties (e.g. prov:wasInformedBy, prov:actedOnBehalfOf, prov:wasEndedBy, etc.) should be used when applicable.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property has multiple RDFS domains to suit multiple OWL Profiles. See &lt;a href="#owl-profile"&gt;PROV-O OWL Profile&lt;/a&gt;.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasInfluencedBy</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualified</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agents-responsibility</prov:component>
  <prov:editorialNote xml:lang="en">The sub-properties of prov:wasInfluencedBy can be elaborated in more detail using the Qualification Pattern. For example, the binary relation :baking prov:used :spoon can be qualified by asserting :baking prov:qualifiedUsage [ a prov:Usage; prov:entity :spoon; prov:atLocation :kitchen ] .

Subproperties of prov:wasInfluencedBy may also be asserted directly without being qualified.

prov:wasInfluencedBy should not be used without also using one of its subproperties. 
</prov:editorialNote>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">influenced</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recorded in</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an observation record and a room when the observation represented by the record pertains to that room as its spatial context</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantityValue"/>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedAt">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is evaluated at</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a measurement and a policy assessment when the measurement is used as evidence in the assessment to determine compliance with one or more policy requirements</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition derived from the NIST OSCAL decomposition of an assessment into reviewed controls, control objectives, assessment activities, observations, and findings, specialized to the policy-assessment structure of this ontology and formulated according to ISO 704:2022.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has policy assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance assessment and a policy assessment when the policy assessment constitutes part of the compliance assessment by evaluating requirements associated with a compliance policy</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connects to</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">topological relation that holds between two entities when they are directly linked to one another</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn">
  <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acts on</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relates an actor in a given situation to the undergoer that they affect under the circumstances</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/neighbor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neighbor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between two entities when they are adjacent or sufficiently close according to the relevant spatial or structural context</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedInNeighbor">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/neighbor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recorded in neighbor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an observation record and a room when the room is adjacent to the room that constitutes the primary spatial context of the observation</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/rec/core/componentOfBuilding">
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/rec/core/componentOf"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Building"/>
  <rdfs:comment xml:lang="en">Indicates which Building a certain Building Component is part of.</rdfs:comment>
  <rdfs:label xml:lang="en">component of building</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/rec/core/componentOf">
  <owl:inverseOf rdf:resource="https://w3id.org/rec/core/hasBuildingComponent"/>
  <rdfs:comment xml:lang="en">Links a Building Component to a Space, that the Building Component is either contained in, adjacent to or intersecting with.</rdfs:comment>
  <rdfs:label xml:lang="en">component of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit">
  <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has measurement unit</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicates the unit against which a quantity can be expressed in a quantity value</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasDerivedFrom</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derivations</prov:component>
  <prov:definition xml:lang="en">A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity.</prov:definition>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hadDerivation</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#hadPrimarySource">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hadPrimarySource</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derivations</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasPrimarySourceOf</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/fso#isComponentOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/fso#Component"/>
  <rdfs:range rdf:resource="https://w3id.org/fso#System"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent">
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/fso#hasComponent"/>
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Collections/hasPart"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has service component</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building service system and a building service component when the component constitutes part of the system</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/fso#hasComponent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="https://w3id.org/fso#isComponentOf"/>
  <rdfs:domain rdf:resource="https://w3id.org/fso#System"/>
  <rdfs:range rdf:resource="https://w3id.org/fso#Component"/>
  <rdfs:comment xml:lang="en">Relates a system to a component it contains</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a system to a component it contains. If system A has a subsystem B, which has a component C, then system A is said to have component C as well.</rdfs:comment>
  <rdfs:label xml:lang="da">har komponent</rdfs:label>
  <rdfs:label xml:lang="en">has component</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/hasPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has part</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicates any portion of something, regardless of whether the portion itself is attached to the remainder or detached; cognitively salient or arbitrarily demarcated; self-connected or disconnected; homogeneous or gerrymandered; material or immaterial; extended or unextended; spatial or temporal</core:definition>
  <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that 'has part' is not a subproperty of 'comprises' in order to enable transitivity for whole-part relationships without limiting the use of cardinality constraints on comprises and membership.</core:note>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/rec/core/serves">
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building service system and a room when the system provides a building service whose effect or coverage applies to that room</core:definition>
  <rdfs:comment xml:lang="en">The coverage or impact area of a given Asset or Sensor/Actuator. For example: an air-treatment unit might serve several Rooms or a full Building. Note that Assets can also service one another, e.g., an air-treatment Asset might serve an air diffuser Asset.</rdfs:comment>
  <rdfs:label xml:lang="en">serves</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredIn">
  <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measured in</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a measurement and a room when the measured property pertains to an entity or condition in that room</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToPolicyAssessment">
  <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">applies to policy assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment context and a policy assessment when the context specifies the conditions under which the policy assessment is performed or interpreted</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">applies to</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an entity and another entity when the former is relevant or valid for the latter under specified conditions</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures">
  <rdfs:domain rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measures</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an entity having a measurement capability and an entity whose value is determined through realization of that capability</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasQuotedFrom">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">An entity is derived from an original entity by copying, or 'quoting', some or all of it.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasQuotedFrom</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derivations</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quotedAs</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound">
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantity"/>
  <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has lower bound</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifies the quantity value that is the lower value of a pair of values representing a range</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantity">
  <owl:equivalentProperty rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantityValue"/>
  <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/isValueOf"/>
  <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has quantity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relates something (an expression, formula, etc.) to its magnitude expressed as a number together with its unit of measure (if applicable)</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasStartedBy">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">Start is when an activity is deemed to have started. A start may refer to an entity, known as trigger, that initiated the activity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasStartedBy</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">started</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesMeasurement">
  <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedAt"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluates measurement</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a policy assessment and a measurement when the measurement is used as evidence in the assessment to determine compliance with one or more policy requirements</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasRoom">
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Collections/hasPart"/>
  <rdfs:domain rdf:resource="https://w3id.org/rec/core/Building"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building and a room when the room forms part of the building’s spatial structure</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToRoom">
  <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">applies to room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an entity and a room when the entity is relevant, valid, or applicable to that room under specified conditions</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy">
  <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isPolicyOf"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derived from the policy-grouping semantics of ODRL involvedPolicy and from NIST OSCAL's profile/control-composition model, formulated according to ISO 704:2022.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has policy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance framework and a compliance policy when the policy is included in or specified by the framework as part of its compliance requirements</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound">
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantity"/>
  <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has upper bound</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifies the quantity value that is the higher value of a pair of values representing a range</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasContext">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition derived from the NIST OSCAL representation of assessment scope, subjects, terms and conditions, methodology, activities, and related contextual information, and formulated according to ISO 704:2022.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has context</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance assessment and an assessment context when the context specifies the circumstances, scope, or conditions under which the assessment is performed or interpreted</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesMeasurement">
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uses measurement</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment context and a measurement when the measurement provides evidence used for assessment within that context</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/ContextualDesignators/uses">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uses</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employs to accomplish some task or achieve some result</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithSystem">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">was associated with system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment and a building service system when the outcome of the assessment is associated with that system</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesFramework">
  <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uses framework</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment context and a compliance framework when the framework specifies the compliance requirements applicable within that context</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/forRoom">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">for room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment context and a room when the room is the spatial subject or scope to which the assessment context applies</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">Attribution is the ascribing of an entity to an agent.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasAttributedTo</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agents-responsibility</prov:component>
  <prov:definition xml:lang="en">Attribution is the ascribing of an entity to an agent.</prov:definition>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contributed</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isPolicyOf">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is policy of</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance policy and a compliance framework when the policy is included in or specified by the framework as part of its compliance requirements</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is affected by</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relates an undergoer in a given situation to the actor that has an impact on them under the circumstances</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedCompliance">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition derived from the NIST OSCAL assessment model, in which an assessment determines compliance relative to defined controls or control baselines, and formulated according to ISO 704:2022.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluated compliance</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance assessment and a compliance framework when the requirements specified by the framework provide the basis for determining compliance in the assessment</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn">
  <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedBy"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluates on</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a compliance policy and a measurement when the measurement provides evidence used to determine whether the requirements expressed by the policy are satisfied</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedBy">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is evaluated by</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elation that holds between a measurement and a compliance policy when the measurement provides evidence used to determine whether the requirements expressed by the policy are satisfied</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasEndedBy">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">End is when an activity is deemed to have ended. An end may refer to an entity, known as trigger, that terminated the activity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasEndedBy</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ended</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/componentOfServiceSystem">
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/rec/core/componentOf"/>
  <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">component of service system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building service component and a building service system when the component constitutes part of the system</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/rec/core/servedBy">
  <owl:inverseOf rdf:resource="https://w3id.org/rec/core/serves"/>
  <rdfs:comment xml:lang="en">Indicates that a Space or Asset is served by some Sensor/Actuator or other Asset. For example: an entrance room might be served by (e.g., covered by) some camera equipment, or a conference room served by a CO2 sensor. Note that Assets can also service one another, e.g., an air-treatment Asset might serve an air diffuser Asset.</rdfs:comment>
  <rdfs:label xml:lang="en">served by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceSystem">
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has service system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building and a building service system when the system provides one or more building services for that building</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasGeneratedBy</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">generated</prov:inverse>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/servesRoom">
  <rdfs:subPropertyOf rdf:resource="https://w3id.org/rec/core/serves"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
  <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serves room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building service system and a room to which the system provides a building service</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/isValueOf"/>

<owl:ObjectProperty rdf:about="https://w3id.org/rec/core/hasBuildingComponent">
  <rdfs:comment xml:lang="en">Links a Space to a BuildingComponent that is either contained in, adjacent to or intersecting with the Space.</rdfs:comment>
  <rdfs:label xml:lang="en">has building component</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredBy">
  <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measured by</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an entity whose value is determined and an entity having the measurement capability realized to determine that value</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/ContextualDesignators/isUsedBy">
  <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is used by</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serves a function or purpose for</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasBuildingSystem">
  <rdfs:domain rdf:resource="https://w3id.org/rec/core/Building"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has building system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between a building and a building system when the system is associated with the building as part of its operational or functional infrastructure</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithComponent">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
  <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment"/>
  <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">was associated with component</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation that holds between an assessment and a building service component when the outcome of the assessment is associated with that component</core:definition>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#atTime">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
  <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
  <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#invalidatedAtTime"/>
  <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
  <rdfs:comment xml:lang="en">The time at which an InstantaneousEvent occurred, in the form of xsd:dateTime.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atTime</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualified</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#endedAtTime">
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#atTime"/>
  <rdfs:comment xml:lang="en">The time at which an activity ended. See also prov:startedAtTime.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endedAtTime</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:editorialNote xml:lang="en">It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime.</prov:editorialNote>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#atTime"/>
  <rdfs:comment xml:lang="en">The time at which an entity was completely created and is available for use.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">generatedAtTime</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:editorialNote xml:lang="en">It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime.</prov:editorialNote>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#invalidatedAtTime">
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#atTime"/>
  <rdfs:comment xml:lang="en">The time at which an entity was invalidated (i.e., no longer usable).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">invalidatedAtTime</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:editorialNote xml:lang="en">It is the intent that the property chain holds: (prov:qualifiedInvalidation o prov:atTime) rdfs:subPropertyOf prov:invalidatedAtTime.</prov:editorialNote>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#startedAtTime">
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#atTime"/>
  <rdfs:comment xml:lang="en">The time at which an activity started. See also prov:endedAtTime.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startedAtTime</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting-point</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:editorialNote xml:lang="en">It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime.</prov:editorialNote>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasNumericValue"/>

<owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value">
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">value</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entities-activities</prov:component>
  <prov:definition xml:lang="en">Provides a value that is a direct representation of an entity.</prov:definition>
  <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value</prov:dm>
  <prov:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The editor's definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue</prov:editorialNote>
  <prov:editorialNote xml:lang="en">This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, 'may be used in describing structured values').</prov:editorialNote>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en"></rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en"></rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
  <rdfs:comment xml:lang="en"></rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#unqualifiedForm">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:comment xml:lang="en">Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#qualifiedForm">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:comment xml:lang="en">This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. 

Example annotation:

    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .

Then this unqualified assertion:

    :entity1 prov:wasGeneratedBy :activity1 .

can be qualified by adding:

   :entity1 prov:qualifiedGeneration :entity1Gen .
   :entity1Gen 
       a prov:Generation, prov:Influence;
       prov:activity :activity1;
       :customValue 1337 .

Note how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">A revision is a derivation that revises an entity into a revised version.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasRevisionOf</rdfs:label>
  <prov:category rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expanded</prov:category>
  <prov:component rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derivations</prov:component>
  <prov:inverse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hadRevision</prov:inverse>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#aq">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#n">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-DM document that describes this concept.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#inverse">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/prov-o/#names-of-inverse-properties"/>
  <rdfs:comment xml:lang="en">PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#constraints">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#sharesDefinitionWith">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#editorsDefinition">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#definition"/>
  <rdfs:comment xml:lang="en">When the prov-o term does not have a definition drawn from prov-dm, and the prov-o editor provides one.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#definition">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#dm">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-DM document that describes this concept.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/dateCopyrighted"/>

<owl:AnnotationProperty rdf:about="https://karlhammar.com/owl2oas/o2o.owl#included"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#order">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">The position that this OWL term should be listed within documentation. The scope of the documentation (e.g., among all terms, among terms within a prov:category, among properties applying to a particular class, etc.) is unspecified.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#category">
  <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <rdfs:comment xml:lang="en">Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. </rdfs:comment>
</owl:AnnotationProperty>

