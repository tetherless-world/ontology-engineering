    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heating coil</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">air-to-fluid or air-to-refrigerant heat exchanger that transfers heat to an airstream.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/sterilizing_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sterilizing lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory support space equipped to render reusable items free of viable microorganisms by a validated sterilization process.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRateSensor">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">airflow rate sensor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetric airflow rate of outdoor air entering an air-handling unit.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/OutdoorAirDamper">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUOutdoorAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/OutdoorAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outdoor-air damper</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">damper that controls the flow of outdoor air into an air-handling system</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/IncomingTransferAirflowRate">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DerivedMeasurement"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ReturnAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incoming transfer airflow rate</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">airflow rate representing the volume of air per unit time that enters a room from an adjacent area through an intentional transfer opening or an unintended leakage path.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/HeatExchanger">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcheatexchanger.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_heatexchangertypecommon.htm"/>
  <rdfs:comment xml:lang="en">A heat exchanger is a device used to provide heat transfer between non-mixing media such as plate and shell and tube heat exchangers. HeatExchanger is commonly used on water-side distribution systems to recover energy from a liquid to another liquid (typically water-based), whereas AirToAirHeatRecovery is commonly used on air-side distribution systems to recover energy from a gas to a gas (usually air).</rdfs:comment>
  <rdfs:label xml:lang="en">Heat exchanger</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcHeatExchanger</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/TotalAirChangePerHour">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DerivedMeasurement"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/roomVolume"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total air change per hour</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Room air-change rate calculated from total supply airflow rate divided by room volume.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Boiler">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcboiler.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_boilertypecommon.htm"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heating source that transfers heat from fuel combustion or electricity to water or steam.</core:definition>
  <rdfs:comment xml:lang="en">A boiler is a closed, pressure-rated vessel in which water or other fluid is heated using an energy source such as natural gas, heating oil, or electricity. The fluid in the vessel is then circulated out of the boiler for use in various processes or heating applications.</rdfs:comment>
  <rdfs:label xml:lang="en">Boiler</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcBoiler</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Tank">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowStorageDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifctank.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_tanktypecommon.htm"/>
  <rdfs:comment xml:lang="en">A tank is a vessel or container in which a fluid or gas is stored for later use.</rdfs:comment>
  <rdfs:label xml:lang="en">Tank</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcTank</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/EvaporativeCooler">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcevaporativecooler.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_evaporativecoolertypecommon.htm"/>
  <rdfs:comment xml:lang="en">An evaporative cooler is a device that cools air by saturating it with water vapor.</rdfs:comment>
  <rdfs:label xml:lang="en">Evaporative cooler</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcEvaporativeCooler</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/protective_environment_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nursing_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protective environment room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patient room designed to reduce exposure of a highly susceptible occupant to airborne contaminants from surrounding indoor areas.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/dark_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/radiology_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dark room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiology support room in which light-sensitive imaging materials are handled under controlled illumination.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/radiology_area">
  <rdfs:subClassOf rdf:resource="https://w3id.org/rec/core/Room"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiology area</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnostic area containing equipment and spaces used to create medical images with ionizing radiation.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/SpaceHeater">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcspaceheater.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_spaceheatertypecommon.htm"/>
  <rdfs:comment xml:lang="en">Space heaters utilize a combination of radiation and/or natural convection using a heating source such as electricity, steam or hot water to heat a limited space or area. Examples of space heaters include radiators, convectors, baseboard and finned-tube heaters.

UnitaryEquipment should be used for packaged units supporting a combination of heating, cooling, and/or dehumidification; Coil should be used for coil-based floor heating.</rdfs:comment>
  <rdfs:label xml:lang="en">Space heater</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcSpaceHeater</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Outlet">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifcoutlet.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_outlettypecommon.htm"/>
  <rdfs:comment xml:lang="en">An outlet is a device installed at a point to receive one or more inserted plugs for electrical power or communications.

Power outlets are commonly connected within a junction box; data outlets may be directly connected to a wall. For power outlets sharing the same circuit within a junction box, the ports should indicate the logical wiring relationship to the enclosing junction box, even though they may be physically connected to a cable going to another outlet, switch, or fixture.</rdfs:comment>
  <rdfs:label xml:lang="en">Outlet</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcOutlet</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/soiled_workroom">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/diagnostic_and_treatment_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soiled workroom</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">service room used to receive, hold, clean, or process contaminated supplies or equipment before decontamination or disposal.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/CommunicationAppliance">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifccommunicationsappliance.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_communicationsappliancetypecommon.htm"/>
  <rdfs:comment xml:lang="en">A communications appliance transmits and receives electronic or digital information as data or sound.

Communication appliances may be fixed in place or may be able to be moved from one space to another. Communication appliances require an electrical supply that may be supplied either by an electrical circuit or provided from a local battery source.</rdfs:comment>
  <rdfs:label xml:lang="en">Communication appliance</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcCommunicationAppliance</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heating and cooling source</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HVAC energy-conversion equipment that produces heating or cooling capacity for delivery to air, water, refrigerant, or another heat-transfer medium.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exaust air flow rate</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volumetric airflow rate removed from a room through the exhaust path.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/toilet_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nursing_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">toilet room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enclosed healthcare facility space containing a toilet and intended for sanitary use.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/UnsatisfiedComplianceAssessment">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/UnsatisfiedPolicyAssessment"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unsatisfied compliance assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compliance assessment covering one or more applicable policies whose policy assessments are all unsatisfied</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AllAirExhaustedDirectlyToOutdoors">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/TotalAirChangePerHour"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all air exhausted directly to outdoors</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust-air disposition requirement specifying that air removed from a room must be discharged outdoors and must not be recirculated to other areas.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HVACSystem">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hvac system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">building services system that provides heating, ventilation, and air conditioning to control conditions in one or more indoor spaces.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/SanitaryTerminal">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcplumbingfireprotectiondomain/lexical/ifcsanitaryterminal.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcplumbingfireprotectiondomain/pset/pset_sanitaryterminaltypecommon.htm"/>
  <rdfs:comment xml:lang="en">A sanitary terminal is a fixed appliance or terminal usually supplied with water and used for drinking, cleaning or foul water disposal or that is an item of equipment directly used with such an appliance or terminal.</rdfs:comment>
  <rdfs:label xml:lang="en">Sanitary terminal</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcSanitaryTerminal</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/physical_therapy_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/diagnostic_and_treatment_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical therapy room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treatment space equipped for therapeutic exercise, mobility training, or other physical rehabilitation activities.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ETO-sterilizer_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/diagnostic_and_treatment_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ETO-sterilizer room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">service room containing equipment that uses ethylene oxide for low-temperature microbial-elimination processing of compatible items.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/CooledBeam">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifccooledbeam.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_cooledbeamtypecommon.htm"/>
  <rdfs:comment xml:lang="en">A cooled beam (or chilled beam) is a device typically used to cool air by circulating a fluid such as chilled water through exposed finned tubes above a space. Typically mounted overhead near or within a ceiling, the cooled beam uses convection to cool the space below it by acting as a heat sink for the naturally rising warm air of the space. Once cooled, the air naturally drops back to the floor where the cycle begins again.</rdfs:comment>
  <rdfs:label xml:lang="en">Cooled beam</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcCooledBeam</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/MinBoundedCompliancePolicy">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound"/>
      <owl:onClass rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">min bounded compliance policy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compliance policy that specifies a minimum value as the lowest acceptable measurement and specifies no maximum value.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Compressor">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowMovingDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifccompressor.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_compressortypecommon.htm"/>
  <rdfs:comment xml:lang="en">A compressor is a device that compresses a fluid typically used in a refrigeration circuit.</rdfs:comment>
  <rdfs:label xml:lang="en">Compressor</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcCompressor</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/sterile_storage">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/central_medical_and_surgical_supply_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sterile storage</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">room designated for the secure storage of sterilized medical supplies and instruments prior to clinical use.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/MinimumAirChangesOfOutdoorAirPerHour">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/OutdoorAirChangePerHour"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum air changes of outdoorAir perhour</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outdoor-air ventilation requirement specifying the minimum outdoor-air airflow rate divided by room volume, expressed in h⁻¹.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/FlowInstrument">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/DistributionControlDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/lexical/ifcflowinstrument.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/pset/pset_flowinstrumenttypecommon.htm"/>
  <rdfs:comment xml:lang="en">A flow instrument reads and displays the value of a particular property of a system at a point, or displays the difference in the value of a property between two points.

Instrumentation is typically for the purpose of determining the value of the property at a point in time. It is not the purpose of an instrument to record or integrate the values over time (although they may be connected to recording devices that do perform such a function). This entity provides for all forms of mechanical flow instrument (thermometers, pressure gauges etc.) and electrical flow instruments (ammeters, voltmeters etc.)</rdfs:comment>
  <rdfs:label xml:lang="en">Flow instrument</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcFlowInstrument</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/ProtectiveDeviceTrippingUnit">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/DistributionControlDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifcprotectivedevicetrippingunit.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_protectivedevicetrippingunittypecommon.htm"/>
  <rdfs:comment xml:lang="en">A protective device tripping unit breaks an electrical circuit at a separate breaking unit when a stated electric current that passes through the unit is exceeded.</rdfs:comment>
  <rdfs:label xml:lang="en">Protective device tripping unit</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcProtectiveDeviceTrippingUnit</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SatisfiedComplianceAssessment">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SatisfiedPolicyAssessment"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">satisfied compliance assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compliance assessment covering one or more applicable policies whose policy assessments are all satisfied</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nuclear_medicine_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear medicine lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specialized room equipped for post-mortem examination of a human body.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ArbitraryUnit">
  <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit"/>
  <owl:disjointWith rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/PhysicalUnit"/>
  <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 11240 Health informatics - Identification of medicinal products - Data elements and structures for the unique identification and exchange of units of measurement, clause 3.1.1</term:source>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrary unit</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrarily defined unit of measurement, where a relation of the unit to a physical unit of the SI does not exist or is unknown</core:definition>
  <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arbitrary units represent references to materials or procedures that are defined outside of the SI system. A quantity value is arbitrarily assigned to the reference preparation or the result of a measurement procedure, usually specific for a particular substance. This generally precludes comparability of quantity values across different systems and components for this type of units.</core:note>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/ElectricAppliance">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifcelectricappliance.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_electricappliancetypecommon.htm"/>
  <rdfs:comment xml:lang="en">An electric appliance is a device intended for consumer usage that is powered by electricity.

Electric appliances may be fixed in place or may be able to be moved from one space to another. Electric appliances require an electrical supply that may be supplied either by an electrical circuit or provided from a local battery source.</rdfs:comment>
  <rdfs:label xml:lang="en">Electric appliance</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcElectricAppliance</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/RelativeHumidity">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative humidity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">moisture-condition parameter equal to the partial, density, or mole fraction of water vapor in air divided by the corresponding saturation value at the same temperature and barometric conditions, usually expressed as a percentage.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/pathology_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathology lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory support space equipped to render reusable items free of viable microorganisms by a validated sterilization process.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem">
  <rdfs:subClassOf rdf:resource="https://w3id.org/fso#System"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">building system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">system associated with a building that performs or supports one or more operational functions</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Coil">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifccoil.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_coiltypecommon.htm"/>
  <rdfs:comment xml:lang="en">A coil is a device used to provide heat transfer between non-mixing media. A common example is a cooling coil, which utilizes a finned coil in which circulates chilled water, antifreeze, or refrigerant that is used to remove heat from air moving across the surface of the coil. A coil may be used either for heating or cooling purposes by placing a series of tubes (the coil) carrying a heating or cooling fluid into an airstream. The coil may be constructed from tubes bundled in a serpentine form or from finned tubes that give a extended heat transfer surface.

Coils may also be used for non-airflow cases such as embedded in a floor slab.</rdfs:comment>
  <rdfs:label xml:lang="en">Coil</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcCoil</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/service_area">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/central_medical_and_surgical_supply_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">service area</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">designated space within a facility utilized for utility maintenance, equipment storage, or logistical support operations.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Diffuser">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SupplyAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diffuser</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supply-air terminal device that discharges air into a space in a specified pattern and promotes mixing of supply air with room air.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/treatment_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/critical_care_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">traetment room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical room equipped for non-operative therapeutic procedures performed on patients.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/cytology_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cytology lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory space used to prepare and examine cells for diagnostic evaluation.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Interceptor">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTreatmentDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcplumbingfireprotectiondomain/lexical/ifcinterceptor.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcplumbingfireprotectiondomain/pset/pset_interceptortypecommon.htm"/>
  <rdfs:comment xml:lang="en">An interceptor is a device designed and installed in order to separate and retain deleterious, hazardous or undesirable matter while permitting normal sewage or liquids to discharge into a collection system by gravity.</rdfs:comment>
  <rdfs:label xml:lang="en">Interceptor</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcInterceptor</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/MaxBoundedCompliancePolicy">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound"/>
      <owl:onClass rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">max bounded compliance policy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compliance policy that specifies a maximum value as the highest acceptable measurement and specifies no minimum value.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Alarm">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/DistributionControlDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/lexical/ifcalarm.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/pset/pset_alarmtypecommon.htm"/>
  <rdfs:comment xml:lang="en">An alarm is a device that signals the existence of a condition or situation that is outside the boundaries of normal expectation or that activates such a device.

Alarms include the provision of break glass buttons and manual pull boxes that are used to activate alarms.</rdfs:comment>
  <rdfs:label xml:lang="en">Alarm</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcAlarm</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/x-ray_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/radiology_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x-ray room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiology-area room containing equipment used to produce diagnostic images with X-radiation.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustFan">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust fan</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fan that draws air out of a space or system and moves it toward discharge</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isolation_alcove">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nursing_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isolation alcove</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partially enclosed patient-care space intended to separate an occupant or activity from adjacent care areas.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust and relief system</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">building service component comprising the equipment and ductwork that removes air from spaces and discharges it</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/bathroom">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/central_medical_and_surgical_supply_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bathroom</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">room containing a toilet and washbasin designated for patient or staff personal hygiene.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Pump">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowMovingDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcpump.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_pumptypecommon.htm"/>
  <rdfs:comment xml:lang="en">A pump is a device which imparts mechanical work on fluids or slurries to move them through a channel or pipeline. A typical use of a pump is to circulate chilled water or heating hot water in a building services distribution system.</rdfs:comment>
  <rdfs:label xml:lang="en">Pump</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcPump</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/patient_corridor">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nursing_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patient corridor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circulation space connecting patient rooms and other patient-care spaces.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/UnknownPolicyAssessment">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unknown policy assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy assessment for which the available information is insufficient to determine whether the evaluated policy’s applicable requirements are met</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirMovementRelationshipToAdjacentArea">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/IncomingTransferAirflowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">air movement relationship to adjacent area</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">airflow-direction requirement that specifies whether air is to move into a room from, out of a room toward, or without a prescribed direction relative to adjacent areas.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/SwitchingDevice">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowController"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifcswitchingdevice.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_switchingdevicetypecommon.htm"/>
  <rdfs:comment xml:lang="en">A switch is used in a cable distribution system (electrical circuit) to control or modulate the flow of electricity.

Switches include those used for electrical power, communications, audio-visual, or other distribution system types as determined by the available ports.</rdfs:comment>
  <rdfs:label xml:lang="en">Switching device</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcSwitchingDevice</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/AirToAirHeatRecovery">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcairtoairheatrecovery.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_airtoairheatrecoverytypecommon.htm"/>
  <rdfs:comment xml:lang="en">An air-to-air heat recovery device employs a counter-flow heat exchanger between inbound and outbound air flow. It is typically used to transfer heat from warmer air in one chamber to cooler air in the second chamber (i.e., typically used to recover heat from the conditioned air being exhausted and the outside air being supplied to a building), resulting in energy savings from reduced heating (or cooling) requirements.</rdfs:comment>
  <rdfs:label xml:lang="en">Air to air heat recovery</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcAirToAirHeatRecovery</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/roomVolume">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">room volume</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space volume bounded by the room’s enclosing surfaces.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustDuctwork">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust ductwork</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ductwork that conveys exhaust air from spaces toward an outdoor discharge</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HumiditySensor">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">humidity sensor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetric total supply-airflow rate discharged by an air-handling unit.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/UnknownComplianceAssessment">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment"/>
          <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/UnknownPolicyAssessment"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unknown compliance assessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compliance assessment containing at least one unknown policy assessment</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/glass_washing_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass washing lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory support space equipped for cleaning and processing reusable laboratory glassware.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/DistributionDevice">
  <rdfs:comment xml:lang="en">Generalization of all devices that participate in a distribution system. (Definition adapated from https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcproductextension/lexical/ifcdistributionelement.htm)</rdfs:comment>
  <rdfs:label xml:lang="en">Distribution device</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DesignTemperature">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design temperature</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indoor temperature requirement specifying the temperature or allowable range that the HVAC system is capable of maintaining during normal operation.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustInlet">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust inlet</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">opening through which air is drawn from a space into exhaust ductwork</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Damper">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowController"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifcdamper.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/pset/pset_dampertypecommon.htm"/>
  <rdfs:comment xml:lang="en">A damper typically participates in an HVAC duct distribution system and is used to control or modulate the flow of air.</rdfs:comment>
  <rdfs:label xml:lang="en">Damper</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcDamper</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/ProtectiveDevice">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowController"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifcprotectivedevice.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_protectivedevicetypecommon.htm"/>
  <rdfs:comment xml:lang="en">A protective device breaks an electrical circuit when a stated electric current that passes through it is exceeded.

A protective device provides protection against electrical current only (not as a general protective device). It may be used to represent the complete set of elements including both the tripping unit and the breaking unit that provide the protection. This may be particularly useful at earlier stages of design where the approach to breaking the electrical supply may be determined but the method of tripping may not. Alternatively, this entity may be used to specifically represent the breaking unit alone (in which case the tripping unit will also be specifically identified). This entity is specific to dedicated protective devices and excludes electrical outlets that may have circuit protection.</rdfs:comment>
  <rdfs:label xml:lang="en">Protective device</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcProtectiveDevice</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PressureSensor">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
      <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure sensor</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor that detects the static or differential pressure of a medium</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/biochemistry_lab">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biochemistry lab</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory space used to measure chemical constituents or biochemical properties of clinical specimens.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/nonrefrigerated_body-holding_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/laboratory_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nonrefrigerated body-holding room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">service-area room used for temporary holding of human remains without refrigerated storage.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Actuator">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/DistributionControlDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/lexical/ifcactuator.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcbuildingcontrolsdomain/pset/pset_actuatortypecommon.htm"/>
  <rdfs:comment xml:lang="en">An actuator is a mechanical device for moving or controlling a mechanism or system. An actuator takes energy, usually created by air, electricity, or liquid, and converts that into some kind of motion.</rdfs:comment>
  <rdfs:label xml:lang="en">Actuator</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcActuator</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Lamp">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/FlowTerminal"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/lexical/ifclamp.htm"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcelectricaldomain/pset/pset_lamptypecommon.htm"/>
  <rdfs:comment xml:lang="en">A lamp is an artificial light source such as a light bulb or tube.</rdfs:comment>
  <rdfs:label xml:lang="en">Lamp</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ifc/IFC4_ADD1#IfcLamp</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/medication_room">
  <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/diagnostic_and_treatment_area"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medication room</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">healthcare facility room used for secure storage, preparation, and handling of medications before administration.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Humidifier">
  <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/EnergyConversionDevice"/>
  <term:source rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifchvacdomain/lexical/ifchumidifier.htm"/>
