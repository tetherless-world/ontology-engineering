        <rdfs:label>exhaust and relief system</rdfs:label>
        <skos:definition>building service component comprising the equipment and ductwork that removes air from spaces and discharges it</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustDuctwork -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustDuctwork">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
