<?xml version="1.0"?>
<rdf:RDF xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/"
     xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:fso="https://w3id.org/fso#"
     xmlns:o2o="https://karlhammar.com/owl2oas/o2o.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="https://w3id.org/rec/core/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:core1="http://www.linkedmodel.org/owl/schema/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:cmns-col="https://www.omg.org/spec/Commons/Collections/"
     xmlns:cmns-qtu="https://www.omg.org/spec/Commons/QuantitiesAndUnits/"
     xmlns:metadata="https://w3id.org/rec/metadata/"
     xmlns:saref4bldg="https://saref.etsi.org/saref4bldg/"
     xmlns:cmns-cxtdsg="https://www.omg.org/spec/Commons/ContextualDesignators/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:AnnotationVocabulary="https://www.omg.org/spec/Commons/AnnotationVocabulary/">
    <owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/">
        <owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-20130430"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4bldg/v2.1.1/"/>
        <owl:imports rdf:resource="https://w3id.org/rec/core/3.3/"/>
        <owl:imports rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/"/>
        <dc:creator>Ahosan Habib</dc:creator>
        <dc:creator>Andy Cheng</dc:creator>
        <dc:creator>Carina Liu</dc:creator>
        <dc:creator>Nipun Deelaka</dc:creator>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://www.w3.org/ns/prov#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo">
        <rdfs:label>applies to</rdfs:label>
        <skos:definition>relation that holds between an entity and another entity when the former is relevant or valid for the latter under specified conditions</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToPolicyAssessment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToPolicyAssessment">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        <rdfs:label>applies to policy assessment</rdfs:label>
        <skos:definition>relation that holds between an assessment context and a policy assessment when the context specifies the conditions under which the policy assessment is performed or interpreted</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToRoom -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesToRoom">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/appliesTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>applies to room</rdfs:label>
        <skos:definition>relation that holds between an entity and a room when the entity is relevant, valid, or applicable to that room under specified conditions</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/componentOfServiceSystem -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/componentOfServiceSystem">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rec/core/componentOf"/>
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
        <rdfs:label>component of service system</rdfs:label>
        <skos:definition>relation that holds between a building service component and a building service system when the component constitutes part of the system</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>connects to</rdfs:label>
        <skos:definition>topological relation that holds between two entities when they are directly linked to one another</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedCompliance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedCompliance">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
        <rdfs:comment>Definition derived from the NIST OSCAL assessment model, in which an assessment determines compliance relative to defined controls or control baselines, and formulated according to ISO 704:2022.</rdfs:comment>
        <rdfs:label>evaluated compliance</rdfs:label>
        <skos:definition>relation that holds between a compliance assessment and a compliance framework when the requirements specified by the framework provide the basis for determining compliance in the assessment</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedPolicy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatedPolicy">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:label>evaluated policy</rdfs:label>
        <skos:definition>relation that holds between a policy assessment and a compliance policy when the policy provides the requirements against which the assessment determines compliance</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesMeasurement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesMeasurement">
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedAt"/>
        <rdfs:label>evaluates measurement</rdfs:label>
        <skos:definition>relation that holds between a policy assessment and a measurement when the measurement is used as evidence in the assessment to determine compliance with one or more policy requirements</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn">
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedBy"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:label>evaluates on</rdfs:label>
        <skos:definition>relation that holds between a compliance policy and a measurement when the measurement provides evidence used to determine whether the requirements expressed by the policy are satisfied</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/forRoom -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/forRoom">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>for room</rdfs:label>
        <skos:definition>relation that holds between an assessment context and a room when the room is the spatial subject or scope to which the assessment context applies</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasBuildingSystem -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasBuildingSystem">
        <rdfs:domain rdf:resource="https://w3id.org/rec/core/Building"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem"/>
        <rdfs:label>has building system</rdfs:label>
        <skos:definition>relation that holds between a building and a building system when the system is associated with the building as part of its operational or functional infrastructure</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasContext -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasContext">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
        <rdfs:comment>Definition derived from the NIST OSCAL representation of assessment scope, subjects, terms and conditions, methodology, activities, and related contextual information, and formulated according to ISO 704:2022.</rdfs:comment>
        <rdfs:label>has context</rdfs:label>
        <skos:definition>relation that holds between a compliance assessment and an assessment context when the context specifies the circumstances, scope, or conditions under which the assessment is performed or interpreted</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy">
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isPolicyOf"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:comment>derived from the policy-grouping semantics of ODRL involvedPolicy and from NIST OSCAL&apos;s profile/control-composition model, formulated according to ISO 704:2022.</rdfs:comment>
        <rdfs:label>has policy</rdfs:label>
        <skos:definition>relation that holds between a compliance framework and a compliance policy when the policy is included in or specified by the framework as part of its compliance requirements</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicyAssessment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        <rdfs:comment>Definition derived from the NIST OSCAL decomposition of an assessment into reviewed controls, control objectives, assessment activities, observations, and findings, specialized to the policy-assessment structure of this ontology and formulated according to ISO 704:2022.</rdfs:comment>
        <rdfs:label>has policy assessment</rdfs:label>
        <skos:definition>relation that holds between a compliance assessment and a policy assessment when the policy assessment constitutes part of the compliance assessment by evaluating requirements associated with a compliance policy</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasRoom -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasRoom">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Collections/hasPart"/>
        <rdfs:domain rdf:resource="https://w3id.org/rec/core/Building"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>has room</rdfs:label>
        <skos:definition>relation that holds between a building and a room when the room forms part of the building’s spatial structure</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/fso#hasComponent"/>
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Collections/hasPart"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:label>has service component</rdfs:label>
        <skos:definition>relation that holds between a building service system and a building service component when the component constitutes part of the system</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceSystem -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceSystem">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
        <rdfs:label>has service system</rdfs:label>
        <skos:definition>relation that holds between a building and a building service system when the system provides one or more building services for that building</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedAt -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedAt">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/PolicyAssessment"/>
        <rdfs:label>is evaluated at</rdfs:label>
        <skos:definition>relation that holds between a measurement and a policy assessment when the measurement is used as evidence in the assessment to determine compliance with one or more policy requirements</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isEvaluatedBy">
        <rdfs:label>is evaluated by</rdfs:label>
        <skos:definition>elation that holds between a measurement and a compliance policy when the measurement provides evidence used to determine whether the requirements expressed by the policy are satisfied</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isPolicyOf -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/isPolicyOf">
        <rdfs:label>is policy of</rdfs:label>
        <skos:definition>relation that holds between a compliance policy and a compliance framework when the policy is included in or specified by the framework as part of its compliance requirements</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredBy -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredBy">
        <owl:inverseOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
        <rdfs:label>measured by</rdfs:label>
        <skos:definition>relation that holds between an entity whose value is determined and an entity having the measurement capability realized to determine that value</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredIn -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measuredIn">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>measured in</rdfs:label>
        <skos:definition>relation that holds between a measurement and a room when the measured property pertains to an entity or condition in that room</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
        <rdfs:label>measures</rdfs:label>
        <skos:definition>relation that holds between an entity having a measurement capability and an entity whose value is determined through realization of that capability</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/neighbor -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/neighbor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>neighbor</rdfs:label>
        <skos:definition>relation that holds between two entities when they are adjacent or sufficiently close according to the relevant spatial or structural context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <rdfs:label>recorded in</rdfs:label>
        <skos:definition>relation that holds between an observation record and a room when the observation represented by the record pertains to that room as its spatial context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedInNeighbor -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedInNeighbor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/recordedIn"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/neighbor"/>
        </owl:propertyChainAxiom>
        <rdfs:label>recorded in neighbor</rdfs:label>
        <skos:definition>relation that holds between an observation record and a room when the room is adjacent to the room that constitutes the primary spatial context of the observation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/servesRoom -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/servesRoom">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rec/core/serves"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/rec/core/Room"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasServiceComponent"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo"/>
        </owl:propertyChainAxiom>
        <rdfs:label>serves room</rdfs:label>
        <skos:definition>relation that holds between a building service system and a room to which the system provides a building service</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesFramework -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesFramework">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
        <rdfs:label>uses framework</rdfs:label>
        <skos:definition>relation that holds between an assessment context and a compliance framework when the framework specifies the compliance requirements applicable within that context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesMeasurement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/usesMeasurement">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:label>uses measurement</rdfs:label>
        <skos:definition>relation that holds between an assessment context and a measurement when the measurement provides evidence used for assessment within that context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithComponent -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:label>was associated with component</rdfs:label>
        <skos:definition>relation that holds between an assessment and a building service component when the outcome of the assessment is associated with that component</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithSystem -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/wasAssociatedWithSystem">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
        <rdfs:label>was associated with system</rdfs:label>
        <skos:definition>relation that holds between an assessment and a building service system when the outcome of the assessment is associated with that system</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fso#hasComponent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fso#hasComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/fso#isComponentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/fso#System"/>
        <rdfs:range rdf:resource="https://w3id.org/fso#Component"/>
        <rdfs:comment xml:lang="en">Relates a system to a component it contains</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a system to a component it contains. If system A has a subsystem B, which has a component C, then system A is said to have component C as well.</rdfs:comment>
        <rdfs:label xml:lang="da">har komponent</rdfs:label>
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fso#isComponentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fso#isComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/fso#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/fso#System"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rec/core/componentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rec/core/componentOf"/>
    


    <!-- https://w3id.org/rec/core/serves -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rec/core/serves">
        <skos:definition>relation that holds between a building service system and a room when the system provides a building service whose effect or coverage applies to that room</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Collections/hasPart -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/hasPart">
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>has part</rdfs:label>
        <skos:definition>indicates any portion of something, regardless of whether the portion itself is attached to the remainder or detached; cognitively salient or arbitrarily demarcated; self-connected or disconnected; homogeneous or gerrymandered; material or immaterial; extended or unextended; spatial or temporal</skos:definition>
        <skos:note>Note that &apos;has part&apos; is not a subproperty of &apos;comprises&apos; in order to enable transitivity for whole-part relationships without limiting the use of cardinality constraints on comprises and membership.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Collections/isPartOf -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>is part of</rdfs:label>
        <skos:definition>relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</skos:definition>
        <skos:note>Note that &apos;is part of&apos; is not a subproperty of &apos;isIncludedIn&apos; in order to enable transitivity for whole-part relationships without limiting the use of cardinality constraints on inclusion and membership.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/ContextualDesignators/isUsedBy -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/ContextualDesignators/isUsedBy">
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/ContextualDesignators/uses"/>
        <rdfs:label>is used by</rdfs:label>
        <skos:definition>serves a function or purpose for</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/ContextualDesignators/uses -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/ContextualDesignators/uses">
        <rdfs:label>uses</rdfs:label>
        <skos:definition>employs to accomplish some task or achieve some result</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn">
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy"/>
        <rdfs:label>acts on</rdfs:label>
        <skos:definition>relates an actor in a given situation to the undergoer that they affect under the circumstances</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy">
        <rdfs:label>is affected by</rdfs:label>
        <skos:definition>relates an undergoer in a given situation to the actor that has an impact on them under the circumstances</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound"/>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit"/>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#value -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://saref.etsi.org/core/Actuator -->

    <owl:Class rdf:about="https://saref.etsi.org/core/Actuator">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>device, operated electrically, pneumatically or hydraulically, that changes the position of a movable device such as a valve or damper</skos:definition>
        <skos:note xml:lang="en">A subset of the nine permitted measurements, determined by its operated equipment. For example, an outdoor-air-damper actuator can influence OutdoorAirFlowRate and AHUOutdoorAirFlowRate.</skos:note>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4bldg/Boiler -->

    <owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Boiler">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>heating source that transfers heat from fuel combustion or electricity to water or steam.</skos:definition>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4bldg/Chiller -->

    <owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Chiller">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>cooling source that removes heat from water or another liquid to produce chilled fluid for cooling.</skos:definition>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4bldg/Controller -->

    <owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Controller">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>device that regulates a system or component in normal operation, either manually or automatically</skos:definition>
        <skos:note xml:lang="en">A subset of the nine permitted measurements, determined by its controlled equipment. Materialize only the measurements influenced through its actual control connections.</skos:note>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4bldg/Fan -->

    <owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Fan">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUOutdoorAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUSupplyAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/OutdoorAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ReturnAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SupplyAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>air-moving device that produces a  difference to move air through an AHU, duct, or space.</skos:definition>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4bldg/Sensor -->

    <owl:Class rdf:about="https://saref.etsi.org/saref4bldg/Sensor">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUOutdoorAirFlowRate -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUOutdoorAirFlowRate">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ReturnAirFlowRate"/>
        <rdfs:label>AHU outdoor air flow rate</rdfs:label>
        <skos:definition>Volumetric airflow rate of outdoor air entering an air-handling unit.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUSupplyAirFlowRate -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AHUSupplyAirFlowRate">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SupplyAirFlowRate"/>
        <rdfs:label>AHU supply air flow rate</rdfs:label>
        <skos:definition>Volumetric total supply-airflow rate discharged by an air-handling unit.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
        <rdfs:label>air flow rate</rdfs:label>
        <skos:definition>flow rate equal to the volume of air moving past a given plane per unit time.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRateSensor -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRateSensor">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4bldg/Sensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/measures"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>airflow rate sensor</rdfs:label>
        <skos:definition>sensor that detects or measures the volumetric flow rate of air through a duct, opening, or air-handling component</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>air handling unit</rdfs:label>
        <skos:altLabel>AHU</skos:altLabel>
        <skos:definition>air-handling assembly that uses fans and air-treatment components to circulate, filter, mix, heat, cool, humidify, dehumidify, or otherwise condition air.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:label>air loop</rdfs:label>
        <skos:definition>air-side subsystem of an HVAC system that conditions, supplies, and usually returns air between central air-handling equipment and one or more served zones.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirMovementRelationshipToAdjacentArea -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirMovementRelationshipToAdjacentArea">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/IncomingTransferAirflowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>air movement relationship to adjacent area</rdfs:label>
        <skos:definition>airflow-direction requirement that specifies whether air is to move into a room from, out of a room toward, or without a prescribed direction relative to adjacent areas.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AllAirExhaustedDirectlyToOutdoors -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AllAirExhaustedDirectlyToOutdoors">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/TotalAirChangePerHour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>all air exhausted directly to outdoors</rdfs:label>
        <skos:definition>exhaust-air disposition requirement specifying that air removed from a room must be discharged outdoors and must not be recirculated to other areas.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment">
        <rdfs:comment>concept derived from the NIST OSCAL assessment model, which represents planned and performed evaluations of controls and their resulting observations/findings, and formulated according to ISO 704:2022.</rdfs:comment>
        <rdfs:label>assessment</rdfs:label>
        <skos:definition>process in which evidence is evaluated against specified criteria to determine an outcome</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AssessmentContext">
        <rdfs:label>assessment context</rdfs:label>
        <skos:definition>context specifying the assessed entity, temporal scope, and applicable policy versions within which an assessment result is interpreted</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingMeasurement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingMeasurement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:label>building measurement</rdfs:label>
        <skos:definition>measurement associated with a building, building system, component, room, or building environmental condition</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fso#Component"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/connectsTo"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rec/core/Room"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SensorMeasurement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
                            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>building service component</rdfs:label>
        <skos:definition>component that is part of a building service system and contributes to delivery, distribution, control, or measurement of a building service</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fso#System"/>
        <rdfs:label>building service system</rdfs:label>
        <skos:definition>system of building services that supplies, distributes, or controls utilities and environmental services within a building to support its use and operation</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fso#System"/>
        <rdfs:label>building system</rdfs:label>
        <skos:definition>system associated with a building that performs or supports one or more operational functions</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CDC_compliance_framework -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CDC_compliance_framework">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirMovementRelationshipToAdjacentArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AllAirExhaustedDirectlyToOutdoors"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DesignTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/MinimumAirChangesOfOutdoorAirPerHour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/RecirculatedByMeansOfRoomUnits"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/hasPolicy"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/RelativeHumidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CDC compliance framework</rdfs:label>
        <skos:definition>organized set of compliance requirements, policies, and assessment rules used to evaluate a target.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceAssessment">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Assessment"/>
        <rdfs:label>compliance assessment</rdfs:label>
        <skos:definition>assessment that evaluates whether one or more compliance policies are satisfied for a defined target and context</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ComplianceFramework">
        <rdfs:label>compliance framework</rdfs:label>
        <skos:definition>organized set of compliance requirements, policies, and assessment rules used to evaluate a target</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy">
        <rdfs:label>compliance policy</rdfs:label>
        <skos:definition>policy that specifies requirements used to determine whether an entity or situation is compliant</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Controls">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:label>HVAC control system</rdfs:label>
        <skos:definition>HVAC control system that monitors conditions and commands equipment to maintain specified operating conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CoolingCoil -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CoolingCoil">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirHandlingUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>cooling coil</rdfs:label>
        <skos:definition>air-to-fluid or air-to-refrigerant heat exchanger that removes sensible heat and, when its surface is below the air dew point, moisture from an airstream.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DerivedMeasurement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DerivedMeasurement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
                <owl:allValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Measurement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>derived measurement</rdfs:label>
        <skos:definition>measurement calculated from one or more other measurements or known quantities</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DesignTemperature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DesignTemperature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/CompliancePolicy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/evaluatesOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>design temperature</rdfs:label>
        <skos:definition>indoor temperature requirement specifying the temperature or allowable range that the HVAC system is capable of maintaining during normal operation.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Diffuser -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Diffuser">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirLoop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/SupplyAirFlowRate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>diffuser</rdfs:label>
        <skos:definition>supply-air terminal device that discharges air into a space in a specified pattern and promotes mixing of supply air with room air.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DirectExpansionUnit -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/DirectExpansionUnit">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/BuildingServiceComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/HeatingAndCoolingSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Humidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/PartiesAndSituations/actsOn"/>
                <owl:someValuesFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>direct-expansion unit</rdfs:label>
        <skos:altLabel>DX unit</skos:altLabel>
        <skos:definition>refrigeration-based HVAC unit that transfers heat between air and refrigerant in a direct-expansion coil, without chilled water being the cooling medium at that coil.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ETO-sterilizer_room -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ETO-sterilizer_room">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/diagnostic_and_treatment_area"/>
        <rdfs:label>ETO-sterilizer room</rdfs:label>
        <skos:definition>service room containing equipment that uses ethylene oxide for low-temperature microbial-elimination processing of compatible items.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAirFlowRate">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/AirFlowRate"/>
        <rdfs:label>exaust air flow rate</rdfs:label>
        <skos:definition>Volumetric airflow rate removed from a room through the exhaust path.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/ventilation-compliance/ventilation-compliance/ExhaustAndReliefSystem">
