    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/isMaximumInclusive -->

    <owl:DatatypeProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/isMaximumInclusive">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is maximum inclusive</rdfs:label>
        <skos:definition>indicates whether something, such as a measurement scale, includes the absolute maximum permissive value or not</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/isMinimumInclusive -->

    <owl:DatatypeProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/isMinimumInclusive">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is minimum inclusive</rdfs:label>
        <skos:definition>indicates whether something, such as a measurement scale, includes the absolute minimum permissive value or not</skos:definition>
    </owl:DatatypeProperty>
</rdf:RDF>



