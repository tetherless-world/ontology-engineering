     xmlns:quantitykind="http://qudt.org/vocab/quantitykind/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="https://w3id.org/rec/units/">
        <owl:versionIRI rdf:resource="https://w3id.org/rec/units/3.3/"/>
        <owl:imports rdf:resource="https://w3id.org/rec/metadata/3.3/"/>
        <dc:description xml:lang="en">This RealEstateCore module includes a subset of the QUDT ontology and instances, for easy reuse throughout the rest of REC.</dc:description>
        <dc:title>RealEstateCore Units Module</dc:title>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/vocab/quantitykind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/vocab/unit"/>
    </owl:Ontology>
    


