		<prov:wasAttributedTo rdf:resource="&tracking-cjf;CQSampleSpeakerA"/>
		<prov:wasGeneratedBy rdf:resource="&tracking-cjf;CQSampleConversation"/>
		<tracking-cjf:hasConversationText>The annual quote is $24,000, and we have $18,000 allocated. So there’s a $6,000 gap we would need to cover.</tracking-cjf:hasConversationText>
