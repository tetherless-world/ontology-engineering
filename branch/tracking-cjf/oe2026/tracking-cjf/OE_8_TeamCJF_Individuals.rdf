		<rdf:type rdf:resource="&tracking-cjf;TextSpan"/>
		<rdfs:label>Full utterance evidence, source turn 3</rdfs:label>
		<tracking-cjf:hasConversationText>What makes you say that? Are you mainly thinking about the setup work?</tracking-cjf:hasConversationText>
		<tracking-cjf:isPartOfUtterance rdf:resource="&tracking-cjf;CQSampleTurn3"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&tracking-cjf;CQSampleTurn4">
		<rdf:type rdf:resource="&tracking-cjf;Utterance"/>
		<prov:wasAttributedTo rdf:resource="&tracking-cjf;CQSampleSpeakerA"/>
		<prov:wasGeneratedBy rdf:resource="&tracking-cjf;CQSampleConversation"/>
		<tracking-cjf:hasConversationText>Yes. Platform A could simplify implementation because it already includes the repository management, issue tracking, and deployment tools we need.</tracking-cjf:hasConversationText>
