  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_1ce82228187659212b16">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
    <cjf:hasSpeakerName>Speaker C</cjf:hasSpeakerName>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_2f4f9e914b2c410c19ca">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Let’s move the $6,000 into the platform budget. We’ve all agreed to that, so the funding gap for Platform A is covered.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_18"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_908d1b67947cf090e9a6">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>I’ve checked those quotes too. Platform A includes the connectors and vendor onboarding in its price, so the revised comparison actually puts Platform A lower.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_2a9889c600ad54cc9787">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>so we can start setting up the environment next week.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_5">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
    <cjf:hasConversationText>My concern is the cost. Platform A looks more expensive than we can afford with the current tooling budget.</cjf:hasConversationText>
    <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</cjf:hasTurnNumber>
    <dc:identifier>5</dc:identifier>
    <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
    <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/State_654bc1fd20d65f93e063">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_33f1186a2b40a1f7b8a3">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Its base subscription is $12,000 a year, so I expect Platform B would cost us less overall.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Relationship_73e675a0f6746b049ee1">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Challenge"/>
    <cjf:isAimedAtChallenges rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Move_OCT21_A-M0003"/>
    <cjf:hasReason>Limited onboarding time is presented as a constraint on adopting Platform A.</cjf:hasReason>
    <ns1:SIO_000206 rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_d74a177aab42ae8063ba"/>
    <ns1:SIO_000206 rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_202584627b08b6cd6c0d"/>
    <cjf:hasUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_2"/>
    <cjf:hasUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_f90ae4cd0e368c3a8fd7">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>For this project, I think Platform A’s tested integrations and simpler setup make it the better fit. I support choosing Platform A.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_25"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Assignment_26d509938bfd1f3a2a5f">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
    <cjf:assignedState rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/State_26d509938bfd1f3a2a5f"/>
    <cjf:assignedAtUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_18"/>
    <cjf:hasReason>Generated candidate from relationship event: The exchange establishes the proposed $6,000 reallocation as the group's agreed action.</cjf:hasReason>
    <cjf:hasStateEvidence rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_bb729291b1ff0433afd4"/>
    <cjf:hasStateEvidence rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_8919307898a38f364aeb"/>
    <cjf:hasStateEvidence rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_1dd3d08956c307a4d698"/>
    <cjf:hasStateEvidence rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_9dba47deb827f27a7021"/>
    <cjf:hasPreviousAssignment rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Assignment_0e6815b92dd316042ca7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_27">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
    <cjf:hasConversationText>I’m voting for Platform A as well. The full cost comparison and the integration test changed my mind.</cjf:hasConversationText>
    <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">27</cjf:hasTurnNumber>
    <dc:identifier>27</dc:identifier>
    <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
    <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_1ce82228187659212b16"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/State_b4304706796d96d1f561">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Unassessed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_16">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
    <cjf:hasConversationText>I manage that budget, and the funds are still available. I’m comfortable moving them because we haven’t committed to purchasing the add-on.</cjf:hasConversationText>
    <cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#int">16</cjf:hasTurnNumber>
    <dc:identifier>16</dc:identifier>
    <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Conversation"/>
    <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Speaker_2948d155af88e5ec9810"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_a444baaea5f36f1ae3d6">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Yes. Platform A could simplify implementation because it already includes the repository management, issue tracking, and deployment tools we need.</cjf:hasConversationText>
