    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>I need to check whether the release team can attend Monday from five to six</cjf:hasConversationText>
