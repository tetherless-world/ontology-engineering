    <cjf:assignedAtUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_13"/>
    <cjf:hasReason>Generated initial assignment from move introduction</cjf:hasReason>
    <cjf:hasStateEvidence rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_c6779f15fd2acfcdfcac"/>
  </rdf:Description>
