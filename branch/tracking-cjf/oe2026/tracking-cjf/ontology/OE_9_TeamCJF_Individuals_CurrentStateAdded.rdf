  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_cca4051a80a6a1864e7b">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>The annual quote is $24,000, and we have $18,000 allocated. So there’s a $6,000 gap we would need to cover.</cjf:hasConversationText>
