  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_c6779f15fd2acfcdfcac">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>It does. I put together a fuller estimate this morning. The required licenses add $8,000, and training adds another $6,000. That puts Platform B at $26,000 for the first year, compared with $24,000 for Platform A.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_13"/>
  </rdf:Description>
