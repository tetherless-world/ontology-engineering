  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_acbd55774438f91e9eb8">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>We could use Monday’s five-to-six training slot for a vendor-led session, then give developers the recording and a practice environment.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_20"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/State_1260302aff67dac323a5">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_4c7a96f5fa699501c138">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>I’m not sure that training arrangement will work yet. I need to check whether the release team can attend Monday from five to six and whether the vendor is available then.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_21"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Span_045194dfece7d55a065b">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
    <cjf:hasConversationText>Would we have it ready in time, though? Platform B needs additional configuration, and we only have two weeks before development starts.</cjf:hasConversationText>
    <cjf:isPartOfUtterance rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_11"/>
  </rdf:Description>
