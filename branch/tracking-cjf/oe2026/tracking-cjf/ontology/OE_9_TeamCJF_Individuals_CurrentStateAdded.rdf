  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSample/Turn_20">
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
    <cjf:hasConversationText>We could use Monday’s five-to-six training slot for a vendor-led session, then give developers the recording and a practice environment.</cjf:hasConversationText>
