    <!-- http://semanticscience.org/resource/SIO_000001 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000001">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <dc:identifier>SIO_000001</dc:identifier>
        <dct:description xml:lang="en">A is related to B iff there is some relation between A and B.</dct:description>
        <resource:subset>core</resource:subset>
        <resource:subset>relations+</resource:subset>
        <rdfs:comment>&apos;is related to&apos; is the top level relation in SIO</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000028 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000028">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000028</dc:identifier>
        <dct:description xml:lang="en">has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:example xml:lang="en">a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000053 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000053">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000028"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000053</dc:identifier>
        <dct:description xml:lang="en">has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has proper part</rdfs:label>
        <skos:example xml:lang="en">a car has an engine as a proper part; a car has a piston as a proper part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000061 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000061">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000061</dc:identifier>
        <dct:description xml:lang="en">A is located in B iff the spatialtemporial region occupied by A is part of the spatialtemporal region occupied by B. [T][R]</dct:description>
        <resource:equivalentTo>OBO_REL:located_in</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <skos:example xml:lang="en">A parasite in the interior of a person&apos;s intestine is located in their intestinal lumen.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000068 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000068">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000061"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000068</dc:identifier>
        <dct:description xml:lang="en">is part of is a transitive, reflexive and anti-symmetric mereological relation between a whole and itself or a part and its whole.</dct:description>
        <resource:equivalentTo>OBO_REL:part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000093 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000093">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000093</dc:identifier>
        <dct:description xml:lang="en">is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole.</dct:description>
        <resource:equivalentTo>OBO_REL:proper_part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is proper part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000145 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000145">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000145</dc:identifier>
        <dct:description xml:lang="en">A is location of B iff the spatialtemporal region occupied by A has the spatialtemporal region occupied by B as a part. [T][R]</dct:description>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000206 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000206">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000772"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000208"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/TextSpan"/>
        <dc:identifier>SIO_000206</dc:identifier>
        <dct:description xml:lang="en">is supported by is a relation between a proposition and something that supports the truth of the assertion.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is supported by</rdfs:label>
        <skos:definition>directed grounding relationship linking a CJF conversation move to the Text Span that provides transcript evidence for the conversation move annotation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000208 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000208">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000773"/>
        <dc:identifier>SIO_000208</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is supporting evidence for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000212 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000212">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000628"/>
        <dc:identifier>SIO_000212</dc:identifier>
        <dct:description xml:lang="en">A is referred to by B iff B is an informational entity that makes reference to A.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is referred to by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000252 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000252">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000212"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <dc:identifier>SIO_000252</dc:identifier>
        <dct:description xml:lang="en">is reference for is a relation between a document that provides information about an entity.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is referenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000322 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000322">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc:identifier>SIO_000322</dc:identifier>
        <dct:description xml:lang="en">A is spatiotemporally related to B iff A is in the spatial or temporal vicinity of B</dct:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is spatiotemporally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000628 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000628">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:identifier>SIO_000628</dc:identifier>
        <dct:description xml:lang="en">refers to is a relation between one entity and the entity that it makes reference to.</dct:description>
        <resource:subset>core</resource:subset>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">refers to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000631 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000631">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000628"/>
        <dc:identifier>SIO_000631</dc:identifier>
        <dct:alternative>mentions</dct:alternative>
        <dct:description xml:lang="en">references is a relation between one entity and the entity that it makes reference to by name, but is not described by it.</dct:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">references</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000772 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000772">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000773"/>
        <dc:identifier>SIO_000772</dc:identifier>
        <dct:description xml:lang="en">has evidence is a relation between a proposition and something that demonstrates the truth of the assertion.</dct:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000773 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000773">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000252"/>
        <dc:identifier>SIO_000773</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is evidence for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_001403 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_001403">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:description xml:lang="en">x is associated with y when x and y are logically or statistically related to one another.</dc:description>
        <dc:identifier>SIO_001403</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/addresses -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/addresses">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Option"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Outcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAddresses"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAddresses"/>
        </owl:propertyChainAxiom>
        <rdfs:label>addresses</rdfs:label>
        <skos:definition>substantively engages with the concern represented by</skos:definition>
        <skos:prefLabel>addresses</skos:prefLabel>
        <skos:scopeNote>Directed: Claim, Option, or Outcome → Issue. Handles the Issue without necessarily settling it.</skos:scopeNote>
        <cmns-av:usageNote>Use resolves when an explicit Outcome settles the Issue</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/answers -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/answers">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/respondsTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/InformationRequest"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesAnswers"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtAnswers"/>
        </owl:propertyChainAxiom>
        <rdfs:label>answers</rdfs:label>
        <skos:definition>provides a response that fully satisfies the information need expressed by</skos:definition>
        <skos:prefLabel>answers</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedAtUtterance -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedAtUtterance">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <rdfs:label>assigned at utterance</rdfs:label>
        <skos:definition>records a conversation move’s state as becoming applicable at</skos:definition>
        <skos:prefLabel>assigned at utterance</skos:prefLabel>
        <cmns-av:usageNote>Identifies where the state becomes applicable in the conversation, rather than when an annotator entered the record. The turn number belongs to the linked Utterance.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/assignedState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/State"/>
        <rdfs:label>assigned state</rdfs:label>
        <skos:definition>records the conversation move’s condition at the specified point in the conversation as</skos:definition>
        <skos:prefLabel>assigned state</skos:prefLabel>
        <cmns-av:usageNote>Records the state for that assignment</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/challenges -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/challenges">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Claim"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Issue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesChallenges"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtChallenges"/>
        </owl:propertyChainAxiom>
        <rdfs:label>challenges</rdfs:label>
        <skos:definition>provides evidence or reasoning that weakens or rebuts the epistemic standing of</skos:definition>
        <skos:prefLabel>challenges</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasCurrentStateAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasCurrentStateAssignment">
        <rdfs:subPropertyOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasStateAssignment"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:label>has current state assignment</rdfs:label>
        <skos:definition>Links an entity to the state assignment that represents its current state.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPositionTowards -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPositionTowards">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ExpressedPosition"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/DeliberativeConversationMove"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/makesPositionTowards"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isAimedAtPositionTowards"/>
        </owl:propertyChainAxiom>
        <rdfs:label>has position towards</rdfs:label>
        <skos:definition>expresses the speaker’s attitude toward</skos:definition>
        <skos:prefLabel>has position towards</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasPreviousAssignment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/StateAssignment"/>
        <rdfs:label>has previous assignment</rdfs:label>
        <skos:definition>has as its immediately preceding state record for the same conversation move</skos:definition>
        <skos:prefLabel>has previous assignment</skos:prefLabel>
        <cmns-av:usageNote>Omit for the initial state assignment. The preceding assignment must concern the same conversation move (the current cardinality restriction does not enforce that condition.)</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeaker -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasSpeaker">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_001403"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMove"/>
                    <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CollectiveJudgmentFormationConversationMoveRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Speaker"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000206"/>
            <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/isPartOfUtterance"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo"/>
        </owl:propertyChainAxiom>
        <rdfs:label>has speaker</rdfs:label>
        <skos:definition>is expressed in a conversational contribution made by</skos:definition>
        <skos:prefLabel>has speaker</skos:prefLabel>
        <cmns-av:explanatoryNote>The relationship is inferred from the conversational contribution that expresses the conversation move.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/hasState">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/ConversationMoveWithState"/>
