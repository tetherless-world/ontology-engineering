<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY cmns-av "https://www.omg.org/spec/Commons/AnnotationVocabulary/">
	<!ENTITY cmns-dt "https://www.omg.org/spec/Commons/DatesAndTimes/">
	<!ENTITY dc "http://purl.org/dc/elements/1.1/">
	<!ENTITY dct "http://purl.org/dc/terms/">
	<!ENTITY ns "http://www.w3.org/2003/06/sw-vocab-status/ns#">
	<!ENTITY oe-cjf "https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY protege "http://protege.stanford.edu/plugins/owl/protege#">
	<!ENTITY prov "http://www.w3.org/ns/prov#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY resource "http://semanticscience.org/resource/">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
	xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
	xmlns:cmns-av="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
	xmlns:cmns-dt="https://www.omg.org/spec/Commons/DatesAndTimes/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:dct="http://purl.org/dc/terms/"
	xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
	xmlns:oe-cjf="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
	xmlns:prov="http://www.w3.org/ns/prov#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:resource="http://semanticscience.org/resource/"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/">
		<rdfs:label>Tracking collective judgment formation</rdfs:label>
		<dct:abstract>Represents conversation moves, their evidenced relationships, and recorded state assignments in collective judgment formation.</dct:abstract>
		<dct:creator>Devin De Silva</dct:creator>
		<dct:creator>Matthew Lausev</dct:creator>
		<dct:creator>Srihari Sridharan</dct:creator>
		<dct:creator>Tiziana Hernandez</dct:creator>
		<owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"/>
	</owl:Ontology>
	
	<owl:AnnotationProperty rdf:about="&dc;description">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&dc;identifier">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&dct;alternative">
	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="&resource;SIO_000000">
		<rdfs:label xml:lang="en">entity</rdfs:label>
		<dc:identifier>SIO_000000</dc:identifier>
		<dct:description xml:lang="en">Every thing is an entity.</dct:description>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000001">
		<rdf:type rdf:resource="&owl;SymmetricProperty"/>
		<rdfs:label xml:lang="en">is related to</rdfs:label>
		<rdfs:comment>&apos;is related to&apos; is the top level relation in SIO</rdfs:comment>
		<dc:identifier>SIO_000001</dc:identifier>
		<dct:description xml:lang="en">A is related to B iff there is some relation between A and B.</dct:description>
		<resource:subset>core</resource:subset>
		<resource:subset>relations+</resource:subset>
		<rdfs:domain rdf:resource="&resource;SIO_000000"/>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<rdfs:range rdf:resource="&resource;SIO_000000"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000028">
		<rdf:type rdf:resource="&owl;ReflexiveProperty"/>
		<rdf:type rdf:resource="&owl;TransitiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000145"/>
		<rdfs:label xml:lang="en">has part</rdfs:label>
		<dc:identifier>SIO_000028</dc:identifier>
		<dct:description xml:lang="en">has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.</dct:description>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000068"/>
		<skos:example xml:lang="en">a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;</skos:example>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000053">
		<rdf:type rdf:resource="&owl;AsymmetricProperty"/>
		<rdf:type rdf:resource="&owl;IrreflexiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000028"/>
		<rdfs:label xml:lang="en">has proper part</rdfs:label>
		<dc:identifier>SIO_000053</dc:identifier>
		<dct:description xml:lang="en">has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part.</dct:description>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000093"/>
		<skos:example xml:lang="en">a car has an engine as a proper part; a car has a piston as a proper part;</skos:example>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000061">
		<rdf:type rdf:resource="&owl;TransitiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000322"/>
		<rdfs:label xml:lang="en">is located in</rdfs:label>
		<dc:identifier>SIO_000061</dc:identifier>
		<dct:description xml:lang="en">A is located in B iff the spatialtemporial region occupied by A is part of the spatialtemporal region occupied by B. [T][R]</dct:description>
		<resource:equivalentTo>OBO_REL:located_in</resource:equivalentTo>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000145"/>
		<skos:example xml:lang="en">A parasite in the interior of a person&apos;s intestine is located in their intestinal lumen.</skos:example>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000068">
		<rdf:type rdf:resource="&owl;ReflexiveProperty"/>
		<rdf:type rdf:resource="&owl;TransitiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000061"/>
		<rdfs:label xml:lang="en">is part of</rdfs:label>
		<dc:identifier>SIO_000068</dc:identifier>
		<dct:description xml:lang="en">is part of is a transitive, reflexive and anti-symmetric mereological relation between a whole and itself or a part and its whole.</dct:description>
		<resource:equivalentTo>OBO_REL:part_of</resource:equivalentTo>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000093">
		<rdf:type rdf:resource="&owl;AsymmetricProperty"/>
		<rdf:type rdf:resource="&owl;IrreflexiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000068"/>
		<rdfs:label xml:lang="en">is proper part of</rdfs:label>
		<dc:identifier>SIO_000093</dc:identifier>
		<dct:description xml:lang="en">is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole.</dct:description>
		<resource:equivalentTo>OBO_REL:proper_part_of</resource:equivalentTo>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000145">
		<rdf:type rdf:resource="&owl;TransitiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000322"/>
		<rdfs:label xml:lang="en">is location of</rdfs:label>
		<dc:identifier>SIO_000145</dc:identifier>
		<dct:description xml:lang="en">A is location of B iff the spatialtemporal region occupied by A has the spatialtemporal region occupied by B as a part. [T][R]</dct:description>
		<resource:subset>nlp+</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000206">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000772"/>
		<rdfs:label xml:lang="en">is supported by</rdfs:label>
		<dc:identifier>SIO_000206</dc:identifier>
		<dct:description xml:lang="en">is supported by is a relation between a proposition and something that supports the truth of the assertion.</dct:description>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<rdfs:range rdf:resource="&oe-cjf;TextSpan"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000208"/>
		<skos:definition>directed grounding relationship linking a CJF conversation move to the Text Span that provides transcript evidence for the conversation move annotation</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000208">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000773"/>
		<rdfs:label xml:lang="en">is supporting evidence for</rdfs:label>
		<dc:identifier>SIO_000208</dc:identifier>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000212">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000001"/>
		<rdfs:label xml:lang="en">is referred to by</rdfs:label>
		<dc:identifier>SIO_000212</dc:identifier>
		<dct:description xml:lang="en">A is referred to by B iff B is an informational entity that makes reference to A.</dct:description>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000628"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000252">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000212"/>
		<rdfs:label xml:lang="en">is referenced by</rdfs:label>
		<dc:identifier>SIO_000252</dc:identifier>
		<dct:description xml:lang="en">is reference for is a relation between a document that provides information about an entity.</dct:description>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000631"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000322">
		<rdf:type rdf:resource="&owl;SymmetricProperty"/>
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000001"/>
		<rdfs:label xml:lang="en">is spatiotemporally related to</rdfs:label>
		<dc:identifier>SIO_000322</dc:identifier>
		<dct:description xml:lang="en">A is spatiotemporally related to B iff A is in the spatial or temporal vicinity of B</dct:description>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000628">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000001"/>
		<rdfs:label xml:lang="en">refers to</rdfs:label>
		<dc:identifier>SIO_000628</dc:identifier>
		<dct:description xml:lang="en">refers to is a relation between one entity and the entity that it makes reference to.</dct:description>
		<resource:subset>core</resource:subset>
		<resource:subset>nlp+</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000631">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000628"/>
		<rdfs:label xml:lang="en">references</rdfs:label>
		<dc:identifier>SIO_000631</dc:identifier>
		<dct:alternative>mentions</dct:alternative>
		<dct:description xml:lang="en">references is a relation between one entity and the entity that it makes reference to by name, but is not described by it.</dct:description>
		<resource:subset>core</resource:subset>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000772">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000631"/>
		<rdfs:label xml:lang="en">has evidence</rdfs:label>
		<dc:identifier>SIO_000772</dc:identifier>
		<dct:description xml:lang="en">has evidence is a relation between a proposition and something that demonstrates the truth of the assertion.</dct:description>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
		<owl:inverseOf rdf:resource="&resource;SIO_000773"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_000773">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000252"/>
		<rdfs:label xml:lang="en">is evidence for</rdfs:label>
		<dc:identifier>SIO_000773</dc:identifier>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&resource;SIO_001403">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000001"/>
		<rdfs:label xml:lang="en">is associated with</rdfs:label>
		<dc:description xml:lang="en">x is associated with y when x and y are logically or statistically related to one another.</dc:description>
		<dc:identifier>SIO_001403</dc:identifier>
		<rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
	</owl:ObjectProperty>
	
	<owl:AnnotationProperty rdf:about="&resource;equivalentTo">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&resource;subset">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&owl;maxQualifiedCardinality">
	</owl:AnnotationProperty>
	
	<owl:AnnotationProperty rdf:about="&owl;qualifiedCardinality">
	</owl:AnnotationProperty>
	
	<rdf:Description rdf:about="&prov;Activity">
		<owl:disjointWith rdf:resource="&prov;Agent"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="&prov;Agent">
		<owl:disjointWith rdf:resource="&prov;Entity"/>
	</rdf:Description>
	
	<owl:Class rdf:about="&oe-cjf;Address">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:label>address</rdfs:label>
		<skos:definition>CJF conversation move relationship in which the source Claim, Option, or Outcome engages with the concern expressed by the target Issue</skos:definition>
		<skos:prefLabel>address</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Addressed">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>addressed</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;State">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;assignedState"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;StateAssignment">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;StateAssignment">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
														<owl:someValuesFrom rdf:resource="&oe-cjf;Open"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
									<owl:Restriction>
										<owl:onProperty>
											<rdf:Description>
												<owl:inverseOf rdf:resource="&oe-cjf;hasStateAssignment"/>
											</rdf:Description>
										</owl:onProperty>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;Issue">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty>
															<rdf:Description>
																<owl:inverseOf rdf:resource="&oe-cjf;addresses"/>
															</rdf:Description>
														</owl:onProperty>
														<owl:someValuesFrom rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>state of an Issue for which a Claim or Option substantively engages with the entire concern, without necessarily settling it</skos:definition>
		<skos:prefLabel>addressed</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Agreement">
		<rdfs:subClassOf rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:label>agreement</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;isPositiveSupportedBy"/>
						<owl:someValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>value of an Expressed Position indicating that a participant directly shares or accepts a position</skos:definition>
		<skos:prefLabel>agreement</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Answer">
		<rdfs:subClassOf rdf:resource="&oe-cjf;Response"/>
		<rdfs:label>answer</rdfs:label>
		<skos:definition>response relationship in which the source move fully satisfies the information need expressed by the target Information Request</skos:definition>
		<skos:prefLabel>answer</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Answered">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>answered</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;State">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;assignedState"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;StateAssignment">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;StateAssignment">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
														<owl:someValuesFrom rdf:resource="&oe-cjf;Open"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
									<owl:Restriction>
										<owl:onProperty>
											<rdf:Description>
												<owl:inverseOf rdf:resource="&oe-cjf;hasStateAssignment"/>
											</rdf:Description>
										</owl:onProperty>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;InformationRequest">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty>
															<rdf:Description>
																<owl:inverseOf rdf:resource="&oe-cjf;answers"/>
															</rdf:Description>
														</owl:onProperty>
														<owl:someValuesFrom rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>state of an Information Request whose full information need is satisfied by one or more contributions</skos:definition>
		<skos:prefLabel>answered</skos:prefLabel>
		<skos:scopeNote>The transition axiom classifies a recorded successor state from an Open predecessor and an incoming answers relationship. It does not create named assignments, compare turns, verify predecessor ownership, or establish the current state. Those annotation checks are performed separately.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Challenge">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:label>challenge</rdfs:label>
		<skos:definition>CJF conversation move relationship in which the source Claim or Issue provides evidence or reasoning that weakens or rebuts the epistemic standing of the target deliberative conversation move</skos:definition>
		<skos:prefLabel>challenge</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Claim">
		<rdfs:subClassOf rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateAssignment"/>
				<owl:allValuesFrom>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
						<owl:allValuesFrom>
							<owl:Class>
								<owl:unionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;Contested">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Rejected">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Supported">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;SupportedContested">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Unassessed">
									</rdf:Description>
								</owl:unionOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasState"/>
				<owl:allValuesFrom>
					<owl:Class>
						<owl:unionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&oe-cjf;Contested">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Rejected">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Supported">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;SupportedContested">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Unassessed">
							</rdf:Description>
						</owl:unionOf>
					</owl:Class>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>claim</rdfs:label>
		<owl:disjointWith rdf:resource="&oe-cjf;Issue"/>
		<owl:disjointWith rdf:resource="&oe-cjf;Option"/>
		<skos:altLabel>Assertion</skos:altLabel>
		<skos:altLabel>Statement</skos:altLabel>
		<skos:definition>CJF conversation move that introduces an assertion, interpretation, assessment, explanation, or piece of evidence for the group to consider, accept, or challenge</skos:definition>
		<skos:prefLabel>claim</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMove">
		<rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&resource;SIO_000206"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasUtterance"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;Utterance"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>collective judgment formation conversation move</rdfs:label>
		<owl:disjointWith rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<skos:definition>persistent semantic object representing a consequential contribution to the evolving collective judgment, such as an information request, issue, option, claim, expressed position, or outcome</skos:definition>
		<skos:prefLabel>collective judgment formation conversation move</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship">
		<rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&resource;SIO_000206"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasUtterance"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;Utterance"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>collective judgment formation conversation move relationship</rdfs:label>
		<skos:definition>relationship between a source CJF conversation move and a target CJF conversation move, represented as an individual to which information about that relationship can be attached</skos:definition>
		<skos:prefLabel>collective judgment formation conversation move relationship</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Contested">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>contested</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;State">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;assignedState"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;StateAssignment">
									</rdf:Description>
									<owl:Class>
										<owl:unionOf rdf:parseType="Collection">
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;StateAssignment">
																	</rdf:Description>
																	<owl:Restriction>
																		<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
																		<owl:someValuesFrom rdf:resource="&oe-cjf;Contested"/>
																	</owl:Restriction>
																</owl:intersectionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasTriggeringRelationship"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:unionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;Challenge">
																	</rdf:Description>
																	<rdf:Description rdf:about="&oe-cjf;Support">
																	</rdf:Description>
																</owl:unionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;StateAssignment">
																	</rdf:Description>
																	<owl:Restriction>
																		<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
																		<owl:someValuesFrom>
																			<owl:Class>
																				<owl:unionOf rdf:parseType="Collection">
																					<rdf:Description rdf:about="&oe-cjf;Supported">
																					</rdf:Description>
																					<rdf:Description rdf:about="&oe-cjf;Unassessed">
																					</rdf:Description>
																				</owl:unionOf>
																			</owl:Class>
																		</owl:someValuesFrom>
																	</owl:Restriction>
																</owl:intersectionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasTriggeringRelationship"/>
														<owl:someValuesFrom rdf:resource="&oe-cjf;Challenge"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:unionOf>
									</owl:Class>
									<owl:Restriction>
										<owl:onProperty>
											<rdf:Description>
												<owl:inverseOf rdf:resource="&oe-cjf;hasStateAssignment"/>
											</rdf:Description>
										</owl:onProperty>
										<owl:someValuesFrom rdf:resource="&oe-cjf;Claim"/>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>state of a Claim subject to a challenge from an Issue or another Claim</skos:definition>
		<skos:scopeNote>Classifies a Claim state from an assignment triggered by Challenge with an Unassessed or Supported predecessor. Contested membership is also retained from a Contested predecessor when the assignment is triggered by Support or Challenge. Trigger targets and evidence timing are validated separately; later relationships on the Claim do not by themselves classify earlier state assignments.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;ConversationMoveWithState">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateAssignment"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;StateAssignment"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>conversation move with state</rdfs:label>
		<skos:definition>CJF conversation move for which the ontology records a time-dependent State supported by evidence from the conversation</skos:definition>
		<skos:prefLabel>conversation move with state</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;DeliberativeConversationMove">
		<rdfs:subClassOf rdf:resource="&oe-cjf;ConversationMoveWithState"/>
		<rdfs:label>deliberative conversation move</rdfs:label>
		<skos:definition>ConversationMoveWithState that introduces or develops the content of the group’s reasoning by stating a Claim, raising an Issue, or proposing an Option</skos:definition>
		<skos:prefLabel>deliberative conversation move</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Disagreement">
		<rdfs:subClassOf rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:label>disagreement</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;isNegativeSupportedBy"/>
						<owl:someValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>value of an Expressed Position indicating that a participant directly does not share a position</skos:definition>
		<skos:prefLabel>disagreement</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;ExpressedPosition">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasSpeaker"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;Speaker"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;isNegativeSupportedBy"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;isPositiveSupportedBy"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>expressed position</rdfs:label>
		<skos:definition>CJF conversation move that directly communicates a participant’s agreement or disagreement toward an identifiable Claim, Option, or Issue</skos:definition>
		<skos:prefLabel>expressed position</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;InformationRequest">
		<rdfs:subClassOf rdf:resource="&oe-cjf;ConversationMoveWithState"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateAssignment"/>
				<owl:allValuesFrom>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
						<owl:allValuesFrom>
							<owl:Class>
								<owl:unionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;Answered">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Open">
									</rdf:Description>
								</owl:unionOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasState"/>
				<owl:allValuesFrom>
					<owl:Class>
						<owl:unionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&oe-cjf;Answered">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Open">
							</rdf:Description>
						</owl:unionOf>
					</owl:Class>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>information request</rdfs:label>
		<skos:altLabel>info-request</skos:altLabel>
		<skos:altLabel>question</skos:altLabel>
		<skos:definition>CJF conversation move that creates an information need calling for another contribution to provide information, a claim, evidence, reasoning, an option, a position or reaction, or clarification</skos:definition>
		<skos:prefLabel>information request</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Issue">
		<rdfs:subClassOf rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateAssignment"/>
				<owl:allValuesFrom>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
						<owl:allValuesFrom>
							<owl:Class>
								<owl:unionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;Addressed">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Open">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Resolved">
									</rdf:Description>
								</owl:unionOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasState"/>
				<owl:allValuesFrom>
					<owl:Class>
						<owl:unionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&oe-cjf;Addressed">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Open">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Resolved">
							</rdf:Description>
						</owl:unionOf>
					</owl:Class>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>issue</rdfs:label>
		<owl:disjointWith rdf:resource="&oe-cjf;Option"/>
		<skos:altLabel>Challenge</skos:altLabel>
		<skos:definition>CJF conversation move that introduces a problem, concern, challenge, objection, correction, limitation, or lack of understanding for the group to address</skos:definition>
		<skos:prefLabel>issue</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;MultipartyConversation">
		<rdfs:subClassOf rdf:resource="&prov;Activity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasConversationIdentifier"/>
				<owl:allValuesFrom rdf:resource="&xsd;string"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;hadMember"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;Utterance"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>multiparty conversation</rdfs:label>
		<skos:altLabel>multi-speaker conversation</skos:altLabel>
		<skos:altLabel>multiparty conversation</skos:altLabel>
		<skos:definition>conversation among three or more identifiable participants, comprising ordered contributions that may respond to or build on contributions by different speakers</skos:definition>
		<skos:prefLabel>multiparty conversation</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Open">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>open</rdfs:label>
		<skos:definition>state of an Information Request or Issue when introduced, before evidence establishes another applicable state</skos:definition>
		<skos:prefLabel>open</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Option">
		<rdfs:subClassOf rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateAssignment"/>
				<owl:allValuesFrom>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
						<owl:allValuesFrom>
							<owl:Class>
								<owl:unionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;Rejected">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;Selected">
									</rdf:Description>
									<rdf:Description rdf:about="&oe-cjf;UnderConsideration">
									</rdf:Description>
								</owl:unionOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasState"/>
				<owl:allValuesFrom>
					<owl:Class>
						<owl:unionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&oe-cjf;Rejected">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;Selected">
							</rdf:Description>
							<rdf:Description rdf:about="&oe-cjf;UnderConsideration">
							</rdf:Description>
						</owl:unionOf>
					</owl:Class>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>option</rdfs:label>
		<skos:altLabel>Course of action</skos:altLabel>
		<skos:altLabel>Proposal</skos:altLabel>
		<skos:altLabel>Resolution proposal</skos:altLabel>
		<skos:altLabel>Solution</skos:altLabel>
		<skos:altLabel>Suggestion</skos:altLabel>
		<skos:definition>CJF conversation move that introduces a possible solution or course of action for the group to consider, compare, select, or reject</skos:definition>
		<skos:prefLabel>option</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Outcome">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<rdfs:label>outcome</rdfs:label>
		<skos:altLabel>decision</skos:altLabel>
		<skos:altLabel>resolution</skos:altLabel>
		<skos:definition>CJF conversation move that records an established group-level selection, rejection, resolution, deferral, or commitment reached through deliberation</skos:definition>
		<skos:prefLabel>outcome</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Position">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:label>position</rdfs:label>
		<skos:definition>CJF conversation move relationship in which the source Expressed Position communicates a participant’s attitude toward the target deliberative conversation move</skos:definition>
		<skos:prefLabel>position</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Rejected">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>rejected</rdfs:label>
		<skos:definition>state of an Option or Claim evidenced by a group-level decision to rule out the Option or disallow the Claim as a premise in collective reasoning</skos:definition>
		<skos:prefLabel>rejected</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Resolve">
		<rdfs:subClassOf rdf:resource="&oe-cjf;Address"/>
		<rdfs:label>resolve</rdfs:label>
		<skos:definition>address relationship in which the source Outcome explicitly settles the target Issue through collective confirmation of a recommended Option</skos:definition>
		<skos:prefLabel>resolve</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Resolved">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>resolved</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;State">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;assignedState"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;StateAssignment">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;StateAssignment">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
														<owl:someValuesFrom rdf:resource="&oe-cjf;Addressed"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
									<owl:Restriction>
										<owl:onProperty>
											<rdf:Description>
												<owl:inverseOf rdf:resource="&oe-cjf;hasStateAssignment"/>
											</rdf:Description>
										</owl:onProperty>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="&oe-cjf;Issue">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty>
															<rdf:Description>
																<owl:inverseOf rdf:resource="&oe-cjf;addresses"/>
															</rdf:Description>
														</owl:onProperty>
														<owl:someValuesFrom rdf:resource="&oe-cjf;SelectedOption"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>state of an Issue evidenced by a group Outcome that explicitly settles the concern it represents</skos:definition>
		<skos:prefLabel>resolved</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Response">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:label>response</rdfs:label>
		<skos:definition>A CJF conversation move relationship in which the source contribution addresses the information need expressed by the target request.</skos:definition>
		<skos:prefLabel>response</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Selected">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>selected</rdfs:label>
		<skos:definition>state of an Option evidenced by a group Outcome that explicitly chooses the Option</skos:definition>
		<skos:prefLabel>selected</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;SelectedOption">
		<rdfs:subClassOf rdf:resource="&oe-cjf;Option"/>
		<rdfs:label>selected option</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;Option">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;selects"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom rdf:resource="&oe-cjf;Outcome"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>An option selected by a specific outcome that expresses the group&apos;s judgment.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Speaker">
		<rdfs:subClassOf rdf:resource="&prov;Person"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasSpeakerName"/>
				<owl:allValuesFrom rdf:resource="&xsd;string"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>speaker</rdfs:label>
		<skos:definition>prov:Agent that participates in a multiparty conversation and is identified as the source of one or more Utterances</skos:definition>
		<skos:prefLabel>speaker</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;State">
		<rdfs:label>state</rdfs:label>
		<skos:definition>status assigned to a CJF conversation move at a specified point in a conversation based on evidence of how its information need, issue, option, or claim has been addressed or evaluated</skos:definition>
		<skos:prefLabel>state</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;StateAssignment">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasTriggeringRelationship"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
				<owl:onClass rdf:resource="&oe-cjf;StateAssignment"/>
				<owl:maxQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:maxQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
				<owl:onClass rdf:resource="&oe-cjf;State"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;assignedAtUtterance"/>
				<owl:onClass rdf:resource="&oe-cjf;Utterance"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasStateEvidence"/>
				<owl:someValuesFrom rdf:resource="&oe-cjf;TextSpan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>state assignment</rdfs:label>
		<skos:definition>record that associates a state-bearing collective judgment formation conversation move with one State at a specified Utterance and with the Text Span evidence supporting that state assignment</skos:definition>
		<skos:prefLabel>state assignment</skos:prefLabel>
		<cmns-av:usageNote>Preserve earlier assignment records when a conversation move changes state. Assignment records include both initial states and subsequent changes.</cmns-av:usageNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Support">
		<rdfs:subClassOf rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:label>support</rdfs:label>
		<skos:definition>CJF conversation move relationship in which the source Claim provides evidence or reasoning that strengthens the epistemic standing of the target deliberative conversation move</skos:definition>
		<skos:prefLabel>support</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Supported">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>supported</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;State">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty>
							<rdf:Description>
								<owl:inverseOf rdf:resource="&oe-cjf;assignedState"/>
							</rdf:Description>
						</owl:onProperty>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&oe-cjf;StateAssignment">
									</rdf:Description>
									<owl:Class>
										<owl:unionOf rdf:parseType="Collection">
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;StateAssignment">
																	</rdf:Description>
																	<owl:Restriction>
																		<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
																		<owl:someValuesFrom rdf:resource="&oe-cjf;Supported"/>
																	</owl:Restriction>
																</owl:intersectionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasTriggeringRelationship"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:unionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;Challenge">
																	</rdf:Description>
																	<rdf:Description rdf:about="&oe-cjf;Support">
																	</rdf:Description>
																</owl:unionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasPreviousAssignment"/>
														<owl:someValuesFrom>
															<owl:Class>
																<owl:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="&oe-cjf;StateAssignment">
																	</rdf:Description>
																	<owl:Restriction>
																		<owl:onProperty rdf:resource="&oe-cjf;assignedState"/>
																		<owl:someValuesFrom>
																			<owl:Class>
																				<owl:unionOf rdf:parseType="Collection">
																					<rdf:Description rdf:about="&oe-cjf;Contested">
																					</rdf:Description>
																					<rdf:Description rdf:about="&oe-cjf;Unassessed">
																					</rdf:Description>
																				</owl:unionOf>
																			</owl:Class>
																		</owl:someValuesFrom>
																	</owl:Restriction>
																</owl:intersectionOf>
															</owl:Class>
														</owl:someValuesFrom>
													</owl:Restriction>
													<owl:Restriction>
														<owl:onProperty rdf:resource="&oe-cjf;hasTriggeringRelationship"/>
														<owl:someValuesFrom rdf:resource="&oe-cjf;Support"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:unionOf>
									</owl:Class>
									<owl:Restriction>
										<owl:onProperty>
											<rdf:Description>
												<owl:inverseOf rdf:resource="&oe-cjf;hasStateAssignment"/>
											</rdf:Description>
										</owl:onProperty>
										<owl:someValuesFrom rdf:resource="&oe-cjf;Claim"/>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:definition>state of a Claim evidenced by support from another claim</skos:definition>
		<skos:prefLabel>supported</skos:prefLabel>
		<skos:scopeNote>Classifies a Claim state from an assignment triggered by Support with an Unassessed or Contested predecessor. Supported membership is also retained from a Supported predecessor when the assignment is triggered by Support or Challenge. Trigger targets and evidence timing are validated separately; later relationships on the Claim do not by themselves classify earlier state assignments.</skos:scopeNote>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;SupportedContested">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>supported contested</rdfs:label>
		<skos:definition>state of a Claim evidenced by support from another claim and subject to a challenge from an Issue or another Claim</skos:definition>
		<skos:prefLabel>supported contested</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;TextSpan">
		<rdfs:subClassOf rdf:resource="&prov;Entity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasConversationText"/>
				<owl:allValuesFrom rdf:resource="&xsd;string"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;isPartOfUtterance"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;Utterance"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>text span</rdfs:label>
		<skos:definition>contiguous segment of transcript text delimited by start and end positions and used as the specific target of an annotation</skos:definition>
		<skos:prefLabel>text span</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Unassessed">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>unassessed</rdfs:label>
		<skos:definition>state of a Claim introduced into the conversation without an identifiable group assessment of its standing in collective reasoning</skos:definition>
		<skos:prefLabel>unassessed</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;UnderConsideration">
		<rdfs:subClassOf rdf:resource="&oe-cjf;State"/>
		<rdfs:label>under consideration</rdfs:label>
		<skos:definition>state of a proposed Option without an established group selection, group rejection, or explicit deferral</skos:definition>
		<skos:prefLabel>under consideration</skos:prefLabel>
	</owl:Class>
	
	<owl:Class rdf:about="&oe-cjf;Utterance">
		<rdfs:subClassOf rdf:resource="&prov;Entity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasTurnNumber"/>
				<owl:allValuesFrom rdf:resource="&xsd;int"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&oe-cjf;hasConversationText"/>
				<owl:allValuesFrom rdf:resource="&xsd;string"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&prov;wasAttributedTo"/>
				<owl:allValuesFrom rdf:resource="&oe-cjf;Speaker"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-dt;hasTime"/>
				<owl:allValuesFrom rdf:resource="&cmns-dt;DateTime"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>utterance</rdfs:label>
		<skos:definition>speaker-attributed segment of a conversation bounded for annotation as one communicative contribution and capable of expressing one or more dialogue functions</skos:definition>
		<skos:prefLabel>utterance</skos:prefLabel>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;addresses">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>addresses</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;Claim">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Option">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Outcome">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Issue"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesAddresses">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtAddresses">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>substantively engages with the concern represented by</skos:definition>
		<skos:prefLabel>addresses</skos:prefLabel>
		<skos:scopeNote>Directed: Claim, Option, or Outcome → Issue. Handles the Issue without necessarily settling it.</skos:scopeNote>
		<cmns-av:usageNote>Use resolves when an explicit Outcome settles the Issue</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;answers">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;respondsTo"/>
		<rdfs:label>answers</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;DeliberativeConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;InformationRequest"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesAnswers">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtAnswers">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>provides a response that fully satisfies the information need expressed by</skos:definition>
		<skos:prefLabel>answers</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;assignedAtUtterance">
		<rdfs:label>assigned at utterance</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;StateAssignment"/>
		<rdfs:range rdf:resource="&oe-cjf;Utterance"/>
		<skos:definition>records a conversation move’s state as becoming applicable at</skos:definition>
		<skos:prefLabel>assigned at utterance</skos:prefLabel>
		<cmns-av:usageNote>Identifies where the state becomes applicable in the conversation, rather than when an annotator entered the record. The turn number belongs to the linked Utterance.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;assignedState">
		<rdfs:label>assigned state</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;StateAssignment"/>
		<rdfs:range rdf:resource="&oe-cjf;State"/>
		<skos:definition>records the conversation move’s condition at the specified point in the conversation as</skos:definition>
		<skos:prefLabel>assigned state</skos:prefLabel>
		<cmns-av:usageNote>Records the state for that assignment</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;challenges">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>challenges</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;Claim">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Issue">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesChallenges">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtChallenges">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>provides evidence or reasoning that weakens or rebuts the epistemic standing of</skos:definition>
		<skos:prefLabel>challenges</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-cjf;hasConversationIdentifier">
		<rdfs:subPropertyOf rdf:resource="&owl;topDataProperty"/>
		<rdfs:label>has conversation identifier</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;MultipartyConversation"/>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition>has as its unique conversation identifier</skos:definition>
		<skos:prefLabel>has conversation identifier</skos:prefLabel>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-cjf;hasConversationText">
		<rdfs:subPropertyOf rdf:resource="&prov;value"/>
		<rdfs:label>has conversation text</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;TextSpan">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Utterance">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition>has its conversation text recorded as</skos:definition>
		<skos:prefLabel>has conversation text</skos:prefLabel>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasCurrentStateAssignment">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;hasStateAssignment"/>
		<rdfs:label>has current state assignment</rdfs:label>
		<skos:definition>Links an entity to the state assignment that represents its current state.</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasPositionTowards">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>has position towards</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesPositionTowards">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtPositionTowards">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>expresses the speaker’s attitude toward</skos:definition>
		<skos:prefLabel>has position towards</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasPreviousAssignment">
		<rdfs:label>has previous assignment</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;StateAssignment"/>
		<rdfs:range rdf:resource="&oe-cjf;StateAssignment"/>
		<skos:definition>has as its immediately preceding state record for the same conversation move</skos:definition>
		<skos:prefLabel>has previous assignment</skos:prefLabel>
		<cmns-av:usageNote>Omit for the initial state assignment. The preceding assignment must concern the same conversation move (the current cardinality restriction does not enforce that condition.)</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasSpeaker">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_001403"/>
		<rdfs:label>has speaker</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Speaker"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&resource;SIO_000206">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isPartOfUtterance">
			</rdf:Description>
			<rdf:Description rdf:about="&prov;wasAttributedTo">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>is expressed in a conversational contribution made by</skos:definition>
		<skos:prefLabel>has speaker</skos:prefLabel>
		<cmns-av:explanatoryNote>The relationship is inferred from the conversational contribution that expresses the conversation move.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-cjf;hasSpeakerName">
		<rdfs:subPropertyOf rdf:resource="&owl;topDataProperty"/>
		<rdfs:label>has speaker name</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Speaker"/>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition>has as its speaker name</skos:definition>
		<skos:prefLabel>has speaker name</skos:prefLabel>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasState">
		<rdfs:label>has state</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ConversationMoveWithState"/>
		<rdfs:range rdf:resource="&oe-cjf;State"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;hasCurrentStateAssignment">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;assignedState">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>has its evidence-based standing at a specified point in the conversation characterized by</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasStateAssignment">
		<rdfs:label>has state assignment</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ConversationMoveWithState"/>
		<rdfs:range rdf:resource="&oe-cjf;StateAssignment"/>
		<skos:definition>has its state at a specified point in the conversation recorded through</skos:definition>
		<skos:prefLabel>has state assignment</skos:prefLabel>
		<cmns-av:usageNote>Links to all recorded state assignments, including the assignment corresponding to the current state.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasStateEvidence">
		<rdfs:label>has state evidence</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;StateAssignment"/>
		<rdfs:range rdf:resource="&oe-cjf;TextSpan"/>
		<skos:definition>has its assigned state justified by</skos:definition>
		<skos:prefLabel>has state evidence</skos:prefLabel>
		<cmns-av:usageNote>May link to multiple Text Spans, including evidence from earlier Utterances.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasTriggeringRelationship">
		<rdfs:label>has triggering relationship</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;StateAssignment"/>
		<rdfs:range rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<skos:definition>has its recorded state transition triggered by</skos:definition>
		<skos:prefLabel>has triggering relationship</skos:prefLabel>
		<cmns-av:usageNote>Links a relationship-based state assignment to the relationship individual that triggers that transition. The relationship must target the same conversation move and be established by evidence available at the assignment&apos;s effective utterance. Earlier contextual evidence alone does not establish the trigger. Initial assignments and evidence-based transitions need not have a triggering relationship; multiple relationships may jointly trigger one transition.</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&oe-cjf;hasTurnNumber">
		<rdfs:subPropertyOf rdf:resource="&prov;value"/>
		<rdfs:label>has turn number</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Utterance"/>
		<rdfs:range rdf:resource="&xsd;int"/>
		<skos:definition>has its position in the conversation identified by</skos:definition>
		<skos:prefLabel>has turn number</skos:prefLabel>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;hasUtterance">
		<rdfs:subPropertyOf rdf:resource="&owl;topObjectProperty"/>
		<rdfs:label>has utterance</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Utterance"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&resource;SIO_000206">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isPartOfUtterance">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>has supporting conversational evidence in</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAbout">
		<rdfs:label>is about</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;InformationRequest"/>
		<rdfs:range>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;DeliberativeConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:range>
		<skos:definition>concerns the content of</skos:definition>
		<skos:prefLabel>is about</skos:prefLabel>
		<cmns-av:explanatoryNote>The target identifies the conversation move that the InformationRequest concerns: a Claim, Option, Issue, or ExpressedPosition.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAt">
		<rdfs:subPropertyOf rdf:resource="&owl;topObjectProperty"/>
		<rdfs:label>is aimed at</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<rdfs:range rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<skos:definition>has as its target conversation move</skos:definition>
		<skos:prefLabel>is aimed at</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtAddresses">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAt"/>
		<rdfs:label>is aimed at addresses</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Address"/>
		<rdfs:range rdf:resource="&oe-cjf;Issue"/>
		<skos:definition>represents engagement with the concern expressed by</skos:definition>
		<skos:prefLabel>is aimed at addresses</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtAnswers">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAtRespondsTo"/>
		<rdfs:label>is aimed at answers</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Answer"/>
		<rdfs:range rdf:resource="&oe-cjf;InformationRequest"/>
		<skos:definition>represents a response that fully satisfies the information need expressed by</skos:definition>
		<skos:prefLabel>is aimed at answers</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtChallenges">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAt"/>
		<rdfs:label>is aimed at challenges</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Challenge"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<skos:definition>represents evidence or reasoning that weakens or rebuts the epistemic standing of</skos:definition>
		<skos:prefLabel>is aimed at challenges</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtPositionTowards">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAt"/>
		<rdfs:label>is aimed at position towards</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Position"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<skos:definition>represents an expression of a participant’s attitude toward</skos:definition>
		<skos:prefLabel>is aimed at position towards</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtResolves">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAtAddresses"/>
		<rdfs:label>is aimed at resolves</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Resolve"/>
		<rdfs:range rdf:resource="&oe-cjf;Issue"/>
		<skos:definition>represents collective confirmation of a recommended Option that settles</skos:definition>
		<skos:prefLabel>is aimed at resolves</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtRespondsTo">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAt"/>
		<rdfs:label>is aimed at responds to</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Response"/>
		<rdfs:range rdf:resource="&oe-cjf;InformationRequest"/>
		<skos:definition>represents a relevant response to</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAimedAtSupports">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;isAimedAt"/>
		<rdfs:label>is aimed at supports</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Support"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<skos:definition>represents evidence or reasoning that strengthens the epistemic standing of</skos:definition>
		<skos:prefLabel>is aimed at supports</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isAlternativeTo">
		<rdfs:label>is alternative to</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Option"/>
		<rdfs:range rdf:resource="&oe-cjf;Option"/>
		<skos:definition>is a competing course of action to</skos:definition>
		<skos:prefLabel>is alternative to</skos:prefLabel>
		<cmns-av:explanatoryNote>The relationship is symmetric: if one Option is an alternative to another, the reverse also holds.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isNegativeSupportedBy">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000206"/>
		<rdfs:label>is negative supported by</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:range rdf:resource="&oe-cjf;TextSpan"/>
		<owl:propertyDisjointWith rdf:resource="&oe-cjf;isPositiveSupportedBy"/>
		<skos:definition>has its interpretation as a negative-polarity position supported by the linguistic content of</skos:definition>
		<skos:prefLabel>is negative supported by</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isPartOfUtterance">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000093"/>
		<rdfs:label>is part of utterance</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;TextSpan"/>
		<rdfs:range rdf:resource="&oe-cjf;Utterance"/>
		<skos:definition>forms a textual part of</skos:definition>
		<skos:prefLabel>is part of utterance</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;isPositiveSupportedBy">
		<rdfs:subPropertyOf rdf:resource="&resource;SIO_000206"/>
		<rdfs:label>is positive supported by</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:range rdf:resource="&oe-cjf;TextSpan"/>
		<skos:definition>has its interpretation as a positive-polarity position supported by the linguistic content of</skos:definition>
		<skos:prefLabel>is positive supported by</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makes">
		<rdfs:subPropertyOf rdf:resource="&owl;topObjectProperty"/>
		<rdfs:label>makes</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMove"/>
		<rdfs:range rdf:resource="&oe-cjf;CollectiveJudgmentFormationConversationMoveRelationship"/>
		<skos:definition>serves as the source conversation move of</skos:definition>
		<skos:prefLabel>makes</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesAddresses">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makes"/>
		<rdfs:label>makes addresses</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;Claim">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Option">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Outcome">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Address"/>
		<skos:definition>serves as the source of engagement with an issue, as represented by</skos:definition>
		<skos:prefLabel>makes addresses</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesAnswers">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makesRespondsTo"/>
		<rdfs:label>makes answers</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;DeliberativeConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Answer"/>
		<skos:definition>serves as the source of a response that fully satisfies an information request, as represented by</skos:definition>
		<skos:prefLabel>makes answers</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesChallenges">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makes"/>
		<rdfs:label>makes challenges</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;Claim">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;Issue">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Challenge"/>
		<skos:definition>serves as the source of evidence or reasoning that weakens or rebuts another conversation move, as represented by</skos:definition>
		<skos:prefLabel>makes challenges</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesPositionTowards">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makes"/>
		<rdfs:label>makes position towards</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;ExpressedPosition"/>
		<rdfs:range rdf:resource="&oe-cjf;Position"/>
		<skos:definition>serves as the source of an expression of a participant’s attitude toward another conversation move, as represented by</skos:definition>
		<skos:prefLabel>makes position towards</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesResolves">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makesAddresses"/>
		<rdfs:label>makes resolves</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Outcome"/>
		<rdfs:range rdf:resource="&oe-cjf;Resolve"/>
		<skos:definition>serves as the source of collective confirmation of a recommended Option that settles an Issue, as represented by</skos:definition>
		<skos:prefLabel>makes resolves</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesRespondsTo">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makes"/>
		<rdfs:label>makes responds to</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;DeliberativeConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;Response"/>
		<skos:definition>serves as the source of a response to an information request, as represented by</skos:definition>
		<skos:prefLabel>makes responds to</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;makesSupports">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;makes"/>
		<rdfs:label>makes supports</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Claim"/>
		<rdfs:range rdf:resource="&oe-cjf;Support"/>
		<skos:definition>serves as the source of evidence or reasoning that strengthens another conversation move, as represented by</skos:definition>
		<skos:prefLabel>makes supports</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;refines">
		<rdfs:label>refines</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<skos:definition>extends, corrects, or reformulates the content of</skos:definition>
		<skos:prefLabel>refines</skos:prefLabel>
		<cmns-av:explanatoryNote>The source is a later Claim, Option, or Issue, and the target is an earlier conversation move of the same type.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;resolves">
		<rdfs:subPropertyOf rdf:resource="&oe-cjf;addresses"/>
		<rdfs:label>resolves</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Outcome"/>
		<rdfs:range rdf:resource="&oe-cjf;Issue"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesResolves">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtResolves">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>closes through collective confirmation of a recommended Option</skos:definition>
		<skos:prefLabel>resolves</skos:prefLabel>
		<skos:scopeNote>Directed: Outcome → Issue. Requires an explicit issue-settling conversational event. A more specific form of addresses.</skos:scopeNote>
		<cmns-av:explanatoryNote></cmns-av:explanatoryNote>
		<cmns-av:usageNote>An individual’s agreement or an unaccepted proposal does not by itself resolve a group Issue</cmns-av:usageNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;respondsTo">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>responds to</rdfs:label>
		<rdfs:domain>
			<owl:Class>
				<owl:unionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&oe-cjf;DeliberativeConversationMove">
					</rdf:Description>
					<rdf:Description rdf:about="&oe-cjf;ExpressedPosition">
					</rdf:Description>
				</owl:unionOf>
			</owl:Class>
		</rdfs:domain>
		<rdfs:range rdf:resource="&oe-cjf;InformationRequest"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesRespondsTo">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtRespondsTo">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>provides a relevant response to</skos:definition>
		<skos:prefLabel>responds to</skos:prefLabel>
		<cmns-av:explanatoryNote>The relationship does not establish whether the information need is satisfied.</cmns-av:explanatoryNote>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;selects">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>selects</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Outcome"/>
		<rdfs:range rdf:resource="&oe-cjf;Option"/>
		<skos:definition>records the recommendation and confirmation for joint acceptance of</skos:definition>
		<skos:prefLabel>selects</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&oe-cjf;supports">
		<rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#responseTo"/>
		<rdfs:label>supports</rdfs:label>
		<rdfs:domain rdf:resource="&oe-cjf;Claim"/>
		<rdfs:range rdf:resource="&oe-cjf;DeliberativeConversationMove"/>
		<owl:propertyChainAxiom rdf:parseType="Collection">
			<rdf:Description rdf:about="&oe-cjf;makesSupports">
			</rdf:Description>
			<rdf:Description rdf:about="&oe-cjf;isAimedAtSupports">
			</rdf:Description>
		</owl:propertyChainAxiom>
		<skos:definition>provides evidence or reasoning that strengthens the epistemic standing of</skos:definition>
		<skos:prefLabel>supports</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:Class rdf:about="https://w3id.org/deliberation/ontology#Contribution">
		<rdfs:label>Contribution</rdfs:label>
		<rdfs:comment>Any input provided by a participant in a deliberation.</rdfs:comment>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="https://w3id.org/deliberation/ontology#responseTo">
		<rdfs:label>response to</rdfs:label>
		<rdfs:comment>Relates a contribution to another contribution it responds to.</rdfs:comment>
		<rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
		<rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
	</owl:ObjectProperty>
	
	<owl:Class rdf:about="&cmns-dt;DateTime">
		<rdfs:subClassOf rdf:resource="&cmns-dt;TimeInstant"/>
		<rdfs:label>date time</rdfs:label>
		<skos:definition>time point including a date and a time, optionally including a time zone offset</skos:definition>
		<skos:note>&apos;has date time value&apos; is omitted if the &apos;date time&apos; is not (yet) known. The time zone is implicitly UTC.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&cmns-dt;TemporalEntity">
		<rdfs:label>temporal entity</rdfs:label>
		<rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
		<skos:definition>time interval or instant</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cmns-dt;TimeInstant">
		<rdfs:subClassOf rdf:resource="&cmns-dt;TemporalEntity"/>
		<rdfs:label>time instant</rdfs:label>
		<skos:definition>temporal entity that is a member of a time scale, with no extent or duration</skos:definition>
		<skos:example>The Battle of Hastings was on &apos;14 October 1066&apos;. (This gives the Julian date of the battle at a granularity of &apos;day&apos;. If desired, the battle could be given more precisely as a time period within that calendar day.)</skos:example>
		<skos:note>For scales that have a granularity specified in days, a date is a time point; for scales down to the seconds, the equivalent of an xsd:dateTime or xsd:dateTimeStamp is a time point.</skos:note>
		<skos:note>The duration of each time interval that is an instance of the time point is the granularity of the time scale of the time point.</skos:note>
		<cmns-av:adaptedFrom rdf:datatype="&xsd;anyURI">https://www.omg.org/spec/DTV/</cmns-av:adaptedFrom>
		<cmns-av:adaptedFrom rdf:datatype="&xsd;anyURI">https://www.w3.org/TR/owl-time/#time:Instant</cmns-av:adaptedFrom>
		<cmns-av:synonym>instant in time</cmns-av:synonym>
		<cmns-av:synonym>time point</cmns-av:synonym>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&cmns-dt;hasDateTime">
		<rdfs:subPropertyOf rdf:resource="&cmns-dt;hasTime"/>
		<rdfs:label>has date time</rdfs:label>
		<rdfs:range rdf:resource="&cmns-dt;DateTime"/>
		<skos:definition>identifies a specific date and time of day, possibly excluding the time zone</skos:definition>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&cmns-dt;hasTime">
		<rdfs:label>has time</rdfs:label>
		<rdfs:range rdf:resource="&cmns-dt;TemporalEntity"/>
		<rdfs:seeAlso rdf:resource="https://w3c.github.io/sdw/time/#time:hasTime"/>
		<skos:definition>specifies a general time that can be associated with any element</skos:definition>
		<skos:note>This property corresponds to the property of the same name in the W3C Time Ontology, and can be used to support mapping.</skos:note>
	</owl:ObjectProperty>

</rdf:RDF>