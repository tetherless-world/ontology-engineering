    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn15">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
