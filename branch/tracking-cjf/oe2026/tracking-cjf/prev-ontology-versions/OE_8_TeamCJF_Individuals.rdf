        <owl:imports rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/"/>
        <dct:abstract>Extends the team&apos;s annotated platform discussion with four selected-option agreement connections and one information-request answer transition, retaining the source individuals and evidence.</dct:abstract>
        <dct:creator>Devin De Silva</dct:creator>
        <dct:creator>Matthew Lausev</dct:creator>
        <dct:creator>Srihari Sridharan</dct:creator>
        <dct:creator>Tiziana Hernandez</dct:creator>
        <rdfs:label>CJF sample conversation CQs and answers</rdfs:label>
    </owl:Ontology>
    


