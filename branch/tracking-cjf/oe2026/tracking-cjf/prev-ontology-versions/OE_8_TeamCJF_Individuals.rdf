    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn12">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
        <prov:wasAttributedTo rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleSpeakerB"/>
        <prov:wasGeneratedBy rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleConversation"/>
        <tracking-cjf:hasConversationText>I’m not sure that cost comparison includes everything. Doesn’t Platform B require separate licenses for the deployment and identity extensions?</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</tracking-cjf:hasTurnNumber>
