        <tracking-cjf:hasConversationText>We need to choose a platform for the new development project today so we can start setting up the environment next week.</tracking-cjf:hasConversationText>
        <tracking-cjf:hasTurnNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tracking-cjf:hasTurnNumber>
    </owl:NamedIndividual>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn10 -->

    <owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/CQSampleTurn10">
        <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/Utterance"/>
