        <mxCell id="SGgpl_ivyMAPqSVHD-fn-24" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=19;spacing=11;" value="&lt;b&gt;Applicable states by milestone type&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;table-layout:fixed;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;width:23%;vertical-align:top;padding-right:15px;&quot;&gt;&lt;b&gt;InformationRequest&lt;/b&gt;&lt;br&gt;Open, Answered&lt;/td&gt;&lt;td style=&quot;width:23%;vertical-align:top;padding-right:15px;&quot;&gt;&lt;b&gt;Issue&lt;/b&gt;&lt;br&gt;Open, Addressed, Resolved&lt;/td&gt;&lt;td style=&quot;width:27%;vertical-align:top;padding-right:15px;&quot;&gt;&lt;b&gt;Option&lt;/b&gt;&lt;br&gt;Under Consideration,&lt;br&gt;Selected, Rejected&lt;/td&gt;&lt;td style=&quot;width:27%;vertical-align:top;&quot;&gt;&lt;b&gt;Claim&lt;/b&gt;&lt;br&gt;Unassessed, Accepted,&lt;br&gt;Contested, Rejected&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="150" width="1041" x="-120" y="250" as="geometry" />
        </mxCell>
        <mxCell id="nkH-O_3KEUESGwIoCjPI-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fontStyle=0;spacing=0;" value="&lt;div&gt;&lt;b&gt;Description:&lt;/b&gt;&amp;nbsp;States describe milestone standing at a recorded conversation point. Example: an Outcome that resolves an Issue supports a Resolved state at that point. Addressed alone does not imply Resolved; an individual position does not establish group selection or rejection. ExpressedPosition and Outcome have no states in this model. (&lt;b&gt;CQs 1, 2 and 4)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="1141" x="-120" y="410" as="geometry" />
        </mxCell>
