# CQ1: Conversation moves and their latest recorded state information.
# Query the CQ sample conversation and its ontology with inferred triples.
# hasState is inferred from hasCurrentStateAssignment / assignedState.

PREFIX cjf:  <https://tw.rpi.edu/ontology-engineering/oe2026/tracking-cjf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?move ?moveType ?stateType
WHERE {
    ?move a ?moveType .
    ?moveType rdfs:subClassOf* cjf:CollectiveJudgmentFormationConversationMove .

    OPTIONAL {
        ?move cjf:hasState ?state .
        ?state a ?stateType .
        ?stateType rdfs:subClassOf* cjf:State .
        FILTER (?stateType != cjf:State)
    }
}
