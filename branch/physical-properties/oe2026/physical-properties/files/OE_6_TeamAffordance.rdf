        <rdfs:label xml:lang="en">requirement mapping</rdfs:label>
        <skos:definition xml:lang="en">A mapping that relates a target feature condition to a required feature level for an action requirement.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RigidityFeature -->

