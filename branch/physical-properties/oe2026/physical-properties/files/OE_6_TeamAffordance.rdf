    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RotationalStructureRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RotationalStructureRequirement">
