        <rdfs:label xml:lang="en">multi part structure requirement</rdfs:label>
        <skos:definition xml:lang="en">A structural requirement concerning the use or arrangement of multiple parts needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Object -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Object">
