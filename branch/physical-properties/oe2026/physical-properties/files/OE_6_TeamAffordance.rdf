        <rdfs:label xml:lang="en">object</rdfs:label>
        <skos:definition xml:lang="en">A physical entity represented as a whole object that may serve as a candidate or target in an assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart">
