<?xml version="1.0"?>
<rdf:RDF xmlns="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"
     xml:base="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/affectsRequirement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/affectsRequirement">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">affects requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates a requirement mapping to the action requirement whose required level is determined by the mapping.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/concernsFeature -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/concernsFeature">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">concerns feature</rdfs:label>
        <skos:definition xml:lang="en">Relates an action requirement to the physical feature that the requirement concerns.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/conflictsWithRequirement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/conflictsWithRequirement">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">conflicts with requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to an action requirement that is not satisfied by the evaluated candidate configuration.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasAction -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasAction">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action"/>
        <rdfs:label xml:lang="en">has action</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to the action being evaluated.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasCandidate -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasCandidate">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
        <rdfs:label xml:lang="en">has candidate</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to the physical entity being evaluated as the candidate for performing the action.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureType -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureType">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">has feature type</rdfs:label>
        <skos:definition xml:lang="en">Relates a feature value to the physical feature type that it describes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureValue -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasFeatureValue">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue"/>
        <rdfs:label xml:lang="en">has feature value</rdfs:label>
        <skos:definition xml:lang="en">Relates a physical entity to a feature value that specifies one of its physical features and its level.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasJudgment -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasJudgment">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
        <rdfs:label xml:lang="en">has judgment</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to its feasibility judgment.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasLevel -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasLevel">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel"/>
        <rdfs:label xml:lang="en">has level</rdfs:label>
        <skos:definition xml:lang="en">Relates a feature value to its categorical feature level.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasPart">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:definition xml:lang="en">Relates a physical entity to an object part that constitutes part of that entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasRequirement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasRequirement">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">has requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates an action to an action requirement relevant to evaluating its physical feasibility.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasTarget -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hasTarget">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalEntity"/>
        <rdfs:label xml:lang="en">has target</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to the physical entity that serves as the target of the action.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/interactsWith -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/interactsWith">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
        <rdfs:label xml:lang="en">interacts with</rdfs:label>
        <skos:definition xml:lang="en">Relates an object part to another object part with which it physically interacts in a configuration.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/satisfiesRequirement -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/satisfiesRequirement">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">satisfies requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment to an action requirement that is satisfied by the evaluated candidate configuration.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/specifiesRequiredLevel -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/specifiesRequiredLevel">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel"/>
        <rdfs:label xml:lang="en">specifies required level</rdfs:label>
        <skos:definition xml:lang="en">Relates a requirement mapping to the feature level required for the affected action requirement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetFeatureType -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetFeatureType">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">uses target feature type</rdfs:label>
        <skos:definition xml:lang="en">Relates a requirement mapping to the physical feature type of the target used as a condition in the mapping.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetLevel -->

    <owl:ObjectProperty rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/usesTargetLevel">
        <rdfs:domain rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RequirementMapping"/>
        <rdfs:range rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel"/>
        <rdfs:label xml:lang="en">uses target level</rdfs:label>
        <skos:definition xml:lang="en">Relates a requirement mapping to the feature level of the target used as a condition in the mapping.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Action">
        <rdfs:label xml:lang="en">action</rdfs:label>
        <skos:definition xml:lang="en">A physical action whose feasibility is evaluated using represented physical features and action requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement">
        <rdfs:label xml:lang="en">action requirement</rdfs:label>
        <skos:definition xml:lang="en">A represented physical condition relevant to determining whether an action is feasible.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Assessment">
        <rdfs:label xml:lang="en">assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation context that relates a candidate physical entity, a target physical entity, and an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature"/>
        <rdfs:label xml:lang="en">contact area feature</rdfs:label>
        <skos:definition xml:lang="en">A geometric feature describing the area of a physical entity available for contact during an interaction.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ContactAreaRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
        <rdfs:label xml:lang="en">contact area requirement</rdfs:label>
        <skos:definition xml:lang="en">A geometric requirement concerning the contact area needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature"/>
        <rdfs:label xml:lang="en">edge geometry feature</rdfs:label>
        <skos:definition xml:lang="en">A geometric feature describing the shape or form of an edge relevant to physical interaction.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/EdgeGeometryRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement"/>
        <rdfs:label xml:lang="en">edge geometry requirement</rdfs:label>
        <skos:definition xml:lang="en">A geometric requirement concerning the edge geometry needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment">
        <rdfs:label xml:lang="en">feasibility judgment</rdfs:label>
        <skos:definition xml:lang="en">A judgment representing the outcome of evaluating whether a candidate can physically support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Feasible -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Feasible">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
        <rdfs:label xml:lang="en">feasible</rdfs:label>
        <skos:definition xml:lang="en">A feasibility judgment indicating that at least one evaluated configuration is supported by the represented information.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureLevel">
        <rdfs:label xml:lang="en">feature level</rdfs:label>
        <skos:definition xml:lang="en">A categorical level used to represent the degree of a physical feature, such as low, medium, or high.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeatureValue">
        <rdfs:label xml:lang="en">feature value</rdfs:label>
        <skos:definition xml:lang="en">A representation that associates a physical feature type with a categorical feature level for a physical entity.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature"/>
        <rdfs:label xml:lang="en">flexibility feature</rdfs:label>
        <skos:definition xml:lang="en">A mechanical feature describing the degree to which a physical entity can bend or deform without failure.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FlexibilityRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalRequirement"/>
        <rdfs:label xml:lang="en">flexibility requirement</rdfs:label>
        <skos:definition xml:lang="en">A mechanical requirement concerning the flexibility needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceFeature"/>
        <rdfs:label xml:lang="en">friction feature</rdfs:label>
        <skos:definition xml:lang="en">A surface feature describing resistance to sliding between contacting surfaces</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FrictionRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/SurfaceRequirement"/>
        <rdfs:label xml:lang="en">friction requirement</rdfs:label>
        <skos:definition xml:lang="en">A surface requirement concerning the friction needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">geometric feature</rdfs:label>
        <skos:definition xml:lang="en">A physical feature describing the geometry, dimensions, or spatial form of a physical entity.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/GeometricRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">geometric requirement</rdfs:label>
        <skos:definition xml:lang="en">An action requirement concerning geometric characteristics needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/HardnessFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/HardnessFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature"/>
        <rdfs:label xml:lang="en">hardness feature</rdfs:label>
        <skos:definition xml:lang="en">A mechanical feature describing resistance to localized deformation or indentation.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Infeasible -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Infeasible">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
        <rdfs:label xml:lang="en">infeasible</rdfs:label>
        <skos:definition xml:lang="en">A feasibility judgment indicating that all evaluated configurations are explicitly blocked by represented information.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/InsufficientInformation">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/FeasibilityJudgment"/>
        <rdfs:label xml:lang="en">insufficient information</rdfs:label>
        <skos:definition xml:lang="en">A feasibility judgment indicating that the represented information is insufficient to determine feasibility or infeasibility.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralFeature"/>
        <rdfs:label xml:lang="en">joint feature</rdfs:label>
        <skos:definition xml:lang="en">A structural feature describing a connection between parts of a physical entity.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/JointRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralRequirement"/>
        <rdfs:label xml:lang="en">joint requirement</rdfs:label>
        <skos:definition xml:lang="en">A structural requirement concerning a connection between parts needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">material feature</rdfs:label>
        <skos:definition xml:lang="en">A physical feature describing a material characteristic of a physical entity.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MaterialRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">material requirement</rdfs:label>
        <skos:definition xml:lang="en">An action requirement concerning a material characteristic needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/PhysicalFeature"/>
        <rdfs:label xml:lang="en">mechanical feature</rdfs:label>
        <skos:definition xml:lang="en">A physical feature describing the mechanical behavior of a physical entity under applied forces.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MechanicalRequirement">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ActionRequirement"/>
        <rdfs:label xml:lang="en">mechanical requirement</rdfs:label>
        <skos:definition xml:lang="en">An action requirement concerning mechanical behavior needed to support an action.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureFeature -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureFeature">
        <rdfs:subClassOf rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/StructuralFeature"/>
        <rdfs:label xml:lang="en">multi part structure feature</rdfs:label>
        <skos:definition xml:lang="en">A structural feature describing an arrangement in which multiple parts jointly participate in a physical configuration.</skos:definition>
    </owl:Class>
    


    <!-- https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureRequirement -->

    <owl:Class rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/MultiPartStructureRequirement">
