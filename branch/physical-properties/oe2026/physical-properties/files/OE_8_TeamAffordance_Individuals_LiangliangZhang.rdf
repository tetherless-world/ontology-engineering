  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/scissorsBlade1">
    <hasFeatureValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/scissorsBlade1EdgeThicknessValue"/>
    <hasFeatureValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/scissorsBlade1RigidityValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/ObjectPart"/>
    <owl:differentFrom rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/scissorsBlade2"/>
    <skos:definition xml:lang="en">object part of the scissors candidate representing one blade, with associated edge thickness and rigidity feature values and an interaction with the second blade</skos:definition>
    <interactsWith rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/scissorsBlade2"/>
    <rdfs:label xml:lang="en">scissors blade 1</rdfs:label>
  </rdf:Description>
