    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">requirement mapping that maps high target hardness to a high required rigidity level for the cut rigidity requirement</skos:definition>
    <usesTargetLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
    <specifiesRequiredLevel rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/high"/>
    <usesTargetFeatureType rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/hardness"/>
