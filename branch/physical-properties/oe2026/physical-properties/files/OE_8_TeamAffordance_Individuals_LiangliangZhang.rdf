    <hasFeatureValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/spongeRigidityValue"/>
    <skos:definition xml:lang="en">candidate object represented for CUT feasibility assessment, with associated edge thickness and rigidity feature values</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/Object"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/rigidity">
    <rdfs:label xml:lang="en">rigidity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/RigidityFeature"/>
    <skos:definition xml:lang="en">physical feature representing the degree to which a physical entity resists bending or deformation</skos:definition>
  </rdf:Description>
