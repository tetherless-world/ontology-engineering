	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/">
		<rdfs:label xml:lang="en">CUT competency-question test individuals</rdfs:label>
		<dcterms:abstract xml:lang="en">This ontology contains test individuals representing candidate tools, targets, physical features, and CUT assessments. These individuals support the validation of competency questions and property-grounded feasibility reasoning through SWRL and SPARQL.</dcterms:abstract>
		<dcterms:creator>Alex Clark</dcterms:creator>
		<dcterms:creator>Hyejin Park</dcterms:creator>
		<dcterms:creator>Liangliang Zhang</dcterms:creator>
		<dcterms:creator>Xiye Fan</dcterms:creator>
		<dcterms:modified rdf:datatype="&xs;date">2026-11-13</dcterms:modified>
		<dcterms:publisher xml:lang="en">Team Affordance</dcterms:publisher>
		<owl:imports rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/"/>
		<owl:priorVersion rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/versions/OE_10"/>
		<owl:versionIRI rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/versions/OE_11"/>
		<skos:changeNote>Assignment 11: Updated test individual namespaces and references, revised SWRL rules for feasibility judgments, and added metadata to support version management and provenance.
OE11 annotation review (2026-11-13): synchronized curated term definitions, dictionary/adapted-definition sources, bibliographic citations, and explanatory, scope, editorial, usage and example annotations; clarified Low/Medium/High FeatureLevel definitions.</skos:changeNote>
	</owl:Ontology>
	
	<owl:Ontology rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/versions/OE_10">
	</owl:Ontology>
	
