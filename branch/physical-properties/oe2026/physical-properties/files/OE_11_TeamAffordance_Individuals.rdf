	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/cardCandidate">
		<rdf:type rdf:resource="&af;WholeObject"/>
		<rdfs:label xml:lang="en">card candidate</rdfs:label>
		<dcterms:bibliographicCitation>Cambridge Dictionary, “Card.” https://dictionary.cambridge.org/dictionary/english/card</dcterms:bibliographicCitation>
		<dcterms:source>Cambridge Dictionary, “Card.” https://dictionary.cambridge.org/dictionary/english/card</dcterms:source>
		<skos:definition xml:lang="en">candidate object represented for CUT feasibility assessment, with associated edge thickness and rigidity feature values</skos:definition>
		<skos:editorialNote>Project-specific named individual introduced in the RDF/OWL ontology to instantiate controlled CUT competency-question test cases; not adopted from an external terminology source. This named ABox individual is locally constructed test data, not an externally documented instance. The R-column reference supports only the general lexical meaning of the indicated word; it does not substantiate the individual&apos;s particular physical feature assertions, ordinal levels, or expected reasoning result. Concept/term developed for the current ontology; internal artifact history is provenance, not an external literature source. Preferred label is locally assigned for this ontology; no claim of external publication as the label origin.</skos:editorialNote>
		<skos:prefLabel xml:lang="en">Card Candidate</skos:prefLabel>
		<skos:scopeNote xml:lang="en">Applies to the controlled CUT feasibility test cases represented in the current course ontology.</skos:scopeNote>
		<af:hasFeatureValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/cardEdgeThicknessValue"/>
		<af:hasFeatureValue rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/cardRigidityValue"/>
		<cmns-av:explanatoryNote xml:lang="en">Anonymous or named candidate labels are test identifiers; feasibility evidence comes from the stated physical features and assessment requirements.</cmns-av:explanatoryNote>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/cardCarrotCutAssessment">
		<rdf:type rdf:resource="&af;Assessment"/>
		<rdfs:label xml:lang="en">card carrot cut assessment</rdfs:label>
		<dcterms:bibliographicCitation>Cambridge Dictionary, “Assessment.” https://dictionary.cambridge.org/dictionary/english/assessment</dcterms:bibliographicCitation>
		<dcterms:source>Cambridge Dictionary, “Assessment.” https://dictionary.cambridge.org/dictionary/english/assessment</dcterms:source>
		<skos:definition xml:lang="en">assessment of whether the card candidate can perform the cut action on the carrot target</skos:definition>
		<skos:editorialNote>Project-specific named individual introduced in the RDF/OWL ontology to instantiate controlled CUT competency-question test cases; not adopted from an external terminology source. This named ABox individual is locally constructed test data, not an externally documented instance. The R-column reference supports only the general lexical meaning of the indicated word; it does not substantiate the individual&apos;s particular physical feature assertions, ordinal levels, or expected reasoning result. Concept/term developed for the current ontology; internal artifact history is provenance, not an external literature source. Preferred label is locally assigned for this ontology; no claim of external publication as the label origin.</skos:editorialNote>
		<skos:prefLabel xml:lang="en">Card Carrot Cut Assessment</skos:prefLabel>
		<skos:scopeNote xml:lang="en">Applies to the controlled CUT feasibility test cases represented in the current course ontology.</skos:scopeNote>
		<af:hasAction rdf:resource="&af;cut"/>
		<af:hasCandidate rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/cardCandidate"/>
		<af:hasTarget rdf:resource="https://tw.rpi.edu/ontology-engineering/oe2026/physical-properties/individuals/carrotTarget"/>
		<cmns-av:explanatoryNote xml:lang="en">This assessment evaluates a candidate using its represented properties, not the conventional function of its label.</cmns-av:explanatoryNote>
	</owl:NamedIndividual>
	
