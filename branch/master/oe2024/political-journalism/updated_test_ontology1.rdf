	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b059338b-38ab-4210-91de-70b0c808249d">
		<rdfs:label>article-b059338b-38ab-4210-91de-70b0c808249d</rdfs:label>
		<rdfs:comment>The Biden administration’s Education Department is moving to cut ties with an organization that was thrown a life raft under the Trump administration even though it was at the center of an enormous fraud scandal related to for-profit colleges.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b782e9c4-4c0a-4c6c-aa6e-ee0fb7623560"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-23"/>
