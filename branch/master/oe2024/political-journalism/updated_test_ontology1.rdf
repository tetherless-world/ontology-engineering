	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-880b0848-fd94-4a82-9119-d65346361686">
		<rdfs:label>article-880b0848-fd94-4a82-9119-d65346361686</rdfs:label>
		<rdfs:comment>No lawsuits appeared to have been filed, but call centers for abortion services turned into help lines crowded with crying women. Some began seeking services by crossing state lines.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-81f0af94-b9cf-4dcb-8ae5-91c423d251ff"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-843f7a86-cb21-42c6-b668-9e9388bb54e5"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ba1def2a-fecf-4911-9182-36727aa8deac"/>
