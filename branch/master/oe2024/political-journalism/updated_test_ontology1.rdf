		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-26"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8b09a79d-9499-4d3e-992c-35fd9245e770">
		<rdfs:label>article-8b09a79d-9499-4d3e-992c-35fd9245e770</rdfs:label>
		<rdfs:comment>A provision in the law seeking to drive down drug prices has become fodder for misleading claims.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-be4afe5b-5317-4441-a7de-57071d96016d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-19"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
