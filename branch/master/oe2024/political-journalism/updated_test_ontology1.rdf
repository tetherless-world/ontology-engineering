		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-17"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-94c0a75b-059e-47c6-a7f8-a4d6ee76a7c0">
		<rdfs:label>article-94c0a75b-059e-47c6-a7f8-a4d6ee76a7c0</rdfs:label>
		<rdfs:comment>The famed source of the Pentagon Papers, Daniel Ellsberg, has made another unauthorized disclosure — and wants to be prosecuted for it.</rdfs:comment>
