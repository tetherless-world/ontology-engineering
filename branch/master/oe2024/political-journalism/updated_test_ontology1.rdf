	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6d2f03db-c24f-4845-9bae-a1127ca6bcdc">
		<rdfs:label>article-6d2f03db-c24f-4845-9bae-a1127ca6bcdc</rdfs:label>
		<rdfs:comment>No matter who ends up winning, the industry failed to fully account for the missteps that led it to miscalculate Donald J. Trump’s support four years ago.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
