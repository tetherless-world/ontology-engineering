		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3cc0934-6e6a-4d42-a5c8-a91f40d7e077">
		<rdfs:label>article-c3cc0934-6e6a-4d42-a5c8-a91f40d7e077</rdfs:label>
		<rdfs:comment>Mr. Cameron, the first Black attorney general in Kentucky, who is investigating the killing of Breonna Taylor, mentioned her only in passing during his live speech at the Republican National Convention.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d3a2df06-dc48-4fab-a9d1-d1d12442e2e1"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-26"/>
