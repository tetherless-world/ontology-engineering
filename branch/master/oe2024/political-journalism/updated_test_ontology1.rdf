	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a0e1f38-650d-4520-be27-d00db773e401">
		<rdfs:label>article-1a0e1f38-650d-4520-be27-d00db773e401</rdfs:label>
		<rdfs:comment>It’s proven to make you happier.</rdfs:comment>
