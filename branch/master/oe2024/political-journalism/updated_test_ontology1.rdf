	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-436f87b5-e78f-4d76-8776-c4b51a1f1994">
		<rdfs:label>article-436f87b5-e78f-4d76-8776-c4b51a1f1994</rdfs:label>
		<rdfs:comment>After the city struggled to contain large crowds with its police force, Black leaders questioned the tactics.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-577a5c59-9b88-47a0-830e-44803db92a07"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ea9dbbc7-267d-46dd-9bad-620f876af0ba"/>
