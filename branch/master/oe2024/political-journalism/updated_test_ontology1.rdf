	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-83bc231d-2505-493f-a7bb-2e572ce9c128">
		<rdfs:label>article-83bc231d-2505-493f-a7bb-2e572ce9c128</rdfs:label>
