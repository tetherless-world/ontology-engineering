	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9fe2e9d1-4be4-4bc4-a0e5-aa6464a0fee1">
		<rdfs:label>article-9fe2e9d1-4be4-4bc4-a0e5-aa6464a0fee1</rdfs:label>
		<rdfs:comment>Tennessee has a plan for that.</rdfs:comment>
