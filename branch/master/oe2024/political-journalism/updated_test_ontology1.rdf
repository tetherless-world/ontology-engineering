	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a6ae3fd1-b0fb-463c-9c96-1ca0fb6200e0">
		<rdfs:label>article-a6ae3fd1-b0fb-463c-9c96-1ca0fb6200e0</rdfs:label>
		<rdfs:comment>The Fulton County district attorney expressed concern about the former president’s comments at a rally in Texas.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d7a0b17f-e0aa-44c5-a995-e81e028fa879"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-31"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
