		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4e506a5-b81d-4760-93db-95d5e5904f91">
		<rdfs:label>article-a4e506a5-b81d-4760-93db-95d5e5904f91</rdfs:label>
		<rdfs:comment>Legislators failed to advance a total ban on abortion, instead adding more restrictions to an existing law. The G.O.P. split over exceptions for rape and incest.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ec43dee5-5d05-4d6a-870a-4730e5495b8e"/>
