	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-afd49558-1888-4864-94a3-763aaf45a423">
		<rdfs:label>article-afd49558-1888-4864-94a3-763aaf45a423</rdfs:label>
		<rdfs:comment>Hospitals have been ordered to bypass the Centers for Disease Control and Prevention and send all patient information to a central database in Washington, raising questions about transparency.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-14"/>
