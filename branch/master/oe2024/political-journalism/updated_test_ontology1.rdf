	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-015c9452-65cc-41d6-a411-42481ad75e51">
		<rdfs:label>article-015c9452-65cc-41d6-a411-42481ad75e51</rdfs:label>
		<rdfs:comment>A normally ceremonial ritual in Congress exploded into chaos as protesters, egged on by President Trump, forced their way into the Capitol to stop the counting of electoral votes to confirm President-elect Joseph R. Biden Jr.’s victory.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-06"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-015f7932-b0be-4583-bce5-72ef9f941760">
