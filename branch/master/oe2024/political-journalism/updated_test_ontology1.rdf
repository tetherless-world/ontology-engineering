	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-39c0313e-fb0d-4e95-8902-64c1bf6f6c9d">
		<rdfs:label>article-39c0313e-fb0d-4e95-8902-64c1bf6f6c9d</rdfs:label>
