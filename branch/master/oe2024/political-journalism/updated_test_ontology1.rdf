		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0f24b627-afb2-45e7-ade6-6a8dbbe165e2">
		<rdfs:label>article-0f24b627-afb2-45e7-ade6-6a8dbbe165e2</rdfs:label>
		<rdfs:comment>More than a dozen others were taken to local hospitals.</rdfs:comment>
