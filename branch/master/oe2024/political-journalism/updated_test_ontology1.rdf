		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-77840ef9-e860-440e-b47c-8d9dfb5c80be">
		<rdfs:label>article-77840ef9-e860-440e-b47c-8d9dfb5c80be</rdfs:label>
		<rdfs:comment>The state legislature was the first to step into a post-Roe world, clearing the path for full bans in other conservative states.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d7a0b17f-e0aa-44c5-a995-e81e028fa879"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ec43dee5-5d05-4d6a-870a-4730e5495b8e"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-07"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-778afb15-2c41-4dc6-8ec2-40eb44b8109d">
		<rdfs:label>article-778afb15-2c41-4dc6-8ec2-40eb44b8109d</rdfs:label>
		<rdfs:comment>The Trump administration suspended mandated standardized testing and offered loan relief to student borrowers, as the coronavirus shut down education.</rdfs:comment>
