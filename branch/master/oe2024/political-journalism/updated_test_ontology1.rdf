		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-09-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-880b0c88-4fdc-4608-8377-026ec50e56e0">
		<rdfs:label>article-880b0c88-4fdc-4608-8377-026ec50e56e0</rdfs:label>
		<rdfs:comment>Two of them made threatening comments toward lawmakers, and one expressed support for President Trump. The others were removed for a wide variety of reasons.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-46b2f3e2-fc43-4d1f-8134-a17365f8ec33"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5a3094b1-6bc7-47d7-8f53-c56fd8ed0c59"/>
