		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2c59a955-f444-43cb-8ba7-b321fa4835fc">
		<rdfs:label>article-2c59a955-f444-43cb-8ba7-b321fa4835fc</rdfs:label>
		<rdfs:comment>Without continued humanitarian assistance, the U.N. warned, crisis areas will be unable to contain the coronavirus, potentially killing millions of people.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f4f38f08-6492-4112-8b82-52bd8aa6b34f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
