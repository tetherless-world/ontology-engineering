	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03dc9cd2-5ca8-4784-a034-8b7d6060db6a">
		<rdfs:label>article-03dc9cd2-5ca8-4784-a034-8b7d6060db6a</rdfs:label>
		<rdfs:comment>Murdered cattle. Family feuds. People arrested when showing up for jury duty. In America’s least populated county, a bare-knuckle struggle for control may hold implications for Texas voters.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-843f7a86-cb21-42c6-b668-9e9388bb54e5"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-02"/>
