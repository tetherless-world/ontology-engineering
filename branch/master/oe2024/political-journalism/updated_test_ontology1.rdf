	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9c916431-ce8d-4956-b7fd-c1c0c3d630fc">
		<rdfs:label>article-9c916431-ce8d-4956-b7fd-c1c0c3d630fc</rdfs:label>
		<rdfs:comment>With hundreds of cases and more than two dozen deaths from the virus in the U.S., officials are trying to limit its spread.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-cb5937f2-3b25-42f4-b9a4-e12264df550c"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d0804387-7ba1-4df8-b8ae-a8a9c6bfc424"/>
