		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9f56591b-58a8-48fb-9a1e-f95b23a71349">
		<rdfs:label>article-9f56591b-58a8-48fb-9a1e-f95b23a71349</rdfs:label>
		<rdfs:comment>Rejecting the deployment of camouflaged federal agents, big-city mayors said the Trump administration should use its resources to help tackle problems like gun violence.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-17d88f11-8c44-408d-8ac2-945b979b26ce"/>
