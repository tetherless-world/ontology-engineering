		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-38ce2d5d-5c6a-4afe-9419-faa9704a99fe">
		<rdfs:label>article-38ce2d5d-5c6a-4afe-9419-faa9704a99fe</rdfs:label>
		<rdfs:comment>Advocates said the ruling, in the case of a Qaeda courier, was a watershed in dealing with the treatment of the men who were held and interrogated by the C.I.A. after the Sept. 11 attacks.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4bd6cfaa-ebec-415a-8c53-2870f770bfa7"/>
