	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7217af21-4d79-4193-b47d-2e7fbbceae51">
		<rdfs:label>article-7217af21-4d79-4193-b47d-2e7fbbceae51</rdfs:label>
		<rdfs:comment>Mr. Francisco has represented the Trump administration before the Supreme Court, including in controversial cases like the travel ban against predominantly Muslim countries.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd522e1c-57a0-49bc-9835-fae39d9d58a6"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-11"/>
