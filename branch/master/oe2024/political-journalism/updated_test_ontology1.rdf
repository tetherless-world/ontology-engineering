	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1cf3f1da-90f7-4d54-9c2d-2df2756edbad">
		<rdfs:label>article-1cf3f1da-90f7-4d54-9c2d-2df2756edbad</rdfs:label>
		<rdfs:comment>About half the states are expected to ban or further restrict access to abortion.</rdfs:comment>
