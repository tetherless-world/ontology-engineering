	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7a6347cf-4f12-447f-aaeb-5dc6a9862f4c">
		<rdfs:label>article-7a6347cf-4f12-447f-aaeb-5dc6a9862f4c</rdfs:label>
		<rdfs:comment>Juan David Ortiz, an intelligence officer in Texas, told the police that he had wanted to “clean up the streets,” prosecutors said. He has said the confession was coerced.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ba1def2a-fecf-4911-9182-36727aa8deac"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-12-02"/>
