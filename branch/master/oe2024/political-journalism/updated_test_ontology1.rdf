	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2a8f6566-1aee-4ffe-aed0-b95983c280cd">
		<rdfs:label>article-2a8f6566-1aee-4ffe-aed0-b95983c280cd</rdfs:label>
		<rdfs:comment>Ezra Blount, who had been in a coma, became the 10th, and youngest, person to die from injuries sustained there.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-078e57d0-5b20-48e9-b039-c2569b2acb05"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-15"/>
