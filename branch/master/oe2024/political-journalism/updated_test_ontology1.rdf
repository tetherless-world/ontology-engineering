	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e7d3e87f-bccc-4bb1-bd3b-e21d0999e79a">
		<rdfs:label>article-e7d3e87f-bccc-4bb1-bd3b-e21d0999e79a</rdfs:label>
		<rdfs:comment>A battle involving Michael Pack and a U.S.-funded tech group revolves around software from Falun Gong, the secretive, anti-Beijing spiritual movement with pro-Trump elements.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-83d40723-6a13-432d-8617-d546a58e6733"/>
