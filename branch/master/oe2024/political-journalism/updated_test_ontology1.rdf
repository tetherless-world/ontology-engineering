		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a5e12a5c-9fb7-4a5e-aec3-4bc87570b3a6">
		<rdfs:label>article-a5e12a5c-9fb7-4a5e-aec3-4bc87570b3a6</rdfs:label>
		<rdfs:comment>The former aide to President Donald J. Trump had refused to comply with a demand from the House committee investigating the Jan. 6 Capitol riot.</rdfs:comment>
