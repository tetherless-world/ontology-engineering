		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dffcdb2d-e3e6-45aa-8a02-0d4fe29c7569">
		<rdfs:label>article-dffcdb2d-e3e6-45aa-8a02-0d4fe29c7569</rdfs:label>
		<rdfs:comment>The chairman of a powerful House subcommittee said he is seeking answers from Exxon and other oil and gas giants over their role in spreading disinformation on climate change.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b1afb246-66b2-4eea-8ebc-1b5c7f6c7900"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c4d98394-1549-4853-be0d-e7afcd8ee238"/>
