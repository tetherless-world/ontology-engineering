		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0043e745-228a-40ca-b30c-d249c85d5858">
		<rdfs:label>article-0043e745-228a-40ca-b30c-d249c85d5858</rdfs:label>
		<rdfs:comment>Representative James E. Clyburn, Democrat of South Carolina, supports a little-known federal judge in his home state: J. Michelle Childs.</rdfs:comment>
