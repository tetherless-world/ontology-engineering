	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b1f927e1-8973-4b8c-8804-4f7894214e1a">
		<rdfs:label>article-b1f927e1-8973-4b8c-8804-4f7894214e1a</rdfs:label>
