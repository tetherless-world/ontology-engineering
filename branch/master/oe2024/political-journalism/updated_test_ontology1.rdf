	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8fd19148-570f-4035-9649-5f386a90a5e7">
		<rdfs:label>article-8fd19148-570f-4035-9649-5f386a90a5e7</rdfs:label>
		<rdfs:comment>At City Council meetings and at a protest on Sunday, the relatives of the slain children and teachers have shown their anger and frustration.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ba1def2a-fecf-4911-9182-36727aa8deac"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-11"/>
