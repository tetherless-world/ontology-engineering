		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e98a4d67-141e-44d1-b899-8ba6819ad23c">
		<rdfs:label>article-e98a4d67-141e-44d1-b899-8ba6819ad23c</rdfs:label>
		<rdfs:comment>In the city where the “defund the police” movement took off, voters will decide next week whether to replace their Police Department with a new public safety agency.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9a5389b6-c0ea-4275-8951-1523cfe86f87"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-de093669-b27a-4345-ac65-683caba65a27"/>
