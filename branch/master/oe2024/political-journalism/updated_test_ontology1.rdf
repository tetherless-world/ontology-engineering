		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-06-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-da80ba4b-657a-4a84-94b8-4caa567fbcbd">
		<rdfs:label>article-da80ba4b-657a-4a84-94b8-4caa567fbcbd</rdfs:label>
		<rdfs:comment>An analysis of body camera footage shows that one officer appeared to keep his knee on the upper right side of Mr. Gonzalez’s back for 2 minutes 50 seconds.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-733fab1a-acc8-4055-95e5-48ef400e8c8a"/>
