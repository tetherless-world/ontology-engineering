		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f023bfe2-6abe-4347-8a61-c5294b305bc9">
		<rdfs:label>article-f023bfe2-6abe-4347-8a61-c5294b305bc9</rdfs:label>
		<rdfs:comment>The Fox News decision left the president fuming, and his team complaining. Then he began casting aspersions on other states’ vote counts.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
