	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-70e73538-5023-40cf-9b77-e1241446fcbd">
		<rdfs:label>article-70e73538-5023-40cf-9b77-e1241446fcbd</rdfs:label>
		<rdfs:comment>Across Northern California, huge plumes of smoke from a fire that blasted through the foothills of the Sierra Nevada billowed high into the atmosphere, turning day into an eerie twilight.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
