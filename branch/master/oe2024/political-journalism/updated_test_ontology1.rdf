	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4c71473-9c89-44e6-a2bd-db9e906df85f">
		<rdfs:label>article-a4c71473-9c89-44e6-a2bd-db9e906df85f</rdfs:label>
		<rdfs:comment>A suspect is accused of opening fire at an L.G.B.T.Q. nightclub, killing at least five people and injuring another 18 people.</rdfs:comment>
