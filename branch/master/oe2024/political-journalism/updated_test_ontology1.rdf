	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0d427c85-644b-4d67-826f-331dcdb50929">
		<rdfs:label>article-0d427c85-644b-4d67-826f-331dcdb50929</rdfs:label>
