		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-24"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9f942627-019c-42b7-9ceb-71b5d9638c50">
		<rdfs:label>article-9f942627-019c-42b7-9ceb-71b5d9638c50</rdfs:label>
		<rdfs:comment>More than 1,100 former prosecutors and officials who served in Republican and Democratic administrations signed an open letter condemning the president and the attorney general over the Stone case.</rdfs:comment>
