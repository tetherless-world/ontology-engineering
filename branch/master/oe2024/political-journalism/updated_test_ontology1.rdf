	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4efb6970-b1a2-47fc-9c55-a3d8b1b9883a">
		<rdfs:label>article-4efb6970-b1a2-47fc-9c55-a3d8b1b9883a</rdfs:label>
		<rdfs:comment>The president’s aides say they have found ways to replace lead pipes, wire homes for broadband and build charging hubs for electric cars, for less money than initially proposed.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
