		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7b4e721c-0807-4d9b-94c2-862e6547057b">
		<rdfs:label>article-7b4e721c-0807-4d9b-94c2-862e6547057b</rdfs:label>
		<rdfs:comment>President Trump’s decision to cancel the Jacksonville convention underscores how the coronavirus has upended the presidential race. This afternoon, he signed several executive orders addressing the high price of drugs in the United States.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-24"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
