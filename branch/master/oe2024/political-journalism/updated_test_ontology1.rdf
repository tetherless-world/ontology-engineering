	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b1e4826f-7627-492b-b0e4-dcc11a145d4d">
		<rdfs:label>article-b1e4826f-7627-492b-b0e4-dcc11a145d4d</rdfs:label>
		<rdfs:comment>Donald Trump and the Republican Party returned $12.8 million to donors in the first half of the year, a sign that their aggressive fund-raising tactics ensnared many unwitting contributors.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-07"/>
