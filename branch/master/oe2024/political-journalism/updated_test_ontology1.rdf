	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3345fb2e-1716-4b0d-bbb8-4a17664a5255">
		<rdfs:label>article-3345fb2e-1716-4b0d-bbb8-4a17664a5255</rdfs:label>
		<rdfs:comment>There are limits to what economic sanctions are likely to achieve.</rdfs:comment>
