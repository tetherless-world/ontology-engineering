		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1e134e36-08e4-4102-8b5a-d1a983e806b8">
		<rdfs:label>article-1e134e36-08e4-4102-8b5a-d1a983e806b8</rdfs:label>
		<rdfs:comment>After long delays, the nation’s first big offshore project has won approval</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-12"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
