	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5e2ae044-cd9d-4d06-b539-f535dce6e25d">
		<rdfs:label>article-5e2ae044-cd9d-4d06-b539-f535dce6e25d</rdfs:label>
		<rdfs:comment>Edgar Sandoval knew he was well prepared to report on the spread of the coronavirus on the Texas-Mexico border. He was going home. Little did he know exactly what he would find.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ba1def2a-fecf-4911-9182-36727aa8deac"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-14"/>
