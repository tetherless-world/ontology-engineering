	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-39bd9781-0b7a-4633-b3ec-9d45e2cea80a">
		<rdfs:label>article-39bd9781-0b7a-4633-b3ec-9d45e2cea80a</rdfs:label>
		<rdfs:comment>A growing number of Republicans have acknowledged that President Trump’s phone call with Ukraine wasn’t perfect. But they argue that it doesn’t merit his removal.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-02-02"/>
