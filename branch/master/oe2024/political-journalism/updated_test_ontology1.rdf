		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8ef262c4-2ad2-43db-a845-393243040307">
		<rdfs:label>article-8ef262c4-2ad2-43db-a845-393243040307</rdfs:label>
		<rdfs:comment>A host of countries, including the United States, has told their citizens to leave Ukraine immediately.</rdfs:comment>
