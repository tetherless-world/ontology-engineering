	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2cae5051-1c34-4ae0-9423-ed16069152ec">
		<rdfs:label>article-2cae5051-1c34-4ae0-9423-ed16069152ec</rdfs:label>
		<rdfs:comment>Taken together, the provisions in the social policy bill represent the biggest step toward universal coverage since the passage of the Affordable Care Act.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-025a9bc6-15b8-40f2-8470-85a30f6b6e94"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-576a9017-d1c0-4a28-b730-97415c0f4ae4"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c0f96d-1b8c-4214-8727-29573022489d"/>
