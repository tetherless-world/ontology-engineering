		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0d4eaac5-f865-46bd-9e6d-41829bce6303">
		<rdfs:label>article-0d4eaac5-f865-46bd-9e6d-41829bce6303</rdfs:label>
		<rdfs:comment>The findings of Florida’s 18-month inquiry into allegations of ballot fraud in 2018 received little attention when they were released this year. But they proved the president wrong.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-30"/>
