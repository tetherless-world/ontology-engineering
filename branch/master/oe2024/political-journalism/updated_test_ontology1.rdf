		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6dbc2c50-9091-429a-8d48-155758984274">
		<rdfs:label>article-6dbc2c50-9091-429a-8d48-155758984274</rdfs:label>
		<rdfs:comment>The Biden administration is applying lessons learned from controls on Russia during the Ukraine war to try to limit China’s military and technological advances.</rdfs:comment>
