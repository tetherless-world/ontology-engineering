	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d98496e6-bc7e-4562-8296-bf2ed0dc91ee">
		<rdfs:label>article-d98496e6-bc7e-4562-8296-bf2ed0dc91ee</rdfs:label>
		<rdfs:comment>Several governors have moved to ease mask requirements since Jan. 1. Here’s how policies are changing.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-09"/>
