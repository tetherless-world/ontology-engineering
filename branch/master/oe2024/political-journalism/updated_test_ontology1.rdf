	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ba0bd6e8-40eb-40c6-81ff-ad41a765c392">
		<rdfs:label>article-ba0bd6e8-40eb-40c6-81ff-ad41a765c392</rdfs:label>
		<rdfs:comment>Prosecutors recommended six years in the scheme that undermined college admissions. Mr. Singer asked for a maximum of six months, citing childhood trauma.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-21d856ad-a6ae-406e-a9e4-9707218ad815"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-12-30"/>
