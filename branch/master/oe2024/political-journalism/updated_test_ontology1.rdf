	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4d163b07-d4a3-4a57-bd50-bea83619c081">
		<rdfs:label>article-4d163b07-d4a3-4a57-bd50-bea83619c081</rdfs:label>
		<rdfs:comment>Their daughter’s online venture plunged a Florida family into a nightmare, but they decided not to pull the plug.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5f60b7f2-92f5-4980-9c8e-e8bf01cdb98f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-17"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4d18a08c-6a58-4e84-a9d8-d28eab250a76">
		<rdfs:label>article-4d18a08c-6a58-4e84-a9d8-d28eab250a76</rdfs:label>
		<rdfs:comment>Disappointed young progressives and Bernie Sanders supporters should consider the alternative.</rdfs:comment>
