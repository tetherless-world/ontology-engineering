		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b45a301f-92e2-417d-aeb7-893367b9de31">
		<rdfs:label>article-b45a301f-92e2-417d-aeb7-893367b9de31</rdfs:label>
		<rdfs:comment>A State Department spokesman said Secretary of State Antony J. Blinken had not seen President Biden in several days.</rdfs:comment>
