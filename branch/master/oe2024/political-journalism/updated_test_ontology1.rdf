		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-15"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a5e1eefe-4ae9-4b1a-bb61-b61413727f0f">
		<rdfs:label>article-a5e1eefe-4ae9-4b1a-bb61-b61413727f0f</rdfs:label>
		<rdfs:comment>Prosecutors say its release would compromise the investigation into Donald J. Trump’s handling of secret documents after he left office. Now a judge must decide.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
