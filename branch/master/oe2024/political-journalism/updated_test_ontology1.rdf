		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d7b5f71-5b79-4f51-b902-41fbb477604a">
		<rdfs:label>article-1d7b5f71-5b79-4f51-b902-41fbb477604a</rdfs:label>
		<rdfs:comment>The forests were protected from logging in programs designed to help fight global warming.</rdfs:comment>
