	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4ea682dc-3d8b-4ec1-9595-3ec760359ca4">
		<rdfs:label>article-4ea682dc-3d8b-4ec1-9595-3ec760359ca4</rdfs:label>
		<rdfs:comment>The president, who lost the state by a few thousand votes in 2016, now has the support of the Republican establishment. But not all Republicans are convinced.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
