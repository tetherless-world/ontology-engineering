		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1300a5f8-a824-4425-bdc3-74bd0f42847b">
		<rdfs:label>article-1300a5f8-a824-4425-bdc3-74bd0f42847b</rdfs:label>
		<rdfs:comment>At issue is whether Ms. Potter, a former police officer, was criminally reckless when she fired a gunshot into Mr. Wright’s chest while seeming to think she was holding her Taser.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-21"/>
