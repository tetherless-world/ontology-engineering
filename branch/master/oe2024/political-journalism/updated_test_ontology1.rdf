		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b1ee10f5-99fe-40df-a0d3-970939c79acb">
		<rdfs:label>article-b1ee10f5-99fe-40df-a0d3-970939c79acb</rdfs:label>
		<rdfs:comment>The defendant, Michael Sussmann, is accused of lying to the F.B.I. in a meeting about Trump and Russia. He denies wrongdoing.</rdfs:comment>
