		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-977a8283-6b42-4be5-b0ee-882377fc64ec">
		<rdfs:label>article-977a8283-6b42-4be5-b0ee-882377fc64ec</rdfs:label>
		<rdfs:comment>Delaware’s own Joe Biden was eventually named the winner of the 2020 presidential race. By then, Delaware itself had gotten a decent turn in the spotlight, as the nation waited.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7da4dfa6-58ba-4b1b-8d80-6c39df820022"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
