		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a6a9976d-0601-4c5b-8ae9-ae79310ad41c">
		<rdfs:label>article-a6a9976d-0601-4c5b-8ae9-ae79310ad41c</rdfs:label>
		<rdfs:comment>The pandemic has changed everything about the stressful admissions process, adding even more strain on students.</rdfs:comment>
