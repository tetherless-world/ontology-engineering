		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-27"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b956b6c8-ae4f-4c7c-b483-898ac13f2fb4">
		<rdfs:label>article-b956b6c8-ae4f-4c7c-b483-898ac13f2fb4</rdfs:label>
		<rdfs:comment>Even for a conservative religious community, the People of Praise is notable in how deeply embedded members are in one another’s lives.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c9e39358-a975-42ba-a74a-ab413e845336"/>
