	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-baef6223-eb8c-4b98-a33a-be4db4cc01db">
		<rdfs:label>article-baef6223-eb8c-4b98-a33a-be4db4cc01db</rdfs:label>
		<rdfs:comment>The omnibus voting, ethics and campaign finance bill would roll back barriers to voting enacted by Republican statehouses, but it faces an uphill battle in the Senate.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-04"/>
