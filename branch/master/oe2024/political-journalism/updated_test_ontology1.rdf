		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-709112e8-59ab-4f6f-93b7-0e3e7b7a4a55">
		<rdfs:label>article-709112e8-59ab-4f6f-93b7-0e3e7b7a4a55</rdfs:label>
		<rdfs:comment>Republicans in the Granite State are selecting their choices to challenge Senator Maggie Hassan, a Democrat, and two Democratic members of Congress.</rdfs:comment>
