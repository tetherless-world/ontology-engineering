	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b958f82b-99d4-4a73-8266-3f39e347b7bd">
		<rdfs:label>article-b958f82b-99d4-4a73-8266-3f39e347b7bd</rdfs:label>
		<rdfs:comment>The court also turned down an appeal on whether transit systems may reject religious advertising.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-04-06"/>
