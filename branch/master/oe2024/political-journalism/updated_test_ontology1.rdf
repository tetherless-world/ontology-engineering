		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-21"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dcc4cf4e-bf31-4bd6-9cb8-7f4cb9e91c70">
		<rdfs:label>article-dcc4cf4e-bf31-4bd6-9cb8-7f4cb9e91c70</rdfs:label>
		<rdfs:comment>The speaker said staff aides would earn at least $45,000 annually and boosted the pay cap to $203,700. She also set a vote on a bill to protect those who unionize.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
