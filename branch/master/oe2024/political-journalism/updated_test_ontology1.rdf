	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-fb5eda23-1914-4fdd-8fe8-bc07047d5cb2">
		<rdfs:label>article-fb5eda23-1914-4fdd-8fe8-bc07047d5cb2</rdfs:label>
		<rdfs:comment>In remarks at a conference in Dallas, he also denounced the recent protests at justices’ homes and said conservatives would not adopt such tactics.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-14"/>
