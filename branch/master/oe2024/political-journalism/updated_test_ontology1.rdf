		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-19"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c463b9e3-08f4-40a6-a7dd-75d28dcdb5ab">
		<rdfs:label>article-c463b9e3-08f4-40a6-a7dd-75d28dcdb5ab</rdfs:label>
		<rdfs:comment>For over a decade, the program, now tucked inside the Office of Naval Intelligence, has discussed mysterious events in classified briefings.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-448d10d6-f454-446a-87c4-fb541dbe3894"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a9ce0fab-c673-49bd-845d-341d8b9dbcc9"/>
