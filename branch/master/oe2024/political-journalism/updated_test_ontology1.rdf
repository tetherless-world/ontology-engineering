		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c809e3b7-eb51-41ce-9340-1467dc2053d1">
		<rdfs:label>article-c809e3b7-eb51-41ce-9340-1467dc2053d1</rdfs:label>
		<rdfs:comment>More than 5.5 million people have cast ballots in person or by mail. Experts predict high turnout in the midterm elections.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-93d154d3-6d3d-4599-ac55-e63a146d8d6f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-22"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c809e669-ebec-4d36-b36b-1031b0792e29">
		<rdfs:label>article-c809e669-ebec-4d36-b36b-1031b0792e29</rdfs:label>
		<rdfs:comment>Mr. Majewski, a surprise victor this week in Ohio, has voiced sympathy for QAnon believers and suggested that the F.B.I. drove much of the violence at the Capitol riot.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a5fb0ba0-4965-4f76-8b52-d16ac9dac194"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d01bf002-c77d-4553-95c9-1a8ab8cd235b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
