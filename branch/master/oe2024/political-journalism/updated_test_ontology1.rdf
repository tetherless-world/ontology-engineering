	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b6428ad9-940c-4d82-85aa-6eb38550c520">
		<rdfs:label>article-b6428ad9-940c-4d82-85aa-6eb38550c520</rdfs:label>
		<rdfs:comment>President-elect Joseph R. Biden Jr. on Monday denounced the attacks on voting by President Trump and his allies, calling them “unconscionable” and saying that no officials should ever face the kind of pressure they received to falsely proclaim an election to be fraudulent.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-14"/>
