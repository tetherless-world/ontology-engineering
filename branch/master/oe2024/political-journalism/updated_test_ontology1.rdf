	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c276bcf7-d8a2-4828-b32f-492e08f34769">
		<rdfs:label>article-c276bcf7-d8a2-4828-b32f-492e08f34769</rdfs:label>
		<rdfs:comment>The government decides to try to enforce antitrust laws.</rdfs:comment>
