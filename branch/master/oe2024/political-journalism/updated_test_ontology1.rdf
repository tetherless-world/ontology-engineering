		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-08"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-42096452-7d06-4d82-8d96-cc60403ec4ff">
		<rdfs:label>article-42096452-7d06-4d82-8d96-cc60403ec4ff</rdfs:label>
		<rdfs:comment>The measure creates a 13-member investigative panel with subpoena power. Eight members are to be named by Democrats and five with input from Republicans.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
