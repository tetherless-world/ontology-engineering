		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-69bf1ee8-c81c-4ac6-b112-2247e3e7f90b">
		<rdfs:label>article-69bf1ee8-c81c-4ac6-b112-2247e3e7f90b</rdfs:label>
		<rdfs:comment>The Arizona senator is registering as an independent, noting that she “never fit perfectly in either national party.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0e84c75e-7bc1-4744-83f1-7496fcf4721d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-12-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-69c21fb5-2f60-48ce-86ed-6303f5660917">
		<rdfs:label>article-69c21fb5-2f60-48ce-86ed-6303f5660917</rdfs:label>
		<rdfs:comment>Native Americans built the Alamo and hundreds of converts were buried there. Descendants are now fuming because Texas has rejected efforts to protect the site.</rdfs:comment>
