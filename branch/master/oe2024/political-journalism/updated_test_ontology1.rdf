	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-98c28c6e-df30-4cfa-9b18-3b7f81959fcf">
		<rdfs:label>article-98c28c6e-df30-4cfa-9b18-3b7f81959fcf</rdfs:label>
		<rdfs:comment>Don’t squander this opportunity, America.</rdfs:comment>
