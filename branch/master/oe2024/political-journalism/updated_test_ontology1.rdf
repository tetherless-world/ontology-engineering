		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-11"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d2df945a-58f9-4e6c-abfd-8cfd645e1291">
		<rdfs:label>article-d2df945a-58f9-4e6c-abfd-8cfd645e1291</rdfs:label>
		<rdfs:comment>Senators Bernie Sanders and Elizabeth Warren argue over what was said at a private 2018 meeting, their dispute takes center stage at the debate and Cory Booker says goodbye.</rdfs:comment>
