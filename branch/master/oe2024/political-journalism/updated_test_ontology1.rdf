		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7c8ff659-6239-40c1-921d-d0bec71224f9">
		<rdfs:label>article-7c8ff659-6239-40c1-921d-d0bec71224f9</rdfs:label>
		<rdfs:comment>The former vice president didn’t deliver a stellar performance, but he largely executed his goal of providing a stable contrast to his rival.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-577cfa39-5806-4396-ae24-cdf4ba406715"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7479f929-0522-4f1f-a391-dcdb5f4e726c"/>
