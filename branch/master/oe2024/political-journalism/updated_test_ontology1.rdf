	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-fb6708d4-052f-4569-bfd4-5bd4f6b240b3">
		<rdfs:label>article-fb6708d4-052f-4569-bfd4-5bd4f6b240b3</rdfs:label>
		<rdfs:comment>The actions are part of the Trump administration’s broader efforts to punish China for its attempts to stifle political dissent in Hong Kong.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-83d40723-6a13-432d-8617-d546a58e6733"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-19"/>
