	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3fdf7c3b-d7be-467b-b482-a84a768cb8f0">
		<rdfs:label>article-3fdf7c3b-d7be-467b-b482-a84a768cb8f0</rdfs:label>
		<rdfs:comment>Congress is considering bills to help communities prepare for extreme weather and to cut the greenhouse gases that are driving climate change. But passage is not assured.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c55cfad1-37a4-40de-ab47-b363a537db6a"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d8148593-227b-4889-ae70-592b440737ae"/>
