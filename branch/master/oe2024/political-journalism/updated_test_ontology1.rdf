		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f64937ca-2a53-453e-bd7f-01fbef3074e4">
		<rdfs:label>article-f64937ca-2a53-453e-bd7f-01fbef3074e4</rdfs:label>
		<rdfs:comment>Dr. Joseph Ladapo, Florida’s new surgeon general, has vowed to “completely reject fear” in managing the pandemic.</rdfs:comment>
