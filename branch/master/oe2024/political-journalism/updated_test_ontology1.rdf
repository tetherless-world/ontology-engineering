		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6ab728ff-6f8d-4d93-af95-e69e140ccac4">
		<rdfs:label>article-6ab728ff-6f8d-4d93-af95-e69e140ccac4</rdfs:label>
		<rdfs:comment>Mr. Biden has spoken publicly about how he once sent Mr. Netanyahu a photograph with the inscription, “Bibi, I don’t agree with a damn thing you say, but I love you.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
