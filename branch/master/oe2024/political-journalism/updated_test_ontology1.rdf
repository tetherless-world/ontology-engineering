		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f8c53e8d-5598-4549-8bda-28e16847f7bf">
		<rdfs:label>article-f8c53e8d-5598-4549-8bda-28e16847f7bf</rdfs:label>
		<rdfs:comment>Republicans are eager to be rid of Mr. Massie, but he is trying to turn the donations into a political weapon of his own.</rdfs:comment>
