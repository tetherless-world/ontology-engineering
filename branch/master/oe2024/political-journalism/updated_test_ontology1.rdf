	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d1b94f1c-737c-45c7-a886-2096729db679">
		<rdfs:label>article-d1b94f1c-737c-45c7-a886-2096729db679</rdfs:label>
		<rdfs:comment>The president has conceded that his $3.5 trillion collection of spending programs and tax cuts will need to shrink substantially.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
