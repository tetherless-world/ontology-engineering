	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e9dc016d-3a8a-4f51-b15a-2c8d5912dc03">
		<rdfs:label>article-e9dc016d-3a8a-4f51-b15a-2c8d5912dc03</rdfs:label>
		<rdfs:comment>The timing of the meetings later this month suggests that the agency plans to move quickly to decide both issues.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-10-01"/>
