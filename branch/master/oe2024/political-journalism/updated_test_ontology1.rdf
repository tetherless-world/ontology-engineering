	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-54d875ae-a0c1-47bf-8b03-83a3ca8fcc1d">
		<rdfs:label>article-54d875ae-a0c1-47bf-8b03-83a3ca8fcc1d</rdfs:label>
		<rdfs:comment>The announcement comes amid tensions with China over the self-governing island, which several American lawmakers recently visited.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-94d58c04-d925-44a3-9534-35b73b8dc25d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-18"/>
