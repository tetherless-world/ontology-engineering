	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-72ab1895-b4d7-4ad4-842f-59824a9aab17">
		<rdfs:label>article-72ab1895-b4d7-4ad4-842f-59824a9aab17</rdfs:label>
		<rdfs:comment>Klete Keller, a champion swimmer who won two Olympic gold medals as a relay teammate of Michael Phelps, was identified by former teammates and coaches as a member of the crowd that surged into the U.S. Capitol during violent protests on Wednesday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7dabe50a-50e9-4d58-884b-2762fae02489"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c283d02b-4203-4385-ab77-0565daa78786"/>
