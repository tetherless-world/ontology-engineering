		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3cbd3b4a-474a-4ff4-bb18-33145a1f43a0">
		<rdfs:label>article-3cbd3b4a-474a-4ff4-bb18-33145a1f43a0</rdfs:label>
		<rdfs:comment>Urgently needed: teachers in struggling districts, certified in math or special education. Perks: maybe a pay raise, or how about a four-day week?</rdfs:comment>
