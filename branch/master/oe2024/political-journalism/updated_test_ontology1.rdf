	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-54e8b4ff-22b3-4454-986f-b040fa012dd2">
		<rdfs:label>article-54e8b4ff-22b3-4454-986f-b040fa012dd2</rdfs:label>
		<rdfs:comment>Officials in Evanston, Ill., were weighing how to distribute $10 million in reparations to those who suffered housing discrimination.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d0d7757-313d-444e-a4df-32876c51aaa0"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-22"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
