		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d2e9e5b6-70ce-40f6-a1ed-d0a20d830758">
		<rdfs:label>article-d2e9e5b6-70ce-40f6-a1ed-d0a20d830758</rdfs:label>
		<rdfs:comment>A study group appointed by Congress finds that removing international forces by the May 1 date set in the 2020 U.S.-Taliban peace agreement could lead to a civil war in Afghanistan.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3bea54bd-f3ee-4712-b704-2739e55e376e"/>
