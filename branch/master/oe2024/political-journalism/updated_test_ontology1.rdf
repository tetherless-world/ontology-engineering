	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d89733cb-46d3-4a4a-9169-1c0321eb47b8">
		<rdfs:label>article-d89733cb-46d3-4a4a-9169-1c0321eb47b8</rdfs:label>
		<rdfs:comment>The president is questioning whether stay-at-home orders have gone too far. But relaxing them could significantly increase the death toll from the coronavirus, health officials warn.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-49a73997-b3e5-4f97-8d10-e5b247447638"/>
