	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-63ca8f47-262f-4cc3-bf58-087b251466aa">
		<rdfs:label>article-63ca8f47-262f-4cc3-bf58-087b251466aa</rdfs:label>
		<rdfs:comment>Police officers used flash grenades to disperse a crowd so the president could visit for a photo opportunity. And in New York, protesters and looters defied a curfew.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-63cf1667-7381-433f-bc6d-f03479babcac">
