		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-05"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9fdc397f-471a-4fd6-bdc0-e43857864099">
		<rdfs:label>article-9fdc397f-471a-4fd6-bdc0-e43857864099</rdfs:label>
		<rdfs:comment>The nominee, William J. Burns, appears likely to win bipartisan support from senators.</rdfs:comment>
