		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d8970384-7ea4-45ab-8e1f-e4bb8746a24d">
		<rdfs:label>article-d8970384-7ea4-45ab-8e1f-e4bb8746a24d</rdfs:label>
		<rdfs:comment>Why on earth are representatives and senators allowed to trade stocks?</rdfs:comment>
