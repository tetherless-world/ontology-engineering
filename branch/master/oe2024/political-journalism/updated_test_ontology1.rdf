	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d866c74d-9106-4901-8226-f2b5fd0fad92">
		<rdfs:label>article-d866c74d-9106-4901-8226-f2b5fd0fad92</rdfs:label>
		<rdfs:comment>The next mass shooting is just a matter of time.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4174129c-26f0-4215-a9d5-425a654777c4"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-27"/>
