		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-df2cee8c-beaf-43dd-9715-0542119a526a">
		<rdfs:label>article-df2cee8c-beaf-43dd-9715-0542119a526a</rdfs:label>
		<rdfs:comment>Richard B. Moore chose a firing squad over electrocution but said both methods were unconstitutional. His execution, set for this month, would be the country’s first by firing squad since 2010.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-04-15"/>
