		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2bc99e73-b507-4660-a478-2f62efed0f97">
		<rdfs:label>article-2bc99e73-b507-4660-a478-2f62efed0f97</rdfs:label>
		<rdfs:comment>But under Georgia law, all three men must get sentenced to life in prison.</rdfs:comment>
