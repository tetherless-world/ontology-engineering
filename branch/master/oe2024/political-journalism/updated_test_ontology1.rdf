		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5a3094b1-6bc7-47d7-8f53-c56fd8ed0c59"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-28"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8d650827-591c-41bd-863e-be27c512856f">
		<rdfs:label>article-8d650827-591c-41bd-863e-be27c512856f</rdfs:label>
		<rdfs:comment>The move follows similar transitions announced in states like California, Massachusetts, New Jersey, New York and Oregon.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-becd702f-c674-4653-9a6c-90ee51977e85"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-17"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8d68926f-ef50-49af-903f-7e656ba4fcf1">
		<rdfs:label>article-8d68926f-ef50-49af-903f-7e656ba4fcf1</rdfs:label>
		<rdfs:comment>A federal judge in Houston on Monday rejected Republican efforts to invalidate more than 127,000 votes that were cast at drive-through locations in Harris County, a Democratic stronghold that includes Houston, the nation’s fourth-largest city.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-93d154d3-6d3d-4599-ac55-e63a146d8d6f"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fd2d6ec4-4aa3-452f-8e17-99a953af7b67"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8d69a89c-493a-4a7b-a667-eabd000d4e39">
		<rdfs:label>article-8d69a89c-493a-4a7b-a667-eabd000d4e39</rdfs:label>
		<rdfs:comment>The visit will be the first time President Volodymyr Zelensky of Ukraine has left his country since Russia invaded in February.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-12-21"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8d69d0f4-afda-463c-b202-5699c6338d7d">
		<rdfs:label>article-8d69d0f4-afda-463c-b202-5699c6338d7d</rdfs:label>
		<rdfs:comment>More than 60 percent of the chamber’s Republicans — including party leaders — signed onto a brief, underscoring the party’s willingness to back the president no matter how extreme the test.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ce324a4b-e256-4143-b6b8-1dde4bc956af"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-12"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
