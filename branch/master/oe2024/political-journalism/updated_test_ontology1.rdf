		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e7db0624-7aee-4bae-bd8b-8d1ce1862a96">
		<rdfs:label>article-e7db0624-7aee-4bae-bd8b-8d1ce1862a96</rdfs:label>
		<rdfs:comment>Congressional leaders and business groups are raising the possibility of new economic aid from Congress in the lame-duck session.</rdfs:comment>
