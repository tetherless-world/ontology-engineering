		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-105f623d-8479-4286-ac81-308b295605ce">
		<rdfs:label>article-105f623d-8479-4286-ac81-308b295605ce</rdfs:label>
		<rdfs:comment>WASHINGTON — Derrick Johnson, the president of the N.A.A.C.P., pressed President-elect Joseph R. Biden Jr. on Tuesday to create a civil rights envoy position in the West Wing that would report directly to the president.</rdfs:comment>
