		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8ee19308-5530-403a-b3e5-811ce5aa65c1">
		<rdfs:label>article-8ee19308-5530-403a-b3e5-811ce5aa65c1</rdfs:label>
		<rdfs:comment>Evidence emerged that top officials, including at the F.B.I., had warnings about violence before the riot at the Capitol.</rdfs:comment>
