		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-06-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b8bfd305-9b3f-4688-b567-7de57945a6f4">
		<rdfs:label>article-b8bfd305-9b3f-4688-b567-7de57945a6f4</rdfs:label>
		<rdfs:comment>State legislatures are facing chaos amid the coronavirus crisis, with revenue projections suddenly expected to dip and major agendas put on hold.</rdfs:comment>
