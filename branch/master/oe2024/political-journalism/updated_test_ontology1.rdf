	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0f1d6801-bd0d-406b-b097-7ab5a38c6406">
		<rdfs:label>article-0f1d6801-bd0d-406b-b097-7ab5a38c6406</rdfs:label>
		<rdfs:comment>The administration urged a court to throw out a challenge brought by tribal and environmental groups, backing a pipeline that would carry Canadian oil across Minnesota and Wisconsin.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c4d98394-1549-4853-be0d-e7afcd8ee238"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-06-24"/>
