		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-17"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a09653f-05a5-4cf4-9f1e-7e185d06b5d2">
		<rdfs:label>article-1a09653f-05a5-4cf4-9f1e-7e185d06b5d2</rdfs:label>
		<rdfs:comment>The Biden administration has pushed social media giants like Facebook to curb Covid misinformation. But it is thriving on fringe platforms like Gab, a hub for extremist content.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-11-22"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a0a4768-54c9-43d7-81b7-bd885f12d5c7">
		<rdfs:label>article-1a0a4768-54c9-43d7-81b7-bd885f12d5c7</rdfs:label>
		<rdfs:comment>Thursday: He has experience dealing with big disruptions. He’ll need it. Also: California sues the Trump administration — again.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-738c55e5-1f96-4b93-8c70-fc8c1c8c9119"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-28"/>
