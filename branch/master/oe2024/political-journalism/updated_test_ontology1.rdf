	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bb0aa6ca-c039-426e-bcc7-0c1bed74be99">
		<rdfs:label>article-bb0aa6ca-c039-426e-bcc7-0c1bed74be99</rdfs:label>
		<rdfs:comment>Dr. Andrew Baker, who performed the official autopsy of George Floyd, said that fentanyl and heart disease had contributed to his death, but that the officers’ actions were the main cause.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9a5389b6-c0ea-4275-8951-1523cfe86f87"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e2a444d6-76b3-4fc5-9655-0178ae16f402"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
