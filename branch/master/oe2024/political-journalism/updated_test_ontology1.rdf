	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9c886ecc-3097-446f-b561-51a176ea9645">
		<rdfs:label>article-9c886ecc-3097-446f-b561-51a176ea9645</rdfs:label>
		<rdfs:comment>The president-elect has several veteran aides to choose from, even as some liberals complain about a return of the foreign policy “Blob.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc2c2b47-32c2-43a0-8e5f-dd4e72335932"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-10"/>
