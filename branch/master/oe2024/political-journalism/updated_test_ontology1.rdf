		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b1ee9e6d-5a92-42fe-b75d-76df542e6458">
		<rdfs:label>article-b1ee9e6d-5a92-42fe-b75d-76df542e6458</rdfs:label>
		<rdfs:comment>Letters with the lethal substance were also sent to local law enforcement offices in Texas, an official said. Investigators are trying to find out who sent them and whether more were circulating through the postal system.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd522e1c-57a0-49bc-9835-fae39d9d58a6"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-19"/>
