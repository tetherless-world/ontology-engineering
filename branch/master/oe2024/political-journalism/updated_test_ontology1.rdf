	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2ca7cc5c-230d-4b1a-944a-ae146b531cbb">
		<rdfs:label>article-2ca7cc5c-230d-4b1a-944a-ae146b531cbb</rdfs:label>
		<rdfs:comment>Pence today, Biden and McConnell soon: This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
