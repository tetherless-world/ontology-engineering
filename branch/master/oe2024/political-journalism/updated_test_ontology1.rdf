		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9e886404-67cb-491b-a823-d4847d6dac8f">
		<rdfs:label>article-9e886404-67cb-491b-a823-d4847d6dac8f</rdfs:label>
		<rdfs:comment>Mr. Santos, a Republican representative-elect from Long Island, has admitted to lying about his professional background, educational history and property ownership.</rdfs:comment>
