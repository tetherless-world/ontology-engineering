	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f02bfdce-a02c-40d1-9848-86737f446243">
		<rdfs:label>article-f02bfdce-a02c-40d1-9848-86737f446243</rdfs:label>
		<rdfs:comment>When President Trump departs the White House, he will have a huge pile of cash to fuel his future ambitions. He can hold rallies, hire staff and even lay groundwork for a potential 2024 run.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
