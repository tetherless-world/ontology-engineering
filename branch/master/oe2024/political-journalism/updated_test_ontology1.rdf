		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3b93cf4-5acf-4a15-a6ae-191d465ee610">
		<rdfs:label>article-c3b93cf4-5acf-4a15-a6ae-191d465ee610</rdfs:label>
		<rdfs:comment>The affirmative action lawsuit against Harvard seemed to confirm advice given for years to Asian Americans: Don’t play chess, don’t check the box declaring race.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c87a0742-aa3c-4c1b-bf3f-6a582a57320e"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-12-02"/>
