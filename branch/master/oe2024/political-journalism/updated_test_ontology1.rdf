		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f054aa66-2374-4f42-8ea3-5d2fd3c51e19"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3c23805-ad4d-4733-9904-c1c27f878297">
		<rdfs:label>article-c3c23805-ad4d-4733-9904-c1c27f878297</rdfs:label>
		<rdfs:comment>District of Columbia statehood has long been out of reach. Proponents hope Democratic control of the federal government and the security issues raised over the past week could change that.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-be4a3e54-4b34-4f4b-b446-90f3692a587d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-10"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3c51eeb-2d1a-4e0a-8ce3-f3fa5b221b70">
		<rdfs:label>article-c3c51eeb-2d1a-4e0a-8ce3-f3fa5b221b70</rdfs:label>
		<rdfs:comment>Senator Mitch McConnell postponed the Senate’s return for two weeks but said lawmakers would continue confirmation hearings as planned.</rdfs:comment>
