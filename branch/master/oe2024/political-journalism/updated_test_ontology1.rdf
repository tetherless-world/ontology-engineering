	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e9d74043-69e6-4bad-9e74-3c63023d7348">
		<rdfs:label>article-e9d74043-69e6-4bad-9e74-3c63023d7348</rdfs:label>
		<rdfs:comment>Senator Mark Kelly is no stranger to lonely missions.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ce324a4b-e256-4143-b6b8-1dde4bc956af"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-02"/>
