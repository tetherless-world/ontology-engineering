		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-21"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c5d74bf4-0c9e-4417-bf08-0fbff60b71de">
		<rdfs:label>article-c5d74bf4-0c9e-4417-bf08-0fbff60b71de</rdfs:label>
		<rdfs:comment>Representative Ted Budd and Cheri Beasley, who were quick to criticize one another, both sought to distance themselves from the presidents so closely linked to their fates.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6fcc2118-4d59-415b-8f82-fd519f6b2d34"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-07"/>
