		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-edf10d88-4eb1-47c0-bf7e-1912fd6a26ad">
		<rdfs:label>article-edf10d88-4eb1-47c0-bf7e-1912fd6a26ad</rdfs:label>
		<rdfs:comment>Once sections of the site are safe, search and rescue work will resume, the mayor of Miami-Dade County told reporters.</rdfs:comment>
