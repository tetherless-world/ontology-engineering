		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b4bba6aa-1d96-47b7-bb08-0efc8626765e">
		<rdfs:label>article-b4bba6aa-1d96-47b7-bb08-0efc8626765e</rdfs:label>
		<rdfs:comment>For all of the attention on the Justice Department’s investigation into the Jan. 6 attack, Mr. Garland has focused on the everyday work of being the attorney general.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd522e1c-57a0-49bc-9835-fae39d9d58a6"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-04-25"/>
