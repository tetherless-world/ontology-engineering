		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-18e41421-a398-4c2b-8a25-6e2342da45b6">
		<rdfs:label>article-18e41421-a398-4c2b-8a25-6e2342da45b6</rdfs:label>
		<rdfs:comment>Democratic leaders were aiming to pass the $1 trillion bipartisan infrastructure bill, but they postponed a vote on the $1.85 trillion social safety net and climate change measure.</rdfs:comment>
