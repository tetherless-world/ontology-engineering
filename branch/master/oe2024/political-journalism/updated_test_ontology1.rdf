		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0d516aef-0120-439a-b429-9004a4b101f3">
		<rdfs:label>article-0d516aef-0120-439a-b429-9004a4b101f3</rdfs:label>
