	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9d3ee661-4e5c-4507-8796-f83b710ef742">
		<rdfs:label>article-9d3ee661-4e5c-4507-8796-f83b710ef742</rdfs:label>
		<rdfs:comment>Friday: A professor of epidemiology at U.C. Davis talks about what is necessary to safely reopen schools. Also: Tesla’s surprise profit sets it up for another major milestone.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-14f82d09-3a15-43b0-8f6d-ebdb1405d989"/>
