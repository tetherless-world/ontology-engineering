	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dfe667bf-1813-4a86-a17a-36d96fcf580b">
		<rdfs:label>article-dfe667bf-1813-4a86-a17a-36d96fcf580b</rdfs:label>
		<rdfs:comment>After President Trump incited a mob of his supporters who violently stormed the Capitol on Wednesday, Congress is once again weighing whether to impeach him, this time with only days remaining in his term.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dfec75db-5e57-40a7-9b8a-ee5968f00ab1">
