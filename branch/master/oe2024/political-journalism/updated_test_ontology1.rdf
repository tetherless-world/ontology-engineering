	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-aad90215-f5ec-40f7-a85b-e40ecea27799">
		<rdfs:label>article-aad90215-f5ec-40f7-a85b-e40ecea27799</rdfs:label>
		<rdfs:comment>Some New Year’s resolutions for the incoming boss.</rdfs:comment>
