	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ddbb968a-c83e-46e5-8a2d-99242ec8fab6">
		<rdfs:label>article-ddbb968a-c83e-46e5-8a2d-99242ec8fab6</rdfs:label>
		<rdfs:comment>Over his near half-century in public life, Joseph R. Biden Jr. has made many speeches: good speeches, bad speeches, campaign kickoff speeches and concession speeches, speeches without proper attribution to original sources, speeches so impossibly Biden that no one could ever accuse him of lifting anything.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f33dc887-a9a6-4b4f-adce-fc81b6f27a0c"/>
