	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c45c48cf-aeb2-4135-9024-434e47271de8">
		<rdfs:label>article-c45c48cf-aeb2-4135-9024-434e47271de8</rdfs:label>
		<rdfs:comment>Ms. Whitmer, the governor of Michigan and a contender on Joe Biden’s short list for V.P., spoke with The Times ahead of her speech on Monday night at the Democratic National Convention.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-44926325-5c4f-4e18-89e5-b1470d62842c"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-17"/>
