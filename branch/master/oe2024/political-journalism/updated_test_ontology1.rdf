	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8af6ae4c-7a1c-474c-9dae-00b8be8becc7">
		<rdfs:label>article-8af6ae4c-7a1c-474c-9dae-00b8be8becc7</rdfs:label>
		<rdfs:comment>The quake struck southwest of Eureka at about 2:30 a.m., leaving at least two people dead and knocking out power for tens of thousands of customers in Humboldt County.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-59b7e6a0-5bff-459d-9120-cd62945b2e1f"/>
