		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c7f73d39-0a41-423e-84a7-bc8f546c00a5">
		<rdfs:label>article-c7f73d39-0a41-423e-84a7-bc8f546c00a5</rdfs:label>
		<rdfs:comment>A transcript of the former White House counsel’s appearance, which ended a two-year dispute between the Justice Department and Congress over a subpoena, will be made public next week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
