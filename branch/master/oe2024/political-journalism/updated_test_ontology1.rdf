	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d9c8bdfb-550b-4791-9f01-f101a46fea4f">
		<rdfs:label>article-d9c8bdfb-550b-4791-9f01-f101a46fea4f</rdfs:label>
		<rdfs:comment>Mr. Lipton, who served in senior roles in the Clinton and Obama administrations and at the I.M.F., is retiring.</rdfs:comment>
