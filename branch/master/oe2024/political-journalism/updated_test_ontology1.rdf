		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-18e17b4f-66e1-442b-9b0f-065fa538406b">
		<rdfs:label>article-18e17b4f-66e1-442b-9b0f-065fa538406b</rdfs:label>
		<rdfs:comment>An article, written with other vaccine experts, put the regulators at odds with key federal health officials, including Dr. Anthony S. Fauci.</rdfs:comment>
