		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-24"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-499e628d-3a90-4645-baa2-3b80a374a0f6">
		<rdfs:label>article-499e628d-3a90-4645-baa2-3b80a374a0f6</rdfs:label>
		<rdfs:comment>Mr. O’Rourke is returning to an issue that had haunted his campaign for Texas governor for months.</rdfs:comment>
