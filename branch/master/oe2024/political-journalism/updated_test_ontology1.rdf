	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-891eb258-a7b4-4fa6-955b-ffaaf20e374c">
		<rdfs:label>article-891eb258-a7b4-4fa6-955b-ffaaf20e374c</rdfs:label>
		<rdfs:comment>Senator Sanders’s visit to the editorial board, and their subsequent deliberation today on “The Choice” podcast.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-01-20"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
