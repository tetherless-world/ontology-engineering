		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d2e09365-e547-4873-a07a-9c0ec5dea656">
		<rdfs:label>article-d2e09365-e547-4873-a07a-9c0ec5dea656</rdfs:label>
		<rdfs:comment>White House memoirs, journalistic exposés, full-throated defenses of the president: Publishers are producing books for every partisan and wondering if the gravy train ends on Election Day.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9373374d-0dd4-449a-b6ac-ad42e3a2a5cd"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f513b357-0333-48a8-8bf2-2930ee247c2a"/>
