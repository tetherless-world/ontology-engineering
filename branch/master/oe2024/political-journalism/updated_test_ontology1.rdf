		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-08"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d5c790a-3ad4-45ae-a175-7ffd2d111c1d">
		<rdfs:label>article-1d5c790a-3ad4-45ae-a175-7ffd2d111c1d</rdfs:label>
		<rdfs:comment>Bruce Schroeder is presiding over the trial of Kyle Rittenhouse and at times took a strict line with prosecutors.</rdfs:comment>
