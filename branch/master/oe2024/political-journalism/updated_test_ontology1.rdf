	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8c51bbf7-82f3-4c9e-b354-e503154dafa5">
		<rdfs:label>article-8c51bbf7-82f3-4c9e-b354-e503154dafa5</rdfs:label>
		<rdfs:comment>Two of our reporters break down the key moments from the second night of the Republican National Convention.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9c6cc67a-b3c2-45c5-af7a-92a423ab1249"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ebf4f94d-a728-4327-b424-d347782b7b17"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-26"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8c552677-bc55-48a9-8d48-79e0ce0dbb2f">
