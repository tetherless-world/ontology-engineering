	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bfb1a5af-aa18-4dd8-9c5a-05d865ee096a">
		<rdfs:label>article-bfb1a5af-aa18-4dd8-9c5a-05d865ee096a</rdfs:label>
		<rdfs:comment>A fatal shooting after clashes in Portland came on the heels of the shooting deaths of two people during confrontations in Kenosha, Wis., earlier in the week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
