	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-18cb1de7-9b57-481d-936f-f75697c62f66">
		<rdfs:label>article-18cb1de7-9b57-481d-936f-f75697c62f66</rdfs:label>
