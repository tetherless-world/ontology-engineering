		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e037c2d8-2fb5-4c29-953a-43c69ff098b0">
		<rdfs:label>article-e037c2d8-2fb5-4c29-953a-43c69ff098b0</rdfs:label>
		<rdfs:comment>Thousands of logisticians are responsible for making sure that U.S. military aid reaches its destination, on planes, trains and ships.</rdfs:comment>
