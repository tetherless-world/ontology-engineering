	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4a04650d-0f93-4ada-bc13-31334299ff23">
		<rdfs:label>article-4a04650d-0f93-4ada-bc13-31334299ff23</rdfs:label>
		<rdfs:comment>Mr. McAuliffe, who was governor from 2014 to 2018, says he wants to take “Virginia to the next level and to lift up all Virginians.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
