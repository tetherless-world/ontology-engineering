		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ba04129f-fa1b-4396-a679-6df8208a2fc9">
		<rdfs:label>article-ba04129f-fa1b-4396-a679-6df8208a2fc9</rdfs:label>
		<rdfs:comment>The president and his aides are holding out hope for ambitious convention programming, and have considered a return to Mount Rushmore or a speech by Melania Trump from Seneca Falls, N.Y.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-03"/>
