	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-df2f20c6-380b-4831-b8af-e0ae3fa5d5cc">
		<rdfs:label>article-df2f20c6-380b-4831-b8af-e0ae3fa5d5cc</rdfs:label>
		<rdfs:comment>Republicans blocked a move to bring up a $10 billion Covid response package after Democrats refused to consider amendments, including one to keep in place pandemic-era immigration curbs.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-04-05"/>
