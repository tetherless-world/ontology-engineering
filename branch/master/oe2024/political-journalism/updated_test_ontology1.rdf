		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cf049d9-7283-434d-87a9-e1ab3e6422e9">
		<rdfs:label>article-7cf049d9-7283-434d-87a9-e1ab3e6422e9</rdfs:label>
		<rdfs:comment>“Voters, not lawyers, choose the president,” a judge for the Third Circuit Court of Appeals wrote in the 21-page repudiation of Mr. Trump’s legal effort to halt Pennsylvania’s certification process.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
