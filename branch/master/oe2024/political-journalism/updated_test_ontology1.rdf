	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-87fdeedd-e5b7-46a7-969b-90606abd1850">
		<rdfs:label>article-87fdeedd-e5b7-46a7-969b-90606abd1850</rdfs:label>
		<rdfs:comment>Speaker Nancy Pelosi wrote a letter to the acting secretary of defense demanding that he not install a Trump loyalist as the top lawyer at the National Security Agency, her office announced Monday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6f60db0f-4977-4567-b7bd-9abe5d4a35e8"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-18"/>
