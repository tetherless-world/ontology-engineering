	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d9ce3f89-58f3-4094-bc69-0fcf0f65919a">
		<rdfs:label>article-d9ce3f89-58f3-4094-bc69-0fcf0f65919a</rdfs:label>
		<rdfs:comment>The police said five people were stabbed, two of them fatally, at the church on Sunday night. A suspect was in custody, but information on a motive was not immediately available.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-937707f9-4e68-4d82-91c1-90b67e7150a3"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-98e37f30-3255-4507-8253-1403eedcf3ac"/>
