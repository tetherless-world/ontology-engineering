		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03e54664-286e-4010-80ac-120aa671c8f2">
		<rdfs:label>article-03e54664-286e-4010-80ac-120aa671c8f2</rdfs:label>
		<rdfs:comment>Democrats aren’t being very subtle about their feelings toward Matt Lieberman, a Democratic candidate for one of Georgia’s two Senate seats on the ballot in November.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03e6ade9-aa3b-4f89-9a64-df382664dbfc">
		<rdfs:label>article-03e6ade9-aa3b-4f89-9a64-df382664dbfc</rdfs:label>
