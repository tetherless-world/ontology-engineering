		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e03708fa-659f-44fa-bf87-cf22015017d4">
		<rdfs:label>article-e03708fa-659f-44fa-bf87-cf22015017d4</rdfs:label>
		<rdfs:comment>Testimony disclosed by the House committee investigating the attack showed that Mark Meadows and Freedom Caucus members discussed directing marchers to the Capitol as Congress certified the election results.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
