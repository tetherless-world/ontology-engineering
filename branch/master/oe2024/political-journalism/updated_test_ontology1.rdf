		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e98d714a-097c-4d19-8411-78d1c13551a1">
		<rdfs:label>article-e98d714a-097c-4d19-8411-78d1c13551a1</rdfs:label>
		<rdfs:comment>The $10 billion package does not include funds for the global vaccination effort, frustrating some Democrats.</rdfs:comment>
