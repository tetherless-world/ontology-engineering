	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-cdc3b739-234b-4d8c-a1d4-140f05b49821">
		<rdfs:label>article-cdc3b739-234b-4d8c-a1d4-140f05b49821</rdfs:label>
		<rdfs:comment>Public health officials say that injecting politics into the growing outbreak could make it harder to fight.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-81f0af94-b9cf-4dcb-8ae5-91c423d251ff"/>
