		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-19e20bec-894f-4282-b19c-7c5cac091cca">
		<rdfs:label>article-19e20bec-894f-4282-b19c-7c5cac091cca</rdfs:label>
		<rdfs:comment>The city on Tuesday rescinded a moratorium on elective surgery, clearing the way for some cosmetic surgeons to reopen.</rdfs:comment>
