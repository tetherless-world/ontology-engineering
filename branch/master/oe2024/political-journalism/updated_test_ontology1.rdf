		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-07"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4ca066aa-2e7b-498a-b612-918ea9d77b9f">
		<rdfs:label>article-4ca066aa-2e7b-498a-b612-918ea9d77b9f</rdfs:label>
		<rdfs:comment>The three white men are facing federal hate crime charges in Mr. Arbery’s death. In opening arguments, their lawyers said that they were motivated by concern about crime in their South Georgia neighborhood.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5f497c4d-378e-4c6b-a1e7-70ebd6812d68"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ea9dbbc7-267d-46dd-9bad-620f876af0ba"/>
