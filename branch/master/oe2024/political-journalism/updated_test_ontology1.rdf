		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-04-26"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bb155e12-f304-4ec8-a47f-dc486e136ee0">
		<rdfs:label>article-bb155e12-f304-4ec8-a47f-dc486e136ee0</rdfs:label>
		<rdfs:comment>People in rural areas are killed in police shootings at about the same rate as in cities, but victims’ families and activists say they have struggled to get justice or even make themselves heard.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b0d8acac-ba33-4091-b922-0eb5b9ab904d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-06"/>
