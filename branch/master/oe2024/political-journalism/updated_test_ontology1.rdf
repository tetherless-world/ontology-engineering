	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9f1acc32-8667-4ec3-bdf0-325a4d0bc67a">
		<rdfs:label>article-9f1acc32-8667-4ec3-bdf0-325a4d0bc67a</rdfs:label>
		<rdfs:comment>The agency will reverse a Trump-era decision to keep chlorpyrifos, one of the most common pesticides, in use.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c55cfad1-37a4-40de-ab47-b363a537db6a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-18"/>
