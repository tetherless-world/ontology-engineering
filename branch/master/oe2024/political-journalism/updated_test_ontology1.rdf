	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d6fabd11-6168-415f-b7bd-6a235fa5c498">
		<rdfs:label>article-d6fabd11-6168-415f-b7bd-6a235fa5c498</rdfs:label>
