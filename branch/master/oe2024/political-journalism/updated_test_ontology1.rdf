		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7c9832bb-5d50-4d2e-81e2-5baf56f17689">
		<rdfs:label>article-7c9832bb-5d50-4d2e-81e2-5baf56f17689</rdfs:label>
		<rdfs:comment>The move came on the eve of the Republican convention and after President Trump pressed the agency to move faster to address the pandemic.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
