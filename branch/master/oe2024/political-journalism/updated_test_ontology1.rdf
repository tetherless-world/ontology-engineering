		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d2e01b74-abd2-42e3-850f-f4e807647e36">
		<rdfs:label>article-d2e01b74-abd2-42e3-850f-f4e807647e36</rdfs:label>
		<rdfs:comment>BA.5, a highly transmissible variant, is dominating a surge of new infections. Many health officials say the wave is cause for caution, not alarm.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d0d7757-313d-444e-a4df-32876c51aaa0"/>
