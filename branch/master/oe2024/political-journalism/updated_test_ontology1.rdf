	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-801fd463-b446-414d-be78-8db5f1cbf8ab">
		<rdfs:label>article-801fd463-b446-414d-be78-8db5f1cbf8ab</rdfs:label>
