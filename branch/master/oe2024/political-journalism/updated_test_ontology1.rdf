		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3ae1daa-f999-4061-b435-a01f76257656">
		<rdfs:label>article-c3ae1daa-f999-4061-b435-a01f76257656</rdfs:label>
		<rdfs:comment>President Biden says he won’t keep “quiet” any longer about protecting ballot access. But voting rights groups say he should’ve raised his voice months ago.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-93d154d3-6d3d-4599-ac55-e63a146d8d6f"/>
