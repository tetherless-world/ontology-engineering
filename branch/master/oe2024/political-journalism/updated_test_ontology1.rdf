		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-30"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b2f4330a-1488-4be7-af28-399bee8de460">
		<rdfs:label>article-b2f4330a-1488-4be7-af28-399bee8de460</rdfs:label>
		<rdfs:comment>Five years after the mass shooting at Emanuel African Methodist Episcopal Church, officials in Charleston, S.C., announced a plan to remove a monument to the prominent slavery defender John C. Calhoun.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f08506e1-4ec6-45c9-9d85-46fe67848dee"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc5a47b7-5e7e-4d58-8ee7-caaf2f703c6a"/>
