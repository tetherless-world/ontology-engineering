		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-779dac36-4cf7-46d1-8449-bcb69fe279a4">
		<rdfs:label>article-779dac36-4cf7-46d1-8449-bcb69fe279a4</rdfs:label>
		<rdfs:comment>The departures, which include his lead lawyer, Butch Bowers, come more than a week before his Senate trial is set to begin.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-31"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
