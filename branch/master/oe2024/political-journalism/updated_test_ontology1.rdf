		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4c7da2ee-b8d9-462c-b640-c49794c6f760">
		<rdfs:label>article-4c7da2ee-b8d9-462c-b640-c49794c6f760</rdfs:label>
		<rdfs:comment>Gov. Larry Hogan announced that a partnership with the state’s lottery would provide $2 million in prize money for residents who get vaccinated.</rdfs:comment>
