		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2372682c-c360-4efc-982d-ccf22b91d444">
		<rdfs:label>article-2372682c-c360-4efc-982d-ccf22b91d444</rdfs:label>
		<rdfs:comment>The district has seen more new cases in the last week than in any other seven-day stretch in the pandemic, part of a broader surge in the nation’s Mid-Atlantic region.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d0d7757-313d-444e-a4df-32876c51aaa0"/>
