		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9247119f-e3c2-496e-82ce-460fdcff0bc7">
		<rdfs:label>article-9247119f-e3c2-496e-82ce-460fdcff0bc7</rdfs:label>
		<rdfs:comment>The resignation came amid increasing expectations that the department may disclose partial results from the review before it is completed but ahead of the presidential election.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3a4b0b1a-f7a7-498e-8805-48a907d13871"/>
