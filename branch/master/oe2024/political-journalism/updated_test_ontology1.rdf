	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2aaa9120-5ac4-463b-af35-4c6818b18d14">
		<rdfs:label>article-2aaa9120-5ac4-463b-af35-4c6818b18d14</rdfs:label>
		<rdfs:comment>The C.D.C. issued the moratorium last fall, citing its jurisdictional authority to implement measures needed to promote public health.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7479f929-0522-4f1f-a391-dcdb5f4e726c"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-29"/>
