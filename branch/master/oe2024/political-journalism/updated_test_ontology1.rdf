	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-62357a20-cfc1-4983-9f61-5e10e338d1da">
		<rdfs:label>article-62357a20-cfc1-4983-9f61-5e10e338d1da</rdfs:label>
		<rdfs:comment>The teachers’ work stoppage is extending to a fourth school day, while negotiations with the city go on.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-078e57d0-5b20-48e9-b039-c2569b2acb05"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-10"/>
