		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-656e90ef-8047-4ec7-9632-cba63c6dc84b">
		<rdfs:label>article-656e90ef-8047-4ec7-9632-cba63c6dc84b</rdfs:label>
		<rdfs:comment>The four-day virtual event focused on character rather than policy. Still, Democrats exaggerated about Social Security, jobs and the coronavirus pandemic.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-be4afe5b-5317-4441-a7de-57071d96016d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-21"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
