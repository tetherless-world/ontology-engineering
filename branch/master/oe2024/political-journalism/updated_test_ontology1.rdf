		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f1b22f75-3d92-4642-bac2-6d353da14c3d">
		<rdfs:label>article-f1b22f75-3d92-4642-bac2-6d353da14c3d</rdfs:label>
		<rdfs:comment>The special counsel scrutinizing the Russia inquiry, a Trump-era leftover, appears to be retreading ground that an inspector general explored in 2019.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3a4b0b1a-f7a7-498e-8805-48a907d13871"/>
