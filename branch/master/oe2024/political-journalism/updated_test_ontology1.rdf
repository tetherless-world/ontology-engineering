		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-11"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ddb13651-a395-46c2-801c-5be5f87f6b43">
		<rdfs:label>article-ddb13651-a395-46c2-801c-5be5f87f6b43</rdfs:label>
		<rdfs:comment>Texas opened a wide range of malls, restaurants and businesses just a day after the state reported its highest death toll from the coronavirus.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-781f7c76-864b-4901-8b16-90c83d96e113"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fd2d6ec4-4aa3-452f-8e17-99a953af7b67"/>
