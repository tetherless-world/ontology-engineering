		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7777912f-739d-4bb5-95a3-78a641ec5b42">
		<rdfs:label>article-7777912f-739d-4bb5-95a3-78a641ec5b42</rdfs:label>
		<rdfs:comment>Geoffrey S. Berman will be a visiting professor of law at Stanford Law School.</rdfs:comment>
