	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-47014dc3-0e73-4013-b554-123ca1d0e0ea">
		<rdfs:label>article-47014dc3-0e73-4013-b554-123ca1d0e0ea</rdfs:label>
