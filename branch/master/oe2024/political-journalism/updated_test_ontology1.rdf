	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-880030b8-bbc8-482f-a302-f6d9c89666b9">
		<rdfs:label>article-880030b8-bbc8-482f-a302-f6d9c89666b9</rdfs:label>
		<rdfs:comment>The two runoff elections in Georgia that will determine which party controls the Senate are already drawing enormous sums of cash, with more than $125 million pouring into the state in only two weeks.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-19"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-880272d4-3e55-4ddb-bb75-253fd4e480b7">
		<rdfs:label>article-880272d4-3e55-4ddb-bb75-253fd4e480b7</rdfs:label>
		<rdfs:comment>The Trumpiest man in Wisconsin wants another term in the Senate.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd146215-8c12-40b0-bfb7-0d9c07c5e63d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
