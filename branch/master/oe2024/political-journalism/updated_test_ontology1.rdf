		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-00531a14-dfb8-489f-8142-4c25b07095c2">
		<rdfs:label>article-00531a14-dfb8-489f-8142-4c25b07095c2</rdfs:label>
		<rdfs:comment>Joseph R. Biden Jr. is making his first trip to Florida of the general election on Tuesday as he seeks to rally Latino voters in the crucial battleground state.</rdfs:comment>
