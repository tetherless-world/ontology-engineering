	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b4715fe0-2dee-47ec-9045-765bb6e1daa0">
		<rdfs:label>article-b4715fe0-2dee-47ec-9045-765bb6e1daa0</rdfs:label>
		<rdfs:comment>For months, demonstrators have kept up their demands for resignations and reforms.</rdfs:comment>
