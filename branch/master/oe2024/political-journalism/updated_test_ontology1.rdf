	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-eb752389-ea8c-48cb-ae97-cb30319c6299">
		<rdfs:label>article-eb752389-ea8c-48cb-ae97-cb30319c6299</rdfs:label>
