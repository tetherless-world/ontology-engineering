	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c2872c41-3b0a-4fcc-9f69-91025b081799">
		<rdfs:label>article-c2872c41-3b0a-4fcc-9f69-91025b081799</rdfs:label>
		<rdfs:comment>A Times reporter who covers Guantánamo Bay tracked down military photographs of the early days of the U.S. detention center there.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4bd6cfaa-ebec-415a-8c53-2870f770bfa7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-12"/>
