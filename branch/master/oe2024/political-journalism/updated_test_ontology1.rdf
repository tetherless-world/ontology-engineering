		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-81cc2497-7269-4622-8ec6-28a100d36152">
		<rdfs:label>article-81cc2497-7269-4622-8ec6-28a100d36152</rdfs:label>
		<rdfs:comment>Gov. Gavin Newsom has called for a 15 percent reduction in water usage, but we’re far from that target.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-1e5cee4f-82a8-44a6-9cc0-9285f4da7bf4"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
