		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-884fabd6-02b5-45e2-8892-b278149b73eb">
		<rdfs:label>article-884fabd6-02b5-45e2-8892-b278149b73eb</rdfs:label>
		<rdfs:comment>Voters should choose “no” on the recall question and the state should look to reform the process.</rdfs:comment>
