		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c5e2b62b-3db1-4e26-ae0d-26522b3d2cf9">
		<rdfs:label>article-c5e2b62b-3db1-4e26-ae0d-26522b3d2cf9</rdfs:label>
		<rdfs:comment>There are competitive House races in New York, and Charles Booker faces Amy McGrath in the Senate primary in Kentucky. Results may be delayed because of the many voters casting absentee ballots.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4a606035-f311-493f-9272-00230e475b23"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-94edf185-50a8-4071-bd51-9f26c711d174"/>
