		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-11-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-27789fe6-44d3-4ede-bade-7b2416127a6c">
		<rdfs:label>article-27789fe6-44d3-4ede-bade-7b2416127a6c</rdfs:label>
		<rdfs:comment>Mayor G.T. Bynum finds himself on the defensive over the presidential campaign, the coronavirus pandemic and the uproar over police abuse.</rdfs:comment>
