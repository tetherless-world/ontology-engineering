	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0c3c6e28-20c2-466f-a99e-b0a2ad3c222b">
		<rdfs:label>article-0c3c6e28-20c2-466f-a99e-b0a2ad3c222b</rdfs:label>
		<rdfs:comment>Mr. Trump was the first sitting president to speak in person at the annual March for Life.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-1f4003c3-78bb-4191-901d-febdb359732e"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-81f0af94-b9cf-4dcb-8ae5-91c423d251ff"/>
