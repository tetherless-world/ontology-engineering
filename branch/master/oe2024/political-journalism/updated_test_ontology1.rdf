		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dffe1e28-967e-49ca-859b-c35efc0d0e45">
		<rdfs:label>article-dffe1e28-967e-49ca-859b-c35efc0d0e45</rdfs:label>
		<rdfs:comment>Prosecutors in April dropped a first-degree murder charge against Barry Morphew, whose wife, Suzanne Morphew, disappeared in May 2020.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a4bd1aa5-c807-421e-b8ae-1b3824d70300"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-22"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e000af7a-0171-4a21-9419-29308de41e81">
		<rdfs:label>article-e000af7a-0171-4a21-9419-29308de41e81</rdfs:label>
		<rdfs:comment>Cassidy Hutchinson recounted to the House select committee how a lawyer with ties to former President Donald J. Trump said to her that she should “focus on protecting the president.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
