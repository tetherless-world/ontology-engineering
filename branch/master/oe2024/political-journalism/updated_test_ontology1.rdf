		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-27"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d0803d7-7f11-4a6e-b0e3-ed8cdd5bdac4">
		<rdfs:label>article-1d0803d7-7f11-4a6e-b0e3-ed8cdd5bdac4</rdfs:label>
		<rdfs:comment>The conviction of Stewart Rhodes for sedition was a signal victory for the Justice Department, but prosecutors still face challenges as they prepare for the trials of other far-right figures.</rdfs:comment>
