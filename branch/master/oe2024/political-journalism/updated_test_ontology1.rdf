	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b2143946-6ab4-4326-8e14-e6e068ba92a6">
		<rdfs:label>article-b2143946-6ab4-4326-8e14-e6e068ba92a6</rdfs:label>
		<rdfs:comment>His remarks went viral after he repeated the chant, which is understood to be code for swearing at President Biden, during a Southwest Airlines flight.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-073a2c11-e123-4e83-900b-90a962ee7e54"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
