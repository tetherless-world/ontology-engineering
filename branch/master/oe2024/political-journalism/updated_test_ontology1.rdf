	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ae583d93-7e6e-4648-beab-283615f36222">
		<rdfs:label>article-ae583d93-7e6e-4648-beab-283615f36222</rdfs:label>
		<rdfs:comment>The Democrat Jeff Ettinger, running in a special election for a House seat in southern Minnesota, is in favor of passing legislation that would codify Roe v. Wade into federal law.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-256e095e-335c-4403-9a00-3366dd2b451f"/>
