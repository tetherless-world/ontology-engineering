		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-257ad095-8a66-47f4-88d3-8d0e2259ec8d">
		<rdfs:label>article-257ad095-8a66-47f4-88d3-8d0e2259ec8d</rdfs:label>
		<rdfs:comment>The president will travel to Brussels for the NATO session, and will also attend a European Union summit meeting.</rdfs:comment>
