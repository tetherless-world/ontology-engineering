		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4e44e81b-3626-496b-a22e-1dbbf89551bf">
		<rdfs:label>article-4e44e81b-3626-496b-a22e-1dbbf89551bf</rdfs:label>
		<rdfs:comment>Right as the presidential campaign enters the final stretch, the nation’s schools will be plunged into a huge experiment during a pandemic.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5298104c-81c8-4a22-af1d-23823869871b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-09"/>
