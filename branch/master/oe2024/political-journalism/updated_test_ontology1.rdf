	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-18c21c4a-ba8b-4fd3-9c94-ee4c3c508f22">
		<rdfs:label>article-18c21c4a-ba8b-4fd3-9c94-ee4c3c508f22</rdfs:label>
