		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-04955df1-34e7-4634-abc1-a951110ab122">
		<rdfs:label>article-04955df1-34e7-4634-abc1-a951110ab122</rdfs:label>
