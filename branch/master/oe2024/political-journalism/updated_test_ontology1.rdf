	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-feeb419d-2674-4419-a480-dd4a621d5656">
		<rdfs:label>article-feeb419d-2674-4419-a480-dd4a621d5656</rdfs:label>
		<rdfs:comment>Quintin Jones, 41, had been convicted of killing a great-aunt and drew national attention when his relatives sought clemency.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ba1def2a-fecf-4911-9182-36727aa8deac"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-20"/>
