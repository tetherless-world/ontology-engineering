	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-380bcbb8-a233-4408-9781-81df5172217f">
		<rdfs:label>article-380bcbb8-a233-4408-9781-81df5172217f</rdfs:label>
		<rdfs:comment>We’re on top of the latest extreme weather in the U.S. and around the world. Follow here for news on heat waves, wildfires, floods and more.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e17310c8-39f3-4c91-8224-a91b0b94e409"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-380d0add-c2b6-4658-9c56-7fed4d7ced08">
		<rdfs:label>article-380d0add-c2b6-4658-9c56-7fed4d7ced08</rdfs:label>
		<rdfs:comment>We spoke with Fiona Hill, a former Trump adviser, about how the Russian leader’s view of history has led him to the brink of war.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e9c4025-7dbe-4808-a3d4-b9d25fa14354"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-89135d87-ed63-4619-a5ce-c3f23d9e6fd4"/>
