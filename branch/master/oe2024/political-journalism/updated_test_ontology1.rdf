	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d87061a1-d012-480a-9569-2c8d75435910">
		<rdfs:label>article-d87061a1-d012-480a-9569-2c8d75435910</rdfs:label>
		<rdfs:comment>Several European leaders criticized the Supreme Court’s decision, which goes against a global trend, while the Vatican welcomed it.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8585af28-d70d-45d6-ae09-260d12d2e2ec"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-24"/>
