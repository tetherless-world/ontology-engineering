	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c4d12ea1-8380-4ef8-a68c-a40d8bf2673d">
		<rdfs:label>article-c4d12ea1-8380-4ef8-a68c-a40d8bf2673d</rdfs:label>
		<rdfs:comment>The president called it an “economic imperative” to provide more aid for millions of Americans who are struggling to make ends meet as the virus exacts a bruising toll.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4b06f805-a6f6-4cda-9908-3f8ddd3a0432"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
