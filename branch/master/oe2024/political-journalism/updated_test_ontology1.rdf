		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-10ac2d2b-df6f-4f6e-81ed-6043c29aa826"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-07-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a08c8fd-966f-4bef-96da-c7c69777097e">
		<rdfs:label>article-1a08c8fd-966f-4bef-96da-c7c69777097e</rdfs:label>
		<rdfs:comment>Small enterprises that support homeless people, orphans and refugees are seeing their ads pulled as part of the social media platform’s ban on political advertising.</rdfs:comment>
