		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4d5a1b5-fb70-49f5-9db6-49ea1d88a177">
		<rdfs:label>article-a4d5a1b5-fb70-49f5-9db6-49ea1d88a177</rdfs:label>
		<rdfs:comment>John Fetterman, the Pennsylvania lieutenant governor who is running for the state’s Democratic Senate nomination, canceled events on Friday, Saturday and Sunday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-15"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4d60ea1-dcb5-450a-8289-615b409a6611">
		<rdfs:label>article-a4d60ea1-dcb5-450a-8289-615b409a6611</rdfs:label>
		<rdfs:comment>Puerto Rico also announced a longer overnight curfew until May 9 as cases rise on the island.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b234823e-9687-443c-921d-17ad590417a4"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-04-08"/>
