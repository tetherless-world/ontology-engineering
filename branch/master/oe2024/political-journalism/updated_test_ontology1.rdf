	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b1e0363f-937f-4e01-beff-238b0d1e46d0">
		<rdfs:label>article-b1e0363f-937f-4e01-beff-238b0d1e46d0</rdfs:label>
		<rdfs:comment>The former White House counsel testified behind closed doors last week about the former president’s attempts to interfere with the Russia investigation.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
