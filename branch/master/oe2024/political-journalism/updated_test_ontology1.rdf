		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-07-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5e1f388b-2688-4afd-8bdf-2d1d47cc4e9a">
		<rdfs:label>article-5e1f388b-2688-4afd-8bdf-2d1d47cc4e9a</rdfs:label>
		<rdfs:comment>The president kicked off a week of events to promote his $1.9 trillion American Rescue Plan by appointing Gene Sperling, a longtime Democratic aide, to oversee spending under the bill.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4b06f805-a6f6-4cda-9908-3f8ddd3a0432"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
