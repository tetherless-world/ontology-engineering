	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c0cd77e7-f879-4e7f-9c86-f0c17d31645c">
		<rdfs:label>article-c0cd77e7-f879-4e7f-9c86-f0c17d31645c</rdfs:label>
