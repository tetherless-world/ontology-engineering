	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0241e382-46f8-4cb4-85cb-005837af66d7">
		<rdfs:label>article-0241e382-46f8-4cb4-85cb-005837af66d7</rdfs:label>
		<rdfs:comment>The storm system in South Florida also caused a sewage overflow in Miami-Dade County.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-22d46982-bbc7-431e-ac81-222c4aacd666"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-391c12fb-c20f-4088-9e16-8f097dc13a5a"/>
