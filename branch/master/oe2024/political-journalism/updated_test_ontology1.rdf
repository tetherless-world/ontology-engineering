	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6f29546f-5fe5-41a0-aa3e-1cc4f167c1f6">
		<rdfs:label>article-6f29546f-5fe5-41a0-aa3e-1cc4f167c1f6</rdfs:label>
		<rdfs:comment>Abandoning the case is the latest step in a pattern of dismantling the work of the Russia investigators. A former prosecutor likened it to eating the department from the inside out.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
