		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-81ecb185-fd78-4ef0-ac26-5e1e1ffe12b7">
		<rdfs:label>article-81ecb185-fd78-4ef0-ac26-5e1e1ffe12b7</rdfs:label>
		<rdfs:comment>The Senate voted unanimously to award the Congressional Gold Medal to the officers, during a week when officials confirmed two suicides of officers who were at the Capitol the day of the rampage.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
