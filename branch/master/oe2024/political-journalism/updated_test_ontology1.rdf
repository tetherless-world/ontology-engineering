	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-93d44d68-01a2-4ae5-9526-49d1f44de36e">
		<rdfs:label>article-93d44d68-01a2-4ae5-9526-49d1f44de36e</rdfs:label>
		<rdfs:comment>Many states are slow to vaccinate incarcerated people despite the high risk of outbreaks in prisons and jails. But some are doing better with inmates than with the wider public.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-33709db8-2f1b-4de8-b586-0d050bd917df"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-06-01"/>
