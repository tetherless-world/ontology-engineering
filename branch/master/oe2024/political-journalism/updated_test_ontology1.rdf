		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d195cd99-e29f-4481-b202-ceabb1cd3cd9">
		<rdfs:label>article-d195cd99-e29f-4481-b202-ceabb1cd3cd9</rdfs:label>
		<rdfs:comment>The Trump administration granted visa officers more power to block pregnant women from visiting the United States if applicants were believed to be traveling to give birth.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-558cc815-e7e6-47a5-bd90-ac5a453042ba"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-01-23"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d19e42e1-a35b-41e5-a395-2363ee05d5e8">
		<rdfs:label>article-d19e42e1-a35b-41e5-a395-2363ee05d5e8</rdfs:label>
		<rdfs:comment>Saudi leaders decided earlier this month to join Russia in leading a cartel of oil producers to announce cutting production by two million barrels a day, which could raise prices and help Russia.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b32f6625-044c-4b5c-a23c-681cb2a901f9"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-26"/>
