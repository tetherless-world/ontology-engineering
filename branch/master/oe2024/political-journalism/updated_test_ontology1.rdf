		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f64fa319-1e59-49a8-8ac6-b5cef21912c0">
		<rdfs:label>article-f64fa319-1e59-49a8-8ac6-b5cef21912c0</rdfs:label>
		<rdfs:comment>The Supreme Court has hinted that it is ready to trim the doctrine of qualified immunity, which makes it difficult to sue government officials for violence and cruelty.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-08"/>
