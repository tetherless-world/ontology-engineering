	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-37c3260c-5b0d-41ed-87f0-86d70830b992">
		<rdfs:label>article-37c3260c-5b0d-41ed-87f0-86d70830b992</rdfs:label>
