	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-df5d0911-a4d5-4f7e-ad8f-2d675270c0b7">
		<rdfs:label>article-df5d0911-a4d5-4f7e-ad8f-2d675270c0b7</rdfs:label>
		<rdfs:comment>How big automakers are abandoning resistance</rdfs:comment>
