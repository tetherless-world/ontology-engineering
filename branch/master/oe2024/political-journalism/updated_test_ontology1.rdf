		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-20"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6ab4468f-863f-44e3-986f-fe6110ad5297">
		<rdfs:label>article-6ab4468f-863f-44e3-986f-fe6110ad5297</rdfs:label>
		<rdfs:comment>Jacob Blake, a Black resident of Kenosha, was shot in the back, setting off condemnations from Wisconsin’s governor and Joe Biden, the Democrats’ presidential nominee.</rdfs:comment>
