	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-df13c6ca-c647-4244-bbf6-e2cd313c6b61">
		<rdfs:label>article-df13c6ca-c647-4244-bbf6-e2cd313c6b61</rdfs:label>
		<rdfs:comment>Authoritarian leaders are waging a war against the free press.</rdfs:comment>
