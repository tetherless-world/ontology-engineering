		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-37d28737-d55e-4750-ae1a-08710c083d92">
		<rdfs:label>article-37d28737-d55e-4750-ae1a-08710c083d92</rdfs:label>
		<rdfs:comment>The latest coverage of the crisis from The Times as well as stories of its impact on California and beyond.</rdfs:comment>
