	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a6d9b1be-eb8c-464c-b54b-d84977e52060">
		<rdfs:label>article-a6d9b1be-eb8c-464c-b54b-d84977e52060</rdfs:label>
		<rdfs:comment>Justice Neil M. Gorsuch added his voice to that of Justice Clarence Thomas in questioning the longstanding standard for public officials set in New York Times v. Sullivan.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-07-02"/>
