	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1b82dd3a-77df-4371-b4bf-8586078c8fee">
		<rdfs:label>article-1b82dd3a-77df-4371-b4bf-8586078c8fee</rdfs:label>
