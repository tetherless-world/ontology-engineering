	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d3b213f4-0923-4d95-8b6c-610b98badefe">
		<rdfs:label>article-d3b213f4-0923-4d95-8b6c-610b98badefe</rdfs:label>
