	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0ef0bae8-9cfc-4171-bae1-460ff47a0a23">
		<rdfs:label>article-0ef0bae8-9cfc-4171-bae1-460ff47a0a23</rdfs:label>
		<rdfs:comment>The gift vault was “in a state of disarray,” and tens of thousands of dollars of items remain unaccounted for, including a $5,800 bottle of whiskey.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2c183a13-1898-4deb-ad56-cc02fd034eaf"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-05"/>
