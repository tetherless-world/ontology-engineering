	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f7f18130-3bfe-4e55-9786-a7de05af0466">
		<rdfs:label>article-f7f18130-3bfe-4e55-9786-a7de05af0466</rdfs:label>
