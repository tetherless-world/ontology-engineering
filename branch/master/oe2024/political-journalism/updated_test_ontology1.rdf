	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c26a2fac-8d54-4438-963f-93f898641601">
		<rdfs:label>article-c26a2fac-8d54-4438-963f-93f898641601</rdfs:label>
		<rdfs:comment>Amy Coney Barrett was confirmed as the next Supreme Court justice only eight days before a presidential election.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-922ad7b9-e6de-456a-9bc2-69207748d175"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-27"/>
