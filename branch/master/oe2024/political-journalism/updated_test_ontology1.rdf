		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f8b095b0-6707-4eb7-91bd-50f3cd5d90c4">
		<rdfs:label>article-f8b095b0-6707-4eb7-91bd-50f3cd5d90c4</rdfs:label>
		<rdfs:comment>Violent crime in cities has become a central talking point of Republican campaigns. It’s hurting many Democratic candidates, but not all.</rdfs:comment>
