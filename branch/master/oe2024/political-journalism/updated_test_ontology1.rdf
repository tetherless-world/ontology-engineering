		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a10bccc7-dfe6-46f4-aced-8d665b15094a">
		<rdfs:label>article-a10bccc7-dfe6-46f4-aced-8d665b15094a</rdfs:label>
		<rdfs:comment>Kroger employees watched the gunman shoot co-workers and customers.</rdfs:comment>
