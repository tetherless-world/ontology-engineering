	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cdc722e-2570-4f39-8af2-e69743ff4b0e">
		<rdfs:label>article-7cdc722e-2570-4f39-8af2-e69743ff4b0e</rdfs:label>
		<rdfs:comment>The condo board knew that Champlain Towers South in Surfside, Fla., needed major repairs. It did not know the complex was in a race against time.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-21d856ad-a6ae-406e-a9e4-9707218ad815"/>
