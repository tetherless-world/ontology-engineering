	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0c47c061-3acb-462b-bfce-b8901081bb62">
		<rdfs:label>article-0c47c061-3acb-462b-bfce-b8901081bb62</rdfs:label>
		<rdfs:comment>The legal authority for some F.B.I. surveillance tools expires next week, and law enforcement officials and lawmakers are divided.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
