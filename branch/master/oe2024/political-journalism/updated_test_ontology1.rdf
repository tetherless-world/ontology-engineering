	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-657f1839-1634-4118-ba6b-b9a0ca1d389d">
		<rdfs:label>article-657f1839-1634-4118-ba6b-b9a0ca1d389d</rdfs:label>
		<rdfs:comment>For the American public, there was never any great outcry for withdrawing, polling suggests.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-04-15"/>
