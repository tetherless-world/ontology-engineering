		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-11"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-49f5da20-24aa-4c93-aba7-571eda46edca">
		<rdfs:label>article-49f5da20-24aa-4c93-aba7-571eda46edca</rdfs:label>
		<rdfs:comment>President Trump trails Joseph R. Biden Jr. by four points in the latest Times/Siena survey of North Carolina, and Senator Thom Tillis is lagging behind his Democratic challenger in a crucial Senate race.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8a614115-3578-4c7f-b70a-6cdd9b0a4f3d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-49f7e4df-80dc-441a-a16d-50fe0ecd12c0">
		<rdfs:label>article-49f7e4df-80dc-441a-a16d-50fe0ecd12c0</rdfs:label>
		<rdfs:comment>Michelle Obama, the former first lady, was the keynote speaker on the first night of the 2020 Democratic National Convention.</rdfs:comment>
