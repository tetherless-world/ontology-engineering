		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d7c57d5d-1f6d-4311-af20-aaf256a1832c">
		<rdfs:label>article-d7c57d5d-1f6d-4311-af20-aaf256a1832c</rdfs:label>
		<rdfs:comment>The government emphasized not only racial slurs but also expressions of support for vigilantism.</rdfs:comment>
