		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3fcb15ed-7d65-42a6-999d-ececf79c274d">
		<rdfs:label>article-3fcb15ed-7d65-42a6-999d-ececf79c274d</rdfs:label>
		<rdfs:comment>The Trump administration awarded a no-bid contract to Deloitte to develop software to track vaccinations, but the system has flaws. A competitor claims the C.D.C. and the company stole her intellectual property.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-06"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3fd36c02-02fc-49f0-b76c-d4215d834571">
		<rdfs:label>article-3fd36c02-02fc-49f0-b76c-d4215d834571</rdfs:label>
		<rdfs:comment>Educators say they want to teach from home during the pandemic, but are fighting to limit work hours and counter demands that they consider unreasonable.</rdfs:comment>
