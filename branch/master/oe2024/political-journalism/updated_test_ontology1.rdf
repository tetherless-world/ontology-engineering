	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-78944bab-2e4c-4861-8046-e8f0d43cfdf9">
		<rdfs:label>article-78944bab-2e4c-4861-8046-e8f0d43cfdf9</rdfs:label>
		<rdfs:comment>These two do not like each other! Play the tape.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-93d154d3-6d3d-4599-ac55-e63a146d8d6f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-02-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
