		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d1ccc88-5041-461d-b4ab-4a8d64cf450e">
		<rdfs:label>article-1d1ccc88-5041-461d-b4ab-4a8d64cf450e</rdfs:label>
		<rdfs:comment>A respected, combat-tested Black colonel has been passed over three times for promotion to brigadier general. What does his fate say about the Corps?</rdfs:comment>
