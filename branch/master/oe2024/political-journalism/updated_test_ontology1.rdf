	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e0ee5cd8-d1c2-489a-b4c7-e100028b5179">
		<rdfs:label>article-e0ee5cd8-d1c2-489a-b4c7-e100028b5179</rdfs:label>
		<rdfs:comment>The postmaster general, under fire for his business ties and his cost-cutting measures, will testify before the House next week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ce324a4b-e256-4143-b6b8-1dde4bc956af"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
