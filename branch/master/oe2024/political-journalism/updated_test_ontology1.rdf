	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2fbd94d7-e504-4b7c-9d54-42fba33a26fe">
		<rdfs:label>article-2fbd94d7-e504-4b7c-9d54-42fba33a26fe</rdfs:label>
		<rdfs:comment>In Oakland, Calif., the birthplace of Vice President-elect Kamala Harris, Mayor Libby Schaaf was in tears on Saturday as she spoke about the victory.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
