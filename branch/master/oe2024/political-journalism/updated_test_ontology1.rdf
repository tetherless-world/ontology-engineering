	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bd04bae3-0633-4055-91c3-e271710b5d75">
		<rdfs:label>article-bd04bae3-0633-4055-91c3-e271710b5d75</rdfs:label>
		<rdfs:comment>Amid California’s drought, desperate landowners and managers are turning to those who practice an ancient, disputed method for locating water.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-10ac2d2b-df6f-4f6e-81ed-6043c29aa826"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-07-17"/>
