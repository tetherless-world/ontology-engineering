		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-04-29"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2c03d792-7e67-4c51-893a-34f6a45f9980">
		<rdfs:label>article-2c03d792-7e67-4c51-893a-34f6a45f9980</rdfs:label>
		<rdfs:comment>A dispute over legislation to make lynching a federal crime has grown fierce as Congress turns its attention to issues of race and law enforcement amid protests across the country.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-05"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2c04c43d-0c03-4da8-b3f6-46f2a81917de">
		<rdfs:label>article-2c04c43d-0c03-4da8-b3f6-46f2a81917de</rdfs:label>
		<rdfs:comment>The Bolt Creek fire led to an evacuation order for one town and produced smoke and ash that drifted 40 miles away.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4a40b1cb-c11d-4122-ae5a-754463517860"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-09-11"/>
