	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7899d00d-863b-4c4d-a5d0-649a4e4fa945">
		<rdfs:label>article-7899d00d-863b-4c4d-a5d0-649a4e4fa945</rdfs:label>
		<rdfs:comment>Medics in the protester-run zone treated the victims before they were transported to a hospital. Some protesters objected to the arrival of officers in riot gear.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-781f7c76-864b-4901-8b16-90c83d96e113"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-becd702f-c674-4653-9a6c-90ee51977e85"/>
