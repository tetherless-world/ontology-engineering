	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-70082dd3-0a2e-464f-8197-fca5941d189e">
		<rdfs:label>article-70082dd3-0a2e-464f-8197-fca5941d189e</rdfs:label>
		<rdfs:comment>“His death has left a gaping void in our lives that will never be filled,” Officer Evans’s family said in a statement released last week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
