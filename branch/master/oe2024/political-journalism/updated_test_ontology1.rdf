		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4fbbefd8-0f00-4b5f-9ed9-e5aeba04e7c4">
		<rdfs:label>article-4fbbefd8-0f00-4b5f-9ed9-e5aeba04e7c4</rdfs:label>
		<rdfs:comment>Milwaukee health officials said six voters and one poll worker contracted the coronavirus from participating in Election Day, which was held despite a stay-at-home order issued throughout the state.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
