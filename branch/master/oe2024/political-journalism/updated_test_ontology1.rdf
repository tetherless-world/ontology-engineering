	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-385a3f20-895b-41db-aa8b-c04f38d805f0">
		<rdfs:label>article-385a3f20-895b-41db-aa8b-c04f38d805f0</rdfs:label>
		<rdfs:comment>The former vice president had struggled with fund-raising throughout much of the primary campaign, but the pace of giving has sharply increased.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-15"/>
