	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c7ffebb3-f51c-4c3b-af2a-def53fb4cfa7">
		<rdfs:label>article-c7ffebb3-f51c-4c3b-af2a-def53fb4cfa7</rdfs:label>
		<rdfs:comment>San Franciscans are done apologizing for their cold Julys and Augusts. In a time of punishing heat waves, the city likes being a place to chill out.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6ebd0cd5-ea30-4810-9596-627dcc7bde1b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-27"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c803c40b-ee6f-469f-a366-34c2de541fef">
		<rdfs:label>article-c803c40b-ee6f-469f-a366-34c2de541fef</rdfs:label>
		<rdfs:comment>Mr. Stewart helped defend a Trump administration order that a 17-year-old in a federal refugee center continue her pregnancy or leave the country. The order was overruled.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-078e57d0-5b20-48e9-b039-c2569b2acb05"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c808e07c-89f8-469b-94d4-0982e68ee67c">
		<rdfs:label>article-c808e07c-89f8-469b-94d4-0982e68ee67c</rdfs:label>
		<rdfs:comment>A letter from lawmakers on the Oversight Committee asks for Customs and Border Protection officials to brief the committee by the end of the week about the conduct of border agents.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dad1523a-f983-4f0f-af53-0061c7165e91"/>
