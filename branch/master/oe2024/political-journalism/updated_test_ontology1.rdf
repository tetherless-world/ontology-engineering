		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9d63647c-a367-48e8-a138-624625ff1803">
		<rdfs:label>article-9d63647c-a367-48e8-a138-624625ff1803</rdfs:label>
		<rdfs:comment>The Food and Drug Administration’s move is expected to kick off more vaccination mandates for hospital workers, college students and federal troops.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e4ac7a5-be1a-4937-b91e-66276e5f8dd9"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-03"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9d692d00-dcc4-4db9-a24b-0b5c890de634">
		<rdfs:label>article-9d692d00-dcc4-4db9-a24b-0b5c890de634</rdfs:label>
		<rdfs:comment>Federal regulators are considering granting requests for Pfizer-BioNTech and Moderna boosters to be authorized for all adults as early as this week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0cc8020e-7db7-428c-8db7-36cf2f5c4168"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-17"/>
