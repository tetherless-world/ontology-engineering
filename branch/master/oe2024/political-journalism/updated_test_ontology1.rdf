	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d87b422b-930e-46db-8c08-eb53fe09d8a7">
		<rdfs:label>article-d87b422b-930e-46db-8c08-eb53fe09d8a7</rdfs:label>
		<rdfs:comment>President Trump retains a powerful hold on his party. But a growing number of Republican elected officials and party leaders have signaled they will indulge his conspiracy theories for only so long.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
