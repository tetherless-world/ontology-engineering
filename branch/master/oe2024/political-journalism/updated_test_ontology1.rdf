	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8b353ba7-fb84-4173-9898-20e141a14026">
		<rdfs:label>article-8b353ba7-fb84-4173-9898-20e141a14026</rdfs:label>
		<rdfs:comment>The Chicago Teachers Union has reached a tentative agreement with Mayor Lori Lightfoot to reopen the city’s schools for in-person classes, the mayor announced on Sunday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9ef20237-f390-44c5-8d52-031cdd2c86e1"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-07"/>
