	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d9c40d11-396d-467c-8617-ffd29c13ac76">
		<rdfs:label>article-d9c40d11-396d-467c-8617-ffd29c13ac76</rdfs:label>
		<rdfs:comment>Seven people have died and more than 30 were wounded.</rdfs:comment>
