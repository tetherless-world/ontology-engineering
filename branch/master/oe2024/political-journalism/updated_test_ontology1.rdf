	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-daf0fdd5-98f0-45cc-8ab5-36a161a444ee">
		<rdfs:label>article-daf0fdd5-98f0-45cc-8ab5-36a161a444ee</rdfs:label>
		<rdfs:comment>The proposal comes after Republicans struggled to iron out their policy differences with the administration and each other. Democrats are all but guaranteed to reject the offer.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
