		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-eded3529-9bdb-40aa-9911-a29938041a25">
		<rdfs:label>article-eded3529-9bdb-40aa-9911-a29938041a25</rdfs:label>
		<rdfs:comment>The coronavirus isn’t going away, but a vaccine is coming and so is an election.</rdfs:comment>
