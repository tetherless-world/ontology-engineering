	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1faabe94-0d95-48fc-9d82-f5533f0f6c52">
		<rdfs:label>article-1faabe94-0d95-48fc-9d82-f5533f0f6c52</rdfs:label>
		<rdfs:comment>A forensic pathologist called to testify by the defense said it was his medical opinion that George Floyd died from cardiac arrhythmia.</rdfs:comment>
