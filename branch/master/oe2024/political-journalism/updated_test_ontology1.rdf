		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d8a1f7c4-9bca-4b7e-80f6-22a27bcfe7a1">
		<rdfs:label>article-d8a1f7c4-9bca-4b7e-80f6-22a27bcfe7a1</rdfs:label>
		<rdfs:comment>Reasons to show a defendant mercy include extreme mental or emotional disturbance, as well as a broad consideration of “factors in the defendant’s background.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
