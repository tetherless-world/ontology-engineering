	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bc851844-0fe8-40c8-927f-ef4e417e0d83">
		<rdfs:label>article-bc851844-0fe8-40c8-927f-ef4e417e0d83</rdfs:label>
		<rdfs:comment>The president is opting for settings where there is virtually no risk he will encounter an uncomfortable question, but in doing so he is missing a chance to talk to a broader range of voters.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
