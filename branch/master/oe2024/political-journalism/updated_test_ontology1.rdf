		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-18"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4ca2db0a-7741-4fac-9c67-e5d93ae78429">
		<rdfs:label>article-4ca2db0a-7741-4fac-9c67-e5d93ae78429</rdfs:label>
		<rdfs:comment>The decision does not necessarily mean the committee will get the information it is seeking.</rdfs:comment>
