	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d280e6a4-1f86-4de9-b48b-d73734d79943">
		<rdfs:label>article-d280e6a4-1f86-4de9-b48b-d73734d79943</rdfs:label>
		<rdfs:comment>“This is not the Shasta County I know,” said Cathy Darling Allen, who has been overseeing elections in the county for 18 years.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-27"/>
