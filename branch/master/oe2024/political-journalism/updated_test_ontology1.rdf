		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-daf283f9-63df-4db9-917b-9ef73d10ae8a">
		<rdfs:label>article-daf283f9-63df-4db9-917b-9ef73d10ae8a</rdfs:label>
		<rdfs:comment>The two Democratic victories in the Senate runoffs confirmed that Georgia’s metamorphosis from conservative bastion to battleground state was complete.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5298104c-81c8-4a22-af1d-23823869871b"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d7a0b17f-e0aa-44c5-a995-e81e028fa879"/>
