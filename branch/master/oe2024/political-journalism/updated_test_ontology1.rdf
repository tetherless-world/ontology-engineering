		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-04-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0fdfd612-5413-45ac-af9c-2fe1d4d0252f">
		<rdfs:label>article-0fdfd612-5413-45ac-af9c-2fe1d4d0252f</rdfs:label>
		<rdfs:comment>A meeting with President Volodymyr Zelensky of Ukraine would have been the first for a top Trump official since the impeachment inquiry began.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b32f6625-044c-4b5c-a23c-681cb2a901f9"/>
