		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4d4e81d-3651-422b-8660-7e1fa4461489">
		<rdfs:label>article-a4d4e81d-3651-422b-8660-7e1fa4461489</rdfs:label>
		<rdfs:comment>As his administration grapples with reopening the economy and responding to the coronavirus crisis, President Trump worries about his re-election and how the news media is portraying him.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd42dd7e-7a0d-4a74-908e-252de023edfb"/>
