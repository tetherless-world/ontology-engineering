		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-21"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cb9058b-4e94-4673-abfe-1d6efdbd312f">
		<rdfs:label>article-7cb9058b-4e94-4673-abfe-1d6efdbd312f</rdfs:label>
		<rdfs:comment>The F.B.I. and state authorities last week arrested 13 men in connection with a domestic terrorism plot directed against the first-term governor.</rdfs:comment>
