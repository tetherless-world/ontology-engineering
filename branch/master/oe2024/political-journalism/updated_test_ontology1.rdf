	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-cdca6207-1c29-453b-b8d7-94424ca0cf32">
		<rdfs:label>article-cdca6207-1c29-453b-b8d7-94424ca0cf32</rdfs:label>
		<rdfs:comment>The House Jan. 6 committee played testimony from former Trump aides who said at least half a dozen Republicans had pre-emptively sought clemency.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2c183a13-1898-4deb-ad56-cc02fd034eaf"/>
