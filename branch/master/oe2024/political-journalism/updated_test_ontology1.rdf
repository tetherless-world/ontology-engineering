	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c295d4c6-07ac-4baa-861e-16ee9257efe4">
		<rdfs:label>article-c295d4c6-07ac-4baa-861e-16ee9257efe4</rdfs:label>
		<rdfs:comment>Ms. Peters, the Mesa County clerk accused of overseeing a breach of election equipment, went to Las Vegas this week to speak at an event. A judge said the trip violated her bond conditions.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-93d154d3-6d3d-4599-ac55-e63a146d8d6f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-14"/>
