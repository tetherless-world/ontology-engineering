	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-89048891-1f19-4e14-ba00-db50d3630a70">
		<rdfs:label>article-89048891-1f19-4e14-ba00-db50d3630a70</rdfs:label>
		<rdfs:comment>Days after President Biden took office, the Bureau of Land Management put a scenic landscape of a winding river at the top of its website, which during the previous administration had featured a photograph of a huge wall of coal.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-24"/>
