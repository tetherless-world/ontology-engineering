	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2ddf7a64-1fe1-4ffa-948b-531359077eba">
		<rdfs:label>article-2ddf7a64-1fe1-4ffa-948b-531359077eba</rdfs:label>
		<rdfs:comment>Mr. Vindman, a witness in the first Trump impeachment trial, failed to prove that Donald Trump Jr., Rudolph W. Giuliani and others had engaged in more than “political hackery,” the judge wrote.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9d70ec7c-4469-4070-b704-f06eb556d22a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-11-09"/>
