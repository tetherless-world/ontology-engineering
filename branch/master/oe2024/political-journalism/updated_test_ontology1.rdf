		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7a5ac8bb-de9e-4764-b8ab-7541e77a7d98">
		<rdfs:label>article-7a5ac8bb-de9e-4764-b8ab-7541e77a7d98</rdfs:label>
		<rdfs:comment>“Without MAGA, he would have lost by 15 points or more,” the former president said in a radio interview.</rdfs:comment>
