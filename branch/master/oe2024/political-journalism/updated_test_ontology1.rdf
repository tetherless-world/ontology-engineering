	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f3b5ce38-476f-40a1-90fe-9143bcc0231a">
		<rdfs:label>article-f3b5ce38-476f-40a1-90fe-9143bcc0231a</rdfs:label>
		<rdfs:comment>The Commerce and Treasury Departments put new restrictions on an array of companies and institutions that they said were misusing biotechnology.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6f60db0f-4977-4567-b7bd-9abe5d4a35e8"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-16"/>
