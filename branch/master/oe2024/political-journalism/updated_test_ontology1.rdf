		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-98f6611c-6ea8-469e-89a1-1d87533cfa10">
		<rdfs:label>article-98f6611c-6ea8-469e-89a1-1d87533cfa10</rdfs:label>
		<rdfs:comment>White House officials refused to say if all holdout Democrats in Congress had expressed support for the framework.</rdfs:comment>
