	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2ab09406-7e0d-4f33-b79f-0cb51c39ae9f">
		<rdfs:label>article-2ab09406-7e0d-4f33-b79f-0cb51c39ae9f</rdfs:label>
		<rdfs:comment>In Florida, where a quarter of the population is older than 60, Gov. Ron DeSantis has started to control public gatherings. But testing has been slow.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c27717ae-a4a7-43e2-a892-7d5659d97cf6"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ea9dbbc7-267d-46dd-9bad-620f876af0ba"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-18"/>
