	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-81e89665-4d72-42c7-9cf8-b57f6fcbbe0e">
		<rdfs:label>article-81e89665-4d72-42c7-9cf8-b57f6fcbbe0e</rdfs:label>
		<rdfs:comment>The hackers are accused of sending threatening messages to thousands of people after breaking into voter registration systems and a media company.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6f60db0f-4977-4567-b7bd-9abe5d4a35e8"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b6772619-716a-4e22-b807-36e658c83435"/>
