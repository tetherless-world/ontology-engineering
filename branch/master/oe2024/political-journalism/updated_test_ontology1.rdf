	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-aefb8921-888f-4f73-b73a-149bf5531047">
		<rdfs:label>article-aefb8921-888f-4f73-b73a-149bf5531047</rdfs:label>
		<rdfs:comment>The chairwoman of the Energy and Commerce health subcommittee said she planned to hold hearings on Rick Bright’s dismissal as the head of an agency helping to develop a coronavirus vaccine.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
