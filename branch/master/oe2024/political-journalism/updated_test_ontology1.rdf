		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-436f27ff-6441-46fc-9542-256257069fa7">
		<rdfs:label>article-436f27ff-6441-46fc-9542-256257069fa7</rdfs:label>
		<rdfs:comment>The Nigerian foreign minister said he learned about the ban just before a meeting with the United States to expand cooperation. But he said American officials had signaled it could soon be lifted.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f4f38f08-6492-4112-8b82-52bd8aa6b34f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-02-05"/>
