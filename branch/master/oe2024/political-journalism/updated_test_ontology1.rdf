	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-326f3092-37c8-4a18-a0af-d0431cef516c">
		<rdfs:label>article-326f3092-37c8-4a18-a0af-d0431cef516c</rdfs:label>
		<rdfs:comment>The Homeland Security Committee, which is looking into Hunter Biden and Ukraine’s role in the 2016 election, was told a former Ukrainian official could be spreading Russian disinformation.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9fcaaf17-51fe-4de9-aec7-f53a415e4396"/>
