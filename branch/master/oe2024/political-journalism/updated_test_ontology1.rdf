	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cc58398-6b47-4d61-b0af-0bde5015066f">
		<rdfs:label>article-7cc58398-6b47-4d61-b0af-0bde5015066f</rdfs:label>
		<rdfs:comment>The 13 Republican lawmakers who broke with their party to support a $1 trillion bipartisan public works bill have drawn anger and threats from their colleagues and constituents.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ce324a4b-e256-4143-b6b8-1dde4bc956af"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-10"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cc779c2-7aaa-4ad2-adc4-bf086c837016">
		<rdfs:label>article-7cc779c2-7aaa-4ad2-adc4-bf086c837016</rdfs:label>
		<rdfs:comment>The decision will lead to all but total bans on the procedure in about half of the states.</rdfs:comment>
