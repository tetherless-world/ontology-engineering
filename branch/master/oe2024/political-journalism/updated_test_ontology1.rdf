	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9f14de73-e844-43e3-b600-a24821944f1f">
		<rdfs:label>article-9f14de73-e844-43e3-b600-a24821944f1f</rdfs:label>
		<rdfs:comment>U.S. District Court Judge Emmet Sullivan will hear a challenge to the Justice Department’s surprise move to drop charges against President Trump’s former national security adviser Michael T. Flynn.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc2c2b47-32c2-43a0-8e5f-dd4e72335932"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-14"/>
