	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-70fb8f46-fa54-4870-869d-873ee45a455a">
		<rdfs:label>article-70fb8f46-fa54-4870-869d-873ee45a455a</rdfs:label>
		<rdfs:comment>Organizers said the police response had dampened turnout for the “Justice for J6” rally, which served as a platform for pro-Trump politicians seeking House seats next year.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-803bdb8f-8c3c-4210-80c9-22b0af3fd2ba"/>
