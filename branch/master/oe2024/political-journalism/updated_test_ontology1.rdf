	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4969fac-55d6-49a8-99e7-f4744e82ba5e">
		<rdfs:label>article-a4969fac-55d6-49a8-99e7-f4744e82ba5e</rdfs:label>
		<rdfs:comment>Joe Biden is playing down expectations in New Hampshire. How much would a loss hurt?</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5298104c-81c8-4a22-af1d-23823869871b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-02-11"/>
