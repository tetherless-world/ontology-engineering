		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-f7d54296-4f6d-4656-bd4e-ce98de1cb5ba"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-23"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c0e10571-e23c-45e7-8a74-87c24994befe">
		<rdfs:label>article-c0e10571-e23c-45e7-8a74-87c24994befe</rdfs:label>
		<rdfs:comment>The accusations came as other elements of the federal government moved to head off a broader wave of infections like those in China.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-922ad7b9-e6de-456a-9bc2-69207748d175"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c67a9047-7b94-4e45-aaa9-c820c2b967de"/>
