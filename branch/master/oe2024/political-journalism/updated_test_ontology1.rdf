	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f1ab6639-0880-4e99-92ff-7f140d5a838f">
		<rdfs:label>article-f1ab6639-0880-4e99-92ff-7f140d5a838f</rdfs:label>
		<rdfs:comment>The man who opened fire on a Taiwanese congregation in Laguna Woods, Calif., killing one and injuring five, was motivated by political hatred, the Orange County Sheriff said.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-10ac2d2b-df6f-4f6e-81ed-6043c29aa826"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
