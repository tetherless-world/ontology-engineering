	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e9a6a09c-edd2-4653-a7ad-d4593c8deeb8">
		<rdfs:label>article-e9a6a09c-edd2-4653-a7ad-d4593c8deeb8</rdfs:label>
		<rdfs:comment>Not sure if you can vote? Or where to cast your ballot? Here’s what to know about voting in Maine.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a5fb0ba0-4965-4f76-8b52-d16ac9dac194"/>
