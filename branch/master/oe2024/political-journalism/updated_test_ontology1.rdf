	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3d6e92f2-c87e-42cb-8ea7-e0e405d1002f">
		<rdfs:label>article-3d6e92f2-c87e-42cb-8ea7-e0e405d1002f</rdfs:label>
		<rdfs:comment>The gift will help Morgan State University, a historically Black college, finance scholarships for financially needy students.</rdfs:comment>
