	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d8779b8f-ce60-4115-97a8-b9bc745f0bbb">
		<rdfs:label>article-d8779b8f-ce60-4115-97a8-b9bc745f0bbb</rdfs:label>
		<rdfs:comment>Humans pumped 36 billion tons of the planet-warming gas into the atmosphere in 2021, more than in any previous year. It comes from burning oil, gas and coal.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e17310c8-39f3-4c91-8224-a91b0b94e409"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-03"/>
