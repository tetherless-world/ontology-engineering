	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-54e509fb-1a2a-4aa8-903e-945ce72e4061">
		<rdfs:label>article-54e509fb-1a2a-4aa8-903e-945ce72e4061</rdfs:label>
		<rdfs:comment>Bree Newsome Bass was arrested after climbing a flagpole at the South Carolina State Capitol. Now, she sees more people moved to act for similar reasons.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5f497c4d-378e-4c6b-a1e7-70ebd6812d68"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-14"/>
