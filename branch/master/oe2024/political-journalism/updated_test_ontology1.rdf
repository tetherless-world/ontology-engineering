		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f02dd845-49c4-47cb-a300-ac9e7a1c7065">
		<rdfs:label>article-f02dd845-49c4-47cb-a300-ac9e7a1c7065</rdfs:label>
		<rdfs:comment>The bill includes billions in tax credits for the production of renewable energy, drug-pricing reforms and a boost for the I.R.S.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b1afb246-66b2-4eea-8ebc-1b5c7f6c7900"/>
