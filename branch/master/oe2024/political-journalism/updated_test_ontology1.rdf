	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3277b655-a0a5-47e6-ad6d-3cd39d192df2">
		<rdfs:label>article-3277b655-a0a5-47e6-ad6d-3cd39d192df2</rdfs:label>
		<rdfs:comment>Could Democrats be heading for a landslide in November?</rdfs:comment>
