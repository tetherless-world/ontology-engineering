	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0c4a3f70-bffb-4fc5-98d5-54bae96392da">
		<rdfs:label>article-0c4a3f70-bffb-4fc5-98d5-54bae96392da</rdfs:label>
		<rdfs:comment>Prosecutors said they would not object if Judge Raymond J. Dearie of the Federal District Court in Brooklyn is appointed to review the sensitive documents seized from Mar-a-Lago.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-09-13"/>
