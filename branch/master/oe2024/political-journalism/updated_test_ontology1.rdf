	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2376438c-8273-4c34-9928-d5402b024ea4">
		<rdfs:label>article-2376438c-8273-4c34-9928-d5402b024ea4</rdfs:label>
		<rdfs:comment>As a Supreme Court case on college admissions nears, the California and Michigan university systems say their efforts to build diverse classes have hardly worked.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-21d856ad-a6ae-406e-a9e4-9707218ad815"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-26"/>
