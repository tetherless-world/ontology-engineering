	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d7c6703-3630-4fde-9779-a9790ea0fd5a">
		<rdfs:label>article-1d7c6703-3630-4fde-9779-a9790ea0fd5a</rdfs:label>
		<rdfs:comment>Mr. Trump dramatically escalated his effort to undermine public confidence in the integrity of the election.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7479f929-0522-4f1f-a391-dcdb5f4e726c"/>
