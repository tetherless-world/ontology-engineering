		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-26"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7ac8a7b9-17a9-408f-9a9b-7e22ba347c7f">
		<rdfs:label>article-7ac8a7b9-17a9-408f-9a9b-7e22ba347c7f</rdfs:label>
		<rdfs:comment>The annual celebration has been subdued by pandemic restrictions. “We’re trying to be responsible and feel like New Orleans, but it’s a struggle,” one bar employee said.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0cc8020e-7db7-428c-8db7-36cf2f5c4168"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6dadb73c-5b4c-4b58-be0a-fb2ab99cdfa1"/>
