		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b4390fd4-ede8-4830-8a56-5d3d30e35f39">
		<rdfs:label>article-b4390fd4-ede8-4830-8a56-5d3d30e35f39</rdfs:label>
		<rdfs:comment>More than half of California’s nearly 40 million residents live in counties now under the most restrictive measures for businesses and public gatherings.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
