	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b8aa15ea-1cfa-4d3a-aeef-b14e88136c61">
		<rdfs:label>article-b8aa15ea-1cfa-4d3a-aeef-b14e88136c61</rdfs:label>
		<rdfs:comment>Donald J. Trump, sitting on a huge campaign war chest, is eyeing a raft of television ads to help Republican candidates in the midterm elections, people familiar with the talks say.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d8482953-a125-4fa7-a4ef-dc645e3472e1"/>
