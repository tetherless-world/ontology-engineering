	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-df584ffb-f822-49b7-b532-a17aff289acd">
		<rdfs:label>article-df584ffb-f822-49b7-b532-a17aff289acd</rdfs:label>
		<rdfs:comment>A day after Michigan’s 16 electoral votes formally went to President-elect Joseph R. Biden Jr., a voting machine manufacturer told state senators that he stood by his company’s work, and shot down unfounded allegations that the results may have been manipulated.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-44926325-5c4f-4e18-89e5-b1470d62842c"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-15"/>
