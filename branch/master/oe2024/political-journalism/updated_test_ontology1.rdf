		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8814c511-6f1d-4ea4-a2b6-663aa69a52a0">
		<rdfs:label>article-8814c511-6f1d-4ea4-a2b6-663aa69a52a0</rdfs:label>
		<rdfs:comment>Last weekend was one of Seattle’s snowiest on record.</rdfs:comment>
