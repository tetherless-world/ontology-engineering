		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-05"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-564a2a60-e9df-48a7-ad3b-6a7affbc4741">
		<rdfs:label>article-564a2a60-e9df-48a7-ad3b-6a7affbc4741</rdfs:label>
		<rdfs:comment>Senate wrangling and presidential promises: This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-23"/>
