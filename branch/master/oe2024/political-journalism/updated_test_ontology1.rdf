		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-46b2f3e2-fc43-4d1f-8134-a17365f8ec33"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e4bddf24-bea8-4733-afa3-32262dd581ce">
		<rdfs:label>article-e4bddf24-bea8-4733-afa3-32262dd581ce</rdfs:label>
		<rdfs:comment>The president-elect has to wear it because of the hairline fractures in his right foot he suffered while playing with a German shepherd shelter dog named Major over the weekend.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e4be83ef-6a9f-44f8-a0f5-f991af7494c9">
		<rdfs:label>article-e4be83ef-6a9f-44f8-a0f5-f991af7494c9</rdfs:label>
		<rdfs:comment>Navy officials insist that they are doing everything short of Saran-wrapping the ship to try to keep it virus-free.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3bea54bd-f3ee-4712-b704-2739e55e376e"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-46b2f3e2-fc43-4d1f-8134-a17365f8ec33"/>
