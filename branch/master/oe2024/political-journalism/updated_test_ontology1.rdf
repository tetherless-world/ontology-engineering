	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4a19f121-226b-4526-a4d5-a083653077a9">
		<rdfs:label>article-4a19f121-226b-4526-a4d5-a083653077a9</rdfs:label>
		<rdfs:comment>The president has tested positive for the coronavirus and is isolated at the White House for the time being. Aides said he has “mild symptoms” but much remains unknown.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-922ad7b9-e6de-456a-9bc2-69207748d175"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-02"/>
