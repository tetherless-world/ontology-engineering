		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e2bd88ff-adb2-4d32-a886-0669c6205d94">
		<rdfs:label>article-e2bd88ff-adb2-4d32-a886-0669c6205d94</rdfs:label>
		<rdfs:comment>The move put the Biden administration in the position of defending the secrecy of a memo related to the disputed decision to clear President Donald J. Trump.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
