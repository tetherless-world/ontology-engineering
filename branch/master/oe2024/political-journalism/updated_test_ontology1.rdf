	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-923a2fdc-822d-474c-8977-1b1c6c84d69a">
		<rdfs:label>article-923a2fdc-822d-474c-8977-1b1c6c84d69a</rdfs:label>
