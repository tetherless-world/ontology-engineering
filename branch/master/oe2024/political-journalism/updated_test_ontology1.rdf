	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-efb24bb1-baeb-4bf9-957b-99a156f7ba97">
		<rdfs:label>article-efb24bb1-baeb-4bf9-957b-99a156f7ba97</rdfs:label>
		<rdfs:comment>The settlement, which includes insurance companies, developers and other defendants, comes nearly a year after the tragedy killed 98 people.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-10ac2d2b-df6f-4f6e-81ed-6043c29aa826"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
