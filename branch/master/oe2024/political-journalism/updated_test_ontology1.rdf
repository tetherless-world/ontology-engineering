		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2a89d171-d9b7-461f-9496-98cb49d2cbe9">
		<rdfs:label>article-2a89d171-d9b7-461f-9496-98cb49d2cbe9</rdfs:label>
		<rdfs:comment>The president’s interest in the case of Austin Tice, a journalist who went missing in Syria in 2012, prompted the C.I.A. to renew its focus on finding him.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3a4b0b1a-f7a7-498e-8805-48a907d13871"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6f60db0f-4977-4567-b7bd-9abe5d4a35e8"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
