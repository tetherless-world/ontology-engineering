	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e2b55869-fd5e-4874-8d65-8fca0105590f">
		<rdfs:label>article-e2b55869-fd5e-4874-8d65-8fca0105590f</rdfs:label>
