	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f12ea7c6-029e-4539-84b8-772dc451a1e9">
		<rdfs:label>article-f12ea7c6-029e-4539-84b8-772dc451a1e9</rdfs:label>
		<rdfs:comment>Two of the victims were hospitalized with life-threatening injuries, the authorities said. The shooting occurred at a campus in the Bay Area that houses several schools.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-bc861102-55e0-4752-9370-ad6d58043db1"/>
