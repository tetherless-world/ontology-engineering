	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f4db118f-5751-4ae3-9c8b-b77bcac4ea5e">
		<rdfs:label>article-f4db118f-5751-4ae3-9c8b-b77bcac4ea5e</rdfs:label>
		<rdfs:comment>Mike Garcia, who won the endorsement of President Trump, flipped California’s 25th Congressional District after Representative Katie Hill, a Democrat, resigned last year.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9c6cc67a-b3c2-45c5-af7a-92a423ab1249"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-13"/>
