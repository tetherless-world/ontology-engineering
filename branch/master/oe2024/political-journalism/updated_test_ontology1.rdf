	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e0387b13-9af8-4d0e-9417-a8c8df32d560">
		<rdfs:label>article-e0387b13-9af8-4d0e-9417-a8c8df32d560</rdfs:label>
		<rdfs:comment>An evolving virus and 18 months of ever-changing pandemic messaging have left Americans angry, exhausted and skeptical of public health advice.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f6de486-2c48-474d-84c4-ae7a2ad3d34b"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
