		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-827bcf91-3f3f-4741-8bc3-5f90c6d14689">
		<rdfs:label>article-827bcf91-3f3f-4741-8bc3-5f90c6d14689</rdfs:label>
		<rdfs:comment>Justice Ginsburg’s death on Friday night plunged Washington into what is certain to be a fierce clash as liberals seek to stop President Trump and the Republican-led Senate from confirming a replacement before Inauguration Day.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-19"/>
