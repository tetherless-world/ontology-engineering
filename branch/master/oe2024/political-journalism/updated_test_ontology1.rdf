		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-498acc59-0946-42f5-b615-afda38fe3566">
		<rdfs:label>article-498acc59-0946-42f5-b615-afda38fe3566</rdfs:label>
		<rdfs:comment>Six states and the District of Columbia sued the Postal Service and the postmaster general on Friday, alleging that recent operational and policy changes were illegal and “designed to undermine” the agency’s ability to operate effectively as millions of Americans plan to vote by mail during the pandemic.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-86cb289f-07a2-4230-a325-a1b201d41c50"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8a614115-3578-4c7f-b70a-6cdd9b0a4f3d"/>
