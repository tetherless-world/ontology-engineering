	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-702a20d9-cb55-426b-92af-4a55b294d409">
		<rdfs:label>article-702a20d9-cb55-426b-92af-4a55b294d409</rdfs:label>
		<rdfs:comment>Even before the snow began falling in New York City on Wednesday afternoon, the Department of Sanitation had turned away from its daily trash collecting and toward the plowing of the city’s 6,300 miles of streets.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-bd483682-8f72-4ada-ac78-c94354fc563f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-702b36f9-c7d4-4f96-baf2-ef02651eae94">
		<rdfs:label>article-702b36f9-c7d4-4f96-baf2-ef02651eae94</rdfs:label>
