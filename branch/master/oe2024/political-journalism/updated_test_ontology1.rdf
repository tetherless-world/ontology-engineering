	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a0e3352-bae3-4586-8644-e2fe62415c7e">
		<rdfs:label>article-1a0e3352-bae3-4586-8644-e2fe62415c7e</rdfs:label>
		<rdfs:comment>See elephant seals, visit a gold rush town and more.</rdfs:comment>
