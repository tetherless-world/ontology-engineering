	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e9a865f9-f6d4-4414-9768-827a9a3c1c7a">
		<rdfs:label>article-e9a865f9-f6d4-4414-9768-827a9a3c1c7a</rdfs:label>
		<rdfs:comment>If all goes smoothly, the races could be called late Tuesday or early Wednesday. But that’s far from guaranteed.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d3a2df06-dc48-4fab-a9d1-d1d12442e2e1"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-05"/>
