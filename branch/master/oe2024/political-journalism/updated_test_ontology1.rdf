	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a5e04cb6-6a39-4bb0-b573-20cf0d0c0f6b">
		<rdfs:label>article-a5e04cb6-6a39-4bb0-b573-20cf0d0c0f6b</rdfs:label>
		<rdfs:comment>Thousands of Native American children attended U.S. boarding schools designed to “civilize the savage.” Many died. Many who lived are reclaiming their identity.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-37f61f7f-75e2-434f-ae69-a6fd4decb9eb"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-61c7f88d-22d2-4db1-b65d-cd967b328980"/>
