	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d714b858-2665-4ec6-8033-56c25b0fe233">
		<rdfs:label>article-d714b858-2665-4ec6-8033-56c25b0fe233</rdfs:label>
