		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8c49b8a2-e93e-41ef-8c6b-177a5cf27e94">
		<rdfs:label>article-8c49b8a2-e93e-41ef-8c6b-177a5cf27e94</rdfs:label>
		<rdfs:comment>President Trump will hold a funeral service for his younger brother, Robert, at the White House on Friday, three people familiar with the plans said.</rdfs:comment>
