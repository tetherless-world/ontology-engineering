		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc5a47b7-5e7e-4d58-8ee7-caaf2f703c6a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-29"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1f4967f1-1d5b-4201-a5fc-a7115cc1eb39">
		<rdfs:label>article-1f4967f1-1d5b-4201-a5fc-a7115cc1eb39</rdfs:label>
		<rdfs:comment>A surge in turnout from Georgia’s Black voters has powered the fortunes of the Rev. Raphael Warnock and Jon Ossoff, putting the Democrats within reach of flipping two Senate seats and winning control of the chamber.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-01-06"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
