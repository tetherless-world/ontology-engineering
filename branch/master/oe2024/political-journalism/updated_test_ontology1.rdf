		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-02-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0a0145fd-e378-4e5b-bd85-ec1d85182db2">
		<rdfs:label>article-0a0145fd-e378-4e5b-bd85-ec1d85182db2</rdfs:label>
		<rdfs:comment>Smog from factories and cars has led to more storms in the Atlantic Ocean, but fewer in the Pacific. A new study explains why.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e17310c8-39f3-4c91-8224-a91b0b94e409"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-11"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0a06e63e-358c-4eed-9b2e-9c49ac83e2c3">
		<rdfs:label>article-0a06e63e-358c-4eed-9b2e-9c49ac83e2c3</rdfs:label>
		<rdfs:comment>The unemployment insurance system needs a major overhaul.</rdfs:comment>
