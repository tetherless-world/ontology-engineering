		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e9da23f5-7e16-49ff-9e24-4b2c6bf10223">
		<rdfs:label>article-e9da23f5-7e16-49ff-9e24-4b2c6bf10223</rdfs:label>
		<rdfs:comment>A veteran public corruption and war-crimes prosecutor, Jack Smith will take over two Trump-related criminal investigations.</rdfs:comment>
