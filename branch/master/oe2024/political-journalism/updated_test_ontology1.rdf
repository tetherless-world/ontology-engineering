		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-27"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-fb937153-1c3a-43a8-9624-8623068ec84e">
		<rdfs:label>article-fb937153-1c3a-43a8-9624-8623068ec84e</rdfs:label>
		<rdfs:comment>It comes two days before an outside advisory committee of experts is scheduled to meet to recommend whether or not the agency should approve the company’s request.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
