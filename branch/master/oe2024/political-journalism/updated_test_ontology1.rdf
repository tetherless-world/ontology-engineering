		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6ac2ba1f-92bd-41e1-939b-d4d7e5487084"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-05"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d9c64a41-798e-496c-80c6-e2e90989e831">
		<rdfs:label>article-d9c64a41-798e-496c-80c6-e2e90989e831</rdfs:label>
		<rdfs:comment>The justices, who will hear arguments on Monday in two cases challenging the state’s near-total ban, required the parties to file their briefs with extraordinary speed.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-10-27"/>
