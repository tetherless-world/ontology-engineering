		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a0f98979-35a0-4e5d-9a0b-7001488f04c9">
		<rdfs:label>article-a0f98979-35a0-4e5d-9a0b-7001488f04c9</rdfs:label>
		<rdfs:comment>Representative Kevin McCarthy, the minority leader, prolonged debate with a record-breaking speech of more than eight hours, attacking Democrats and veering from G.O.P. talking points to personal anecdotes.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-803bdb8f-8c3c-4210-80c9-22b0af3fd2ba"/>
