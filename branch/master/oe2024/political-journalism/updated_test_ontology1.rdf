	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b45ac7f6-d91c-47ea-b5d1-03d0f774f52d">
		<rdfs:label>article-b45ac7f6-d91c-47ea-b5d1-03d0f774f52d</rdfs:label>
		<rdfs:comment>Democratic state leaders from California to New Jersey are demanding immediate action after the Uvalde shooting.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-94edf185-50a8-4071-bd51-9f26c711d174"/>
