	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4b2b8171-6571-4348-9ff2-8ba1060233ff">
		<rdfs:label>article-4b2b8171-6571-4348-9ff2-8ba1060233ff</rdfs:label>
		<rdfs:comment>President Trump accused doctors of trying to profit from coronavirus deaths and mocked the Fox News host Laura Ingraham for wearing a mask as she attended his first campaign rally of the day in Michigan on Friday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-30"/>
