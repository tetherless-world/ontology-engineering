		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc2c2b47-32c2-43a0-8e5f-dd4e72335932"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-01-09"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c223afc4-e8be-46e9-801d-8000318fcff3">
		<rdfs:label>article-c223afc4-e8be-46e9-801d-8000318fcff3</rdfs:label>
		<rdfs:comment>A policy has not been set. But nursing home residents and health care workers would most likely be first in line.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
