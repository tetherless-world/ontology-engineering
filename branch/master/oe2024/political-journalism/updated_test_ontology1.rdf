	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ffd7641a-e194-4d84-a1ba-ea539a78ddff">
		<rdfs:label>article-ffd7641a-e194-4d84-a1ba-ea539a78ddff</rdfs:label>
		<rdfs:comment>Democrats in the state had urged the justices to reinstate a federal trial judge’s order based on the 26th Amendment, which bars voting discrimination based on age.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-26"/>
