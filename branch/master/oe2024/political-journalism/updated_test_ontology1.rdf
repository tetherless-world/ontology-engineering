		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2c57565a-d446-4893-8392-60392ba9ac6c">
		<rdfs:label>article-2c57565a-d446-4893-8392-60392ba9ac6c</rdfs:label>
		<rdfs:comment>Moderna will ask federal regulators to increase the amount of coronavirus vaccine it can put in each vial by as much as 50 percent, potentially bolstering availability quickly.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3263b980-a580-440f-bdd2-6d7fa7bb3fab"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e4ac7a5-be1a-4937-b91e-66276e5f8dd9"/>
