	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-00657b31-f835-4897-9f31-5e30dc930caa">
		<rdfs:label>article-00657b31-f835-4897-9f31-5e30dc930caa</rdfs:label>
		<rdfs:comment>Providing more aid to struggling governments has become one of the biggest issues tangling up the debate over another pandemic rescue package.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-19a7fb6b-a5ad-4f65-8d9c-b053a6ce8ab9"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4b06f805-a6f6-4cda-9908-3f8ddd3a0432"/>
