		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ed93c007-2d69-4f47-b063-4bedbd2bc075">
		<rdfs:label>article-ed93c007-2d69-4f47-b063-4bedbd2bc075</rdfs:label>
		<rdfs:comment>The Biden campaign has trumpeted its success with small donations, but in the last six months it has raised almost $200 million from donors who gave at least $100,000. As sums have grown, transparency has diminished.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-20"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ed9810e5-3101-42a7-965b-e16344813849">
		<rdfs:label>article-ed9810e5-3101-42a7-965b-e16344813849</rdfs:label>
		<rdfs:comment>The coronavirus threat is global. So is the remedy.</rdfs:comment>
