	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-dad874a7-7335-4f94-84c6-7983963d5c1a">
		<rdfs:label>article-dad874a7-7335-4f94-84c6-7983963d5c1a</rdfs:label>
		<rdfs:comment>A review of the Democratic presidential candidate’s reported assets calls into question his claims that he no longer has investments in oil, gas and coal.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-be4afe5b-5317-4441-a7de-57071d96016d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-01-23"/>
