	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6fff98c0-fb4a-4f5e-b3af-32c8d9ef3d7e">
		<rdfs:label>article-6fff98c0-fb4a-4f5e-b3af-32c8d9ef3d7e</rdfs:label>
		<rdfs:comment>Ms. Ross was called on by the prosecution to testify on Thursday.</rdfs:comment>
