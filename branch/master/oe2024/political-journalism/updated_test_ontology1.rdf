	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-88046022-515e-418b-9637-40e660f25554">
		<rdfs:label>article-88046022-515e-418b-9637-40e660f25554</rdfs:label>
		<rdfs:comment>Democrats acted over unified Republican opposition to push through an emergency pandemic aid plan that included a vast expansion of the country’s social safety net.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-03-10"/>
