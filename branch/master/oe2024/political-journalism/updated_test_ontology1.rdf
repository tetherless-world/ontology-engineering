		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0d7883f7-14fb-45a7-8aae-a9349660f0ad">
		<rdfs:label>article-0d7883f7-14fb-45a7-8aae-a9349660f0ad</rdfs:label>
		<rdfs:comment>Senior lawyers for the Trump campaign set up a small law firm last year that is working for Marjorie Taylor Greene, a Republican House candidate in Georgia with a history of promoting QAnon, a pro-Trump conspiracy theory.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ac748b00-7205-45e9-ba20-53ddfa903a7f"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-16"/>
