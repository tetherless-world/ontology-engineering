	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f958a302-48b0-4486-8d29-a6035856323b">
		<rdfs:label>article-f958a302-48b0-4486-8d29-a6035856323b</rdfs:label>
		<rdfs:comment>A liberal challenger’s surprise triumph over a Trump-backed incumbent demonstrated strong turnout and vote-by-mail efforts for the Democrats in a key general election state.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-04-13"/>
