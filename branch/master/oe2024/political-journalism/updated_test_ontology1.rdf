	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-fb66ab7c-f4d9-4ce5-b2e8-3272057bc1e0">
		<rdfs:label>article-fb66ab7c-f4d9-4ce5-b2e8-3272057bc1e0</rdfs:label>
		<rdfs:comment>When coronavirus cases rose in New Jersey, Matt Klapper, a former firefighter and ambulance crew chief, answered a call for retired medical workers to help out.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-5298104c-81c8-4a22-af1d-23823869871b"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-07"/>
