		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1a0856ad-2d07-4ff4-b13e-555e74a55048">
		<rdfs:label>article-1a0856ad-2d07-4ff4-b13e-555e74a55048</rdfs:label>
		<rdfs:comment>Los Angeles County on Sunday became the first major county to revert to requiring masks for all people indoors in public spaces.</rdfs:comment>
