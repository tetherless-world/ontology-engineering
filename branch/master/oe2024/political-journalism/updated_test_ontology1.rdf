		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1d52ffd2-465b-4f09-ae1d-cebdb9dc69fd">
		<rdfs:label>article-1d52ffd2-465b-4f09-ae1d-cebdb9dc69fd</rdfs:label>
		<rdfs:comment>The testing is meant to forestall universal quarantining at the isolated U.S. naval base in Cuba, which would complicate upcoming hearings in terrorism cases.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4bd6cfaa-ebec-415a-8c53-2870f770bfa7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-05"/>
