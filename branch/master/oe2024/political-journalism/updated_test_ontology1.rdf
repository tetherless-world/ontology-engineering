	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2bfbb810-2f0c-492a-aebd-e1497229dd4c">
		<rdfs:label>article-2bfbb810-2f0c-492a-aebd-e1497229dd4c</rdfs:label>
		<rdfs:comment>Alex M. Azar II has long been seen as a difficult personality in President Trump’s cabinet, but the pandemic has heightened personal clashes, putting him on thin ice.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e4ac7a5-be1a-4937-b91e-66276e5f8dd9"/>
