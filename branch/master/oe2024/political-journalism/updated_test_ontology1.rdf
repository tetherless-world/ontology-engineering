	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-49d325a1-ca76-46de-bbbf-2793e4100a6c">
		<rdfs:label>article-49d325a1-ca76-46de-bbbf-2793e4100a6c</rdfs:label>
		<rdfs:comment>Tonight’s debate could also be a critical test for Michael Bloomberg. This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-02-25"/>
