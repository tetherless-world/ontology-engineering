		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6f472ef3-227c-48bf-9f87-7ea950a50b39">
		<rdfs:label>article-6f472ef3-227c-48bf-9f87-7ea950a50b39</rdfs:label>
		<rdfs:comment>We want to hear from you.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b88bbe6e-8f2c-4db2-8047-26dad883cc72"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-01-06"/>
