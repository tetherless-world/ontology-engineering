		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-04b42070-c549-464c-8027-cc6dab0fbe44">
		<rdfs:label>article-04b42070-c549-464c-8027-cc6dab0fbe44</rdfs:label>
		<rdfs:comment>Two Britons accused of involvement in the kidnapping and torture of American hostages were brought to the United States to face charges more than two years after they were captured in Syria.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
