	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bd12ed3a-259d-4a5b-8930-1f8180c69227">
		<rdfs:label>article-bd12ed3a-259d-4a5b-8930-1f8180c69227</rdfs:label>
		<rdfs:comment>The officer was struck with a fire extinguisher as the violence unfolded.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3a4b0b1a-f7a7-498e-8805-48a907d13871"/>
