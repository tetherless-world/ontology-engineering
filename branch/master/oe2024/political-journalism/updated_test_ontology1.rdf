	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7a5d85a5-52fe-45d5-beff-22d29e7b61ce">
		<rdfs:label>article-7a5d85a5-52fe-45d5-beff-22d29e7b61ce</rdfs:label>
		<rdfs:comment>Judge Bruce Schroeder&apos;s longevity is a subject of frequent conversation in the courtroom. </rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d0d7757-313d-444e-a4df-32876c51aaa0"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-11-02"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
