		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-27"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e8640c03-34c2-488c-b641-b01d50ac9bac">
		<rdfs:label>article-e8640c03-34c2-488c-b641-b01d50ac9bac</rdfs:label>
		<rdfs:comment>The revolution in digital money is now moving into banking, as cryptocurrency starts to reshape the way people borrow and save.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2098993a-1d86-4c6d-b5b9-c15f8e12852e"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9f9cc56c-65dd-4b26-8e31-cb0c48bf78ea"/>
