	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-bf3a73d8-f778-43d7-9186-c1d5d90ef88a">
		<rdfs:label>article-bf3a73d8-f778-43d7-9186-c1d5d90ef88a</rdfs:label>
		<rdfs:comment>One Florida lawmaker suggested amending state laws regarding federal agencies.</rdfs:comment>
