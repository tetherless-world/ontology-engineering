		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-130067cc-5b89-4e81-a464-7963322c223b">
		<rdfs:label>article-130067cc-5b89-4e81-a464-7963322c223b</rdfs:label>
		<rdfs:comment>There were militia flags and banners of extremist groups, as well as absurd images of dinosaurs and comic book logos that belied the violence that was to unfold.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-bd6dc076-a1a0-4152-9f20-ce7eece97d34"/>
