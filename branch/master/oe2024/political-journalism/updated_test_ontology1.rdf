		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5e730091-570b-46fc-b560-1b909e6c77d5">
		<rdfs:label>article-5e730091-570b-46fc-b560-1b909e6c77d5</rdfs:label>
		<rdfs:comment>It was the state’s first lethal injection since 2015, when it halted executions after using the wrong drug in one instance and allowing a prisoner to regain consciousness in another.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
