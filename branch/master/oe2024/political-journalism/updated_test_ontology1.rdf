	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8ffd9488-d7bd-494b-baae-733c6f09c6b6">
		<rdfs:label>article-8ffd9488-d7bd-494b-baae-733c6f09c6b6</rdfs:label>
		<rdfs:comment>The Environmental Protection Agency found that water at a mobile home park that mostly serves agricultural workers contained almost 10 times the allowable limit of arsenic. But housing alternatives are hard to find.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-31e959fb-13d6-45f7-844b-19614018e182"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-738c55e5-1f96-4b93-8c70-fc8c1c8c9119"/>
