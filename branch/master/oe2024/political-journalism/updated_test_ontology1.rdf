	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-437d2413-de5e-47aa-9be5-8449a8f51b6c">
		<rdfs:label>article-437d2413-de5e-47aa-9be5-8449a8f51b6c</rdfs:label>
