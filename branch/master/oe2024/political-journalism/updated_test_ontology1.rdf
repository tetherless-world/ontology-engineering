	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-70c10ed1-1a81-4689-86f3-7c52301fd341">
		<rdfs:label>article-70c10ed1-1a81-4689-86f3-7c52301fd341</rdfs:label>
		<rdfs:comment>Did you apply for undergraduate admission for the fall 2020 semester? Did you write an essay about money, work or social class? We’d like to read it and perhaps publish it.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-aeb15aab-3e1b-43f1-b4e2-2196ef5076da"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-04"/>
