	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8c25acc1-f380-4149-bd44-858329d98a91">
		<rdfs:label>article-8c25acc1-f380-4149-bd44-858329d98a91</rdfs:label>
		<rdfs:comment>Jacob Chansley, who stormed onto the Senate floor in face paint and a horned hat, accepted a deal under which federal prosecutors will recommend a sentence of 41 to 51 months in prison.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-09-03"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
