	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8b31ca5f-f7b4-48f9-9bf0-f2e7df1a701d">
		<rdfs:label>article-8b31ca5f-f7b4-48f9-9bf0-f2e7df1a701d</rdfs:label>
		<rdfs:comment>Texts raised more questions about information suggesting that the United States ambassador to Ukraine was under surveillance.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9fcaaf17-51fe-4de9-aec7-f53a415e4396"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-01-18"/>
