		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-be4a3e54-4b34-4f4b-b446-90f3692a587d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-30"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2aa292f0-0fb5-4af0-98e8-c6b88c615d2d">
		<rdfs:label>article-2aa292f0-0fb5-4af0-98e8-c6b88c615d2d</rdfs:label>
		<rdfs:comment>An important metric for understanding the state of the U.S. coronavirus vaccine rollout took a dip on Tuesday. Should it be cause for concern?</rdfs:comment>
