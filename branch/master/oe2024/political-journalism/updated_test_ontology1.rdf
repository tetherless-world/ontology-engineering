	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b8c4136b-08b6-4c55-893a-bc417d37db77">
		<rdfs:label>article-b8c4136b-08b6-4c55-893a-bc417d37db77</rdfs:label>
		<rdfs:comment>Here are the key people who are part of the trial over the fatal shooting of Daunte Wright.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-17"/>
