	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-52638277-3ecf-4c3b-b544-6b837c530fcb">
		<rdfs:label>article-52638277-3ecf-4c3b-b544-6b837c530fcb</rdfs:label>
		<rdfs:comment>As the Supreme Court confirmation hearings begin for Judge Amy Coney Barrett, can President Trump cede the spotlight? And what is Democrats’ strategy?</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3488268a-8b17-411a-8185-6859abbab9a8"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-12"/>
