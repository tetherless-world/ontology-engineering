		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-23"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ddf13dd4-63f4-4969-aa2e-cb37342b44df">
		<rdfs:label>article-ddf13dd4-63f4-4969-aa2e-cb37342b44df</rdfs:label>
		<rdfs:comment>The White House is eager to project progress, but the public-private partnership it has created still faces scientific hurdles, internal tensions and questions from Congress.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e4ac7a5-be1a-4937-b91e-66276e5f8dd9"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b6772619-716a-4e22-b807-36e658c83435"/>
