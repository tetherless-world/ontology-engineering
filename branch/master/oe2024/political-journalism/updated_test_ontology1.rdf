	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-06cf4ae2-a119-4e0f-94d8-6aa00805a7bc">
		<rdfs:label>article-06cf4ae2-a119-4e0f-94d8-6aa00805a7bc</rdfs:label>
		<rdfs:comment>Sally made landfall near Gulf Shores, Ala., as a Category 2 hurricane and moved through the Florida Panhandle, bringing flooding even as it weakened to a tropical depression.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
