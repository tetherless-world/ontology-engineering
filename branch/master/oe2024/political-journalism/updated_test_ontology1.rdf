	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9fe53e73-81a7-41be-b7f1-291762632ca2">
		<rdfs:label>article-9fe53e73-81a7-41be-b7f1-291762632ca2</rdfs:label>
		<rdfs:comment>The West Virginia Democrat, a holdout on his party’s domestic agenda, said the package would reduce inflation, a concern he had cited in rejecting it just weeks ago.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6c995819-c171-430e-a414-f6167b134557"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
