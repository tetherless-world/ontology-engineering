		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c27bad97-1c10-4eaf-b4de-8593693da724">
		<rdfs:label>article-c27bad97-1c10-4eaf-b4de-8593693da724</rdfs:label>
		<rdfs:comment>More than 48,000 coronavirus cases were announced across the country and eight states announced single-day highs. Europe opens its doors — just not to Americans.</rdfs:comment>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-06-30"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
