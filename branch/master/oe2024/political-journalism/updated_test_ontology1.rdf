		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-8df9a8b3-89ab-49c7-8f46-4603629a5f25">
		<rdfs:label>article-8df9a8b3-89ab-49c7-8f46-4603629a5f25</rdfs:label>
		<rdfs:comment>John Eastman, the author of a memo that some in both parties liken to a blueprint for a coup, sent a hostile email to the vice president’s chief counsel as the mob attacked.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-a2860122-d5d8-4996-a4a4-bc29b03dbcd0"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-10-30"/>
