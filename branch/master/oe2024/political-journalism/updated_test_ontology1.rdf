		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-221e5fb5-d732-4f7f-98ae-3209b5108502">
		<rdfs:label>article-221e5fb5-d732-4f7f-98ae-3209b5108502</rdfs:label>
		<rdfs:comment>The agency had already made shots compulsory for frontline workers. The change will impact more than 200,000 additional workers.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-20ac5364-1758-414f-ab86-a88673954008"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-08-12"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
