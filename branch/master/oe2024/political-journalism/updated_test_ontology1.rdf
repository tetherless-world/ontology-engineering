		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-982bde63-8146-432c-a09a-c9cac220ddaa"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-07"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1ceb6a73-7417-45d7-9454-bb27ad9f2e11">
		<rdfs:label>article-1ceb6a73-7417-45d7-9454-bb27ad9f2e11</rdfs:label>
		<rdfs:comment>President Biden’s $2 trillion infrastructure proposal is a test of his belief that he can generate popular backing across the country as Republicans seek to block him on Capitol Hill.</rdfs:comment>
