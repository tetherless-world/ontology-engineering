	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c0e11188-3b0b-4509-b51c-ba2f7fb920e6">
		<rdfs:label>article-c0e11188-3b0b-4509-b51c-ba2f7fb920e6</rdfs:label>
		<rdfs:comment>The ruling sided with 20 state attorneys general who sued the Biden administration over guidelines on rights for gay and transgender workers and students.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ec43dee5-5d05-4d6a-870a-4730e5495b8e"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-07-18"/>
