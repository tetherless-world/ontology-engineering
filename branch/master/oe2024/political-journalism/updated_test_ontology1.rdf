		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2f7c4dc6-06c8-4140-b6e9-b0a61b41ce6f">
		<rdfs:label>article-2f7c4dc6-06c8-4140-b6e9-b0a61b41ce6f</rdfs:label>
		<rdfs:comment>Democrats laid the groundwork on Friday for impeaching President Trump a second time, as Speaker Nancy Pelosi of California threatened to bring him up on formal charges if he did not resign “immediately” over his role in inciting a violent mob attack on the Capitol this week.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-559d35dd-0818-4064-bd03-731b6c32d473"/>
