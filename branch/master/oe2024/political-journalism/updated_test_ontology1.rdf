		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-04-04"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03e43a18-3420-431a-a0d4-efea82bff82a">
		<rdfs:label>article-03e43a18-3420-431a-a0d4-efea82bff82a</rdfs:label>
		<rdfs:comment>The intelligence agencies missed massive intrusions by Russia and China, forcing the administration and Congress to look for solutions, including closer partnership with private industry.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-6f60db0f-4977-4567-b7bd-9abe5d4a35e8"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b6772619-716a-4e22-b807-36e658c83435"/>
