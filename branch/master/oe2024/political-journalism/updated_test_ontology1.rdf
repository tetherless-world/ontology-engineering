		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-06"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3b6bb04b-9c79-4bbd-be55-c59f6080af84">
		<rdfs:label>article-3b6bb04b-9c79-4bbd-be55-c59f6080af84</rdfs:label>
		<rdfs:comment>The New York Times would like to hear from workers who are unemployed or who lost hours, or business owners who have had to make changes in response to Covid-19.</rdfs:comment>
