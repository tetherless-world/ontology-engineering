	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b44c5d41-52dd-4ed1-b1ab-07ef9421ea64">
		<rdfs:label>article-b44c5d41-52dd-4ed1-b1ab-07ef9421ea64</rdfs:label>
		<rdfs:comment>President-elect Joseph R. Biden Jr. has presented an education agenda that is starkly different from the Trump era, beginning with a far more cautious approach to school reopenings.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b782e9c4-4c0a-4c6c-aa6e-ee0fb7623560"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-13"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
