	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d5a2ee6c-87bc-411f-b0f4-cfbb1118bdd4">
		<rdfs:label>article-d5a2ee6c-87bc-411f-b0f4-cfbb1118bdd4</rdfs:label>
