	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f64fb593-a840-488f-a031-8afc15f21297">
		<rdfs:label>article-f64fb593-a840-488f-a031-8afc15f21297</rdfs:label>
		<rdfs:comment>In a video recorded from his hospital bed, Mr. Blake, who was shot by the police, says, “It hurts to breathe; it hurts to sleep.”</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-09-07"/>
