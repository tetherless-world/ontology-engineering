		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-45052b87-b017-42c6-b523-157aaa37cf39">
		<rdfs:label>article-45052b87-b017-42c6-b523-157aaa37cf39</rdfs:label>
		<rdfs:comment>The president was surprised by the reaction to the White House’s decision to ask Congress to extend an eviction ban, leading to a 36-hour scramble to keep people in their homes.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
