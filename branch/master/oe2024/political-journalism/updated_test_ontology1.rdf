	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e6e483f3-499d-4cd3-871b-a94e89159812">
		<rdfs:label>article-e6e483f3-499d-4cd3-871b-a94e89159812</rdfs:label>
		<rdfs:comment>The gunman used a semiautomatic handgun that is essentially a shortened version of an AR-15-style rifle. He had purchased it legally six days before the attack.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b0d8acac-ba33-4091-b922-0eb5b9ab904d"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-e993acb7-fd71-489b-b569-b6b6d449dfe5"/>
