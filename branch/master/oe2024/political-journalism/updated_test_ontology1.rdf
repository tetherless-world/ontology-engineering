		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3b6ba6b3-7d8d-40a3-a5c1-c159de6c3d8e">
		<rdfs:label>article-3b6ba6b3-7d8d-40a3-a5c1-c159de6c3d8e</rdfs:label>
		<rdfs:comment>The University of Washington is moving to online classes for its 50,000 students. With colleges nationwide about to empty for spring break, students fear they might not be coming back.</rdfs:comment>
