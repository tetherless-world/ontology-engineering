	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2af9bd98-8234-43e6-a426-0e9cb0e4be9c">
		<rdfs:label>article-2af9bd98-8234-43e6-a426-0e9cb0e4be9c</rdfs:label>
		<rdfs:comment>Congress allocated $25 billion in December and another $21 billion in March to help people who fell behind on rent during the pandemic. Little has reached landlords or tenants.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9e94ebbb-365e-41ef-9a76-b300ca95c3d1"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-04-25"/>
