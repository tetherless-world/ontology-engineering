		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-11-19"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-77815c00-f370-4c32-b356-82b61ca301f5">
		<rdfs:label>article-77815c00-f370-4c32-b356-82b61ca301f5</rdfs:label>
		<rdfs:comment>The new president aims to signal a return to normalcy: This is your morning tip sheet.</rdfs:comment>
