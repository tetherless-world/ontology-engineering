		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-83ac9362-16cb-4942-bd26-7b6c7c474191">
		<rdfs:label>article-83ac9362-16cb-4942-bd26-7b6c7c474191</rdfs:label>
		<rdfs:comment>More than 130 countries agreed to set a minimum tax rate of 15 percent as governments look to end a race to the bottom on corporate taxation.</rdfs:comment>
