	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-49d166b6-5e10-47e5-913f-46070b3f9ff1">
		<rdfs:label>article-49d166b6-5e10-47e5-913f-46070b3f9ff1</rdfs:label>
		<rdfs:comment>A blunter Buttigieg, a waning trial, a dig at an ice cream shop: This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7d692afb-28e3-44b7-911c-3ff60f26b4c4"/>
