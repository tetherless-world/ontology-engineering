		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9b31850a-1112-4e13-9f6b-67afd3c17b58">
		<rdfs:label>article-9b31850a-1112-4e13-9f6b-67afd3c17b58</rdfs:label>
		<rdfs:comment>“I honestly can’t recall two independent events of such extreme importance occurring on the same day,” said one historian. “A good day,” said another.</rdfs:comment>
