		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-498c7314-76b7-4246-934e-2f8812c8200e">
		<rdfs:label>article-498c7314-76b7-4246-934e-2f8812c8200e</rdfs:label>
		<rdfs:comment>The court put the case on a fast track, calling for the Justice Department to file a petition seeking review by June 1.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-947ed571-ad87-49fb-b59a-9372d166d3c7"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-05-20"/>
