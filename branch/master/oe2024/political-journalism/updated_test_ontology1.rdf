		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0094e83d-b207-4ee6-b303-227fe407863f">
		<rdfs:label>article-0094e83d-b207-4ee6-b303-227fe407863f</rdfs:label>
		<rdfs:comment>Gen. Michael E. Langley is the first Black person to attain the highest rank in the corps, whose most senior leadership had until now consisted entirely of white men.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-46b2f3e2-fc43-4d1f-8134-a17365f8ec33"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-08-06"/>
