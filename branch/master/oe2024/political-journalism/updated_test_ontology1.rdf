		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-04-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4b3b2cb9-3210-4b9f-b819-deb5c840ba69">
		<rdfs:label>article-4b3b2cb9-3210-4b9f-b819-deb5c840ba69</rdfs:label>
		<rdfs:comment>The loyalty of the longtime Trump adviser Michael Caputo helped him secure a post as the top public affairs official at the Health and Human Services Department during the pandemic.</rdfs:comment>
