	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2ab5365c-47b1-468c-9757-ff168ca05236">
		<rdfs:label>article-2ab5365c-47b1-468c-9757-ff168ca05236</rdfs:label>
		<rdfs:comment>Julia Letlow, the wife of Representative-elect Luke Letlow, a Louisiana Republican who died of complications from Covid-19 days before he was to be sworn in, will seek the open seat in an upcoming special election.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7479f929-0522-4f1f-a391-dcdb5f4e726c"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-99c317df-85f6-43ae-a405-4e8c1bdcbc98"/>
