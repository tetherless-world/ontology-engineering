	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-acece5ad-0fe9-4f67-816e-bbfea6ff5909">
		<rdfs:label>article-acece5ad-0fe9-4f67-816e-bbfea6ff5909</rdfs:label>
