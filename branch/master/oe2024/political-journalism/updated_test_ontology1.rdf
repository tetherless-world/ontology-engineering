	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-db01ab8a-8cfd-461a-ab03-7b49217d185f">
		<rdfs:label>article-db01ab8a-8cfd-461a-ab03-7b49217d185f</rdfs:label>
		<rdfs:comment>Mr. Biden said he would pick a woman to be his vice presidential nominee. Here are several names in the mix, as well as factors on Mr. Biden’s mind.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
