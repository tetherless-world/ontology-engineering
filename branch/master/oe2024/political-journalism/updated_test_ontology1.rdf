		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5ca27aa8-eef7-415e-955c-01c7014701a7">
		<rdfs:label>article-5ca27aa8-eef7-415e-955c-01c7014701a7</rdfs:label>
		<rdfs:comment>The economic stabilization package includes more than $12 billion for housing and protection from evictions and foreclosures, as the pandemic hits cities already in housing crises.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-b6367e10-71fa-497b-a76c-07166686c06a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-26"/>
