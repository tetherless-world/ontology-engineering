	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ebf10ffe-bb77-4d21-ad78-351e5704b8c2">
		<rdfs:label>article-ebf10ffe-bb77-4d21-ad78-351e5704b8c2</rdfs:label>
