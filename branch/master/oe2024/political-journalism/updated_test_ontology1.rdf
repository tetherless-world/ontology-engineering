	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-3281a29e-1ed6-490c-9df9-e70b975e00ca">
		<rdfs:label>article-3281a29e-1ed6-490c-9df9-e70b975e00ca</rdfs:label>
		<rdfs:comment>President Biden’s Justice Department has ordered a moratorium on carrying out federal death sentences after a surge in executions under the Trump administration.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-86cb289f-07a2-4230-a325-a1b201d41c50"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-07-16"/>
