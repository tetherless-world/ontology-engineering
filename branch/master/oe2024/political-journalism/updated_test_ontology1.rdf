		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2dfb9687-35e1-4110-b376-96312dc5c059">
		<rdfs:label>article-2dfb9687-35e1-4110-b376-96312dc5c059</rdfs:label>
		<rdfs:comment>In a joint letter, news organizations warned that the indictment of Julian Assange “sets a dangerous precedent” that could chill reporting about matters of national security.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-010e943a-d70f-4929-8957-2d55ddf6a675"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-11-28"/>
