		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1cf2038e-29c5-4e85-8f7b-1aae351794f5">
		<rdfs:label>article-1cf2038e-29c5-4e85-8f7b-1aae351794f5</rdfs:label>
		<rdfs:comment>Alaska is the 22d state to announce plans to vaccinate nonresidents against the coronavirus.</rdfs:comment>
