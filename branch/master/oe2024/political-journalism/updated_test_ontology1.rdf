		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ba0b75e6-3ba9-41de-9f20-ce59f476172c">
		<rdfs:label>article-ba0b75e6-3ba9-41de-9f20-ce59f476172c</rdfs:label>
		<rdfs:comment>Casey DeSantis has led a state effort to raise money for relief efforts in Ian’s wake, appealing for donations during her husband’s news briefings.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-06"/>
