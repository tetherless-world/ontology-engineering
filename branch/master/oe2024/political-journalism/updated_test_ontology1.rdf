	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-f49fbde8-9b4e-4f1b-a671-e039b6f14f5b">
		<rdfs:label>article-f49fbde8-9b4e-4f1b-a671-e039b6f14f5b</rdfs:label>
