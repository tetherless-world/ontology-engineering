	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-14f2e287-44f8-45f0-a627-301867204173">
		<rdfs:label>article-14f2e287-44f8-45f0-a627-301867204173</rdfs:label>
		<rdfs:comment>The former president began pressuring his incoming acting attorney general even before announcing that his predecessor was stepping down, emails show.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd522e1c-57a0-49bc-9835-fae39d9d58a6"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-06-15"/>
