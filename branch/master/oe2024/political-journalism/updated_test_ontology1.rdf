		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c55cfad1-37a4-40de-ab47-b363a537db6a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-09-24"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d265454b-4957-4913-a7bc-8a672218faf9">
		<rdfs:label>article-d265454b-4957-4913-a7bc-8a672218faf9</rdfs:label>
		<rdfs:comment>Climate change is taking a toll on woodlands in the Northeast.</rdfs:comment>
