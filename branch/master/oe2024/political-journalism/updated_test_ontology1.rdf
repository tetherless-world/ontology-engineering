		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-23582331-ce67-491f-8ae1-725389fcde1f">
		<rdfs:label>article-23582331-ce67-491f-8ae1-725389fcde1f</rdfs:label>
		<rdfs:comment>After battering the New York area, the storm knocked out electricity to hundreds of thousands of customers across New England on Wednesday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-91caa243-6ff4-4c6d-affc-51bd8da8617d"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-10-27"/>
