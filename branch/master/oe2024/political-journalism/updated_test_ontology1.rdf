		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-06-24"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-0422398e-6590-44aa-944e-d22303975d51">
		<rdfs:label>article-0422398e-6590-44aa-944e-d22303975d51</rdfs:label>
		<rdfs:comment>The administration says the country must pivot away from fossil fuels but backed a project set to produce more than 100,000 barrels of oil each day for 30 years.</rdfs:comment>
