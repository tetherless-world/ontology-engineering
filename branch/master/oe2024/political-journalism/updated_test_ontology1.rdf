		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-03-29"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
