		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-34cc1d5f-a9e3-4758-9928-8286ea8eb7fe">
		<rdfs:label>article-34cc1d5f-a9e3-4758-9928-8286ea8eb7fe</rdfs:label>
		<rdfs:comment>The so-called Capitol Hill Organized Protest area was taken over by protesters after the death of George Floyd in Minneapolis. It was the site of at least four shootings last month.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-c76b9467-8722-42b2-8155-eaf44eec0864"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-07-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-34d60cf2-c8e5-43b3-bb0e-0384587c01f8">
		<rdfs:label>article-34d60cf2-c8e5-43b3-bb0e-0384587c01f8</rdfs:label>
		<rdfs:comment>It was the first time a president has held an East Room funeral for a member of his family in nearly 100 years.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd42dd7e-7a0d-4a74-908e-252de023edfb"/>
