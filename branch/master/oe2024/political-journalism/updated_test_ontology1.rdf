		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7c9023ec-89e3-48ea-921f-ac60afff3e12">
		<rdfs:label>article-7c9023ec-89e3-48ea-921f-ac60afff3e12</rdfs:label>
		<rdfs:comment>The boy was fatally shot in March after a police chase in Chicago’s Little Village neighborhood.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d0d7757-313d-444e-a4df-32876c51aaa0"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-59d54949-bf69-47d0-8cbf-2ad4120f202f"/>
