		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a0f08c59-5487-4ebf-9569-3f681e3e860e">
		<rdfs:label>article-a0f08c59-5487-4ebf-9569-3f681e3e860e</rdfs:label>
		<rdfs:comment>Mike Pence and Kamala Harris came ready to dance last night, and they had perfected their sidestep.</rdfs:comment>
