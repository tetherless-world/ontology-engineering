		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-1f000e85-d0db-40bc-ac34-02ff27a287a2">
		<rdfs:label>article-1f000e85-d0db-40bc-ac34-02ff27a287a2</rdfs:label>
		<rdfs:comment>Joe Biden’s claim of being arrested trying to see Nelson Mandela drew skepticism. His campaign called it a “separation.’’</rdfs:comment>
