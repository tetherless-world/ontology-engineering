		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5fa95ae7-fea3-4caf-8fb2-1d0cbf30dce5">
		<rdfs:label>article-5fa95ae7-fea3-4caf-8fb2-1d0cbf30dce5</rdfs:label>
		<rdfs:comment>Michael D. Shear, a longtime White House reporter for The New York Times, talks about recent staff turnover in the administration and frustration around the president.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e9c4025-7dbe-4808-a3d4-b9d25fa14354"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d9dd9624-a9f6-46b2-b101-110db9155c7d"/>
