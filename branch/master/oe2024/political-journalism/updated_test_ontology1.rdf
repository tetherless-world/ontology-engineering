		<rdfs:label>article-e9ebd435-a74c-470a-8449-50d5a4ec2a1e</rdfs:label>
		<rdfs:comment>President Biden looks to win support from moderates and emphasizes fiscal responsibility.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-011ddbd5-8a1e-4932-8bfc-bad05d0ca67f"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4b06f805-a6f6-4cda-9908-3f8ddd3a0432"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-03-28"/>
