	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-44fc3f94-defd-466d-927e-38cb818860ea">
		<rdfs:label>article-44fc3f94-defd-466d-927e-38cb818860ea</rdfs:label>
