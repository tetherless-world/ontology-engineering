	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9c8ce26b-93ce-4688-9c20-571eb17c41b4">
		<rdfs:label>article-9c8ce26b-93ce-4688-9c20-571eb17c41b4</rdfs:label>
