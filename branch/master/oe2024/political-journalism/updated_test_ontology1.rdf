	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-70c38362-6e93-4f19-b375-cf0322e4f73f">
		<rdfs:label>article-70c38362-6e93-4f19-b375-cf0322e4f73f</rdfs:label>
		<rdfs:comment>Galvanized in part by the deployment of federal agents in Portland, Ore., protesters have returned to the streets in Oakland, Seattle and elsewhere.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-0b1c0734-81f6-4bd6-ab6e-2c3d3239bc31"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
