	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-85db32b8-1670-4506-8b02-f52265a2df9b">
		<rdfs:label>article-85db32b8-1670-4506-8b02-f52265a2df9b</rdfs:label>
		<rdfs:comment>After lobbying by the governor, lawmakers adopted $54 billion in climate spending and voted to keep open the state’s last nuclear plant.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-d8148593-227b-4889-ae70-592b440737ae"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-09-01"/>
