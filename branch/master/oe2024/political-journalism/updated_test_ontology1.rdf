		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-88d80829-07c7-43ec-857d-f7f0f36f2222">
		<rdfs:label>article-88d80829-07c7-43ec-857d-f7f0f36f2222</rdfs:label>
		<rdfs:comment>Legal challenges are being prepared against the law, which is one of the most restrictive in the country and threatens doctors and nurses with up to 10 years in prison.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-fc5a47b7-5e7e-4d58-8ee7-caaf2f703c6a"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-04-08"/>
