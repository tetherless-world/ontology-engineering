	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-4c985a13-ab11-4645-ab34-bbb6b750d01e">
		<rdfs:label>article-4c985a13-ab11-4645-ab34-bbb6b750d01e</rdfs:label>
		<rdfs:comment>Neighbors of the president say he has violated the 1993 agreement he made with Palm Beach that allowed him to convert a private residence into a moneymaking club.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-16"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
