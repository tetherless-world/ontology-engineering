		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-ae5a6f02-a491-45f6-89ea-cbe772eb61bb">
		<rdfs:label>article-ae5a6f02-a491-45f6-89ea-cbe772eb61bb</rdfs:label>
		<rdfs:comment>The Golden State sent more competitors to the Beijing Games than any other state.</rdfs:comment>
