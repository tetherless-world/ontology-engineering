		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7b4d53ad-2eb1-4e49-895d-b9ca3fdd862b">
		<rdfs:label>article-7b4d53ad-2eb1-4e49-895d-b9ca3fdd862b</rdfs:label>
		<rdfs:comment>If the Supreme Court overturns Roe v. Wade, all 50 states will be free to set their own rules, leading to one America where access to an abortion is guaranteed and another where it is outlawed.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-922ad7b9-e6de-456a-9bc2-69207748d175"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-05-07"/>
