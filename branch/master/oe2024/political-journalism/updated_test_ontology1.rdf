		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-11-05"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2c0acbb1-41ca-4ef6-8e68-4435fef34d70">
		<rdfs:label>article-2c0acbb1-41ca-4ef6-8e68-4435fef34d70</rdfs:label>
		<rdfs:comment>Dr. Rochelle P. Walensky and Dr. Anthony S. Fauci cautioned that hospitalizations and deaths could be lagging behind case counts.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4e4ac7a5-be1a-4937-b91e-66276e5f8dd9"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-29"/>
