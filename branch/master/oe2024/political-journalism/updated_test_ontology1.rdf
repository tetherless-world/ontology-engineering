		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-10-10"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d4f73a0a-3e4a-41be-b30e-f3a1d7375151">
		<rdfs:label>article-d4f73a0a-3e4a-41be-b30e-f3a1d7375151</rdfs:label>
		<rdfs:comment>The earliest U.S. deaths publicly attributed to the virus had been on Feb. 26, when two people died in the Seattle area. Santa Clara County said an autopsy showed a Feb. 6 death was also related.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-2bfc1d86-f654-490c-ae5c-efaa41acbbe5"/>
