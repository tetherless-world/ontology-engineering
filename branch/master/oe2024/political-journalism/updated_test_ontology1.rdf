		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c3cb5104-13c8-4ea1-82b5-e2cf1dc6b2c8">
		<rdfs:label>article-c3cb5104-13c8-4ea1-82b5-e2cf1dc6b2c8</rdfs:label>
		<rdfs:comment>Exultant Republicans planned new bans. Democrats, who have struggled to rally around abortion rights, hoped a bruising Supreme Court loss could jolt their voters into action.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-45f2da0f-ff11-4bf4-a433-0a1b35060358"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
