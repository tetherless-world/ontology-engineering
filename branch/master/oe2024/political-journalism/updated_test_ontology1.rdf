		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-72b3801d-9e5c-4e8d-b91b-f1854df06164">
		<rdfs:label>article-72b3801d-9e5c-4e8d-b91b-f1854df06164</rdfs:label>
		<rdfs:comment>As cities try to cut back on traditional policing, Seattle has embarked on one of the nation’s most ambitious plans. The Black woman who leads the department is stepping down in frustration.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-becd702f-c674-4653-9a6c-90ee51977e85"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-11"/>
