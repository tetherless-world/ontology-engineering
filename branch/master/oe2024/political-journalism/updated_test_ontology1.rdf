		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e000d7dc-7f24-4b8f-8517-e4b40161377e">
		<rdfs:label>article-e000d7dc-7f24-4b8f-8517-e4b40161377e</rdfs:label>
		<rdfs:comment>The meeting was part of the White House’s efforts to push for an immigration reform bill in Congress.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-7479f929-0522-4f1f-a391-dcdb5f4e726c"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-05-14"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e00279be-bf49-460b-8337-0e020a47241b">
		<rdfs:label>article-e00279be-bf49-460b-8337-0e020a47241b</rdfs:label>
		<rdfs:comment>The Biden administration is fighting to preserve Title 42, a public health rule that turns back families at the border during the pandemic. But some have been allowed to stay in the United States, despite the rule.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dad1523a-f983-4f0f-af53-0061c7165e91"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-03"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e008c881-87dc-4bc6-bf99-675bcba5eb92">
		<rdfs:label>article-e008c881-87dc-4bc6-bf99-675bcba5eb92</rdfs:label>
		<rdfs:comment>Killings in Oregon and Wisconsin reverberate in the 2020 race: This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-31"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
