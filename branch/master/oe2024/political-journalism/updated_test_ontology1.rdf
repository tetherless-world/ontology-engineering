		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-788e797a-01d7-43bd-8d08-665d3203a408"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9c6bcf1d-e179-43a7-9f78-6139ef8f52e0"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-becd702f-c674-4653-9a6c-90ee51977e85"/>
