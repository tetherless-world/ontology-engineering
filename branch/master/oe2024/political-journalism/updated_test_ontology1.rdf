		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c5e2f3d8-2164-4875-b4fc-475488f40cea">
		<rdfs:label>article-c5e2f3d8-2164-4875-b4fc-475488f40cea</rdfs:label>
		<rdfs:comment>Scientists have been able to draw links between a warming planet and hurricanes, heat waves and droughts, but the same can’t be said for tornadoes yet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-912ab23e-cdd9-4a6c-8c3e-574664292078"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-12-11"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c5e3bb90-34f9-461e-8d2d-8090657ba069">
		<rdfs:label>article-c5e3bb90-34f9-461e-8d2d-8090657ba069</rdfs:label>
