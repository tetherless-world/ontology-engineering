		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-78d72a07-307b-4b8e-8d71-c44d13708e1b">
		<rdfs:label>article-78d72a07-307b-4b8e-8d71-c44d13708e1b</rdfs:label>
		<rdfs:comment>The announcement by the 2016 Democratic presidential nominee follows ones from Barack Obama, Bernie Sanders and Elizabeth Warren as the party tries to show its unity.</rdfs:comment>
