	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-818c10b4-bcf7-43b6-993e-e2d68faef56d">
		<rdfs:label>article-818c10b4-bcf7-43b6-993e-e2d68faef56d</rdfs:label>
		<rdfs:comment>But more than 100 inmates already have.</rdfs:comment>
