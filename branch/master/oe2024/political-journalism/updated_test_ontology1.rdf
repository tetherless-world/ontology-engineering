	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-5e23bad0-e581-4984-8dbb-658a86225550">
		<rdfs:label>article-5e23bad0-e581-4984-8dbb-658a86225550</rdfs:label>
