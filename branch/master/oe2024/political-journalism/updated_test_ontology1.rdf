		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-89181719-7eaa-4d17-8078-71ed19ab65fa">
		<rdfs:label>article-89181719-7eaa-4d17-8078-71ed19ab65fa</rdfs:label>
		<rdfs:comment>The United States is history’s largest emitter. China is today’s largest emitter.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ec0f6572-4696-4e2e-b261-57f3ee9a323f"/>
