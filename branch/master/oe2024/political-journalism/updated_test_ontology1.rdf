		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d8804f45-b9a7-409b-9fdd-15f6f1233c5f">
		<rdfs:label>article-d8804f45-b9a7-409b-9fdd-15f6f1233c5f</rdfs:label>
		<rdfs:comment>Monday: Officials in a California ski town worry about its role as an escape.</rdfs:comment>
