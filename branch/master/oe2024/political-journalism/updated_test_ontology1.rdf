		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-08-25"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-d53a9ddc-99d7-4652-a8a6-8041e3dea904">
		<rdfs:label>article-d53a9ddc-99d7-4652-a8a6-8041e3dea904</rdfs:label>
		<rdfs:comment>“The Room Where It Happened” describes Mr. Bolton’s 17 turbulent months at President Trump’s side through a multitude of crises and foreign policy challenges.</rdfs:comment>
