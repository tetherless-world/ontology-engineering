		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-e681d057-ae99-42bb-b29f-d2011c1cf4dc">
		<rdfs:label>article-e681d057-ae99-42bb-b29f-d2011c1cf4dc</rdfs:label>
		<rdfs:comment>Just over two weeks after Election Day, lawyers working with the Trump campaign set out a rationale for creating alternate slates of electors as part of an effort to buy time to overturn the results.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-90788841-2a13-4598-abd3-3b677caff4d4"/>
