	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-712183a3-950f-40e6-b83a-ae0e48678a00">
		<rdfs:label>article-712183a3-950f-40e6-b83a-ae0e48678a00</rdfs:label>
