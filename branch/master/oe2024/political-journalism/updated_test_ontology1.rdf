		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-2ddb8904-2504-4e5d-9f38-cc2934408627">
		<rdfs:label>article-2ddb8904-2504-4e5d-9f38-cc2934408627</rdfs:label>
		<rdfs:comment>Most presidents leave the White House and adopt low profiles. Donald Trump is returning to the national stage with a prominent appearance at a conservative conference on Sunday.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-27"/>
