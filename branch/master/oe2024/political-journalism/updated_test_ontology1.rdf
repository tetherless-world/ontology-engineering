	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6a93f1ea-bfe5-460e-8936-efa951447868">
		<rdfs:label>article-6a93f1ea-bfe5-460e-8936-efa951447868</rdfs:label>
		<rdfs:comment>Mr. Biden has gone on the offensive, taking aim at two rivals ahead of him in the Iowa results, Pete Buttigieg and Bernie Sanders, while Ms. Warren continues to stress unity.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-4a606035-f311-493f-9272-00230e475b23"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-8eb0923f-854c-4241-9d79-040d1aeeb0c0"/>
