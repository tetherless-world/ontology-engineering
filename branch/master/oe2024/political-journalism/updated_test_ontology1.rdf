	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-c80cf9b2-1416-4b44-81e4-f1dec4cf1b16">
		<rdfs:label>article-c80cf9b2-1416-4b44-81e4-f1dec4cf1b16</rdfs:label>
		<rdfs:comment>“We did all the right moves,” the president said Wednesday. “The federal government rose to the challenge, and this is a great success story,” said his son-in-law.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-922ad7b9-e6de-456a-9bc2-69207748d175"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-04-29"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
