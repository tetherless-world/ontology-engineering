		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2022-10-01"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4e6d3f2-9a6d-48fd-a188-c51a426ca21c">
		<rdfs:label>article-a4e6d3f2-9a6d-48fd-a188-c51a426ca21c</rdfs:label>
		<rdfs:comment>A Guantánamo detainee had sought information from two former government contractors to aid in a Polish criminal inquiry into a facility there.</rdfs:comment>
