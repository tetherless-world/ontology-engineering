	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-9b565c55-9f24-48cb-83a8-a4b6ed8b3908">
		<rdfs:label>article-9b565c55-9f24-48cb-83a8-a4b6ed8b3908</rdfs:label>
