	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a4d09898-c0d0-4984-859b-908d33959247">
		<rdfs:label>article-a4d09898-c0d0-4984-859b-908d33959247</rdfs:label>
		<rdfs:comment>The shooting and its aftermath were guaranteed to ratchet up tensions in a country already on edge. Debates about how to improve police accountability have been complicated by looting.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-48e200fd-02da-4ffc-8666-066f9561a258"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-788e797a-01d7-43bd-8d08-665d3203a408"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-ae47edf3-29dc-462d-b74b-f886ebf56402"/>
