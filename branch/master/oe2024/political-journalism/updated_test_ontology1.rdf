	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-6fe1656a-16b8-4ae0-96d1-b5dbaecb2f97">
		<rdfs:label>article-6fe1656a-16b8-4ae0-96d1-b5dbaecb2f97</rdfs:label>
		<rdfs:comment>Record temperatures are possible again on Wednesday as an unrelenting heat wave streches to more of the country.</rdfs:comment>
