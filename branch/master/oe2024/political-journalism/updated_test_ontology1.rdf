	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03d41806-6843-40cd-a537-cfdedcc76197">
		<rdfs:label>article-03d41806-6843-40cd-a537-cfdedcc76197</rdfs:label>
		<rdfs:comment>TV optics and a virtual campaign: This is your morning tip sheet.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-887d1269-7020-4c8e-8dfc-eae7c464f3cb"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-03-31"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
