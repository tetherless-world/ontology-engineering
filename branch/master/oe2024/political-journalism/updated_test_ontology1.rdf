		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-10-23"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-b8f53893-5962-46aa-8910-b54981a94445">
		<rdfs:label>article-b8f53893-5962-46aa-8910-b54981a94445</rdfs:label>
		<rdfs:comment>Matthew Pottinger, who resigned on the day of the Capitol riot, is expected to be among those at the prime-time session on Thursday, along with Sarah Matthews, a former deputy press secretary.</rdfs:comment>
