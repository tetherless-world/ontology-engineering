	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cf4e079-b48c-437b-abfc-a1e5cc83d7c9">
		<rdfs:label>article-7cf4e079-b48c-437b-abfc-a1e5cc83d7c9</rdfs:label>
		<rdfs:comment>SAN ANTONIO — A 32-unit apartment complex near San Antonio burned down on Thursday night into Friday morning as fire hydrants ran dry after a winter storm that disrupted the water supply for millions of Texans.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-38612bef-d331-4b4e-8a11-2278ecc52a9a"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-3d036c4f-8ad0-458c-98fa-b15acd415658"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2021-02-20"/>
		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-7cf9baa7-1369-4d98-99c8-a76adbd9039a">
