		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-83de7d77-8283-4095-9852-94c2d5d36055">
		<rdfs:label>article-83de7d77-8283-4095-9852-94c2d5d36055</rdfs:label>
		<rdfs:comment>The facilities evacuated more than 800 residents to a squalid warehouse where several people died.</rdfs:comment>
