	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-da2eea56-ccb1-4c0e-9a19-9192015f9192">
		<rdfs:label>article-da2eea56-ccb1-4c0e-9a19-9192015f9192</rdfs:label>
		<rdfs:comment>The request comes a week before the highly anticipated memoir was set to be published.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-049fb7b6-9066-46e6-b432-7450b1cd6746"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-dd522e1c-57a0-49bc-9835-fae39d9d58a6"/>
