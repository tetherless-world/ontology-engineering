	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-a05a8d10-153f-4268-a72a-d2d1e143e417">
		<rdfs:label>article-a05a8d10-153f-4268-a72a-d2d1e143e417</rdfs:label>
		<rdfs:comment>The previous recommendation of six feet of distancing was a major obstacle to bringing students back for in-person learning.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-204cd1d8-9d72-4785-968e-7d68ce7d17d7"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-49a73997-b3e5-4f97-8d10-e5b247447638"/>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-9ef20237-f390-44c5-8d52-031cdd2c86e1"/>
