	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-03e055e7-0cf2-4f38-94c6-7cfcf5703c06">
		<rdfs:label>article-03e055e7-0cf2-4f38-94c6-7cfcf5703c06</rdfs:label>
		<rdfs:comment>At least six people were killed and 12 wounded on Sunday in a killing that the police say involved multiple shooters.</rdfs:comment>
