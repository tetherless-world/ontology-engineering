	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-07acb6af-60a3-4db3-8e12-8f1ef7a29e49">
		<rdfs:label>article-07acb6af-60a3-4db3-8e12-8f1ef7a29e49</rdfs:label>
