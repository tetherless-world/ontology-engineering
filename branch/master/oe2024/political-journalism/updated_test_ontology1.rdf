		<PoliticalJournalism:hasPublisher rdf:resource="&PoliticalJournalism;NewYorkTimes"/>
	</PoliticalJournalism:Article>
	
	<PoliticalJournalism:Article rdf:about="&PoliticalJournalism;article-71fe35d5-ce62-48d4-a592-1a0597ea62a6">
		<rdfs:label>article-71fe35d5-ce62-48d4-a592-1a0597ea62a6</rdfs:label>
		<rdfs:comment>Police officers seized the computer, cellphone and hard drives of Rebekah D. Jones, an outspoken critic of Florida’s handling of coronavirus data,  Ms. Jones said.</rdfs:comment>
		<PoliticalJournalism:hasAuthor rdf:resource="&PoliticalJournalism;author-120d1588-a290-47a3-9ce4-8cc42139a1ca"/>
		<PoliticalJournalism:hasPublishDate rdf:resource="&PoliticalJournalism;date-2020-12-07"/>
