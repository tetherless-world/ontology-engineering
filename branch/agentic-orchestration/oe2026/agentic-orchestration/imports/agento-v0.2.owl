<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3id.org/agentic-ai/onto#"
     xml:base="http://www.w3id.org/agentic-ai/onto"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/">
    <owl:Ontology rdf:about="http://www.w3id.org/agentic-ai/onto">
        <dc:contributor>Fajar J. Ekaputra</dc:contributor>
        <dc:creator>Kabul Kurniawan</dc:creator>
        <dc:description xml:lang="en">An ontology for describing agentic AI systems, their components, interraction and patterns.</dc:description>
        <dc:rights>http://creativecommons.org/licenses/by/4.0/</dc:rights>
        <dc:title>Agentic AI Ontology</dc:title>
        <vann:preferredNamespacePrefix>agento</vann:preferredNamespacePrefix>
        <rdfs:comment>An ontology for describing agentic AI systems, their components, interraction and patterns.</rdfs:comment>
        <rdfs:label>Agentic AI Ontology</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/beam/core#participatedIn -->


    <owl:ObjectProperty rdf:about="http://w3id.org/beam/core#participatedIn">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:comment>Indicates that an agent participated in an activity.</rdfs:comment>
        <rdfs:label>participated in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#agentPrompt -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#agentPrompt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasPrompt"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Prompt"/>
        <rdfs:comment>Prompt used by the agent to perform independently of its tasks.</rdfs:comment>
        <rdfs:label>agent prompt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#agentResourceUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#agentResourceUsage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#resourceUsage"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://w3id.org/beam/core#Resource"/>
        <rdfs:comment>Agent directly uses or consumes a resource.</rdfs:comment>
        <rdfs:label>agent resource usage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#agentToolUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#agentToolUsage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#toolUsage"/>
        <rdfs:comment>Agent directly uses a tool to perform tasks or access resources.</rdfs:comment>
        <rdfs:label>agent tool usage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#containsResource -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#containsResource">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Environment"/>
        <rdfs:range rdf:resource="http://w3id.org/beam/core#Resource"/>
        <rdfs:comment>Relates an Environment into resources.</rdfs:comment>
        <rdfs:label>contains resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#contributesToGoal -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#contributesToGoal">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Objective"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Goal"/>
        <rdfs:comment>Relates a objective to the goal it helps achieve.</rdfs:comment>
        <rdfs:label>contributes to goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#contributesToObjective -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#contributesToObjective">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Objective"/>
        <rdfs:comment>task contributes to objective</rdfs:comment>
        <rdfs:label>contributes to objective</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasAgentCapability -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasAgentCapability">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasCapability"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Capability"/>
        <rdfs:comment>Capability that can be performed by agent</rdfs:comment>
        <rdfs:label>has agent capability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasAgentConfig -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasAgentConfig">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasConfig"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Config"/>
        <rdfs:comment>Configuration settings specific to an LLM agent.</rdfs:comment>
        <rdfs:label>has agent config</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasAgentGoal -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasAgentGoal">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasGoal"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Goal"/>
        <rdfs:comment>Goal assigned to an LLM agent.</rdfs:comment>
        <rdfs:label>has agent goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasAgentMember -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasAgentMember">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:comment>Links a team to its participating agents.</rdfs:comment>
        <rdfs:label>has agent member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasAssociatedTask -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasAssociatedTask">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:comment>Links a workflow step to the task it corresponds to.</rdfs:comment>
        <rdfs:label>has associated task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasCapability -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasCapability">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Capability"/>
        <rdfs:comment>Capability that can berforme by agent</rdfs:comment>
        <rdfs:label>has capability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasConfig -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasConfig">
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Config"/>
        <rdfs:comment>Configuration settings for various components.</rdfs:comment>
        <rdfs:label>has config</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasEnvironmentConfig -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasEnvironmentConfig">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasConfig"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Environment"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Config"/>
        <rdfs:comment>Configuration settings specific to an Environment.</rdfs:comment>
        <rdfs:label>has environment config</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasGoal -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasGoal">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Goal"/>
        <rdfs:comment>Relates an agent or team to its goals.</rdfs:comment>
        <rdfs:label>has goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasKnowledge -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasKnowledge">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#KnowledgeBase"/>
        <rdfs:comment>Relates an agent to its knowledge base.</rdfs:comment>
        <rdfs:label>has knowledge base</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasObjective -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasObjective">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Objective"/>
        <rdfs:comment>Objective of a Team or an Agent</rdfs:comment>
        <rdfs:label>has objective</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasPrompt -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasPrompt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Task"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Prompt"/>
        <rdfs:comment>Associates prompts with agents or tasks.</rdfs:comment>
        <rdfs:label>has prompt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasRelatedPattern -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasRelatedPattern">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowPattern"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowPattern"/>
        <rdfs:comment>Indicates a relationship between workflow patterns.</rdfs:comment>
        <rdfs:label>has related pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasSubPattern -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasSubPattern">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasRelatedPattern"/>
        <rdfs:comment>Indicates a sub-pattern that is part of a larger workflow pattern.</rdfs:comment>
        <rdfs:label>has sub pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasSystemConfig -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasSystemConfig">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasConfig"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Config"/>
        <rdfs:comment>Configuration settings specific to a Team system.</rdfs:comment>
        <rdfs:label>has system config</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasTeamGoal -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasTeamGoal">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasGoal"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Goal"/>
        <rdfs:comment>Goal assigned to a Team.</rdfs:comment>
        <rdfs:label>has team goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasToolConfig -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasToolConfig">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasConfig"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Config"/>
        <rdfs:comment>Configuration settings specific to a Tool.</rdfs:comment>
        <rdfs:label>has tool config</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasWorkflowPattern -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasWorkflowPattern">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowPattern"/>
        <rdfs:comment>Relates a team to the workflow pattern it follows.</rdfs:comment>
        <rdfs:label>has workflow pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#hasWorkflowStep -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#hasWorkflowStep">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowPattern"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:comment>Specifies a step that is part of a workflow pattern.</rdfs:comment>
        <rdfs:label>has workflow step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#humanParticipatedIn -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#humanParticipatedIn">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/beam/core#participatedIn"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#HumanAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:comment>Indicates that a human agent participated in a task.</rdfs:comment>
        <rdfs:label>human participated in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#interactsWith -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#interactsWith">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:comment>Relates an agent to other agents it interacts with.</rdfs:comment>
        <rdfs:label>interacts with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#nextPattern -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#nextPattern">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#hasRelatedPattern"/>
        <rdfs:comment>Defines the next workflow pattern in a sequential arrangement.</rdfs:comment>
        <rdfs:label>next pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#nextStep -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#nextStep">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#relatedStep"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:comment>Defines the next step in the workflow sequence.</rdfs:comment>
        <rdfs:label>next step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#operatesIn -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#operatesIn">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Environment"/>
        <rdfs:comment>Relates an agent to its operational environment. (shall we not describing this at this stage?)</rdfs:comment>
        <rdfs:label>operates in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#performedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#performedBy">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:comment>Indicates the tool/agent that performs the task in a step.</rdfs:comment>
        <rdfs:label>performed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#performedByAgent -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#performedByAgent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#performedBy"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:comment>Indicates the agent that performs the task in a step.</rdfs:comment>
        <rdfs:label>performed by agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#producedResource -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#producedResource">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://w3id.org/beam/core#Resource"/>
        <rdfs:comment>Relates a task to resources produced as output.</rdfs:comment>
        <rdfs:label>produced resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#relatedStep -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#relatedStep">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:comment>Indicates a relationship between workflow steps.</rdfs:comment>
        <rdfs:label>related step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#requiresCapability -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#requiresCapability">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Capability"/>
        <rdfs:comment>capability needed for a task .</rdfs:comment>
        <rdfs:label>requires capability (future work)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#requiresResource -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#requiresResource">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://w3id.org/beam/core#Resource"/>
        <rdfs:comment>Relates a task to resources needed for its execution</rdfs:comment>
        <rdfs:label>requires resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/agentic-ai/onto#resourceUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#resourceUsage">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:range rdf:resource="http://w3id.org/beam/core#Resource"/>
        <rdfs:comment>Tool accesses a resource on behalf of the agent.</rdfs:comment>
