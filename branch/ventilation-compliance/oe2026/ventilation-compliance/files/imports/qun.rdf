    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasLowerBound">
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
        <rdfs:label>has lower bound</rdfs:label>
        <skos:definition>specifies the quantity value that is the lower value of a pair of values representing a range</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit">
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit"/>
        <rdfs:label>has measurement unit</rdfs:label>
        <skos:definition>indicates the unit against which a quantity can be expressed in a quantity value</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasUpperBound">
        <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue"/>
        <rdfs:label>has upper bound</rdfs:label>
        <skos:definition>specifies the quantity value that is the higher value of a pair of values representing a range</skos:definition>
    </owl:ObjectProperty>
    


