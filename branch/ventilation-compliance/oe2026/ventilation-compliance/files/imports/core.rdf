    <!-- https://w3id.org/rec/core/CubicMeter -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rec/core/CubicMeter">
        <rdfs:comment xml:lang="en">Volume is the quantity of three-dimensional space enclosed by a closed surface, for example, the space that a substance (solid, liquid, gas, or plasma) or shape occupies or contains. Volume is often quantified numerically using the cubic metre (m3).</rdfs:comment>
