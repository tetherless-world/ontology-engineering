    </owl:Class>
    


    <!-- https://w3id.org/rec/core/Room -->

    <owl:Class rdf:about="https://w3id.org/rec/core/Room">
        <rdfs:comment xml:lang="en">Base class for all more specific room types.</rdfs:comment>
        <rdfs:label xml:lang="en">Room</rdfs:label>
        <o2o:endpoint>room</o2o:endpoint>
        <o2o:included rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</o2o:included>
    </owl:Class>
    


