    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/hasInForce -->

    <owl:ObjectProperty rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/hasInForce">
        <owl:inverseOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/isInForceIn"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/"/>
        <rdfs:label>has in force</rdfs:label>
        <skos:definition>relates a jurisdiction or situation to a rule, regulation or law (collectively &quot;law&quot;) that is currently in force in that situation or jurisdiction</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/isInForceIn -->

    <owl:ObjectProperty rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/isInForceIn">
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/"/>
        <rdfs:label>is in force in</rdfs:label>
        <skos:definition>identifies a jurisdiction in which some law has effect</skos:definition>
    </owl:ObjectProperty>
</rdf:RDF>



