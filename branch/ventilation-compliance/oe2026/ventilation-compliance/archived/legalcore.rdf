<?xml version="1.0"?>
<rdf:RDF xmlns="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/"
     xml:base="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/"
