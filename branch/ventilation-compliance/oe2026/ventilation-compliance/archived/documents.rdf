		See https://opensource.org/licenses/MIT.</dct:license>
        <rdfs:label>Commons Documents Ontology</rdfs:label>
        <skos:changeNote>https://www.omg.org/spec/Commons/20230801/Documents.rdf version of this ontology was revised to add the concept of a document part (COMMONS-13-11).</skos:changeNote>
        <skos:note>This ontology was derived from the Financial Industry Business Ontology (FIBO), and generalized for use in other domain areas.</skos:note>
        <cmns-av:copyright>Copyright (c) 2014-2025 EDM Council, Inc.</cmns-av:copyright>
        <cmns-av:copyright>Copyright (c) 2022-2025 Federated Knowledge LLC</cmns-av:copyright>
        <cmns-av:copyright>Copyright (c) 2022-2025 Mayo Clinic</cmns-av:copyright>
        <cmns-av:copyright>Copyright (c) 2022-2025 Thematix Partners LLC</cmns-av:copyright>
        <cmns-av:copyright>Copyright (c) 2023-2025 Object Management Group, Inc.</cmns-av:copyright>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.omg.org/spec/Commons/Documents/hasDataSource -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/hasDataSource">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
        <rdfs:label>has data source</rdfs:label>
        <skos:definition>relates something, such as an agreement, contract, document, record, report, or process, to a source of data used to analyze, develop, explain, produce, or otherwise create it</skos:definition>
        <cmns-av:usageNote>Although in many cases an annotation property, such as dct:source, is sufficient for this purpose, there are occasions when a more complete description of a source is required, such as to meet data lineage requirements, for which this property may be used.</cmns-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/isAbout -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/isAbout">
        <rdfs:label>is about</rdfs:label>
        <skos:definition>indicates the subject or topic of something, such as a document</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/isReferredToBy -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/isReferredToBy">
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
        <rdfs:label>is referred to by</rdfs:label>
        <skos:definition>indicates something that is referenced as a source for information or explanation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/isSpecifiedIn -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/isSpecifiedIn">
        <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/Commons/Documents/specifies"/>
        <rdfs:label>is specified in</rdfs:label>
        <skos:definition>indicates the explicit source for some requirement, fact, or set of facts</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/records -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/records">
        <rdfs:label>records</rdfs:label>
        <skos:definition>documents for later reference</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/refersTo -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/refersTo">
        <rdfs:label>refers to</rdfs:label>
        <skos:definition>makes reference to as a source for information or explanation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Documents/specifies -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Documents/specifies">
        <rdfs:label>specifies</rdfs:label>
        <skos:definition>mentions, names or states something clearly and definitively</skos:definition>
        <cmns-av:explanatoryNote>Specifies may be used to refer to a requirement, fact, or set of facts.</cmns-av:explanatoryNote>
    </owl:ObjectProperty>
</rdf:RDF>



